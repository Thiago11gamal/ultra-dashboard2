      const catTasksRaw = cat.tasks || [];
      const safeCatTasks = (Array.isArray(catTasksRaw) ? catTasksRaw : Object.values(catTasksRaw || {})).filter(Boolean);
      safeCatTasks.forEach(tsk => {
