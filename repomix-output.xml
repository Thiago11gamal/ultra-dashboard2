<file path="src/components/charts/Coach/CalibrationDriftChart.jsx">
import React, { useMemo } from 'react';
import {
  ComposedChart,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceLine,
  ReferenceArea,
  Legend,
} from 'recharts';
import { ChartFrame } from '../ChartFrame';
import { buildCalibrationSeriesData } from '../../../utils/advancedChartHelpers';

function CalibrationTooltip({ active, payload }) {
  if (!active || !payload || !payload.length) return null;
  const pt = payload[0]?.payload;
  if (!pt) return null;

  return (
    <div className="bg-slate-950/95 border border-white/15 rounded-2xl p-3.5 shadow-2xl text-xs min-w-[190px]">
      <p className="text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-white/10 pb-1 mb-2">
        {pt.dateLabel} {pt.label ? `• ${pt.label}` : ''}
      </p>
      <div className="space-y-1 font-mono">
        {pt.brier !== null && (
          <div className="flex justify-between gap-4">
            <span className="text-rose-300">Brier Score:</span>
            <span className="font-black text-white">{pt.brier.toFixed(3)}</span>
          </div>
        )}
        {pt.ece !== null && (
          <div className="flex justify-between gap-4">
            <span className="text-cyan-300">ECE:</span>
            <span className="font-black text-white">{pt.ece.toFixed(3)}</span>
          </div>
        )}
      </div>
      <p className="text-[10px] text-slate-500 mt-1.5">Quanto menor, mais calibrado o motor.</p>
    </div>
  );
}

export const CalibrationDriftChart = React.memo(function CalibrationDriftChart({
  series = null,
  auditLogs = [],
  historyByCategory = {},
  healthSnapshots = [],
  categoryFilter = 'all',
  height = 240,
}) {
  const data = useMemo(() => {
    if (Array.isArray(series) && series.length > 0) {
      return series.map((pt, idx) => {
        const d = pt.ts > 0 ? new Date(pt.ts) : null;
        return {
          ...pt,
          dateLabel: d && !Number.isNaN(d.getTime())
            ? `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`
            : `#${idx + 1}`,
          brier: pt.brier != null && Number.isFinite(Number(pt.brier)) ? Number(Number(pt.brier).toFixed(4)) : null,
          ece: pt.ece != null && Number.isFinite(Number(pt.ece)) ? Number(Number(pt.ece).toFixed(4)) : null,
        };
      });
    }
    return buildCalibrationSeriesData(auditLogs, historyByCategory, healthSnapshots, { categoryFilter });
  }, [series, auditLogs, historyByCategory, healthSnapshots, categoryFilter]);

  if (!data.length) {
    return (
      <div className="rounded-xl border border-slate-700/50 bg-slate-900/40 p-6 text-center text-xs text-slate-400">
        Sem histórico temporal de Brier Score / ECE ainda. As curvas aparecerão após as auditorias de calibração.
      </div>
    );
  }

  const maxMetric = Math.max(
    0.35,
    ...data.map((d) => Math.max(d.brier || 0, d.ece || 0))
  );
  const yMax = Math.min(1, Number((maxMetric * 1.15).toFixed(2)));

  return (
    <ChartFrame minHeight={height} label="Traçando drift de calibração">
      <div style={{ height }} className="w-full" role="img" aria-label="Evolução temporal do Brier Score e ECE">
        <ResponsiveContainer width="100%" height="100%" minHeight={200} minWidth={1}>
          <ComposedChart data={data} margin={{ top: 10, right: 16, left: 0, bottom: 8 }}>
            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" vertical={false} />
            <ReferenceArea y1={0} y2={0.18} fill="#10b981" fillOpacity={0.05} />
            <ReferenceArea y1={0.25} y2={yMax} fill="#f43f5e" fillOpacity={0.06} />
            <XAxis dataKey="dateLabel" stroke="#64748b" fontSize={10} />
            <YAxis domain={[0, yMax]} stroke="#64748b" fontSize={10} tickFormatter={(v) => Number(v).toFixed(2)} />
            <Tooltip content={<CalibrationTooltip />} />
            <Legend wrapperStyle={{ fontSize: 11 }} />
            <ReferenceLine y={0.25} stroke="#f43f5e" strokeDasharray="4 4" label={{ value: 'Crítico (0.25)', position: 'insideTopRight', fill: '#fb7185', fontSize: 9 }} />
            <ReferenceLine y={0.12} stroke="#22d3ee" strokeDasharray="3 3" label={{ value: 'Alvo ECE (0.12)', position: 'insideTopLeft', fill: '#67e8f9', fontSize: 9 }} />
            <Line
              type="monotone"
              dataKey="brier"
              name="Brier Score (erro)"
              stroke="#fb7185"
              strokeWidth={2.5}
              dot={{ r: 3.5, fill: '#fb7185' }}
              connectNulls
            />
            <Line
              type="monotone"
              dataKey="ece"
              name="ECE (calibração)"
              stroke="#22d3ee"
              strokeWidth={2.5}
              dot={{ r: 3.5, fill: '#22d3ee' }}
              connectNulls
            />
          </ComposedChart>
        </ResponsiveContainer>
      </div>
    </ChartFrame>
  );
});

export default CalibrationDriftChart;
</file>

<file path="src/components/charts/Coach/CausalUpliftChart.jsx">
import React, { useMemo } from 'react';
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceLine,
  Cell,
  ErrorBar,
} from 'recharts';
import { ChartFrame } from '../ChartFrame';

const ACTION_LABELS = {
  srs_review: 'Revisão SRS',
  simulado: 'Simulado',
  error_review: 'Revisão de Erros',
  study_volume: 'Volume de Estudo',
  theory: 'Teoria / Base',
  general_review: 'Consolidação',
  practice: 'Prática / Questões',
  critical_rescue: 'Resgate Crítico',
};

function UpliftTooltip({ active, payload }) {
  if (!active || !payload || !payload.length) return null;
  const item = payload[0]?.payload;
  if (!item) return null;
  const pos = item.uplift >= 0;

  return (
    <div className="bg-slate-950/95 border border-white/15 rounded-2xl p-3.5 shadow-2xl text-xs min-w-[200px]">
      <p className="font-black text-white mb-1.5 border-b border-white/10 pb-1">{item.label}</p>
      <div className="space-y-1 font-mono">
        <div className="flex justify-between gap-4">
          <span className="text-slate-400">Uplift estimado:</span>
          <span className={`font-black ${pos ? 'text-emerald-400' : 'text-rose-400'}`}>
            {pos ? '+' : ''}{item.uplift.toFixed(2)} pts
          </span>
        </div>
        {item.hasCi && (
          <div className="flex justify-between gap-4 text-slate-400">
            <span>IC 95%:</span>
            <span>[{item.ciLow.toFixed(2)}, {item.ciHigh.toFixed(2)}]</span>
          </div>
        )}
        <div className="flex justify-between gap-4 text-slate-400">
          <span>Amostras:</span>
          <span className="text-white">{item.sampleSize}</span>
        </div>
        <div className="flex justify-between gap-4 text-slate-500 text-[10px]">
          <span>Método:</span>
          <span>{item.method}</span>
        </div>
      </div>
    </div>
  );
}

export const CausalUpliftChart = React.memo(function CausalUpliftChart({ causalModel = null }) {
  const chartData = useMemo(() => {
    const actions = causalModel?.actions;
    if (!actions || typeof actions !== 'object') return [];
    return Object.entries(actions)
      .filter(([, est]) => est && typeof est === 'object' && Number.isFinite(Number(est.uplift)))
      .map(([actionType, est]) => {
        const uplift = Number(est.uplift);
        const low = Number(est?.ci?.low);
        const high = Number(est?.ci?.high);
        const hasCi = Number.isFinite(low) && Number.isFinite(high);
        const errMinus = hasCi ? Math.max(0, uplift - low) : 0;
        const errPlus = hasCi ? Math.max(0, high - uplift) : 0;
        return {
          actionType,
          label: ACTION_LABELS[actionType] || actionType,
          uplift: Number(uplift.toFixed(3)),
          errorBar: [Number(errMinus.toFixed(3)), Number(errPlus.toFixed(3))],
          hasCi,
          ciLow: hasCi ? low : uplift,
          ciHigh: hasCi ? high : uplift,
          sampleSize: est.sampleSize ?? 0,
          method: est.method || 'observational',
        };
      })
      .sort((a, b) => b.uplift - a.uplift);
  }, [causalModel]);

  if (!chartData.length) {
    return (
      <div className="rounded-xl border border-slate-700/50 bg-slate-900/40 p-6 text-center text-xs text-slate-400">
        Treine o modelo causal para visualizar o gráfico de ganho real (uplift + IC 95%) por tipo de ação.
      </div>
    );
  }

  return (
    <ChartFrame minHeight={240} label="Carregando uplift causal">
      <div className="h-[240px] w-full" role="img" aria-label="Gráfico de Uplift Causal por Tipo de Ação">
        <ResponsiveContainer width="100%" height="100%" minHeight={220} minWidth={1}>
          <BarChart data={chartData} layout="vertical" margin={{ top: 8, right: 28, left: 20, bottom: 8 }}>
            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" horizontal={false} />
            <XAxis type="number" stroke="#64748b" fontSize={10} tickFormatter={(v) => `${v > 0 ? '+' : ''}${v}`} />
            <YAxis type="category" dataKey="label" width={115} stroke="#94a3b8" fontSize={11} />
            <Tooltip content={<UpliftTooltip />} cursor={{ fill: 'rgba(255,255,255,0.04)' }} />
            <ReferenceLine x={0} stroke="#94a3b8" strokeWidth={1.5} />
            <Bar dataKey="uplift" radius={[4, 4, 4, 4]} barSize={20}>
              {chartData.map((entry) => (
                <Cell
                  key={entry.actionType}
                  fill={entry.uplift >= 0 ? '#10b981' : '#f43f5e'}
                  fillOpacity={0.85}
                />
              ))}
              <ErrorBar dataKey="errorBar" width={6} strokeWidth={1.5} stroke="#e2e8f0" direction="x" />
            </Bar>
          </BarChart>
        </ResponsiveContainer>
      </div>
    </ChartFrame>
  );
});

export default CausalUpliftChart;
</file>

