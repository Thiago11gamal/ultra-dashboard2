                                    }`}>
                                    {label}
                                </span>
                                <div className={`h-1 rounded-full mt-1 w-12 ${isMVP ? 'bg-purple-500' : isNegative ? 'bg-red-500' : 'bg-blue-500'
                                    } opacity-30`} />
