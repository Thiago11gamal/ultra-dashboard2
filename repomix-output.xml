  max-width: 200px;
  transition: opacity 0.2s ease, max-height 0.2s ease;
}

.sidebar.collapsed .sidebar-nav-label {
  display: none;
}

/* Accordion fluido baseado em CSS Grid (Zero stutter!) */
.sidebar-accordion {
  display: grid;
  grid-template-rows: 0fr;
  opacity: 0;
  transition: grid-template-rows 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
}

.sidebar-accordion.expanded {
  grid-template-rows: 1fr;
  opacity: 1;
}

.sidebar-accordion-inner {
  overflow: hidden;
  min-height: 0;
}

/* Itens do Menu Base */
.sidebar-item-wrapper {
  position: relative;
  width: 100%;
}

.sidebar-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 12px;
  color: #cbd5e1;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.84rem;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
    background-color 0.18s ease,
    color 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;
  cursor: pointer;
  background: rgba(15, 23, 42, 0.25);
  width: 100%;
  text-align: left;
  border: 1px solid rgba(255, 255, 255, 0.03);
  margin-bottom: 3px;
  position: relative;
  overflow: hidden;
  outline: none;
  min-height: 42px;
}

/* Icon Box Framer */
.sidebar-item-icon-wrapper {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  color: #94a3b8;
}

.sidebar-item svg {
  width: 16px;
  height: 16px;
  opacity: 0.85;
  transition: color 0.2s ease, opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  flex-shrink: 0;
}

/* Text wrapper que anima sem saltos */
.sidebar-item-text {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  white-space: nowrap;
  overflow: hidden;
  max-width: calc(100% - 48px);
  opacity: 1;
  transform: translateX(0);
  transition: max-width 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, transform 0.2s ease;
  flex: 1;
  min-width: 0;
}

.sidebar.collapsed .sidebar-item-text {
  max-width: 0;
  opacity: 0;
  transform: translateX(-8px);
  pointer-events: none;
}

.sidebar-item-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Hover State */
.sidebar-item:hover {
  background: linear-gradient(90deg, var(--item-color-alpha, rgba(255, 255, 255, 0.08)) 0%, rgba(15, 23, 42, 0.65) 100%);
