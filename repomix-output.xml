<file path="src/components/ui/AdaptiveMaturityBadge.jsx">
import React, { useEffect, useMemo } from 'react';
import { Sparkles, ShieldCheck } from 'lucide-react';
import { useAppStore } from '../../store/useAppStore';
import { useShallow } from 'zustand/react/shallow';
import {
  evaluateContestMaturity,
  syncAdaptiveFeatureFlags,
  ADAPTIVE_STAGES,
} from '../../engine/adaptive/adaptiveMaturityEngine';
import { useAuth } from '../../context/useAuth';
import { isAdminUser } from '../../utils/adminAccess';

const STAGE_STYLE = [
  'border-slate-600/40 bg-slate-800/40 text-slate-300',
  'border-sky-500/30 bg-sky-500/10 text-sky-300',
  'border-indigo-500/30 bg-indigo-500/10 text-indigo-300',
  'border-violet-500/30 bg-violet-500/10 text-violet-300',
  'border-fuchsia-500/30 bg-fuchsia-500/10 text-fuchsia-300',
  'border-emerald-500/40 bg-emerald-500/15 text-emerald-300',
];

/**
 * Selo vivo de maturidade adaptativa (N0 → N5).
 * Sincroniza automaticamente as feature flags do Coach conforme novos dados são lançados
 * (sempre respeitando overrides manuais do Control Center).
 */
export const AdaptiveMaturityBadge = React.memo(function AdaptiveMaturityBadge({
  compact = false,
  autoSync = true,
}) {
  const { activeId, contest } = useAppStore(
    useShallow((state) => {
      const id = state.appState?.activeId || 'default';
      return {
        activeId: id,
        contest: state.appState?.contests?.[id] || null,
      };
    })
  );

  const patchData = useAppStore((state) => state.patchData);
  const currentUser = useAuth()?.currentUser || null;
  const isAdmin = isAdminUser(currentUser);
  const maturity = useMemo(() => evaluateContestMaturity(contest || {}, { isAdmin }), [contest, isAdmin]);

  useEffect(() => {
    if (!autoSync || !contest) return;
    const syncRes = syncAdaptiveFeatureFlags(contest, activeId, { respectOverrides: true, isAdmin });
    if (typeof patchData !== 'function') return;

    // Persiste no documento do concurso APENAS flags derivadas de maturidade real
    // ou overrides explícitos — evitando poluir o documento ao usar bypass administrativo.
    const cloudMaturityUnlocked = isAdmin
      ? evaluateContestMaturity(contest, { isAdmin: false }).unlockedFlags
      : (syncRes?.maturity?.unlockedFlags || {});
    const desiredCloud = {
      ...cloudMaturityUnlocked,
      ...(syncRes?.manualOverrides || {}),
    };
    const desiredEntries = Object.entries(desiredCloud);
    if (desiredEntries.length === 0) return;

    const prevCloud = contest.coachFeatureFlags || {};
    const differs = desiredEntries.some(([k, v]) => prevCloud[k] !== v);
    if (differs) {
      patchData(() => ({
        coachFeatureFlags: { ...prevCloud, ...desiredCloud },
      }));
    }
}, [autoSync, contest, activeId, patchData, isAdmin, maturity.stage, maturity.metrics.simuladoCount, maturity.metrics.studySessionsCount]);

const cls = STAGE_STYLE[maturity.stage] || STAGE_STYLE[0];

if (compact) {
  return (
    <div
      className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-[11px] font-bold ${cls}`}
      title={`${maturity.description} ${maturity.nextHint}`}
    >
      <Sparkles size={12} />
      <span>Motor Adaptativo {maturity.code} · {maturity.name}</span>
      {maturity.unlockedFlagCount > 0 && (
        <span className="text-[10px] opacity-75 font-mono">({maturity.unlockedFlagCount} ativos)</span>
      )}
    </div>
  );
}

return (
  <div className={`rounded-2xl border p-4 backdrop-blur-xl ${cls}`}>
    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div className="flex items-start gap-3">
        <div className="p-2 rounded-xl bg-black/30 border border-white/10 shrink-0">
          {maturity.stage >= 5 ? <ShieldCheck size={18} /> : <Sparkles size={18} />}
        </div>
        <div>
          <div className="flex items-center gap-2 flex-wrap">
            <span className="text-[10px] font-black uppercase tracking-widest px-2 py-0.5 rounded-md bg-black/30 border border-white/10 font-mono">
              {maturity.code} / N5
            </span>
            <h3 className="text-sm font-black text-white">{maturity.name}</h3>
            <span className="text-[11px] opacity-80">· {maturity.shortLabel}</span>
          </div>
          <p className="text-xs text-slate-300/90 mt-1">{maturity.description}</p>
          <p className="text-[11px] text-slate-400 mt-1">{maturity.nextHint}</p>
        </div>
      </div>

      <div className="sm:w-44 shrink-0 space-y-1.5">
        <div className="flex justify-between text-[10px] font-mono">
          <span>{maturity.nextStage ? `Próx: ${maturity.nextStage.code}` : 'Nível Máximo'}</span>
          <span className="font-bold">{maturity.progressToNextPct}%</span>
        </div>
        <div className="h-2 rounded-full bg-black/40 overflow-hidden">
          <div
            className="h-full rounded-full bg-current transition-all duration-700"
            style={{ width: `${maturity.progressToNextPct}%` }}
          />
        </div>
        <div className="flex justify-between gap-0.5 pt-0.5">
          {ADAPTIVE_STAGES.map((st) => (
            <span
              key={st.code}
              className={`h-1 flex-1 rounded-full ${st.stage <= maturity.stage ? 'bg-current' : 'bg-white/10'}`}
              title={`${st.code}: ${st.name}`}
            />
          ))}
        </div>
      </div>
    </div>
  </div>
);
});

export default AdaptiveMaturityBadge;
</file>

<file path="src/components/AnimatedMantaRay.jsx">
import React, { useEffect, useId, useMemo, useRef } from 'react';
import { MANTA_BASIS, MANTA_VIEWBOX } from './mantaGeometry';
import {
    FLOW_MOTES,
    LEFT_TIP_INDEX,
    RIGHT_TIP_INDEX,
    ROLL_RATIO,
    SWIM_OMEGA,
    buildMantaPath,
    buildWakeData,
    clamp,
} from './mantaKinematics';

export default function AnimatedMantaRay({
    className = '',
    style,
    ariaLabel = 'Método Arraia',
    interactive = true,
    showFlow = true,
    respectReducedMotion = false,
}) {
    const uid = useId().replace(/:/g, '');
    const containerRef = useRef(null);
    const rectRef = useRef(null);
    const pathRef = useRef(null);
    const leftWakeRef = useRef(null);
    const rightWakeRef = useRef(null);
    const leftWakeGradRef = useRef(null);
    const rightWakeGradRef = useRef(null);
    const shadowRef = useRef(null);
    const gradRef = useRef(null);
    const moteRefs = useRef([]);

    const hoverTargetRef = useRef({ x: 0, y: 0, active: false });
    const hoverCurrentRef = useRef({ x: 0, y: 0, speedBoost: 0 });

    const restPath = useMemo(() => buildMantaPath(0, 0, 0, 0, true), []);

    useEffect(() => {
        if (typeof window === 'undefined') return undefined;

        const mediaQuery = respectReducedMotion && typeof window.matchMedia === 'function'
            ? window.matchMedia('(prefers-reduced-motion: reduce)')
            : null;

        let reducedMotion = respectReducedMotion && Boolean(mediaQuery?.matches);
        let isTabVisible = typeof document === 'undefined' || !document.hidden;
        let isInViewport = true;
        let rafId = null;
        let simTime = 0.65;
        let lastTimestamp = null;

        const setBodyPath = (d) => {
            if (pathRef.current) pathRef.current.setAttribute('d', d);
        };

        const applyRestPose = () => {
            setBodyPath(restPath);
            if (leftWakeRef.current) leftWakeRef.current.setAttribute('d', '');
            if (rightWakeRef.current) rightWakeRef.current.setAttribute('d', '');
            if (gradRef.current) {
                gradRef.current.setAttribute('y1', '12%');
                gradRef.current.setAttribute('x2', '84%');
            }
            if (shadowRef.current) {
                shadowRef.current.setAttribute('transform', 'translate(268 292) rotate(-31)');
                shadowRef.current.setAttribute('opacity', '0.32');
            }
            for (let i = 0; i < FLOW_MOTES.length; i++) {
                const el = moteRefs.current[i];
                if (!el) continue;
                const m = FLOW_MOTES[i];
                el.setAttribute('cx', String(m.startX));
                el.setAttribute('cy', String(m.startY));
                el.setAttribute('opacity', '0');
            }
        };

        const canAnimate = () => !reducedMotion && isTabVisible && isInViewport;

        const stopLoop = () => {
            if (rafId !== null && typeof window.cancelAnimationFrame === 'function') {
                window.cancelAnimationFrame(rafId);
            }
            rafId = null;
        };

        const step = (timestamp) => {
            rafId = null;
            if (reducedMotion) {
                applyRestPose();
                return;
            }
            if (!isTabVisible || !isInViewport) {
                return;
            }

            if (lastTimestamp === null) {
                lastTimestamp = timestamp;
            }
            const rawDt = (timestamp - lastTimestamp) / 1000;
            lastTimestamp = timestamp;
            const dt = Math.min(0.05, Math.max(0, rawDt));

            const ht = hoverTargetRef.current;
            const hc = hoverCurrentRef.current;
            // Hydraulic water damping so pointer tilt and hover glide settle silkily
            const damp = 1 - Math.exp(-4.0 * dt);
            const boostDamp = 1 - Math.exp(-2.8 * dt);
            hc.x += (ht.x - hc.x) * damp;
            hc.y += (ht.y - hc.y) * damp;
            const targetBoost = ht.active ? 0.20 : 0;
            hc.speedBoost += (targetBoost - hc.speedBoost) * boostDamp;

            simTime += dt * (1 + hc.speedBoost);
            const phase = simTime * SWIM_OMEGA;
            const rollPhase = phase * ROLL_RATIO;

            setBodyPath(buildMantaPath(phase, rollPhase, hc.x, hc.y, false));

            const updateWake = (tipIndex, pathEl, gradEl) => {
                if (!pathEl) return;
                const wake = buildWakeData(tipIndex, phase, rollPhase, hc.x, hc.y);
                pathEl.setAttribute('d', wake.d);
                if (gradEl) {
                    gradEl.setAttribute('x1', wake.xStart.toFixed(1));
                    gradEl.setAttribute('y1', wake.yStart.toFixed(1));
                    gradEl.setAttribute('x2', wake.xEnd.toFixed(1));
                    gradEl.setAttribute('y2', wake.yEnd.toFixed(1));
                }
            };

            if (showFlow) {
                updateWake(LEFT_TIP_INDEX, leftWakeRef.current, leftWakeGradRef.current);
                updateWake(RIGHT_TIP_INDEX, rightWakeRef.current, rightWakeGradRef.current);
            }

            if (gradRef.current) {
                const sheenShift = Math.sin(phase) * 8;
                gradRef.current.setAttribute('y1', `${12 + sheenShift}%`);
                gradRef.current.setAttribute('x2', `${84 + sheenShift * 0.6}%`);
            }

            if (shadowRef.current) {
                const liftFactor = Math.sin(phase - 0.35);
                const sx = 1 - 0.08 * liftFactor;
                const sy = 1 - 0.06 * liftFactor;
                const opacity = (0.34 - 0.08 * liftFactor).toFixed(3);
                shadowRef.current.setAttribute(
                    'transform',
                    `translate(268 292) rotate(-31) scale(${sx.toFixed(3)} ${sy.toFixed(3)})`
                );
                shadowRef.current.setAttribute('opacity', opacity);
            }

            if (showFlow) {
                const B = MANTA_BASIS;
                const span = 440;
                for (let i = 0; i < FLOW_MOTES.length; i++) {
                    const el = moteRefs.current[i];
                    if (!el) continue;
                    const m = FLOW_MOTES[i];
                    const travel = (simTime * m.speed + m.phase * span) % span;
                    const mx = m.startX - B.fwdX * travel;
                    const my = m.startY - B.fwdY * travel;
                    const edgeFade = Math.sin((travel / span) * Math.PI);
                    el.setAttribute('cx', mx.toFixed(1));
                    el.setAttribute('cy', my.toFixed(1));
                    el.setAttribute('opacity', (m.opacity * edgeFade).toFixed(3));
                }
            }

            if (canAnimate() && typeof window.requestAnimationFrame === 'function') {
                rafId = window.requestAnimationFrame(step);
            }
        };

        const syncLoopState = () => {
            if (reducedMotion) {
                stopLoop();
                applyRestPose();
                return;
            }
            if (canAnimate()) {
                if (rafId === null && typeof window.requestAnimationFrame === 'function') {
                    lastTimestamp = null;
                    rafId = window.requestAnimationFrame(step);
                }
            } else {
                stopLoop();
            }
        };

        const handleMotionChange = (e) => {
            reducedMotion = Boolean(e.matches);
            syncLoopState();
        };

        const handleVisibilityChange = () => {
            isTabVisible = !document.hidden;
            syncLoopState();
        };

        if (mediaQuery && typeof mediaQuery.addEventListener === 'function') {
            mediaQuery.addEventListener('change', handleMotionChange);
        }
        if (typeof document !== 'undefined') {
            document.addEventListener('visibilitychange', handleVisibilityChange);
        }

        let intersectionObs = null;
        if (typeof IntersectionObserver === 'function' && containerRef.current) {
            intersectionObs = new IntersectionObserver((entries) => {
                if (entries.length > 0) {
                    isInViewport = entries[0].isIntersecting;
                    syncLoopState();
                }
            }, { threshold: 0.01 });
            intersectionObs.observe(containerRef.current);
        }

        let resizeObs = null;
        if (typeof ResizeObserver === 'function' && containerRef.current) {
            resizeObs = new ResizeObserver(() => {
                rectRef.current = null;
            });
            resizeObs.observe(containerRef.current);
        }

        syncLoopState();

        return () => {
            stopLoop();
            if (mediaQuery && typeof mediaQuery.removeEventListener === 'function') {
                mediaQuery.removeEventListener('change', handleMotionChange);
            }
            if (typeof document !== 'undefined') {
                document.removeEventListener('visibilitychange', handleVisibilityChange);
            }
            if (intersectionObs) intersectionObs.disconnect();
            if (resizeObs) resizeObs.disconnect();
        };
    }, [restPath, showFlow, respectReducedMotion]);

    const handlePointerEnter = (e) => {
        if (!interactive) return;
        rectRef.current = e.currentTarget.getBoundingClientRect();
    };

    const handlePointerMove = (e) => {
        if (!interactive) return;
        let rect = rectRef.current;
        if (!rect) {
            rect = e.currentTarget.getBoundingClientRect();
            rectRef.current = rect;
        }
        if (!rect.width || !rect.height) return;
        const nx = clamp(((e.clientX - rect.left) / rect.width) * 2 - 1, -1, 1);
        const ny = clamp(((e.clientY - rect.top) / rect.height) * 2 - 1, -1, 1);
        hoverTargetRef.current = { x: nx, y: ny, active: true };
    };

    const handlePointerLeave = () => {
        if (!interactive) return;
        rectRef.current = null;
        hoverTargetRef.current = { x: 0, y: 0, active: false };
    };

    const bodyPathId = `manta-body-path-${uid}`;
    const bodyGradId = `manta-body-grad-${uid}`;
    const shadowGradId = `manta-shadow-grad-${uid}`;
    const leftWakeGradId = `manta-lwake-grad-${uid}`;
    const rightWakeGradId = `manta-rwake-grad-${uid}`;

    return (
        <div
            ref={containerRef}
            className={`relative select-none flex items-center justify-center ${className}`}
            style={style}
            role="img"
            aria-label={ariaLabel}
            onPointerEnter={handlePointerEnter}
            onPointerMove={handlePointerMove}
            onPointerLeave={handlePointerLeave}
        >
            {/* Static radial underwater glow composited once on GPU (avoids per-frame CSS blur thrashing) */}
            <div
                aria-hidden="true"
                className="pointer-events-none absolute -inset-12"
                style={{
                    background: 'radial-gradient(closest-side at 50% 50%, rgba(99, 102, 241, 0.22) 0%, rgba(56, 189, 248, 0.08) 46%, rgba(15, 23, 42, 0) 100%)',
                }}
            />

            <svg
                viewBox={MANTA_VIEWBOX}
                className="relative w-full h-auto overflow-visible block"
                aria-hidden="true"
            >
                <defs>
                    <path
                        ref={pathRef}
                        id={bodyPathId}
                        data-manta-body="true"
                        d={restPath}
                    />
                    <linearGradient
                        id={bodyGradId}
                        ref={gradRef}
                        x1="12%"
                        y1="12%"
                        x2="84%"
                        y2="88%"
                    >
                        <stop offset="0%" stopColor="#f8faff" />
                        <stop offset="48%" stopColor="#e0e7ff" />
                        <stop offset="100%" stopColor="#b9c7ff" />
                    </linearGradient>

                    <radialGradient id={shadowGradId} cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stopColor="#6366f1" stopOpacity="0.45" />
                        <stop offset="55%" stopColor="#38bdf8" stopOpacity="0.16" />
                        <stop offset="100%" stopColor="#0f172a" stopOpacity="0" />
                    </radialGradient>

                    <linearGradient id={leftWakeGradId} ref={leftWakeGradRef} gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stopColor="#c7d2fe" stopOpacity="0.22" />
                        <stop offset="48%" stopColor="#38bdf8" stopOpacity="0.10" />
                        <stop offset="100%" stopColor="#38bdf8" stopOpacity="0" />
                    </linearGradient>

                    <linearGradient id={rightWakeGradId} ref={rightWakeGradRef} gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stopColor="#c7d2fe" stopOpacity="0.18" />
                        <stop offset="48%" stopColor="#38bdf8" stopOpacity="0.08" />
                        <stop offset="100%" stopColor="#38bdf8" stopOpacity="0" />
                    </linearGradient>
                </defs>

                <g ref={shadowRef} transform="translate(268 292) rotate(-31)" opacity="0.32">
                    <ellipse cx="0" cy="0" rx="150" ry="58" fill={`url(#${shadowGradId})`} />
                </g>

                {showFlow && (
                    <g aria-hidden="true">
                        {FLOW_MOTES.map((m, idx) => (
                            <circle
                                key={`mote-${idx}`}
                                ref={(el) => { moteRefs.current[idx] = el; }}
                                cx={m.startX}
                                cy={m.startY}
                                r={m.r}
                                fill="#a5f3fc"
                                opacity="0"
                            />
                        ))}
                    </g>
                )}

                {showFlow && (
                    <g fill="none" strokeLinecap="round" aria-hidden="true">
                        <path
                            ref={leftWakeRef}
                            d=""
                            stroke={`url(#${leftWakeGradId})`}
                            strokeWidth="1.4"
                        />
                        <path
                            ref={rightWakeRef}
                            d=""
                            stroke={`url(#${rightWakeGradId})`}
                            strokeWidth="1.4"
                        />
                    </g>
                )}

                <use
                    href={`#${bodyPathId}`}
                    fill="none"
                    stroke="rgba(99, 102, 241, 0.14)"
                    strokeWidth="10"
                    strokeLinejoin="bevel"
                    aria-hidden="true"
                />

                <use
                    href={`#${bodyPathId}`}
                    fill="none"
                    stroke="rgba(186, 230, 253, 0.24)"
                    strokeWidth="3.2"
                    strokeLinejoin="bevel"
                    aria-hidden="true"
                />

                <use
                    href={`#${bodyPathId}`}
                    fill={`url(#${bodyGradId})`}
                />
            </svg>
        </div>
    );
}
