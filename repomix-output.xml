describe('Coach AI Complete Audit Regression Suite (Batches 1-3)', () => {
  beforeEach(() => {
    localStorage.clear();
    clearUrgencyCache();
    clearTopicsCache();
    clearMcCache();
    clearAdaptiveMcCache();
    clearLLMExplanationCache();
    clearLLMProvider();
