      });
    });
  });

  describe('3. coachLogic.js Edge Cases & Null/Empty Coercion Fixes', () => {
    it('ignores empty-string minCutoff in calculateUrgency and falls back to mappedGlobalTarget', () => {
      const cat = {
        id: 'c1',
        name: 'AFO',
        minCutoff: '',
        maxScore: 50,
        minScore: 0,
        simuladoStats: {
          history: [
            { date: '2026-06-01', score: 25, total: 50, correct: 25 },
