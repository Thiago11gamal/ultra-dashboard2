  transform: translateX(0);
}

.sidebar.collapsed .sidebar-logo-text {
  max-width: 0;
  opacity: 0;
  transform: translateX(-10px);
  pointer-events: none;
}

.sidebar-logo span {
  font-size: 1.08rem;
  font-weight: 900;
  background: linear-gradient(135deg, #ffffff 0%, #c7d2fe 100%);
