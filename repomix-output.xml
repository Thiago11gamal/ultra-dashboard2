import { generateId, getSafeId } from '../../utils/idGenerator.js';
import { ensureCoachTaskId } from '../../utils/coachTaskId.js';
import { XP_CONFIG } from '../../config/gamification.js';
import { getTaskXP } from '../../utils/gamification.js';
import { markStorageDirty } from '../../utils/storageSafe.js';
import { normalizePriority } from '../../utils/colorHelper.js';
import { normalize } from '../../utils/normalization.js';
import { matchesActiveSubjectTask } from '../../utils/pomodoroHelpers.js';

const clearPomodoroSession = (state) => {
    const p = state.appState?.pomodoro;
    if (!p) return;
    p.activeSubject = null;
    p.isRunning = false;
    p.neuralMode = false;
    p.neuralQueue = [];
    p.mode = 'work';
    p.sessions = 1;
    p.completedCycles = 0;
    p.accumulatedMinutes = 0;
    try {
        localStorage.removeItem('pomodoroState');
        localStorage.removeItem('pomodoro-endsAt');
    } catch {
        // ignore storage removal errors
    }
};

export const createTaskSlice = (set, get) => ({
    toggleTask: (categoryId, taskId) => {
        let pendingXpChange = 0;
        set((state) => {
            const activeData = state.appState.contests[state.appState.activeId];
            if (!activeData) return;
            if (!Array.isArray(activeData.categories)) {
                activeData.categories = activeData.categories && typeof activeData.categories === 'object'
                    ? Object.values(activeData.categories)
                    : [];
            }

            const category = activeData.categories.find(c => c && (c.id === categoryId || c.name === categoryId));
            if (!category) return;
            if (!Array.isArray(category.tasks)) {
                category.tasks = category.tasks && typeof category.tasks === 'object'
                    ? Object.values(category.tasks)
                    : [];
            }

            const task = category.tasks.find(t => t && (t.id === taskId || t.text === taskId || t.title === taskId));
            if (!task) return;

            const completed = !task.completed;
            const xpChange = getTaskXP(task, completed);
            pendingXpChange = xpChange;

            const nowIso = new Date().toISOString();
            task.completed = completed;
            task.completedAt = completed ? nowIso : null;
            task.updatedAt = nowIso;

            if (completed) {
                task.lastStudiedAt = nowIso;
                // ✅ FIX N-03: Gravar o XP concedido como "recibo" imutável
                task.awardedXP = Math.abs(xpChange);
                if (task.status === 'studying') {
                    task.status = null;
                }
                const activeSubject = state.appState.pomodoro?.activeSubject;
                if (activeSubject && matchesActiveSubjectTask(category, task, activeSubject, taskId)) {
                    clearPomodoroSession(state);
                }
            } else {
                // ✅ FIX N-03: Ao desmarcar, usar o recibo gravado (não o XP atual da prioridade)
                // Isso impede o exploit de mudar prioridade após completar
                delete task.awardedXP;
            }

            activeData.lastUpdated = nowIso;
            state.appState.version = (state.appState.version || 0) + 1;
            state.appState.lastUpdated = nowIso;
            markStorageDirty();
        });
        if (pendingXpChange !== 0 && get().awardExperience) {
            get().awardExperience(pendingXpChange, { skipVersionBump: true });
        }
    },

    toggleNeuralTask: (taskId) => {
        if (!taskId) return;
        let pendingXpChange = 0;
        set((state) => {
            const activeData = state.appState.contests[state.appState.activeId];
            if (!activeData) return;

            let found = false;
            let xpAwarded = false;
            const nowIso = new Date().toISOString();

            let targetCompleted = null;

            const handleTask = (task) => {
                if (task) {
                    if (targetCompleted === null) {
                        targetCompleted = !task.completed;
                    }
                    const completed = targetCompleted;
                    const xpChange = getTaskXP(task, completed);
                    task.completed = completed;
                    task.completedAt = completed ? nowIso : null;
                    task.updatedAt = nowIso;

                    if (completed) {
                        task.lastStudiedAt = nowIso;
                        task.awardedXP = Math.abs(xpChange);
                        if (task.status === 'studying') {
                            task.status = null;
                        }
                    } else {
                        delete task.awardedXP;
                    }

                    if (!xpAwarded) {
                        pendingXpChange += xpChange;
                        xpAwarded = true;
                    }
                    found = true;
                }
            };

            const stripDupSuffix = (idVal) => String(idVal || '').replace(/-dup\d+-[a-zA-Z0-9_-]+$/, '');
            const cleanTaskId = stripDupSuffix(taskId);

            const matchesTask = (t) => {
                if (!t) return false;
                const tIdStr = t.id != null ? stripDupSuffix(t.id) : '';
                const safeIdStr = typeof getSafeId === 'function' ? stripDupSuffix(getSafeId(t)) : '';
                const ensuredIdStr = typeof ensureCoachTaskId === 'function' ? stripDupSuffix(ensureCoachTaskId(t)?.id) : '';
                return (
                    t.id === taskId ||
                    (cleanTaskId && tIdStr === cleanTaskId) ||
                    t.text === taskId ||
                    t.title === taskId ||
                    (cleanTaskId && safeIdStr === cleanTaskId) ||
                    (cleanTaskId && ensuredIdStr === cleanTaskId)
                );
            };

            // Search in coachPlan (Backlog)
            if (activeData.coachPlan) {
                const planList = Array.isArray(activeData.coachPlan) ? activeData.coachPlan : Object.values(activeData.coachPlan || {});
                const task = planList.find(matchesTask);
                if (task) handleTask(task);
            }

            // Search in coachPlanner (Days)
            if (activeData.coachPlanner) {
                    Object.values(activeData.coachPlanner).forEach(rawDayTasks => {
                        const dayTasks = Array.isArray(rawDayTasks) ? rawDayTasks : Object.values(rawDayTasks || {});
                        const task = dayTasks.find(matchesTask);
                        if (task) handleTask(task);
                    });
                }

            // Search in categories (Priority tasks in Pomodoro Focus Panel / Neural Core)
            if (activeData.categories) {
                    (Array.isArray(activeData.categories) ? activeData.categories : Object.values(activeData.categories)).forEach(cat => {
                        const task = (Array.isArray(cat?.tasks) ? cat.tasks : Object.values(cat?.tasks || {})).find(matchesTask);
                        if (task) {
                            handleTask(task);
                            const activeSubject = state.appState.pomodoro?.activeSubject;
                            if (
                                targetCompleted === true &&
                                !state.appState.pomodoro?.neuralMode &&
                                activeSubject &&
                                matchesActiveSubjectTask(cat, task, activeSubject, taskId)
                            ) {
                                clearPomodoroSession(state);
                            }
                        }
                    });
                }

                if (found) {
                    activeData.lastUpdated = nowIso;
                    state.appState.version = (state.appState.version || 0) + 1;
                    state.appState.lastUpdated = nowIso;
                    markStorageDirty();
                }
            });

        if (pendingXpChange !== 0 && get().awardExperience) {
            get().awardExperience(pendingXpChange, { skipVersionBump: true });
        }
    },

    addTask: (categoryId, title) => set((state) => {
        const trimmedTitle = typeof title === 'string' ? title.trim() : '';
        if (!trimmedTitle) return;

        const activeData = state.appState.contests[state.appState.activeId];
        if (!activeData) return;
        if (!Array.isArray(activeData.categories)) {
            activeData.categories = activeData.categories && typeof activeData.categories === 'object'
                ? Object.values(activeData.categories)
                : [];
        }

        const category = activeData.categories.find(c => c && (c.id === categoryId || c.name === categoryId));
        if (category) {
            if (!Array.isArray(category.tasks)) {
                category.tasks = category.tasks && typeof category.tasks === 'object'
                    ? Object.values(category.tasks)
                    : [];
            }
            // BUG-T04 FIX: Impedir duplicatas por nome normalizado.
            const normNew = normalize(trimmedTitle);
            const alreadyExists = category.tasks.some(t => {
                const existing = normalize(String(t.text || t.title || ''));
                return existing === normNew;
            });
            if (alreadyExists) return;
            const nowIso = new Date().toISOString();
            if (Array.isArray(category.deletedTaskIds) && category.deletedTaskIds.length > 0) {
                category.deletedTaskIds = category.deletedTaskIds.filter(
                    (entry) => entry && normalize(String(entry.text || '')) !== normNew
                );
            }
            category.tasks.push({
                id: generateId('task'),
                text: trimmedTitle,
                title: trimmedTitle,
                completed: false,
                priority: 'medium',
                createdAt: nowIso,
                updatedAt: nowIso
            });

            activeData.lastUpdated = nowIso;
            state.appState.version = (state.appState.version || 0) + 1;
            state.appState.lastUpdated = nowIso;
            markStorageDirty();
        }
    }),

    updateTask: (categoryId, taskId, updates) => set((state) => {
        if (!updates || typeof updates !== 'object') return;
        const activeData = state.appState?.contests?.[state.appState?.activeId];
        if (!activeData) return;
        if (!Array.isArray(activeData.categories)) {
            activeData.categories = activeData.categories && typeof activeData.categories === 'object'
                ? Object.values(activeData.categories)
                : [];
        }

        const category = activeData.categories.find(c => c && (c.id === categoryId || c.name === categoryId));
        if (!category) return;
        if (!Array.isArray(category.tasks)) {
            category.tasks = category.tasks && typeof category.tasks === 'object'
                ? Object.values(category.tasks)
                : [];
        }

        const taskIndex = category.tasks.findIndex(t => t && (t.id === taskId || t.text === taskId || t.title === taskId));
        if (taskIndex === -1) return;

        const currentTask = category.tasks[taskIndex];
        const newTitle = typeof updates.title === 'string'
            ? updates.title.trim()
            : typeof updates.text === 'string'
                ? updates.text.trim()
                : (currentTask.title || currentTask.text);

        if (!newTitle) return;

        const normNew = normalize(newTitle);
        const isDuplicate = category.tasks.some((t, idx) => {
            if (idx === taskIndex) return false;
            return normalize(String(t?.text || t?.title || '')) === normNew;
        });
        if (isDuplicate) return;

        const newPriority = updates.priority !== undefined
            ? normalizePriority(updates.priority)
            : currentTask.priority;

        const newNotes = updates.notes !== undefined
            ? (typeof updates.notes === 'string' ? updates.notes.trim() : updates.notes)
            : currentTask.notes;

        const nowIso = new Date().toISOString();
        const sanitizedNotes = newNotes ? newNotes : undefined;
        category.tasks[taskIndex] = {
            ...currentTask,
            title: newTitle,
            text: newTitle,
            priority: newPriority,
            notes: sanitizedNotes,
            updatedAt: nowIso
        };
        if (!sanitizedNotes) {
            delete category.tasks[taskIndex].notes;
        }

        const activeSubject = state.appState.pomodoro?.activeSubject;
        if (activeSubject && matchesActiveSubjectTask(category, currentTask, activeSubject, taskId)) {
            state.appState.pomodoro.activeSubject = {
                ...activeSubject,
                task: newTitle,
                priority: newPriority
            };
        }

        activeData.lastUpdated = nowIso;
        state.appState.version = (state.appState.version || 0) + 1;
        state.appState.lastUpdated = nowIso;
        markStorageDirty();
    }),

    deleteTask: (categoryId, taskId) => {
        let pendingXpDeduction = 0;
        set((state) => {
            const activeData = state.appState.contests[state.appState.activeId];
            if (!activeData) return;
            if (!Array.isArray(activeData.categories)) {
                activeData.categories = activeData.categories && typeof activeData.categories === 'object'
                    ? Object.values(activeData.categories)
                    : [];
            }

            const category = activeData.categories.find(c => c && (c.id === categoryId || c.name === categoryId));
            if (category) {
                if (!Array.isArray(category.tasks)) {
                    category.tasks = category.tasks && typeof category.tasks === 'object'
                        ? Object.values(category.tasks)
                        : [];
                }
                const task = category.tasks.find(t => t && (t.id === taskId || t.text === taskId || t.title === taskId));
                if (task && task.completed) {
                    // BUG-T01 FIX: awardedXP === 0 é um valor válido gravado.
                    // Usar ?? em vez de || para não cair no fallback quando
                    // awardedXP é 0 (o que causaria dedução errada).
                    const rawAwarded = task.awardedXP;
                    if (rawAwarded !== undefined && rawAwarded !== null && Number.isFinite(Number(rawAwarded))) {
                        pendingXpDeduction = Math.abs(Number(rawAwarded));
                    } else {
                        pendingXpDeduction = Math.abs(getTaskXP(task, true));
                    }
                }
                const activeSubject = state.appState.pomodoro?.activeSubject;
                if (activeSubject && matchesActiveSubjectTask(category, task, activeSubject, taskId)) {
                    clearPomodoroSession(state);
                }
                category.tasks = category.tasks.filter(t => t && t.id !== taskId && t.text !== taskId && t.title !== taskId);

                const nowIso = new Date().toISOString();
                const tombstoneId = task?.id != null ? String(task.id) : (taskId != null ? String(taskId) : '');
                const tombstoneText = normalize(String(task?.text || task?.title || ''));
                if (tombstoneId || tombstoneText) {
                    const prevDeleted = Array.isArray(category.deletedTaskIds) ? category.deletedTaskIds : [];
                    category.deletedTaskIds = [
                        ...prevDeleted.filter((e) => e && e.id !== tombstoneId && (!tombstoneText || e.text !== tombstoneText)),
                        { ...(tombstoneId ? { id: tombstoneId } : {}), ...(tombstoneText ? { text: tombstoneText } : {}), deletedAt: nowIso }
                    ].slice(-100);
                }
                activeData.lastUpdated = nowIso;
                state.appState.version = (state.appState.version || 0) + 1;
                state.appState.lastUpdated = nowIso;
                markStorageDirty();
            }
        });
        if (pendingXpDeduction > 0 && get().awardExperience) {
            get().awardExperience(-pendingXpDeduction, { skipVersionBump: true });
        }
    },

    togglePriority: (categoryId, taskId) => {
        const priorities = ['low', 'medium', 'high'];
        let pendingXpDiff = 0;

        set((state) => {
            const activeData = state.appState.contests[state.appState.activeId];
            if (!activeData?.categories) return;

            const categories = Array.isArray(activeData.categories)
                ? activeData.categories
                : Object.values(activeData.categories || {});

            const category = categories.find(c => c && (c.id === categoryId || c.name === categoryId));
            if (!category) return;

            const tasks = Array.isArray(category.tasks)
                ? category.tasks
                : Object.values(category.tasks || {});

            const taskIndex = tasks.findIndex(t => t && ((t.id && t.id === taskId) || (t.text && t.text === taskId) || (t.title && t.title === taskId)));
            if (taskIndex !== -1) {
                let task = tasks[taskIndex];
                const oldPriority = normalizePriority(task.priority);
                const currentIndex = priorities.indexOf(oldPriority);
                const nextIndex = currentIndex === -1 ? 1 : (currentIndex + 1) % 3;
                const newPriority = priorities[nextIndex];
                task = { ...task, priority: newPriority, updatedAt: new Date().toISOString() };

                // BUG-T06 FIX: Se a tarefa já está completada, o XP concedido
                // foi baseado na prioridade antiga. Ajustar o XP e recibo via awardExperience.
                if (task.completed && task.awardedXP !== undefined) {
                    const oldXP = Number.isFinite(Number(task.awardedXP))
                        ? Number(task.awardedXP)
                        : (XP_CONFIG.task[oldPriority] || XP_CONFIG.task.medium);
                    const newXP = XP_CONFIG.task[newPriority] || XP_CONFIG.task.medium;
                    const diff = newXP - oldXP;
                    if (diff !== 0) {
                        // FIX-XP-01: acumular — múltiplas tarefas mudando de prioridade no mesmo
                        // tick sobrescreviam o delta e só a última era creditada.
                        pendingXpDiff += diff;
                        // FIX-XP-02: nova referência do objeto para shallow memo
                        task = { ...task, awardedXP: newXP };
                    }
                }

                tasks[taskIndex] = task;

                const activeSubject = state.appState.pomodoro?.activeSubject;
                if (activeSubject && matchesActiveSubjectTask(category, task, activeSubject, taskId)) {
                    state.appState.pomodoro.activeSubject = {
                        ...activeSubject,
                        priority: newPriority
                    };
                }

                // Garante novas referências de array e de objeto para Zustand / React shallow memoization
                category.tasks = [...tasks];
                activeData.categories = [...categories];

                const nowIso = new Date().toISOString();
                activeData.lastUpdated = nowIso;
                state.appState.version = (state.appState.version || 0) + 1;
                state.appState.lastUpdated = nowIso;
                markStorageDirty();
            }
        });

        if (pendingXpDiff !== 0 && typeof get().awardExperience === 'function') {
            get().awardExperience(pendingXpDiff, { skipVersionBump: true });
        }
    },
});
