export function computeHierarchicalAdjustment(categories, pooledSD, options = {}) {
    const safeCategories = toHistoryArray(categories);
    if (!safeCategories.length) return safeCategories;

    const validCategories = safeCategories.filter(c =>
        Number.isFinite(c.mean) && Number.isFinite(c.n) && c.n > 0
    );

    if (!validCategories.length) return safeCategories;

    const maxProvidedMax = validCategories.reduce((mx, v) => {
        const rm = Number(v?.maxScore);
        return Number.isFinite(rm) && rm > mx ? rm : mx;
    }, 100);

    const getCatBounds = (c) => {
        const cMin = Number.isFinite(Number(c?.minScore)) ? Number(c.minScore) : 0;
        const rawMax = Number(c?.maxScore);
        const cMax = Number.isFinite(rawMax) && rawMax > cMin ? rawMax : Math.max(cMin + 100, maxProvidedMax);
        return { cMin, cRange: Math.max(1e-9, cMax - cMin) };
    };

    const optScale = Number(options?.globalRange ?? options?.pooledSDScale);
    const resolvedPooledSD = Number.isFinite(pooledSD) && pooledSD >= 0
        ? (options?.isRawPooledSD && Number.isFinite(optScale) && optScale > 0
            ? (pooledSD / optScale) * 100
            : pooledSD)
        : 15;

    const normMeans = validCategories.map(c => {
        const { cMin, cRange } = getCatBounds(c);
        return cRange === 100 && cMin === 0 ? (c.mean || 0) : (((c.mean || 0) - cMin) / cRange) * 100;
    });

    const globalMean = kahanSum(normMeans) / Math.max(1, validCategories.length);

    const rawTau2 = validCategories.length > 1
        ? kahanSum(normMeans.map(m => Math.pow(m - globalMean, 2))) / (validCategories.length - 1)
        : 0;
    const meanLocalVar = validCategories.length > 1
        ? kahanSum(validCategories.map(cat => {
            const { cMin, cRange } = getCatBounds(cat);
            const isStd = cRange === 100 && cMin === 0;
            const rawSd = Number.isFinite(cat.sd) ? cat.sd : (isStd ? resolvedPooledSD : (resolvedPooledSD / 100) * cRange);
            const normSd = isStd ? rawSd : (rawSd / cRange) * 100;
            return Math.pow(normSd, 2) / Math.max(1, cat.n);
        })) / validCategories.length
        : 0;
    // Estimador DerSimonian-Laird: desconta a variância amostral intra-categoria para evitar sub-encolhimento
    const tau2 = Math.max(0, rawTau2 - meanLocalVar);

    return safeCategories.map(cat => {
        if (!Number.isFinite(cat.mean) || !cat.n) {
            return { ...cat, bayesianMean: cat.mean, bayesianSd: cat.sd };
        }

        const { cMin, cRange } = getCatBounds(cat);
        const isStandardScale = cRange === 100 && cMin === 0;
        const normMean = isStandardScale ? cat.mean : ((cat.mean - cMin) / cRange) * 100;

        const safePooled = resolvedPooledSD;
        const rawLocalSD = Number.isFinite(cat.sd) ? cat.sd : (isStandardScale ? safePooled : (safePooled / 100) * cRange);
        const normLocalSD = isStandardScale ? rawLocalSD : (rawLocalSD / cRange) * 100;
        const localVar = Math.pow(normLocalSD, 2) / Math.max(1, cat.n);
        const denom = localVar + tau2;
        const B = denom > 1e-15 ? localVar / denom : 0;

        const normBayesianMean = B * globalMean + (1 - B) * normMean;
        const popVar = Math.pow(safePooled, 2);
        const normBayesianSd = Math.sqrt(Math.max(0, B * popVar + (1 - B) * Math.pow(normLocalSD, 2)));

        const bayesianMean = isStandardScale ? normBayesianMean : cMin + (normBayesianMean / 100) * cRange;
        const bayesianSd = isStandardScale ? normBayesianSd : (normBayesianSd / 100) * cRange;

        return {
            ...cat,
            bayesianMean,
            bayesianSd,
            shrinkage: B
        };
    });
}

export function computeAgilityMetrics(history, targetSeconds = 120) {
    const safeHistory = toHistoryArray(history);
    if (!safeHistory.length) return { avgSeconds: 0, agilityPenalty: 0 };

    let totalTimeSpent = 0;
    let totalTimedQuestions = 0;

    for (const h of safeHistory) {
        if (!h || typeof h !== 'object') continue;
        const rawTopics = h.topics;
        const topicsList = Array.isArray(rawTopics)
            ? rawTopics
            : (rawTopics && typeof rawTopics === 'object' ? Object.values(rawTopics) : []);
        let usedTopics = false;
        if (topicsList.length > 0) {
            let tSum = 0;
            let qSum = 0;
            for (const t of topicsList) {
                const ts = Number(t?.timeSpent);
                const tq = Number(t?.timedQuestoes ?? t?.total ?? t?.questoes ?? t?.totalQuestoes ?? t?.questions);
                if (Number.isFinite(ts) && Number.isFinite(tq) && ts > 0 && tq > 0) {
                    tSum += ts;
                    qSum += tq;
                }
            }
            if (tSum > 0 && qSum > 0) {
                totalTimeSpent += tSum;
                totalTimedQuestions += qSum;
                usedTopics = true;
            }
        }
        if (!usedTopics && h.timeSpent != null) {
            const ts = Number(h.timeSpent);
            const tq = Number(h.timedQuestoes ?? h.total ?? h.questoes ?? h.totalQuestoes ?? h.questions);

            if (Number.isFinite(ts) && Number.isFinite(tq) && ts > 0 && tq > 0) {
                totalTimeSpent += ts;
                totalTimedQuestions += tq;
            }
        }
    }

    const avgSeconds = totalTimedQuestions > 0 ? totalTimeSpent / totalTimedQuestions : 0;
    const safeTarget = Math.max(30, Number(targetSeconds) || 120);

    const agilityPenalty = avgSeconds > safeTarget
        ? Math.min(0.4, (avgSeconds - safeTarget) / (safeTarget * 1.25))
        : 0;

    return {
        avgSeconds: Math.round(avgSeconds),
        agilityPenalty: Number(agilityPenalty.toFixed(4))
    };
}

export function calculateSlopePerDay(history, maxScore = 100, minScore = 0) {
    const safeHistory = toHistoryArray(history);
    if (safeHistory.length < 2) return 0;

    const safeMaxScore = safeMaxScoreValue(maxScore, 100);
    const safeMinScore = safeMinScoreValue(minScore, 0);

    // ✅ FIX: Filtrar entradas com datas válidas e ordenar apenas 1 vez com timestamps retidos.
    const validEntries = [];
    for (let i = 0; i < safeHistory.length; i++) {
        const h = safeHistory[i];
        if (typeof h === 'number') continue;
        const dateValue = h?.date ?? h?.createdAt;
        const dateParsed = safeDateParse(dateValue);
        const time = dateParsed?.getTime();
        const y = getSafeScore(h, safeMaxScore, safeMinScore);
        if (Number.isFinite(time) && Number.isFinite(y)) {
            validEntries.push({ time, y, id: h?.id });
        }
    }

    if (validEntries.length < 2) {
        // Fallback: regressão por índice se não houver datas válidas
        const cleanScores = safeHistory
            .map(h => typeof h === 'number' ? h : getSafeScore(h, safeMaxScore, safeMinScore))
            .filter(Number.isFinite);
        if (cleanScores.length < 2) return 0;
        let sX = 0, sY = 0, sXY = 0, sX2 = 0;
        const n = cleanScores.length;
        for (let i = 0; i < n; i++) {
            sX += i;
            sY += cleanScores[i];
            sXY += i * cleanScores[i];
            sX2 += i * i;
        }
        const denom = (n * sX2) - (sX * sX);
        if (Math.abs(denom) < 1e-12) return 0;
        const indexSlope = ((n * sXY) - (sX * sY)) / denom;
        return Number.isFinite(indexSlope) ? indexSlope : 0;
    }

    validEntries.sort((a, b) => {
        if (a.time !== b.time) return a.time - b.time;
        return String(a.id || '').localeCompare(String(b.id || ''));
    });

    // ✅ FIX: firstDate agora é garantidamente válido
    const firstDate = validEntries[0].time;

    let sumX = 0, sumY = 0, sumXY = 0, sumX2 = 0;
    const validN = validEntries.length;

    for (let i = 0; i < validN; i++) {
        const x = (validEntries[i].time - firstDate) / 86400000;
        const y = validEntries[i].y;
        sumX += x;
        sumY += y;
        sumXY += x * y;
        sumX2 += x * x;
    }

    const denominator = (validN * sumX2) - (sumX * sumX);
    if (Math.abs(denominator) < 1e-12) {
        // Fallback: todas as provas na mesma data, calcular por sequência de prova
        let sX = 0, sY = 0, sXY = 0, sX2 = 0;
        for (let i = 0; i < validN; i++) {
            sX += i;
            sY += validEntries[i].y;
            sXY += i * validEntries[i].y;
            sX2 += i * i;
        }
        const denom = (validN * sX2) - (sX * sX);
        if (Math.abs(denom) < 1e-12) return 0;
        const indexSlope = ((validN * sXY) - (sX * sY)) / denom;
        return Number.isFinite(indexSlope) ? indexSlope : 0;
    }

    const slopePerDay = ((validN * sumXY) - (sumX * sumY)) / denominator;
    // ✅ LOTE-01 FIX: slope POR DIA. O "* 10" anterior inflava trendValue em 10×
    // e fazia o clamp do calculateSlope saturar uma ordem de grandeza antes.
    return Number.isFinite(slopePerDay) ? slopePerDay : 0;
}

/**
 * @deprecated Use calculateSlopePerDay instead. Renomeado no Lote 05 para indicar a unidade explícita [pts/dia].
 */
export const calculateTrend = calculateSlopePerDay;
