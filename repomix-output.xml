export const SCENARIO_CONFIG = {
  // FIX: meanBiasFactor era aplicado como absoluto em alguns callers.
  // Documentar claramente que é FRAÇÃO do range (maxScore - minScore).
  conservative: { meanBiasFactor: -0.015, ciMult: 1.5, probMultFactor: 0.045 },
  base: { meanBiasFactor: 0, ciMult: 1, probMultFactor: 0 },
  optimistic: { meanBiasFactor: 0.025, ciMult: 0.85, probMultFactor: 0.045 },
};

// FIX: exportar helper para aplicar bias corretamente na escala do concurso
export function applyScenarioBias(scenario, mean, maxScore, minScore = 0) {
  const range = Math.max(1e-9, maxScore - minScore);
  const cfg = SCENARIO_CONFIG[scenario] || SCENARIO_CONFIG.base;
  return mean + cfg.meanBiasFactor * range;
}

export function applyScenarioAdjustments(data = [], scenario = 'base', maxScore = 100, minScore = 0) {
  const cfg = SCENARIO_CONFIG[scenario] || SCENARIO_CONFIG.base;
  const safeMaxScore = Number.isFinite(Number(maxScore)) && Number(maxScore) > 0 ? Number(maxScore) : 100;
  const safeMinScore = Number.isFinite(Number(minScore)) ? Number(minScore) : 0;
  const lowerBound = Math.min(safeMinScore, safeMaxScore);
  const upperBound = Math.max(safeMinScore, safeMaxScore);
  const range = Math.max(1e-9, upperBound - lowerBound);
  const meanBias = (cfg.meanBiasFactor || 0) * range;
  const probMult = (cfg.probMultFactor || 0) * 100;

  return (data || []).map((d) => {
    const preMean = Number.isFinite(Number(d?.mean)) ? Number(d.mean) : 0;
    const mean = Math.max(lowerBound, Math.min(upperBound, preMean + meanBias));
    const projectedMean = d?.projectedMean !== undefined && Number.isFinite(Number(d.projectedMean))
      ? Math.max(lowerBound, Math.min(upperBound, Number(d.projectedMean) + meanBias))
      : mean;
    const rawCi0 = Number(d?.ciRange?.[0]);
    const rawCi1 = Number(d?.ciRange?.[1]);
    const baseCi0 = Number.isFinite(rawCi0) ? rawCi0 : preMean;
    const baseCi1 = Number.isFinite(rawCi1) ? rawCi1 : preMean;
    let rawLow;
    let rawHigh;
    if (mean >= baseCi0 && mean <= baseCi1) {
      rawLow = mean - ((mean - baseCi0) * cfg.ciMult);
      rawHigh = mean + ((baseCi1 - mean) * cfg.ciMult);
    } else {
      const halfLow = Math.max(0, preMean - baseCi0);
      const halfHigh = Math.max(0, baseCi1 - preMean);
      rawLow = mean - (halfLow * cfg.ciMult);
      rawHigh = mean + (halfHigh * cfg.ciMult);
    }
    const low = Math.max(lowerBound, Math.min(upperBound, rawLow));
    const high = Math.max(lowerBound, Math.min(upperBound, rawHigh));
    const rawProb = Number(d?.probability);
    const probBase = Number.isFinite(rawProb) ? rawProb : 0;
    const probAdjRaw = probBase + (meanBias > 0 ? probMult : meanBias < 0 ? -probMult : 0);
    const probAdj = Number.isFinite(probAdjRaw) ? Math.max(0, Math.min(100, probAdjRaw)) : 0;
    return {
      ...d,
      mean,
      projectedMean,
      probability: Number.isFinite(probAdj) ? probAdj : 0,
      ciRange: [Math.min(low, high), Math.max(low, high)],
    };
  });
}

export function classifyScenarioSignal(data = [], maxScore = 100, minScore = 0) {
  if (!data.length) return null;
  const safeMaxScore = Number.isFinite(Number(maxScore)) && Number(maxScore) > 0 ? Number(maxScore) : 100;
  const safeMinScore = Number.isFinite(Number(minScore)) ? Number(minScore) : 0;
  const range = Math.max(1e-9, safeMaxScore - safeMinScore);
  const latest = data[data.length - 1];
  const high = Number(latest?.ciRange?.[1]);
  const low = Number(latest?.ciRange?.[0]);
  const width = Number.isFinite(high) && Number.isFinite(low) ? Math.max(0, high - low) : Number.POSITIVE_INFINITY;

  let hasDowntrend = false;
  if (data.length >= 2) {
    const prev = data[data.length - 2];
    const currVal = Number(latest?.projectedMean ?? latest?.mean);
    const prevVal = Number(prev?.projectedMean ?? prev?.mean);
    if (Number.isFinite(currVal) && Number.isFinite(prevVal) && (currVal - prevVal) <= -(range * 0.015)) {
      hasDowntrend = true;
    }
  }

  if (data.length < 4 || width >= (range * 0.18)) {
    return { label: 'Sinal Fraco', color: 'text-amber-300 border-amber-500/40 bg-amber-500/10', hasDowntrend };
  }
  if (width <= (range * 0.10) && data.length >= 8) {
    return { label: 'Sinal Forte', color: 'text-emerald-300 border-emerald-500/40 bg-emerald-500/10', hasDowntrend };
  }
  return { label: 'Sinal Médio', color: 'text-sky-300 border-sky-500/40 bg-sky-500/10', hasDowntrend };
}
