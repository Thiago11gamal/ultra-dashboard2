});

describe('MATH-07: computeAdaptiveDampingBase — contínuo e estável', () => {
    it('sempre retorna dentro de [30, 60]', () => {
        const values = [
            computeAdaptiveDampingBase({ sampleSize: 0, drift: 0, driftUncertainty: 999, normalizedVol: 200, scaleFactor: 1 }),
