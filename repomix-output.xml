  box-shadow: 0 6px 20px var(--item-color-alpha, rgba(129, 140, 248, 0.18));
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 15%;
  bottom: 15%;
  width: 3.5px;
  background: var(--item-color, #818cf8);
  border-radius: 0 4px 4px 0;
  box-shadow: 0 0 10px var(--item-color, #818cf8);
