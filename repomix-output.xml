    right: 'right-0',
    auto: 'right-0 sm:right-auto sm:left-0'
};

/**
 * Casca padrão dos cards de métricas do painel.
 * Mantém cabeçalho, valor e rodapé com a mesma hierarquia visual em todos os cards.
 */
const StatCard = ({
    icon: Icon,
