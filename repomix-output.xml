<file path="src/hooks/usePomodoroSync.js">
import { useEffect } from 'react';
import { useAppStore } from '../store/useAppStore';
import { formatTime, SPEED_OPTIONS, MAX_TARGET_CYCLES } from '../utils/pomodoroHelpers';

const SESSION_SCOPED_TYPES = [
    'START_SESSION',
    'PAUSE_SESSION',
    'TIMER_RESET',
    'PHASE_SKIP',
    'PHASE_COMPLETE',
    'PHASE_REWIND',
    'TARGET_CYCLES_CHANGE'
];

export function usePomodoroSync({
    syncChannel,
    STABLE_TAB_ID,
    setIsRunning,
    stateRefs,
    setTimeLeft,
    showToast,
    setSpeed,
    speedRef,
    activeSubjectRef,
    clockRef,
    setIsMuted,
    isMutedRef,
    endsAtRef
}) {
    const syncPomodoroState = useAppStore(state => state.syncPomodoroState);

    useEffect(() => {
        if (!syncChannel || typeof syncChannel.addEventListener !== 'function') return;

        let isMounted = true;

        const handleMessage = (event) => {
            if (!isMounted) return;
            const data = event.data;
            // Validar estrutura da mensagem antes de processar
            if (!data || typeof data !== 'object' || !data.type) return;
            const KNOWN_TYPES = [
                'START_SESSION', 'PAUSE_SESSION', 'TIMER_RESET',
                'PHASE_SKIP', 'PHASE_COMPLETE', 'PHASE_REWIND',
                'TARGET_CYCLES_CHANGE', 'SPEED_CHANGE', 'TOGGLE_MUTE'
            ];
            if (!KNOWN_TYPES.includes(data.type)) return;

            const {
                type,
                tabId,
                taskId,
                sessionInstanceId,
                timeLeft: incomingTime,
                speed: incomingSpeed,
                targetCycles: incomingTarget
            } = data;

            if (tabId === STABLE_TAB_ID) return;

            if (SESSION_SCOPED_TYPES.includes(type)) {
                const currentTaskId = activeSubjectRef.current?.taskId != null ? String(activeSubjectRef.current.taskId) : null;
                const currentSessionId = activeSubjectRef.current?.sessionInstanceId != null ? String(activeSubjectRef.current.sessionInstanceId) : null;
                const msgTaskId = taskId != null ? String(taskId) : null;
                const msgSessionId = sessionInstanceId != null ? String(sessionInstanceId) : null;

                // Se a mensagem tem taskId E nós temos taskId, devem bater
                if (msgTaskId != null && currentTaskId != null && msgTaskId !== currentTaskId) {
                    return;
                }
                // Aba ociosa (sem taskId ativo) não deve adotar estado running de uma tarefa específica
                if (msgTaskId != null && currentTaskId == null) {
                    return;
                }
                // G-09 FIX: Se a mensagem tem sessionInstanceId, validar.
                // Se NÓS temos sessionId mas a mensagem NÃO tem, aceitar
                // (mensagem de aba que não trackeia sessions).
                // Se a mensagem TEM sessionId mas NÓS NÃO temos, rejeitar
                // (excepto START_SESSION que notifica ativação).
                if (msgSessionId != null && currentSessionId != null &&
                    msgSessionId !== currentSessionId) {
                    return;
                }
                // G-09 FIX: Se a mensagem TEM sessionId mas nós NÃO temos,
                // só aceitar START_SESSION (ativação inicial).
                if (type !== 'START_SESSION' && msgSessionId != null && currentSessionId == null) {
                    return;
                }
            }

            switch (type) {
                case 'START_SESSION': {
                    if (data.speed && SPEED_OPTIONS.includes(Number(data.speed))) {
                        const s = Number(data.speed);
                        setSpeed(s);
                        if (speedRef) speedRef.current = s;
                    }

                    setIsRunning(true);
                    stateRefs.current.isRunning = true;
                    syncPomodoroState({ isRunning: true });

                    if (Number.isFinite(incomingTime) && incomingTime >= 0 && incomingTime <= 24 * 3600) {
                        stateRefs.current.timeLeft = incomingTime;
                        setTimeLeft(incomingTime);
                    }

                    const incomingEndsAt = Number(data.endsAt);
                    if (endsAtRef) {
                        if (Number.isFinite(incomingEndsAt) && incomingEndsAt > Date.now()) {
                            endsAtRef.current = incomingEndsAt;
                        } else if (Number.isFinite(incomingTime) && incomingTime > 0 && incomingTime <= 24 * 3600) {
                            const currentSpeed = speedRef?.current || 1;
                            endsAtRef.current = Date.now() + (incomingTime * 1000) / currentSpeed;
                        }
                        try {
                            if (endsAtRef.current) {
                                localStorage.setItem('pomodoro-endsAt', JSON.stringify({
                                    endsAt: endsAtRef.current,
                                    taskId: activeSubjectRef.current?.taskId || null,
                                    sessionInstanceId: activeSubjectRef.current?.sessionInstanceId || null
                                }));
                            }
                        } catch { /* ignore */ }
                    }

                    showToast('Protocolo ativo em outra aba 🖥️', 'info');
                    break;
                }

                case 'PAUSE_SESSION': {
                    if (endsAtRef) endsAtRef.current = null;
                    try { localStorage.removeItem('pomodoro-endsAt'); } catch { /* ignore */ }
                    setIsRunning(false);
                    stateRefs.current.isRunning = false;
                    syncPomodoroState({ isRunning: false });

                    if (Number.isFinite(incomingTime) && incomingTime >= 0 && incomingTime <= 24 * 3600) {
                        setTimeLeft(incomingTime);
                        stateRefs.current.timeLeft = incomingTime;
                        if (clockRef?.current) {
                            clockRef.current.__lastSec = incomingTime;
                            clockRef.current.textContent = formatTime(incomingTime);
                        }
                    }
                    break;
                }

                case 'SPEED_CHANGE': {
                    const parsedSpeed = Number(incomingSpeed);

                    if (SPEED_OPTIONS.includes(parsedSpeed)) {
                        setSpeed(parsedSpeed);
                        if (speedRef) speedRef.current = parsedSpeed;

                        if (stateRefs.current?.isRunning) {
                            const currentLeft = Number(stateRefs.current?.timeLeft) || 0;
                            if (endsAtRef) {
                                endsAtRef.current = Date.now() + (currentLeft * 1000) / parsedSpeed;
                                try {
                                    localStorage.setItem('pomodoro-endsAt', JSON.stringify({
                                        endsAt: endsAtRef.current,
                                        taskId: activeSubjectRef.current?.taskId || null,
                                        sessionInstanceId: activeSubjectRef.current?.sessionInstanceId || null
                                    }));
                                } catch { /* ignore */ }
                            }
                        }
                    }
                    break;
                }

                case 'TARGET_CYCLES_CHANGE': {
                    if (Number.isFinite(incomingTarget)) {
                        const currentCompleted =
                            useAppStore.getState().appState?.pomodoro?.completedCycles || 0;

                        const safeTarget = Math.min(
                            MAX_TARGET_CYCLES,
                            Math.max(1, Math.round(Number(incomingTarget)))
                        );
                        const clampedCompleted = currentCompleted >= safeTarget
                            ? Math.max(0, safeTarget - 1)
                            : currentCompleted;

                        syncPomodoroState({ targetCycles: safeTarget, completedCycles: clampedCompleted });
                        if (stateRefs?.current) {
                            stateRefs.current.targetCycles = safeTarget;
                            stateRefs.current.completedCycles = clampedCompleted;
                        }
                        try {
                            const raw = localStorage.getItem('pomodoroState');
                            if (raw) {
                                const parsed = JSON.parse(raw);
                                if (parsed && typeof parsed === 'object') {
                                    parsed.targetCycles = safeTarget;
                                    parsed.completedCycles = clampedCompleted;
                                    localStorage.setItem('pomodoroState', JSON.stringify(parsed));
                                }
                            }
                        } catch { /* ignore */ }
                    }
                    break;
                }

                case 'TIMER_RESET':
                case 'PHASE_SKIP':
                case 'PHASE_COMPLETE':
                case 'PHASE_REWIND': {
                    if (endsAtRef) endsAtRef.current = null;
                    try { localStorage.removeItem('pomodoro-endsAt'); } catch { /* ignore */ }
                    setIsRunning(false);
                    stateRefs.current.isRunning = false;

                    try {
                        const raw = localStorage.getItem('pomodoroState');
                        let saved = null;
                        try {
                            saved = raw ? JSON.parse(raw) : null;
                        } catch {
                            saved = null;
                        }
                        if (!saved || typeof saved !== 'object') {
                            saved = {};
                        }

                        const currentTaskId = activeSubjectRef.current?.taskId != null ? String(activeSubjectRef.current.taskId) : null;
                        const currentSessionId = activeSubjectRef.current?.sessionInstanceId != null ? String(activeSubjectRef.current.sessionInstanceId) : null;

                        const effectiveTaskId = (saved?.activeTaskId != null ? String(saved.activeTaskId) : null) || (data?.taskId != null ? String(data.taskId) : null);
                        if (
                            effectiveTaskId &&
                            currentTaskId &&
                            effectiveTaskId !== currentTaskId
                        ) {
                            break;
                        }

                        const effectiveSessionId = (saved?.sessionInstanceId != null ? String(saved.sessionInstanceId) : null) || (data?.sessionInstanceId != null ? String(data.sessionInstanceId) : null);
                        if (
                            effectiveSessionId &&
                            currentSessionId &&
                            effectiveSessionId !== currentSessionId
                        ) {
                            break;
                        }

                        const targetMode =
                            data.toMode !== undefined && typeof data.toMode === 'string'
                                ? data.toMode
                                : (typeof saved.mode === 'string' ? saved.mode : undefined);

                        const targetTime =
                            data.timeLeft !== undefined && Number.isFinite(data.timeLeft)
                                ? data.timeLeft
                                : (Number.isFinite(saved.timeLeft) ? saved.timeLeft : undefined);

                        const savedTaskMatches =
                            Boolean(effectiveTaskId && activeSubjectRef.current?.taskId && effectiveTaskId === activeSubjectRef.current.taskId) ||
                            Boolean(!effectiveTaskId && !activeSubjectRef.current?.taskId);

                        if (targetMode !== undefined || savedTaskMatches) {
                            const newSessions = data.sessions !== undefined ? data.sessions : saved.sessions;
                            const newCompleted = data.completedCycles !== undefined ? data.completedCycles : saved.completedCycles;
                            const newAccum = data.accumulatedMinutes !== undefined ? data.accumulatedMinutes : saved.accumulatedMinutes;
                            const newTarget = data.targetCycles !== undefined ? data.targetCycles : saved.targetCycles;

                            syncPomodoroState({
                                mode: targetMode,
                                sessions: newSessions,
                                completedCycles: newCompleted,
                                accumulatedMinutes: newAccum,
                                targetCycles: newTarget,
                                isRunning: false
                            });

                            if (Number.isFinite(targetTime) && targetTime >= 0) {
                                setTimeLeft(targetTime);
                                stateRefs.current.timeLeft = targetTime;
                            }

                            if (targetMode !== undefined) {
                                stateRefs.current.mode = targetMode;
                            }
                            if (newSessions !== undefined) {
                                stateRefs.current.sessions = newSessions;
                            }
                            if (newCompleted !== undefined) {
                                stateRefs.current.completedCycles = newCompleted;
                            }
                            if (newAccum !== undefined) {
                                stateRefs.current.accumulatedMinutes = newAccum;
                            }
                            if (newTarget !== undefined) {
                                stateRefs.current.targetCycles = newTarget;
                            }

                            if (clockRef.current && Number.isFinite(targetTime)) {
                                clockRef.current.textContent = formatTime(targetTime);
                            }
                        }
                    } catch (error) {
                        console.error('Failed to sync state from localStorage:', error);
                    }

                    break;
                }

                case 'TOGGLE_MUTE': {
                    if (!isMounted) break;
                    const muted = Boolean(data.isMuted);

                    setIsMuted(muted);
                    isMutedRef.current = muted;
                    break;
                }

                default:
                    break;
            }
        };

        syncChannel.addEventListener('message', handleMessage);

        return () => {
            isMounted = false;
            try {
                syncChannel?.removeEventListener?.('message', handleMessage);
            } catch { /* ignore */ }
        };
    }, [
        syncChannel,
        showToast,
        syncPomodoroState,
        STABLE_TAB_ID,
        setIsRunning,
        stateRefs,
        setTimeLeft,
        setSpeed,
        speedRef,
        activeSubjectRef,
        clockRef,
        setIsMuted,
        isMutedRef,
        endsAtRef
    ]);
}
</file>

<file path="src/llm/llmSchema.js">
/**
 * llmSchema.js
 *
 * Lote 6 — Validação de saída do mini-LLM.
 *
 * Regra de ouro:
 * O LLM nunca altera matemática, urgência ou probabilidade.
 * Ele apenas produz explicações estruturadas.
 */

const ALLOWED_SEVERITIES = ['low', 'medium', 'high', 'critical'];

function sanitizeText(value, maxLength = 280) {
  if (typeof value !== 'string' && !(typeof value === 'number' && Number.isFinite(value))) {
    return '';
  }
  return String(value)
    // Remove tags HTML (<script>, <b>, etc.) preservando operadores matemáticos como "probabilidade < 25%"
    .replace(/<\/?[a-z][^>]*>/gi, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, maxLength);
}

function sanitizeStringArray(value, maxItems = 6, maxItemLength = 220) {
  if (!Array.isArray(value)) return [];

  return value
    .map((item) => sanitizeText(item, maxItemLength))
    .filter(Boolean)
    .slice(0, maxItems);
}

/**
 * Valida e sanitiza uma explicação do Coach.
 *
 * @param {Object} raw
 * @returns {Object|null}
 */
export function validateCoachExplanation(raw, options = {}) {
  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null;

  const strict = options.strict === true;

  const headline = sanitizeText(raw.headline, 160);
  if (!headline) return null;

  const severityRaw = typeof raw.severity === 'string' ? raw.severity.trim().toLowerCase() : '';
  const hasValidSeverity = ALLOWED_SEVERITIES.includes(severityRaw);
  if (strict && !hasValidSeverity) {
    return null;
  }
  const severity = hasValidSeverity ? severityRaw : 'medium';

  let causes = sanitizeStringArray(raw.causes, 6, 220);

  if (strict && causes.length === 0) {
    return null;
  }

  if (causes.length === 0) {
    causes = ['O sistema detectou um padrão relevante nos dados atuais.'];
  }

  const recommendation = sanitizeText(raw.recommendation, 320);
  if (!recommendation) return null;

  const hasConfidence =
    raw.confidence !== null &&
    raw.confidence !== undefined &&
    raw.confidence !== '' &&
    typeof raw.confidence !== 'boolean';
  const confidenceRaw = hasConfidence ? Number(raw.confidence) : NaN;
  const isConfidenceInRange =
    Number.isFinite(confidenceRaw) &&
    confidenceRaw >= 0 &&
    confidenceRaw <= 100;
  if (strict && raw.confidence !== undefined && !isConfidenceInRange) {
    return null;
  }
  const normalizedConfidence = Number.isFinite(confidenceRaw)
    ? (confidenceRaw > 1 && confidenceRaw <= 100 ? confidenceRaw / 100 : confidenceRaw)
    : NaN;
  const confidence = Number.isFinite(normalizedConfidence)
    ? Math.min(1, Math.max(0, normalizedConfidence))
    : 0.5;

  const tone = sanitizeText(raw.tone, 60) || 'neutral';

  return {
    headline,
    severity,
    causes,
    recommendation,
    confidence: Number(confidence.toFixed(4)),
    tone,
  };
}

export const CoachExplanationSchema = {
  type: 'object',
  required: ['headline', 'severity', 'causes', 'recommendation'],
  properties: {
    headline: { type: 'string' },
    severity: { enum: ALLOWED_SEVERITIES },
    causes: {
      type: 'array',
      items: { type: 'string' },
    },
    recommendation: { type: 'string' },
    confidence: {
      type: 'number',
      minimum: 0,
      maximum: 1,
    },
    tone: { type: 'string' },
  },
};

export default {
  validateCoachExplanation,
  CoachExplanationSchema,
};
</file>

