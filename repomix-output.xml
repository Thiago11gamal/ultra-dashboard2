            <PriorityProgress categories={data.categories} />

            {hasTasks && (
                <SyllabusBurndownChart categories={data.categories} user={data.user} />
            )}

            <div className="tour-step-6">
                <Checklist
                    categories={data.categories}
                    onToggleTask={toggleTask}
