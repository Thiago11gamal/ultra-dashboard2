    expect(handleKeyDownGuard({ code: 'KeyR', ctrlKey: true, metaKey: false, altKey: false })).toBe(false);
    expect(handleKeyDownGuard({ code: 'KeyF', ctrlKey: true, metaKey: false, altKey: false })).toBe(false);
