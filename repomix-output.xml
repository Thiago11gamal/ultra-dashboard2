                                ))}
                                <LabelList 
                                    dataKey="lastTestAcc" 
                                    position="top" 
                                    offset={6} 
                                    formatter={(v) => Number.isFinite(Number(v)) ? `${formatValue(v)}${unit}` : ''} 
                                    fill="#fff" 
