                if (clockRef.current) {
                    clockRef.current.textContent = formatTime(newSeconds);
                }
                if (svgCircleRef.current?.style) {
                    svgCircleRef.current.style.strokeDashoffset = CIRCUMFERENCE;
                }
                savePomodoroStateRef.current?.({
                    timeLeft: newSeconds,
                    isRunning: false,
                    flushedSeconds: 0,
                    addedSeconds: 0
