}

/* Active State Generic */
.sidebar-item.active {
  background: linear-gradient(90deg, var(--item-color-alpha, rgba(129, 140, 248, 0.2)) 0%, rgba(15, 23, 42, 0.85) 100%);
  border-color: var(--item-color-alpha, rgba(129, 140, 248, 0.4));
