<file path="firestore.rules">
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasRestrictedPrivilegeKeys(data) {
      return data.keys().hasAny(['isPremium', 'premium', 'subscription', 'plan', 'admin', 'role', 'roles']);
    }

    function touchesRestrictedPrivilegeKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['isPremium', 'premium', 'subscription', 'plan', 'admin', 'role', 'roles']);
    }

    // O utilizador só pode ler e atualizar campos não-privilegiados no SEU PRÓPRIO documento
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && !hasRestrictedPrivilegeKeys(request.resource.data);
      allow update: if isOwner(userId) && !touchesRestrictedPrivilegeKeys();
      allow delete: if false;
    }

    // No Firestore Rules, data.size() retorna a quantidade de campos no documento (Map).
    // Limitamos o número de chaves a 500 para evitar mapas inflados abusivos.
    // O limite de 1MB por documento é garantido nativamente pela infraestrutura do Firestore.
    function withinFieldCountLimit() {
      // L-02 FIX: Usar <= 500 para permitir exatamente 500 campos
      return request.resource.data.size() <= 500;
    }

    match /backups/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && withinFieldCountLimit();
      allow delete: if isOwner(userId);

      match /{document=**} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && withinFieldCountLimit();
        allow delete: if isOwner(userId);
      }
    }

    // Regras oficiais da extensão Firebase Stripe Payments (clientes, sessões de checkout, pagamentos, assinaturas e produtos)
    match /customers/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }

      match /tax_rates/{id} {
        allow read: if true;
      }
    }

    // Permite que o sistema de sincronização salve os dados na nuvem
    
    // Regra global: Proíbe acesso a qualquer outra coleção acidental
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
