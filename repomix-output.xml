            savePomodoroState({
                isRunning: false,
                timeLeft: nextLeft,
                addedSeconds: addedSecondsInPhaseRef.current
            });
            postSync({
                type: 'PAUSE_SESSION',
                timeLeft: nextLeft
            });
        }

