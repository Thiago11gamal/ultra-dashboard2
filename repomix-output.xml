            console.warn('[PomodoroTimer] BroadcastChannel indisponível:', e);
        }
        return null;
    });

    useEffect(() => {
        return () => {
            try {
                syncChannel?.close?.();
            } catch { /* ignore */ }
        };
    }, [syncChannel]);

