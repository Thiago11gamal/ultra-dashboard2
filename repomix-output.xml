    setAnswers(prev => ({ ...prev, [currentQuestion.id]: letra }));
  }, [currentQuestion]);

  const clearAnswer = useCallback((questionId) => {
    const targetId = questionId || currentQuestion?.id;
    if (!targetId) return;
    setAnswers((prev) => {
      if (!(targetId in prev)) return prev;
      const next = { ...prev };
      delete next[targetId];
      return next;
    });
  }, [currentQuestion]);

  const goTo = useCallback((index) => {
    const qLen = latestQuestionsRef.current.length || questions.length;
    if (index >= 0 && index < qLen) {
      setCurrentIndex(index);
    }
