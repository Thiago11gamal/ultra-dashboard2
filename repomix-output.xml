          <div className="flex justify-between gap-4">
            <span className="text-sky-300">Provável (P50):</span>
            <span className="font-black text-sky-300">{fmt(pt.p50)}</span>
          </div>
          <div className="flex justify-between gap-4">
            <span className="text-amber-300">Conservador (P10):</span>
