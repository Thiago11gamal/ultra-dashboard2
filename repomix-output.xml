            postSync({
                type: 'SPEED_CHANGE',
                speed
            });
        }
    }, [speed, isRunning, postSync, commitTimeLeft]);

    const transitionTimeoutRef = useRef(null);
    const completionTimeoutRef = useRef(null);
    const pendingTransitionFinalizeRef = useRef(null);
    const transitionFinalizedOnUnmountRef = useRef(false);
    const [isTransitioning, setIsTransitioning] = useState(false);
    const transitionRetriesRef = useRef(0);

    const isMountedRef = useRef(true);

    useEffect(() => {
        isMountedRef.current = true;
        transitionFinalizedOnUnmountRef.current = false;
        return () => {
            isMountedRef.current = false;
            clearLiveTimeLeft();
            if (handoffTimerRef.current) {
                clearTimeout(handoffTimerRef.current);
                handoffTimerRef.current = null;
            }
            if (transitionTimeoutRef.current) {
                clearTimeout(transitionTimeoutRef.current);
                transitionTimeoutRef.current = null;
                const pendingFinalize = pendingTransitionFinalizeRef.current;
                pendingTransitionFinalizeRef.current = null;
                if (typeof pendingFinalize === 'function') {
                    transitionFinalizedOnUnmountRef.current = true;
                    pendingFinalize({ fromUnmount: true });
                }
            }
            if (completionTimeoutRef.current) {
                clearTimeout(completionTimeoutRef.current);
                completionTimeoutRef.current = null;
            }
            isTransitioningRef.current = false;
        };
    }, []);

    const toggleMute = () => {
        const newVal = !isMutedRef.current;
        isMutedRef.current = newVal;
        setIsMuted(newVal);
        try {
            localStorage.setItem('pomodoro_muted', String(newVal));
        } catch (error) {
            console.error('Failed to set pomodoro_muted:', error);
        }
        postSync({ type: 'TOGGLE_MUTE', isMuted: newVal });
    };

    const toggleFullscreen = () => {
        setIsFullscreen(prev => !prev);
    };

    // IMPORTANTE: onUpdateStudyTime é uma action do Zustand e DEVE executar mesmo
