                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-2">Tempo de Prova (Horas)</label>
                                <div className="flex items-center bg-slate-900 border border-white/10 rounded-md focus-within:border-emerald-500/50 transition-colors">
                                    <div className="pl-3 pr-2 py-2.5 text-slate-500">
                                        <Clock size={16} />
                                    </div>
                                    <div className="flex items-center justify-between w-full pr-1 py-1">
                                        <span className="bg-transparent text-white font-bold text-sm select-none">{examDurationLabel}</span>
                                        <div className="flex flex-col gap-0.5">
                                            <button type="button" onClick={() => updateExamDurationMinutes(30)} className="text-slate-500 hover:text-white hover:bg-white/10 rounded px-1 transition-colors" title="Aumentar 30min">
                                                <ChevronUp size={12} strokeWidth={4} />
                                            </button>
                                            <button type="button" onClick={() => updateExamDurationMinutes(-30)} className="text-slate-500 hover:text-white hover:bg-white/10 rounded px-1 transition-colors" title="Diminuir 30min">
                                                <ChevronDown size={12} strokeWidth={4} />
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label className="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-2">Total de Questões</label>
                                <div className="flex items-center bg-slate-900 border border-white/10 rounded-md focus-within:border-emerald-500/50 transition-colors">
                                    <div className="pl-3 pr-2 py-2.5 text-slate-500">
                                        <Hash size={16} />
                                    </div>
                                    <input
                                        type="number"
                                        min="10"
                                        max="500"
                                        value={localTotalQuestions}
                                        onChange={updateExamTotalQuestions}
                                        onFocus={() => { isEditingQuestions.current = true; }}
                                        onBlur={commitExamTotalQuestions}
                                        aria-label="Total de questões da prova"
                                        className="bg-transparent text-white font-bold text-sm w-full outline-none py-2.5 pr-3 placeholder:text-slate-600"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div className="bg-slate-800/50 p-1 rounded-xl flex flex-col sm:flex-row my-6 border border-white/5 gap-1 sm:gap-0">
                        <button
                            type="button"
                            onClick={() => {
                                if (!equalWeightsMode) {
                                    savedCustomWeights.current = weights;
                                    if (setUserData && weights && Object.keys(weights).length > 0) {
                                        setUserData(contest => contest ? { ...contest, mcSavedCustomWeights: { ...weights } } : contest, false);
                                    }
                                    const ew = getEqualWeights();
                                    setWeights(ew);
                                }
                                setEqualWeightsMode(true);
                            }}
                            className={`flex-1 py-3 rounded-lg text-[10px] sm:text-xs font-bold transition-all flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-blue-300/60 ${equalWeightsMode ? 'bg-blue-600 text-white shadow-lg' : 'text-slate-500 hover:text-slate-300'}`}
                        >
                            <div className={`w-2 h-2 rounded-full ${equalWeightsMode ? 'bg-white' : 'bg-slate-600'}`} />
                            Pesos Iguais
                        </button>
                        <button
                            type="button"
                            onClick={() => {
                                const savedSource = savedCustomWeights.current || contestSavedCustomWeights;
                                if (equalWeightsMode && savedSource) {
                                    // ✅ LOTE-02 FIX (M10): restaurar apenas chaves que ainda
                                    // existem nas categorias (pesos salvos podem estar obsoletos
                                    // se matérias foram removidas/renomeadas durante o modo igual)
                                    const validIds = new Set();
                                    safeCategories.forEach(c => {
                                        if (c.id) validIds.add(c.id);
                                        if (c.name) validIds.add(c.name);
                                    });
                                    const restored = {};
                                    Object.entries(savedSource).forEach(([k, v]) => {
                                        if (validIds.has(k)) restored[k] = v;
                                    });
                                    if (Object.keys(restored).length > 0) setWeights(restored);
                                }
                                setEqualWeightsMode(false);
                            }}
                            className={`flex-1 py-3 rounded-lg text-[10px] sm:text-xs font-bold transition-all flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-purple-300/60 ${!equalWeightsMode ? 'bg-purple-600 text-white shadow-lg' : 'text-slate-500 hover:text-slate-300'}`}
                        >
                            <div className={`w-2 h-2 rounded-full ${!equalWeightsMode ? 'bg-white' : 'bg-slate-600'}`} />
                            Manual (1, 2, 3...)
                        </button>
                    </div>

                    {/* CONTEXTO SECUNDÁRIO DE LISTAGEM DE MATÉRIAS */}
                    <div className="space-y-3">
                        {equalWeightsMode ? (
                            <div className="py-10 flex flex-col items-center justify-center text-center opacity-50">
                                <Minus size={40} className="text-slate-600 mb-2" />
                                <p className="text-sm text-slate-500 px-10">No modo automático, todas as matérias possuem o mesmo peso de relevância.</p>
                            </div>
                        ) : (
                            safeCategories.length > 0 ? (
                                safeCategories.map(cat => {
                                    const rawW = weights ? (weights[cat.id] ?? weights[cat.name]) : undefined;
                                    const safeW = rawW !== undefined && rawW !== null
                                        ? (Number.isFinite(Number(rawW)) ? Number(rawW) : 0)
                                        : 1;
                                    return (
                                        <WeightRow
                                            key={cat.id || cat.name}
                                            cat={cat}
                                            weight={safeW}
                                            manualTotal={manualTotal}
                                            updateWeight={updateWeight}
                                        />
                                    );
                                })
                            ) : (
                                <div className="py-10 flex flex-col items-center justify-center text-center opacity-50 space-y-2">
                                    <Activity size={40} className="text-slate-600 mb-2" />
                                    <p className="text-sm text-slate-500 px-10">Nenhuma matéria encontrada no concurso atual.</p>
                                    <p className="text-[10px] text-slate-600">Adicione matérias na Planilha ou menu Categorias para configurar os pesos.</p>
                                </div>
                            )
                        )}
                    </div>

                    {!equalWeightsMode && (
                        <p className="text-[10px] text-slate-400 mt-3">No modo manual, você define pesos relativos (1, 2, 3...). O sistema converte automaticamente para percentual.</p>
                    )}
                </div>
            </div>
        </div>
    );

    return typeof document !== 'undefined' && document.body
        ? createPortal(modalContent, document.body)
        : modalContent;
};
</file>

<file path="src/components/NextGoalCard.jsx">
import React, { useMemo, useState, useEffect } from 'react';
import { Target, Play, Clock, Info, Sparkles } from 'lucide-react';
import { getSuggestedFocus } from '../utils/coachLogic';
import { toArray } from '../utils/normalize';
import { normalizePriority, getPriorityConfig } from '../utils/colorHelper';
import { useAppStore } from '../store/useAppStore';
import { getFlashcardDueTodayCount } from '../utils/analytics';
import { resolveUserTargetScorePoints } from '../utils/scoreHelper';

function renderBoldText(text) {
    const safeText = String(text || '');
    const parts = safeText.split(/(\*\*.*?\*\*)/g).filter(Boolean);
    return parts.map((part, idx) => {
        if (part.startsWith('**') && part.endsWith('**')) {
            return <strong key={`ng-bold-${idx}`} className="text-white font-semibold">{part.slice(2, -2)}</strong>;
        }
        return <React.Fragment key={`ng-bold-${idx}`}>{part}</React.Fragment>;
    });
}

function NextGoalCard({
    categories = [],
    simulados = [],
    studyLogs = [],
    onStartStudying,
    maxScore: propMaxScore,
    minScore: propMinScore,
    targetScore: propTargetScore,
    user: propUser,
    contestId: propContestId,
    simuladoRows: propSimuladoRows,
    calibrationHistoryByCategory: propCalibrationHistory,
    flashcardDecks: propFlashcardDecks
}) {
    const storeActiveId = useAppStore(state => state.appState?.activeId);
    const storeContest = useAppStore(state =>
        state.appState?.contests?.[state.appState?.activeId] || null
    );

    const effectiveContestId = propContestId ?? storeActiveId ?? 'default';
    const effectiveUser = propUser ?? storeContest?.user;
    const pickValidNumber = (...candidates) => {
        for (const val of candidates) {
            if (val !== null && val !== undefined && typeof val !== 'boolean' && String(val).trim() !== '' && Number.isFinite(Number(val))) {
                return Number(val);
            }
        }
        return null;
    };
    const resolvedMax = pickValidNumber(propMaxScore, storeContest?.maxScore, storeContest?.settings?.maxScore);
    const effectiveMaxScore = resolvedMax !== null && resolvedMax > 0 ? resolvedMax : 100;
    const resolvedMin = pickValidNumber(propMinScore, storeContest?.minScore, storeContest?.settings?.minScore);
    const effectiveMinScore = resolvedMin !== null
        ? Math.min(resolvedMin, effectiveMaxScore - 1)
        : 0;
    const effectiveTargetScore = propTargetScore ?? resolveUserTargetScorePoints(
        effectiveUser,
        effectiveMinScore,
        effectiveMaxScore,
        0.85
    );
    const effectiveSimuladoRows = propSimuladoRows ?? storeContest?.simuladoRows;
    const effectiveAllSimulados = storeContest?.simulados ?? simulados;
    const effectiveCalibHistory = propCalibrationHistory ?? storeContest?.calibrationHistoryByCategory;
    const effectiveFlashcardDecks = propFlashcardDecks ?? storeContest?.flashcardDecks;
    const effectiveFlashcardDue = useMemo(
        () => getFlashcardDueTodayCount(effectiveFlashcardDecks),
        [effectiveFlashcardDecks]
    );
    const adaptiveCalibrationEnabled = storeContest?.settings?.adaptiveCalibrationEnabled !== false;

    const rawCategories = useMemo(() => toArray(categories), [categories]);
    const hasAnyTasks = useMemo(() => {
        return rawCategories.some(cat => toArray(cat?.tasks).length > 0);
    }, [rawCategories]);

    const [isLoading, setIsLoading] = useState(true);
    const [suggestion, setSuggestion] = useState(null);
    const rawCategoriesRef = React.useRef(rawCategories);
    useEffect(() => { rawCategoriesRef.current = rawCategories; }, [rawCategories]);

    useEffect(() => {
        // Usa setTimeout para não bloquear o render inicial e evitar setState síncrono no efeito
        const timer = setTimeout(() => {
            const currentCats = rawCategoriesRef.current || [];
            if (currentCats.length === 0 || !hasAnyTasks) {
                setIsLoading(false);
                setSuggestion(null);
                return;
            }

            setIsLoading(true);
            try {
                const normalizedCategories = currentCats.map(category => ({
                    ...category,
                    tasks: toArray(category?.tasks)
                }));
                const categoriesWithPending = normalizedCategories.filter(category =>
                    toArray(category?.tasks).some(t => t && !t.completed)
                );
                if (categoriesWithPending.length === 0) {
                    setSuggestion(null);
                    return;
                }
                const suggestedCategory = getSuggestedFocus(
                    categoriesWithPending,
                    toArray(simulados),
                    toArray(studyLogs),
                    {
                        contestId: effectiveContestId,
                        user: effectiveUser,
                        targetScore: effectiveTargetScore,
                        maxScore: effectiveMaxScore,
                        minScore: effectiveMinScore,
                        calibrationHistoryByCategory: effectiveCalibHistory,
                        flashcardDecks: effectiveFlashcardDecks,
                        flashcardDue: effectiveFlashcardDue,
                        simuladoRows: effectiveSimuladoRows,
                        allSimulados: effectiveAllSimulados,
                        allCategories: normalizedCategories,
                        config: {
                            contestId: effectiveContestId,
                            MC_ENABLE_ADAPTIVE_CALIBRATION: adaptiveCalibrationEnabled
                        }
                    }
                );
                if (!suggestedCategory) {
                    setSuggestion(null);
                    return;
                }
                const priorityOrder = { high: 0, medium: 1, low: 2 };
                const sortedTasks = toArray(suggestedCategory.tasks)
                    .filter(t => t && !t.completed && (t.title || t.text || t.id))
                    .slice()
                    .sort((a, b) => {
                        const pA = normalizePriority(a?.priority);
                        const pB = normalizePriority(b?.priority);
                        const diff = (priorityOrder[pA] ?? 1) - (priorityOrder[pB] ?? 1);
                        if (diff !== 0) return diff;
                        // Em caso de mesma prioridade, prioriza tarefa já em andamento ("studying")
                        if (a?.status === 'studying' && b?.status !== 'studying') return -1;
                        if (b?.status === 'studying' && a?.status !== 'studying') return 1;
                        return 0;
                    });
                const nextTask = sortedTasks[0];
                if (!nextTask) {
                    setSuggestion(null);
                    return;
                }
                const fullText = nextTask.title || nextTask.text || 'Estudo';
                const parts = fullText.split(':');
                const hasDetails = parts.length > 1;
                let actionPart = hasDetails
                    ? parts.slice(1).join(':').trim()
                    : fullText.trim();
                actionPart = actionPart.replace(/^\[(.*?)\]\s*/i, '').trim();
                if (!actionPart) {
                    actionPart = fullText.replace(/^\[(.*?)\]\s*/i, '').trim() || 'Estudo';
                }
                const meta = hasDetails
                    ? (parts[0]?.trim() || 'Revisão e exercícios')
                    : 'Revisão e exercícios';
                const taskPriority = normalizePriority(nextTask.priority);
                setSuggestion({
                    category: suggestedCategory,
                    task: nextTask,
                    urgency: suggestedCategory.urgency,
                    priorityConfig: getPriorityConfig(taskPriority),
                    display: {
                        assunto: actionPart.length > 80
                            ? `${actionPart.substring(0, 77)}...`
                            : actionPart,
                        meta
                    }
                });
            } catch (err) {
                console.error('[NextGoalCard] Erro ao calcular sugestão:', err);
                setSuggestion(null);
            } finally {
                setIsLoading(false);
            }
        }, 50);

        return () => clearTimeout(timer);
    }, [
        rawCategories,
        hasAnyTasks,
        simulados,
        studyLogs,
        effectiveContestId,
        effectiveUser,
        effectiveTargetScore,
        effectiveMaxScore,
        effectiveMinScore,
        effectiveCalibHistory,
        effectiveFlashcardDecks,
        effectiveFlashcardDue,
        effectiveSimuladoRows,
        effectiveAllSimulados,
        adaptiveCalibrationEnabled
    ]);

    if (rawCategories.length === 0 || !hasAnyTasks) {
        return null;
    }

    if (isLoading) {
        return (
            <div
                role="status"
                className="rounded-xl p-4 border border-white/10 bg-slate-900/50 backdrop-blur-sm flex items-center gap-4 animate-pulse"
            >
                <div className="w-12 h-12 bg-white/5 rounded-xl" />
                <div className="flex-1 space-y-2">
                    <div className="h-3 bg-white/5 rounded w-1/3" />
                    <div className="h-2 bg-white/5 rounded w-2/3" />
                </div>
            </div>
        );
    }

    if (!suggestion) {
        return (
            <div
                role="status"
                className="rounded-xl p-4 border border-green-500/20 bg-gradient-to-r from-green-900/10 to-emerald-900/10 backdrop-blur-sm flex items-center gap-4"
            >
                <div className="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center animate-pulse">
