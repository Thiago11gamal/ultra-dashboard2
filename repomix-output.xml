<file path="src/components/charts/EvolutionChart/CorrelationRegimeChart.jsx">
import React, { useMemo } from 'react';
import {
  ScatterChart,
  Scatter,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceLine,
  ReferenceArea,
  Cell,
} from 'recharts';
import { Network, Activity } from 'lucide-react';
import { ChartFrame } from '../ChartFrame';
import { computeWeeklyCategoryCorrelation, buildRegimeMapData } from '../../../engine/diagnostics';

function corrCellStyle(r, self) {
  if (self) return 'bg-slate-800/80 text-slate-500 border-white/5';
  if (r === null || r === undefined) return 'bg-slate-900/50 text-slate-600 border-white/5';
  if (r <= -0.45) return 'bg-rose-500/65 text-white border-rose-400/70 font-black';
  if (r <= -0.2) return 'bg-rose-500/25 text-rose-200 border-rose-500/30';
  if (r >= 0.55) return 'bg-emerald-500/65 text-emerald-950 border-emerald-300/70 font-black';
  if (r >= 0.25) return 'bg-emerald-500/25 text-emerald-200 border-emerald-500/30';
  return 'bg-slate-800/40 text-slate-400 border-white/5';
}

function RegimeTooltip({ active, payload }) {
  if (!active || !payload || !payload.length) return null;
  const pt = payload[0]?.payload;
  if (!pt) return null;
  return (
    <div className="bg-slate-950/95 border border-white/15 rounded-2xl p-3.5 shadow-2xl text-xs min-w-[205px]">
      <p className="font-black text-white border-b border-white/10 pb-1.5 mb-2">{pt.name}</p>
      <div className="space-y-1 font-mono">
        <div className="flex justify-between gap-4"><span className="text-slate-400">Hurst (H):</span><span className="text-sky-300 font-bold">{pt.hurstH}</span></div>
        <div className="flex justify-between gap-4"><span className="text-slate-400">Velocidade/sem:</span><span className={pt.velocity >= 0 ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold'}>{pt.velocity >= 0 ? '+' : ''}{pt.velocity}</span></div>
        <div className="flex justify-between gap-4"><span className="text-slate-400">Consistência:</span><span className="text-white">{Math.round(pt.consistency * 100)}%</span></div>
        <div className="pt-1 border-t border-white/10 text-indigo-300 font-sans font-bold">{pt.regimeLabel}</div>
      </div>
    </div>
  );
}

export const CorrelationRegimeChart = React.memo(function CorrelationRegimeChart({
  categories = [],
  studyLogs = [],
  simuladoRows = [],
  targetScore = 80,
  minScore = 0,
  maxScore = 100,
}) {
  const corr = useMemo(
    () => computeWeeklyCategoryCorrelation(categories, maxScore, minScore),
    [categories, maxScore, minScore]
  );

  const regimes = useMemo(
    () => buildRegimeMapData(categories, studyLogs, simuladoRows, maxScore, minScore, targetScore),
    [categories, studyLogs, simuladoRows, maxScore, minScore, targetScore]
  );

  const crowdingPairs = corr.pairs.filter((p) => p.type === 'crowding_out');

  return (
    <div className="w-full space-y-6">
      {/* Parte A — Matriz Semanal de Correlação */}
      <div className="rounded-2xl border border-white/10 bg-slate-950/50 p-4 space-y-3">
        <div className="flex items-center justify-between gap-2 flex-wrap">
          <div className="flex items-center gap-2">
            <Network size={16} className="text-indigo-400" />
            <h4 className="text-xs font-black uppercase tracking-widest text-white">
              Matriz de Correlação Semanal (Matéria × Matéria)
            </h4>
          </div>
          <span className="text-[10px] text-slate-400">
            Verde (+): sobem juntas · Vermelho (−): efeito gangorra / negligência
          </span>
        </div>

        {corr.categories.length < 2 || !corr.matrix.length ? (
          <p className="text-xs text-slate-500 py-6 text-center">
            Cadastre simulados em pelo menos 2 disciplinas ao longo de ≥3 semanas comuns para montar a matriz de correlação.
          </p>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full border-separate border-spacing-1 text-[10px] font-mono">
              <thead>
                <tr>
                  <th className="p-1.5 text-left text-slate-500">Disciplina</th>
                  {corr.categories.map((c) => (
                    <th key={c.id} className="p-1.5 text-center text-slate-400 truncate max-w-[72px]" title={c.name}>
                      {c.name.slice(0, 7)}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {corr.categories.map((catRow, i) => (
                  <tr key={catRow.id}>
                    <td className="p-1.5 font-sans font-bold text-slate-200 whitespace-nowrap max-w-[130px] truncate" title={catRow.name}>
                      {catRow.name}
                    </td>
                    {corr.matrix[i].map((cell, j) => (
                      <td
                        key={`${catRow.id}-${j}`}
                        className={`p-1.5 text-center rounded-md border ${corrCellStyle(cell.r, cell.self)}`}
                        title={`${catRow.name} × ${corr.categories[j].name}: r=${cell.r ?? 'n/a'} (${cell.n} sem)`}
                      >
                        {cell.self ? '—' : (cell.r !== null ? cell.r.toFixed(2) : '·')}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {crowdingPairs.length > 0 && (
          <div className="rounded-xl border border-rose-500/30 bg-rose-500/10 p-3 text-xs text-rose-200">
            <strong>Efeito gangorra detectado:</strong>{' '}
            {crowdingPairs.slice(0, 2).map((p) => `${p.catA} × ${p.catB} (r=${p.r})`).join(' · ')} — intercale essas disciplinas na semana para evitar queda por esquecimento.
          </div>
        )}
      </div>

      {/* Parte B — Mapa de Regimes (Hurst H × Velocidade) */}
      <div className="rounded-2xl border border-white/10 bg-slate-950/50 p-4 space-y-3">
        <div className="flex items-center justify-between gap-2 flex-wrap">
          <div className="flex items-center gap-2">
            <Activity size={16} className="text-emerald-400" />
            <h4 className="text-xs font-black uppercase tracking-widest text-white">
              Mapa de Regimes Estatísticos (Hurst H × Velocidade)
            </h4>
          </div>
          <span className="text-[10px] text-slate-400">
            H &gt; 0.58: tendência persistente · H &lt; 0.42: oscilação / reversão à média
          </span>
        </div>

        {regimes.length === 0 ? (
          <p className="text-xs text-slate-500 py-6 text-center">
            Necessário ao menos 3 simulados em uma disciplina para calcular Expoente de Hurst e Velocidade.
          </p>
        ) : (
          <ChartFrame minHeight={270} label="Calculando regimes Hurst × Velocidade">
            <div className="h-[270px] w-full" role="img" aria-label="Mapa de Regimes Hurst versus Velocidade">
              <ResponsiveContainer width="100%" height="100%" minHeight={240} minWidth={1}>
                <ScatterChart margin={{ top: 16, right: 20, bottom: 24, left: 8 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" />
                  <ReferenceArea x1={0.58} x2={1} y1={0} y2={20} fill="#10b981" fillOpacity={0.05} />
                  <ReferenceArea x1={0} x2={0.42} y1={-20} y2={20} fill="#f59e0b" fillOpacity={0.04} />
                  <XAxis
                    type="number"
                    dataKey="hurstH"
                    domain={[0, 1]}
                    stroke="#64748b"
                    fontSize={10}
                    label={{ value: 'Expoente de Hurst (H)', position: 'insideBottom', offset: -14, fill: '#64748b', fontSize: 10 }}
                  />
                  <YAxis
                    type="number"
                    dataKey="velocity"
                    stroke="#64748b"
                    fontSize={10}
                    tickFormatter={(v) => `${v > 0 ? '+' : ''}${v}`}
                  />
                  <ReferenceLine x={0.5} stroke="#94a3b8" strokeDasharray="4 4" />
                  <ReferenceLine y={0} stroke="#94a3b8" strokeDasharray="4 4" />
                  <Tooltip content={<RegimeTooltip />} />
                  <Scatter data={regimes} name="Disciplinas">
                    {regimes.map((pt) => (
                      <Cell key={pt.id} fill={pt.color} stroke="#fff" strokeWidth={1.5} />
                    ))}
                  </Scatter>
                </ScatterChart>
              </ResponsiveContainer>
            </div>
          </ChartFrame>
        )}
      </div>
    </div>
  );
});

export default CorrelationRegimeChart;
</file>

<file path="src/components/charts/EvolutionChart/ExamPacingChart.jsx">
import React, { useMemo, useState } from 'react';
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  Legend,
} from 'recharts';
import { Clock, AlertTriangle, CheckCircle2, Save } from 'lucide-react';
import { ChartFrame } from '../ChartFrame';
import { buildExamPacingData } from '../../../utils/advancedChartHelpers';
import { useAppStore } from '../../../store/useAppStore';

const fmtMinutes = (mins) => {
  const m = Math.round(Math.abs(Number(mins) || 0));
  const h = Math.floor(m / 60);
  const rem = m % 60;
  return h > 0 ? `${h}h${String(rem).padStart(2, '0')}m` : `${rem}m`;
};

function PacingTooltip({ active, payload }) {
  if (!active || !payload || !payload.length) return null;
  const item = payload[0]?.payload;
  if (!item) return null;
  const isOver = item.deltaMinutes > 0;

  return (
    <div className="bg-slate-950/95 border border-white/15 rounded-2xl p-3.5 shadow-2xl backdrop-blur-xl min-w-[210px] text-xs">
      <p className="font-black text-white mb-2 border-b border-white/10 pb-1.5">{item.name}</p>
      <div className="space-y-1 font-mono">
        <div className="flex justify-between gap-4">
          <span className="text-slate-400">Questões estimadas:</span>
          <span className="text-white font-bold">{item.allocatedQuestions}q</span>
        </div>
        <div className="flex justify-between gap-4">
          <span className="text-slate-400">Seu ritmo médio:</span>
          <span className="text-cyan-300 font-bold">{item.avgSecPerQ}s/q</span>
        </div>
        <div className="flex justify-between gap-4">
          <span className="text-slate-400">Tempo projetado:</span>
          <span className="text-indigo-300 font-bold">{item.projectedMinutes} min</span>
        </div>
        <div className="flex justify-between gap-4">
          <span className="text-slate-400">Orçamento ideal:</span>
          <span className="text-slate-300 font-bold">{item.budgetMinutes} min</span>
        </div>
        <div className="flex justify-between gap-4 pt-1 border-t border-white/10">
          <span className="text-slate-400">Saldo:</span>
          <span className={`font-black ${isOver ? 'text-rose-400' : 'text-emerald-400'}`}>
            {isOver ? `+${item.deltaMinutes} min` : `${item.deltaMinutes} min`}
          </span>
        </div>
      </div>
      {!item.hasTimedData && (
        <p className="text-[10px] text-amber-400/90 mt-2">* Estimado pela média geral (sem cronômetro nesta matéria)</p>
      )}
    </div>
  );
}

export const ExamPacingChart = React.memo(function ExamPacingChart({
  categories = [],
  timeWindow = 'all',
  examDurationMinutes: propDuration = null,
  examTotalQuestions: propQuestions = null,
}) {
  const setData = useAppStore((s) => s.setData);
  const [durationInput, setDurationInput] = useState(() => Number(propDuration) > 0 ? Number(propDuration) : 240);
  const [questionsInput, setQuestionsInput] = useState(() => Number(propQuestions) > 0 ? Number(propQuestions) : 100);
  const [savedFeedback, setSavedFeedback] = useState(false);

  const data = useMemo(
    () =>
      buildExamPacingData(categories, {
        examDurationMinutes: durationInput,
        examTotalQuestions: questionsInput,
        timeWindow,
      }),
    [categories, durationInput, questionsInput, timeWindow]
  );

  const handleSaveExamConfig = () => {
    const safeDur = Math.max(15, Math.min(720, Math.round(Number(durationInput) || 240)));
    const safeQ = Math.max(5, Math.min(500, Math.round(Number(questionsInput) || 100)));
    setData((prev) => ({
      ...(prev || {}),
      examDurationMinutes: safeDur,
      examTotalQuestions: safeQ,
    }));
    setSavedFeedback(true);
    setTimeout(() => setSavedFeedback(false), 2000);
  };

  const isOverTime = data.deltaMinutes > 0;
  const barScaleMax = Math.max(data.examDurationMinutes, data.totalProjectedMinutes, 1);

  return (
    <div className="w-full space-y-5">
      {/* Configuração rápida da prova */}
      <div className="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-white/10 bg-slate-950/60 p-3.5">
        <div className="flex flex-wrap items-center gap-3 text-xs">
          <label className="flex items-center gap-2 text-slate-300 font-semibold">
            <span>Duração (min):</span>
            <input
              type="number"
              min={15}
              max={720}
              value={durationInput}
              onChange={(e) => setDurationInput(Math.max(15, Number(e.target.value) || 15))}
              className="w-20 rounded-lg bg-slate-900 border border-white/10 px-2.5 py-1 text-white font-mono text-xs focus:outline-none focus:border-cyan-400"
            />
          </label>
          <label className="flex items-center gap-2 text-slate-300 font-semibold">
            <span>Questões:</span>
            <input
              type="number"
              min={5}
              max={500}
              value={questionsInput}
              onChange={(e) => setQuestionsInput(Math.max(5, Number(e.target.value) || 5))}
              className="w-20 rounded-lg bg-slate-900 border border-white/10 px-2.5 py-1 text-white font-mono text-xs focus:outline-none focus:border-cyan-400"
            />
          </label>
          <span className="text-[11px] text-cyan-300 font-mono font-bold">
            Alvo: {data.idealSecPerQuestion}s/questão
          </span>
        </div>

        <button
          type="button"
          onClick={handleSaveExamConfig}
          className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 border border-indigo-500/40 text-indigo-200 text-[11px] font-bold transition-colors"
        >
          <Save size={13} />
          {savedFeedback ? 'Salvo no concurso!' : 'Salvar parâmetros'}
        </button>
      </div>

      {!data.hasData ? (
        <div className="min-h-[260px] flex flex-col items-center justify-center gap-3 rounded-2xl border border-white/5 bg-slate-950/50 p-8 text-center">
          <Clock size={34} className="text-cyan-400/50" />
          <p className="text-sm font-bold text-slate-300">Sem dados cronometrados para simular o ritmo de prova</p>
          <p className="text-xs text-slate-500 max-w-md">
            Faça simulados com cronômetro ativo para estimar se você termina a prova inteira dentro de {durationInput} minutos.
          </p>
        </div>
      ) : (
        <>
          {/* Veredito + Barra de Orçamento Global */}
          <div className={`rounded-2xl border p-4 space-y-3 ${isOverTime ? 'border-rose-500/30 bg-rose-500/5' : 'border-emerald-500/30 bg-emerald-500/5'}`}>
            <div className="flex flex-wrap items-center justify-between gap-2">
              <div className="flex items-center gap-2">
                {isOverTime ? (
                  <AlertTriangle size={18} className="text-rose-400 shrink-0" />
                ) : (
                  <CheckCircle2 size={18} className="text-emerald-400 shrink-0" />
                )}
                <p className="text-sm font-black text-white">
                  {isOverTime
                    ? `Estouro estimado de +${fmtMinutes(data.deltaMinutes)} (~${data.estimatedUnanswered} questões sem tempo)`
                    : `Folga estimada de ${fmtMinutes(Math.abs(data.deltaMinutes))} para revisão e gabarito`}
                </p>
              </div>
              <span className="text-xs font-mono font-bold text-slate-300">
                Projetado: <strong className="text-white">{fmtMinutes(data.totalProjectedMinutes)}</strong> / Limite {fmtMinutes(data.examDurationMinutes)}
              </span>
            </div>

            {/* Barra empilhada com marcador de limite */}
            <div className="relative h-6 rounded-xl bg-slate-900/90 border border-white/10 overflow-hidden flex">
              {data.subjects.map((subj) => {
                const widthPct = (subj.projectedMinutes / barScaleMax) * 100;
                return (
                  <div
                    key={subj.id}
                    style={{ width: `${widthPct}%`, backgroundColor: subj.color }}
                    className="h-full border-r border-slate-950/60 opacity-85 hover:opacity-100 transition-opacity"
                    title={`${subj.name}: ${subj.projectedMinutes} min (${subj.allocatedQuestions}q)`}
                  />
                );
              })}
              {/* Linha do tempo limite da prova */}
              <div
                className="absolute top-0 bottom-0 w-0.5 bg-white shadow-[0_0_8px_#fff]"
                style={{ left: `${Math.min(100, (data.examDurationMinutes / barScaleMax) * 100)}%` }}
                title={`Limite da prova: ${data.examDurationMinutes} min`}
              />
            </div>
          </div>

          {/* Comparativo por disciplina: Tempo Projetado vs Orçamento Ideal */}
          <ChartFrame minHeight={300} label="Simulando orçamento por disciplina">
            <div className="h-[300px] w-full" role="img" aria-label="Comparativo de tempo projetado versus orçamento ideal por matéria">
              <ResponsiveContainer width="100%" height="100%" minHeight={260} minWidth={1}>
                <BarChart data={data.subjects} margin={{ top: 12, right: 20, left: 4, bottom: 32 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" vertical={false} />
                  <XAxis
                    dataKey="name"
                    stroke="#64748b"
                    fontSize={10}
                    interval={0}
                    angle={-20}
                    textAnchor="end"
                    height={55}
                    tickFormatter={(v) => (String(v).length > 16 ? `${String(v).slice(0, 15)}…` : v)}
                  />
                  <YAxis stroke="#64748b" fontSize={11} tickFormatter={(v) => `${v}m`} />
                  <Tooltip content={<PacingTooltip />} cursor={{ fill: 'rgba(255,255,255,0.04)' }} />
                  <Legend wrapperStyle={{ fontSize: 11 }} />
                  <Bar dataKey="budgetMinutes" name="Orçamento Ideal (min)" fill="#334155" radius={[6, 6, 0, 0]} />
