              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" vertical={false} />
              <XAxis dataKey="displayDate" stroke="#64748b" fontSize={10} />
              <YAxis
                domain={[minScore, maxScore]}
                stroke="#64748b"
