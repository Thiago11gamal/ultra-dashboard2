      // Steady low chronic baseline (30 min/day for days 28..8), then huge spike (300 min/day for days 6..0)
      const logs = [];
      for (let d = 28; d >= 7; d--) {
        logs.push({ date: makeDayIso(d), minutes: 35, energyLevel: 4 });
      }
      for (let d = 6; d >= 0; d--) {
        logs.push({ date: makeDayIso(d), minutes: 240, energyLevel: 2 });
