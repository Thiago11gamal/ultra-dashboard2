        ],
        auraClass: 'bg-purple-500/15 shadow-[0_0_50px_rgba(147,51,234,0.3)]',
        pulsePingClass: 'bg-purple-400',
        pulseDotClass: 'bg-purple-500',
        statusActive: 'Pausa Longa'
    },
