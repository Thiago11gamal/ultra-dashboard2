        {
          id: 'manual-cat1-task1',
          categoryId: 'cat-1',
          topicId: 'task-1',
          subject: 'Direito Constitucional',
          topic: 'Direitos Fundamentais',
          correct: 8,
          total: 10
        }
      ];

      // Build submittedKeys with BOTH ID and normalized string
      const submittedIds = new Set(submittedRows.map(r => r.id).filter(Boolean));
      const submittedKeys = new Set();
      submittedRows.forEach(r => {
        if (r.categoryId && r.topicId) submittedKeys.add(`${r.categoryId}-${r.topicId}`);
        if (r.subject && r.topic) submittedKeys.add(`${normalize(r.subject)}-${normalize(r.topic)}`);
      });

      const rowsToKeep = prevRows.filter((r) => {
        const isToday = r.date === todayKey;
        const isManual = r && !r.isAuto && r.source !== 'ai-generated';

        if (isToday && isManual) {
          if (r?.id && submittedIds.has(r.id)) return false;

          const key1 = (r?.categoryId && r?.topicId) ? `${r.categoryId}-${r.topicId}` : null;
          const key2 = (r?.subject && r?.topic) ? `${normalize(r.subject)}-${normalize(r.topic)}` : null;

          if (key1 && submittedKeys.has(key1)) return false;
          if (key2 && submittedKeys.has(key2)) return false;
        }

        return true;
      });

      // The legacy row must be removed because key2 matched!
      expect(rowsToKeep).toHaveLength(0);
    });
  });

  describe('Bug 4: lastSimuladoData Strategy B must not include AI rows', () => {
    it('should only include manual rows when lastRef is manual, ignoring AI rows with isAuto=false', () => {
      const todayKey = '2026-11-14';

      // Today has an AI row (which has isAuto: false) and a Manual row
      const simuladoRowsArray = [
        {
          id: 'ai-row-1',
          batchId: 'batch-ai-1',
          subject: 'Direito Constitucional',
          topic: 'Artigo 5',
          correct: 10,
          total: 10,
          source: 'ai-generated',
          isAuto: false, // AI rows have isAuto: false!
          date: todayKey,
          createdAt: `${todayKey}T10:00:00Z`
        },
        {
          id: 'man-row-1',
          batchId: 'batch-man-1',
          subject: 'Direito Constitucional',
          topic: 'Nacionalidade',
          correct: 7,
          total: 10,
          source: 'manual',
          isAuto: false,
          date: todayKey,
          createdAt: `${todayKey}T11:00:00Z` // Later!
        }
      ];

      const lastRef = simuladoRowsArray[1]; // man-row-1 is the most recent
      expect(lastRef.source).toBe('manual');

      // Strategy B filter:
      const refDateKey = todayKey;
      const resultRows = simuladoRowsArray.filter((r) => {
        if (!r || typeof r !== 'object') return false;
        // Fix: isManual must exclude AI source!
        const isAi = r?.source === 'ai-generated' || (r?.batchId && r?.source !== 'manual' && !r?.id?.startsWith('manual'));
        const isManual = !isAi && (r?.source === 'manual' || r?.isAuto === false || r?.id?.startsWith('manual'));
        if (!isManual) return false;
        return r.date === refDateKey;
      });

      // MUST ONLY CONTAIN THE MANUAL ROW
      expect(resultRows).toHaveLength(1);
      expect(resultRows[0].id).toBe('man-row-1');
    });
  });
});
</file>

<file path="src/components/ai/SimuladoPlayer.jsx">
import React, { useRef } from 'react';
// eslint-disable-next-line no-unused-vars
import { motion, AnimatePresence } from 'framer-motion';
import { Clock, ArrowLeft, ArrowRight, Award, CheckCircle2, XCircle } from 'lucide-react';

const normalizeLetter = (val) => String(val ?? '').trim().toUpperCase();

export default function SimuladoPlayer({
  form,
  questions,
  currentIndex,
  answers,
  confidences = {},
  onSelectConfidence,
  timeLeft,
  DIFFICULTIES,
  goTo,
  selectAnswer,
  clearAnswer,
  penaltyPerWrong = 0,
  handleFinish,
  resetAll
}) {
  const touchStartX = useRef(null);
  const touchStartY = useRef(null);

  if (!questions || questions.length === 0) {
    return (
      <div className="flex flex-col items-center justify-center p-12 text-slate-400">
        <p className="mb-4">Nenhuma questão disponível.</p>
        <button onClick={resetAll} className="px-4 py-2 bg-slate-800 rounded-lg text-white">Voltar</button>
      </div>
    );
  }
  const currentQuestion = questions[currentIndex];
  const answeredCount = Object.keys(answers || {}).length;
  const timeColor = timeLeft < 180 ? 'text-red-400 border-red-500/30' : timeLeft < 300 ? 'text-amber-400 border-amber-500/30' : 'text-slate-300 border-white/10';
  const difficultyLabel = DIFFICULTIES.find(d => d.value === form?.dificuldade)?.label || form?.dificuldade || 'Médio';

  const handleTouchStart = (e) => {
    touchStartX.current = e.touches[0].clientX;
    touchStartY.current = e.touches[0].clientY;
  };

  const handleTouchEnd = (e) => {
    // FIX-SWIPE-01: `!touchStartX.current` era falso-negativo em x=0 (borda
    // esquerda). Comparar com null/undefined, não com falsy.
    if (touchStartX.current == null) return;
    const touch = e.changedTouches?.[0];
    if (!touch || touchStartX.current == null) return;

    const touchEndX = touch.clientX;
    const touchEndY = touch.clientY ?? touchStartY.current;
    const diff = touchStartX.current - touchEndX;
    const diffY = Math.abs((touchStartY.current ?? 0) - touchEndY);

    // FIX-SWIPE-02: exigir dominância horizontal — senão scroll vertical
    // avançava/voltava questão acidentalmente.
    if (Math.abs(diff) > 50 && Math.abs(diff) > diffY * 1.5) {
      if (diff > 0 && currentIndex < questions.length - 1) {
        goTo(currentIndex + 1); // Swipe left -> next
      } else if (diff < 0 && currentIndex > 0) {
        goTo(currentIndex - 1); // Swipe right -> prev
      }
    }

    // FIX-SWIPE-03: limpar estado para não contaminar o próximo gesto.
    touchStartX.current = null;
    touchStartY.current = null;
  };

return (
      <div 
        className="w-full"
        onTouchStart={handleTouchStart}
        onTouchEnd={handleTouchEnd}
      >
        {/* ═══ TOP BAR ═══ */}
        <div className="mb-6 rounded-2xl border border-white/[0.06] overflow-hidden" style={{ background: 'linear-gradient(135deg, rgba(30,27,75,0.4), rgba(15,23,42,0.7))', backdropFilter: 'blur(20px)' }}>
          <div className="px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div className="flex items-center gap-3 min-w-0">
              <div className="flex items-center gap-1.5">
                <div className="px-2.5 py-1 rounded-lg bg-indigo-500/15 border border-indigo-500/25 text-indigo-400 text-[10px] font-black tracking-[1.5px]">IA</div>
                <div className="px-2 py-1 rounded-lg bg-white/[0.04] border border-white/[0.06] text-[10px] font-bold text-slate-500">{difficultyLabel.toUpperCase()}</div>
              </div>
              <div className="text-[15px] font-bold text-white truncate">
                {currentQuestion.materia || form.materia}{' '}
                <span className="text-slate-600 mx-1">›</span>{' '}
                <span className="text-slate-400 font-medium">{currentQuestion.assunto || (form.categoryId === 'mixed' ? 'Foco em Fraquezas' : form.assunto)}</span>
              </div>
            </div>

            <div className="flex items-center gap-3 shrink-0">
              <div className="text-right hidden sm:block">
                <div className="text-[11px] font-mono text-slate-500">{currentIndex + 1} / {questions.length}</div>
                <div className="text-[10px] font-bold text-emerald-400/80">{answeredCount} respondidas</div>
              </div>

              {/* Timer */}
              <div className={`flex items-center gap-2 font-mono font-black text-lg px-4 py-2 rounded-xl border transition-colors ${timeColor}`} style={{ background: timeLeft < 180 ? 'rgba(239,68,68,0.08)' : timeLeft < 300 ? 'rgba(245,158,11,0.06)' : 'rgba(255,255,255,0.02)' }}>
                <Clock size={16} className="opacity-60" />
                {Math.floor(timeLeft / 60)}:{String(timeLeft % 60).padStart(2, '0')}
              </div>
            </div>
          </div>

          {/* Progress bars */}
          <div className="px-5 pb-3">
            <div className="flex gap-1 mb-1.5">
              {questions.map((q, i) => {
                const isAnswered = !!answers[q.id];
                const isCurrent = i === currentIndex;
                return (
                  <button
                    key={i}
                    onClick={() => goTo(i)}
                    className={`h-1.5 flex-1 rounded-full transition-all duration-300 ${isCurrent ? 'bg-white shadow-[0_0_6px_rgba(255,255,255,0.4)]' : isAnswered ? 'bg-emerald-400/70' : 'bg-white/10 hover:bg-white/25'}`}
                    title={`Questão ${i + 1}`}
                  />
                );
              })}
            </div>
            <div className="text-center text-[9px] text-slate-600 font-medium tracking-[2px]">A B C D E • ← → • ENTER • ESC</div>
          </div>
        </div>

        {/* ═══ QUESTION CARD ═══ */}
        <div className="relative min-h-[380px]">
          <AnimatePresence mode="wait">
            <motion.div 
              key={currentQuestion.id}
              initial={{ opacity: 0, y: 12 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -12 }}
              transition={{ duration: 0.2, ease: "easeOut" }}
              className="rounded-[24px] border border-white/[0.06] p-7 sm:p-8 mb-6"
              style={{ background: 'linear-gradient(180deg, rgba(30,27,75,0.25) 0%, rgba(15,23,42,0.5) 100%)', backdropFilter: 'blur(16px)' }}
            >
              {/* Question header */}
              <div className="flex items-center justify-between mb-5">
                <div className="flex items-center gap-2.5">
                  <span className="text-[11px] font-black tracking-[2px] text-indigo-400">QUESTÃO {currentIndex + 1}</span>
                  {currentQuestion.categoryId && <span className="text-[9px] px-2 py-0.5 rounded-md bg-white/[0.04] text-slate-600 font-bold tracking-wide">VINCULADA</span>}
                </div>
                <span className="text-[11px] font-mono text-slate-600">{currentIndex + 1}/{questions.length}</span>
              </div>
              
              {/* Enunciado */}
              <div className="text-[17px] leading-[1.7] font-medium text-white/90 tracking-[-0.2px] mb-6">
                {currentQuestion.enunciado}
              </div>

              {/* Confiança Metacognitiva (opcional, 1 clique) */}
              {typeof onSelectConfidence === 'function' && (
                <div className="flex flex-wrap items-center gap-2 mb-5">
                  <span className="text-[10px] font-black uppercase tracking-widest text-slate-500 mr-1">Confiança:</span>
                  {[
                    { key: 'certeza', label: 'Certeza', activeCls: 'bg-emerald-500/25 border-emerald-400/60 text-emerald-200' },
                    { key: 'duvida', label: 'Dúvida', activeCls: 'bg-amber-500/25 border-amber-400/60 text-amber-200' },
                    { key: 'chute', label: 'Chute', activeCls: 'bg-rose-500/25 border-rose-400/60 text-rose-200' },
                  ].map((opt) => {
                    const active = confidences[currentQuestion.id] === opt.key;
                    return (
                      <button
                        key={opt.key}
                        type="button"
                        onClick={() => onSelectConfidence(currentQuestion.id, active ? null : opt.key)}
                        className={`px-3 py-1 rounded-full border text-[11px] font-bold transition-all ${
                          active ? opt.activeCls : 'bg-white/[0.03] border-white/10 text-slate-400 hover:text-white'
                        }`}
                      >
                        {opt.label}
                      </button>
                    );
                  })}
                </div>
              )}

              {/* Alternatives */}
              <div className="space-y-2.5">
                {(currentQuestion.alternativas || []).map((alt, idx) => {
                  const isSelected = normalizeLetter(answers[currentQuestion.id]) === normalizeLetter(alt.letra);
                  return (
                    <motion.button
                      key={idx}
                      onClick={() => selectAnswer(alt.letra)}
                      whileHover={{ scale: 1.005 }}
                      whileTap={{ scale: 0.995 }}
                      className={`group w-full text-left px-5 py-4 rounded-2xl border flex gap-4 items-center transition-all duration-200
                        ${isSelected 
                          ? 'border-indigo-400/60 shadow-[0_0_25px_rgba(99,102,241,0.2)]' 
                          : 'border-white/10 hover:border-white/30 hover:bg-white/[0.03]'}`}
                      style={{
                        background: isSelected 
                          ? 'linear-gradient(135deg, rgba(99,102,241,0.2), rgba(147,51,234,0.1))' 
                          : 'rgba(15,23,42,0.5)'
                      }}
                    >
                      <div className={`shrink-0 w-10 h-10 rounded-xl flex items-center justify-center text-[13px] font-black border transition-all duration-200
                        ${isSelected ? 'bg-indigo-500 border-indigo-400 text-white shadow-[0_0_15px_rgba(99,102,241,0.4)]' : 'bg-slate-800/60 border-slate-600 text-slate-300 group-hover:border-slate-400 group-hover:text-white'}`}>
                        {alt.letra}
                      </div>
                      <div className={`text-[15px] leading-snug flex-1 transition-colors ${isSelected ? 'text-white font-bold' : 'text-slate-200 group-hover:text-white'}`}>
                        {alt.texto}
                      </div>
                      {isSelected && (
                        <motion.div initial={{ scale: 0, rotate: -90 }} animate={{ scale: 1, rotate: 0 }} className="shrink-0">
                          <CheckCircle2 size={20} className="text-indigo-400" />
                        </motion.div>
                      )}
                    </motion.button>
                  );
                })}
              </div>

              {typeof clearAnswer === 'function' && (
                <div className="mt-4 flex flex-wrap items-center justify-between gap-2">
                  <button
                    type="button"
                    onClick={() => clearAnswer(currentQuestion.id)}
                    disabled={!answers[currentQuestion.id]}
                    className="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/[0.03] hover:bg-white/[0.08] text-xs font-bold text-slate-300 disabled:opacity-35 transition-colors"
                  >
                    <XCircle size={13} className="text-slate-400" />
                    Deixar em branco
                  </button>
                  {penaltyPerWrong > 0 && (
                    <span className="text-[10px] font-mono text-amber-300/90 bg-amber-500/10 border border-amber-500/25 px-2.5 py-1 rounded-lg">
                      Penalidade ativa: -{penaltyPerWrong} pt por erro (em branco = 0)
                    </span>
                  )}
                </div>
              )}
            </motion.div>
          </AnimatePresence>
        </div>

        {/* ═══ NAVIGATION ═══ */}
        <div className="flex justify-between items-center gap-3">
          <button
            onClick={() => goTo(currentIndex - 1)}
            disabled={currentIndex === 0}
            className="px-5 py-3 rounded-xl border border-white/[0.08] text-[13px] font-semibold flex items-center gap-2 hover:bg-white/[0.04] disabled:opacity-30 transition"
          >
            <ArrowLeft size={15} /> Anterior
          </button>

          <div className="text-[12px] text-slate-600 font-mono tabular-nums">{answeredCount}/{questions.length}</div>

          {currentIndex < questions.length - 1 ? (
            <button
              onClick={() => goTo(currentIndex + 1)}
              className="px-6 py-3 rounded-xl text-[13px] font-black flex items-center gap-2 transition shadow-[0_4px_15px_-4px_rgba(99,102,241,0.4)]"
              style={{ background: 'linear-gradient(135deg, #4f46e5, #6366f1)' }}
            >
              Próxima <ArrowRight size={15} />
            </button>
          ) : (
            <motion.button
              onClick={handleFinish}
              whileHover={{ scale: 1.02 }}
              whileTap={{ scale: 0.98 }}
              className="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-[13px] font-black flex items-center gap-2 transition shadow-[0_4px_15px_-4px_rgba(16,185,129,0.4)]"
            >
              FINALIZAR <Award size={16} />
            </motion.button>
          )}
        </div>

        <div className="text-center mt-4">
          <button 
            onClick={resetAll}
            className="text-[11px] text-slate-600 hover:text-slate-400 transition"
          >
            Cancelar e voltar
          </button>
        </div>
      </div>
    );
  
}
</file>

<file path="src/components/charts/EvolutionChart/IRTPsychometricChart.jsx">
import React, { useEffect, useMemo, useRef, useState } from 'react';
import {
  ComposedChart,
  Line,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceArea,
  ReferenceLine,
} from 'recharts';
import { Brain, AlertTriangle, Scale, Save } from 'lucide-react';
import { ChartFrame } from '../ChartFrame';
import {
  estimateIRTAbility,
  computeGuessingStrategy,
  EXAM_BOARDS,
} from '../../../engine/adaptive/irtEngine';
import { useAppStore } from '../../../store/useAppStore';

const safeArr = (v) => (Array.isArray(v) ? v : (v && typeof v === 'object' ? Object.values(v) : [])).filter(Boolean);

export const IRTPsychometricChart = React.memo(function IRTPsychometricChart({
  categories = [],
  simuladoRows = [],
  focusCategory = null,
  showOnlyFocus = false,
  minScore = 0,
  maxScore = 100,
  examBoard: propBoard = 'PADRAO',
  penaltyPerWrong: propPenalty = 0,
}) {
  const setData = useAppStore((s) => s.setData);
  const normalizedPropBoard = propBoard || 'PADRAO';
  const normalizedPropPenalty = Number.isFinite(Number(propPenalty)) ? Number(propPenalty) : 0;
  const [prevPropBoard, setPrevPropBoard] = useState(normalizedPropBoard);
  const [prevPropPenalty, setPrevPropPenalty] = useState(normalizedPropPenalty);
  const [selectedBoard, setSelectedBoard] = useState(normalizedPropBoard);
  const [penalty, setPenalty] = useState(normalizedPropPenalty);
  const [savedBoard, setSavedBoard] = useState(false);
  const savedTimerRef = useRef(null);

  if (normalizedPropBoard !== prevPropBoard || normalizedPropPenalty !== prevPropPenalty) {
    setPrevPropBoard(normalizedPropBoard);
    setPrevPropPenalty(normalizedPropPenalty);
    setSelectedBoard(normalizedPropBoard);
    setPenalty(normalizedPropPenalty);
    setSavedBoard(false);
  }

  useEffect(() => () => {
    if (savedTimerRef.current) clearTimeout(savedTimerRef.current);
  }, []);

  const irtEntries = useMemo(() => {
    const targetCats = showOnlyFocus && focusCategory ? [focusCategory] : safeArr(categories);
    const fromHist = targetCats.flatMap((c) => safeArr(c?.simuladoStats?.history));
    const fromRows = safeArr(simuladoRows).filter(
      (r) => !showOnlyFocus || !focusCategory || r.categoryId === focusCategory.id
    );
    return fromRows.length > 0 ? fromRows : fromHist;
  }, [categories, simuladoRows, focusCategory, showOnlyFocus]);

  const irt = useMemo(() => estimateIRTAbility(irtEntries, { minScore, maxScore }), [irtEntries, minScore, maxScore]);

  const allQuestionTelemetry = useMemo(() => {
    return safeArr(simuladoRows).flatMap((r) => safeArr(r?.questionTelemetry));
  }, [simuladoRows]);

  const guessing = useMemo(
    () => computeGuessingStrategy(allQuestionTelemetry, { penaltyPerWrong: penalty }),
    [allQuestionTelemetry, penalty]
  );

  const handleBoardChange = (boardId) => {
    setSelectedBoard(boardId);
    const found = EXAM_BOARDS.find((b) => b.id === boardId);
    if (found) setPenalty(found.penaltyPerWrong);
  };

  const handleSaveBoard = () => {
    setData((prev) => ({
      ...(prev || {}),
      examBoard: selectedBoard,
      penaltyPerWrong: Math.max(0, Math.min(2, Number(penalty) || 0)),
    }));
    setSavedBoard(true);
    if (savedTimerRef.current) clearTimeout(savedTimerRef.current);
    savedTimerRef.current = setTimeout(() => {
      savedTimerRef.current = null;
      setSavedBoard(false);
    }, 2000);
  };

  return (
    <div className="w-full space-y-6">
      {/* Parte A — TRI / IRT 2PL */}
      <div className="rounded-2xl border border-white/10 bg-slate-950/60 p-4 space-y-4">
        <div className="flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-2">
            <Brain size={16} className="text-violet-400" />
            <h4 className="text-xs font-black uppercase tracking-widest text-white">
              Curva Característica TRI / IRT (Habilidade θ)
            </h4>
          </div>
          {irt.hasData && (
            <div className="flex flex-wrap items-center gap-2 text-xs font-mono">
              <span className="px-2.5 py-1 rounded-lg bg-violet-500/15 border border-violet-500/30 text-violet-200 font-black">
                θ = {irt.theta >= 0 ? '+' : ''}{irt.theta} (±{irt.thetaSe})
              </span>
              <span className="px-2.5 py-1 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-200 font-bold capitalize">
                Zona Proximal: {irt.recommendedDifficulty}
              </span>
            </div>
          )}
        </div>

        {irt.pedagogicalIncoherence && (
          <div className="rounded-xl border border-amber-500/35 bg-amber-500/10 p-3 flex items-start gap-2.5 text-xs text-amber-200">
            <AlertTriangle size={15} className="shrink-0 mt-0.5 text-amber-400" />
            <span>{irt.incoherenceMessage}</span>
          </div>
        )}

        {!irt.hasData ? (
          <p className="text-xs text-slate-500 py-6 text-center">
            Cadastre simulados para estimar sua habilidade latente θ e a curva característica por dificuldade.
          </p>
        ) : (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
            <ChartFrame minHeight={240} label="Estimando curva TRI">
              <div className="h-[240px] w-full" role="img" aria-label="Curva Característica do Item TRI 2PL">
                <ResponsiveContainer width="100%" height="100%" minHeight={210} minWidth={1}>
                  <ComposedChart data={irt.iccCurve} margin={{ top: 10, right: 16, left: 0, bottom: 16 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" />
                    <ReferenceArea y1={65} y2={78} fill="#10b981" fillOpacity={0.08} />
                    <XAxis dataKey="b" stroke="#64748b" fontSize={10} label={{ value: 'Dificuldade do item (b)', position: 'insideBottom', offset: -10, fill: '#64748b', fontSize: 10 }} />
                    <YAxis domain={[0, 100]} stroke="#64748b" fontSize={10} tickFormatter={(v) => `${v}%`} />
                    <Tooltip formatter={(val, name) => [`${val}%`, name]} />
                    <ReferenceLine x={irt.theta} stroke="#a78bfa" strokeDasharray="4 4" label={{ value: `θ=${irt.theta}`, position: 'top', fill: '#c4b5fd', fontSize: 10 }} />
                    <Line type="monotone" dataKey="predictedPct" name="P(Acerto) TRI" stroke="#a78bfa" strokeWidth={2.5} dot={false} />
                  </ComposedChart>
                </ResponsiveContainer>
              </div>
            </ChartFrame>

            <ChartFrame minHeight={240} label="Comparando acerto por dificuldade">
              <div className="h-[240px] w-full" role="img" aria-label="Acerto observado versus previsto por nível de dificuldade">
                <ResponsiveContainer width="100%" height="100%" minHeight={210} minWidth={1}>
                  <ComposedChart data={irt.tierBreakdown} margin={{ top: 10, right: 16, left: 0, bottom: 10 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" vertical={false} />
                    <XAxis dataKey="label" stroke="#94a3b8" fontSize={11} />
                    <YAxis domain={[0, 100]} stroke="#64748b" fontSize={10} tickFormatter={(v) => `${v}%`} />
                    <Tooltip formatter={(v) => (v == null ? '—' : `${v}%`)} />
                    <Bar dataKey="observedPct" name="Acerto Real (%)" fill="#38bdf8" radius={[6, 6, 0, 0]} barSize={28} />
                    <Line type="monotone" dataKey="predictedPct" name="Previsto TRI (%)" stroke="#a78bfa" strokeWidth={2.5} dot={{ r: 4 }} />
                  </ComposedChart>
                </ResponsiveContainer>
              </div>
            </ChartFrame>
          </div>
        )}
      </div>

