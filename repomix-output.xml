        })();

        if (!hasDuplicates) return;

        const groups = {};

        activeData.categories.forEach(cat => {
            const norm = normalize(cat.name);

            if (!groups[norm]) groups[norm] = [];

            groups[norm].push(cat);
        });

        let changed = false;
        const newCategories = [];

        Object.values(groups).forEach(group => {
            if (group.length === 1) {
                newCategories.push(group[0]);
