function _getSRSBoost(history, daysSince, maxScore, cfg, mssdVolatility = null, effectiveN = null, minScore = 0, options = null) {
    // Lote 7: FSRS avançado opcional
    if (
        getCoachFeature(options, 'useAdvancedFsrs', false) &&
        getCoachFeature(options, 'useFsrsForSrsBoost', false)
    ) {
        try {
            const fsrsData = estimateCategoryFsrsBoost(history, {
                daysSince,
                maxScore,
                minScore,
                cfg,
                desiredRetention: 0.85,
            });
            if (fsrsData) {
                return fsrsData;
            }
        } catch (err) {
            console.warn('[CoachLogic] Advanced FSRS category boost failed:', err);
        }
    }

    // Fallback legado
    const forgettingData = computeForgettingRisk(
        history,
        maxScore,
        null,
        mssdVolatility,
        effectiveN,
        daysSince,
        0,
        minScore
    );

    // ✅ FIX: Validar retention antes de calcular boost
    const retention = Number.isFinite(forgettingData.retentionPct)
        ? forgettingData.retentionPct
        : 100;

    if (retention < 75) {
        const intensity = Math.pow((75 - retention) / 75, 1.2);
        const boost = cfg.SRS_BOOST * 2.0 * intensity;
        let label;
        if (retention < 30) label = "⚠️ Memória Crítica (Risco de Branco)";
        else if (retention < 55) label = "🧠 Revisão Necessária (Curva de Esquecimento)";
        else label = "🔄 Revisão de Reforço";
        return { boost, label };
    }
    return { boost: 0, label: null };
}

// ==================== FUNÇÃO PRINCIPAL ====================
export const extractMetrics = (category, simulados = [], studyLogs = [], options = {}) => {
    // ✅ FIX: Garantir que options é objeto
    const safeOptions = options && typeof options === 'object' ? options : {};

    const cfg = { ...DEFAULT_CONFIG, ...(safeOptions.config || {}) };
    const safeCategory = category || {};
    const categoryId = safeCategory.id ?? safeCategory.name;
    const calibrationHistory = getCalibrationHistoryFor(safeOptions.calibrationHistoryByCategory, categoryId, safeCategory.name);
    const rollingCalibration = computeRollingCalibrationParams(calibrationHistory, {
        baseline: cfg.MC_CALIBRATION_BRIER_BASELINE,
        maxPenalty: cfg.MC_CALIBRATION_MAX_PENALTY,
        windowDays: cfg.MC_CALIB_WINDOW_DAYS,
        minSamples: cfg.MC_CALIB_MIN_SAMPLES,
        maxSamples: cfg.MC_CALIB_MAX_SAMPLES
    });

    const referenceDate = safeOptions.now ? (normalizeDate(safeOptions.now) || new Date()) : new Date();
    const referenceNow = referenceDate.getTime();

    // ✅ FIX: Priorizar maxScore, minScore e minCutoff da categoria sobre options global
    const rawCatMax = parseOptionalFinite(safeCategory.maxScore);
    const rawOptMax = parseOptionalFinite(safeOptions.maxScore);
    const maxScore = (rawCatMax !== null && rawCatMax > 0)
        ? rawCatMax
        : ((rawOptMax !== null && rawOptMax > 0) ? rawOptMax : 100);

    const rawCatMin = parseOptionalFinite(safeCategory.minScore);
    const rawOptMin = parseOptionalFinite(safeOptions.minScore);
    const rawMinScore = rawCatMin ?? rawOptMin ?? 0;
    const minScore = Math.min(rawMinScore, maxScore);

    const domain = Math.max(1e-9, maxScore - minScore);
    const globalMaxScore = (rawOptMax !== null && rawOptMax > 0)
        ? rawOptMax
        : maxScore;
    const globalMinScore = rawOptMin !== null
        ? Math.min(rawOptMin, globalMaxScore)
        : minScore;
    const globalDomain = Math.max(1e-9, globalMaxScore - globalMinScore);
    const mapGlobalToCategoryScale = (globalVal) => {
        const val = parseOptionalFinite(globalVal);
        if (val === null) return null;
        if (Math.abs(globalMaxScore - maxScore) < 1e-6 && Math.abs(globalMinScore - minScore) < 1e-6) {
            return val;
        }
        const ratio = clamp((val - globalMinScore) / globalDomain, 0, 1);
        return minScore + ratio * domain;
    };

    const fallbackTarget = minScore + domain * 0.8;
    const catMinCutoff = parseOptionalFinite(safeCategory.minCutoff);
    const optTargetScore = parseOptionalFinite(safeOptions.targetScore);
    const mappedGlobalTarget = catMinCutoff === null && optTargetScore !== null
        ? mapGlobalToCategoryScale(optTargetScore)
        : null;
    const unclampedTarget = catMinCutoff ?? mappedGlobalTarget ?? optTargetScore ?? fallbackTarget;
    const targetScore = Math.min(maxScore, Math.max(minScore, unclampedTarget));
    const targetScoreLabel = safeOptions.targetScoreLabel ?? Math.round(((targetScore - minScore) / domain) * 100);

    let rawWeightVal = safeCategory.weight;
    if (typeof rawWeightVal === 'string') {
        const trimmedWeight = rawWeightVal.trim();
        if (trimmedWeight.includes(',')) {
            rawWeightVal = trimmedWeight.replace(/\./g, '').replace(',', '.');
        } else if (/^[1-9]\d{0,2}(\.\d{3}){2,}$/.test(trimmedWeight)) {
            rawWeightVal = trimmedWeight.replace(/\./g, '');
        } else {
            rawWeightVal = trimmedWeight;
        }
    }
    const parsedWeight = Number(rawWeightVal);
    const rawWeight = Number.isFinite(parsedWeight) && parsedWeight > 0 ? parsedWeight : 5;
    // Normalização proporcional de pesos: preserva escala [1..10] legada e evita saturação em editais [10..50+] ou [0..1]
    const allCatWeights = safeArray(safeOptions.allCategories)
        .map((c) => {
            let v = c?.weight;
            if (typeof v === 'string') {
                const t = v.trim();
                v = t.includes(',') ? t.replace(/\./g, '').replace(',', '.') : t;
            }
            const n = Number(v);
            return Number.isFinite(n) && n > 0 ? n : null;
        })
        .filter((n) => n !== null);
    const maxObservedWeight = Math.max(rawWeight, ...allCatWeights, 0);
    let boundedWeight;
    if (maxObservedWeight > 10) {
        boundedWeight = Math.min(10, Math.max(1, (rawWeight / maxObservedWeight) * 10));
    } else if (maxObservedWeight > 0 && maxObservedWeight <= 1 && allCatWeights.length > 0) {
        boundedWeight = Math.min(10, Math.max(1, (rawWeight / maxObservedWeight) * 10));
    } else {
        boundedWeight = Math.min(10, Math.max(1, rawWeight));
    }
    const weight = boundedWeight * 20;
    const weightLabel = boundedWeight <= 3 ? '1 — Baixa' : boundedWeight <= 7 ? '2 — Média' : '3 — Alta';

    let daysToExam = null;
    // ✅ FIX: Verificar se safeOptions.user existe antes de acessar goalDate
    if (safeOptions.user && safeOptions.user.goalDate) {
        try {
            const examDate = normalizeDate(safeOptions.user.goalDate);
            if (examDate && !isNaN(examDate.getTime())) {
                const today = normalizeDate(referenceDate) || referenceDate;
                daysToExam = Math.round((examDate.getTime() - today.getTime()) / MS_PER_DAY);
            }
        } catch {
            console.warn("[CoachLogic] Invalid goalDate:", safeOptions.user.goalDate);
        }
    }
    if (daysToExam === null) {
        const explicitDays = parseOptionalFinite(safeOptions.daysToExam);
        if (explicitDays !== null) {
            daysToExam = Math.round(explicitDays);
        }
    }

    const safeSimulados = Array.isArray(simulados) ? [...simulados] : Object.values(simulados || {});
    const safeStudyLogs = Array.isArray(studyLogs) ? [...studyLogs] : Object.values(studyLogs || {});

    const catName = safeCategory?.name || safeCategory?.id || '';

    // ✅ FIX-AUDIT: Coletar TODOS os simulados relevantes para esta matéria específica:
    // 1. Histórico próprio da categoria em safeCategory.simuladoStats?.history (gerado pelos simulados)
    // 2. Registros em safeSimulados (e safeOptions.allSimulados) que correspondam à matéria
    // 3. Linhas individuais em safeOptions.simuladoRows (ou safeOptions.history) correspondentes à matéria
    const catSims = [];
    const seenSimKeys = new Set();
    const seenDateScoreBySource = new Set();
    const seenDatesBySource = new Set();

    // 1. Histórico da própria categoria
    const rawCatHistory = safeArray(safeCategory?.simuladoStats?.history);
    const source1DateScores = new Set();
    const source1Dates = new Set();
    rawCatHistory.forEach((h, idx) => {
        if (!h || h.valid === false) return;
        const score = getSafeScore(h, maxScore, minScore);
        if (!Number.isFinite(score)) return;
        const realDateKey = getDateKey(h.date || h.createdAt);
        const dStr = realDateKey || `d_${idx}`;
        const key = h.batchId ? `b_${h.batchId}` : (h.id ? `id_${h.id}` : `cat_${dStr}_${score}`);
        if (seenSimKeys.has(key)) return;
        seenSimKeys.add(key);
        if (Array.isArray(h.batchIds)) {
            h.batchIds.forEach(bid => {
                if (bid) seenSimKeys.add(`b_${bid}`);
            });
        }
        if (realDateKey) {
            source1DateScores.add(`${realDateKey}_${Math.round(score * 10)}`);
            source1Dates.add(realDateKey);
        }
        catSims.push({
            ...h,
            id: h.id || key,
            date: h.date || h.createdAt,
            categoryId: safeCategory.id,
            subject: catName,
            score
        });
    });
    source1DateScores.forEach(k => seenDateScoreBySource.add(k));
    source1Dates.forEach(d => seenDatesBySource.add(d));

    // 2. Simulados da lista passada (e safeOptions.allSimulados), deduplicando entre fontes
    const addFromSimList = (list) => {
        const stageDateScores = new Set();
        const stageDates = new Set();
        safeArray(list).forEach(s => {
            if (!s || s.valid === false) return;
            const matches = (safeCategory.id && s.categoryId && String(s.categoryId) === String(safeCategory.id)) ||
                (catName && isSubjectMatch(s.subject || s.categoryName || s.materia || s.disciplina || '', catName));
            if (!matches) return;
            const score = getSafeScore(s, maxScore, minScore);
            if (!Number.isFinite(score)) return;
            const realDateKey = getDateKey(s.date || s.createdAt);
            const dStr = realDateKey || 'no-date';
            const key = s.batchId ? `b_${s.batchId}` : (s.id ? `id_${s.id}` : `sim_${dStr}_${score}`);
            if (seenSimKeys.has(key)) return;
            const dsKey = realDateKey ? `${realDateKey}_${Math.round(score * 10)}` : null;
            const isSyntheticLegacy = String(s.id || '').startsWith('legacy-');
            if (dsKey && seenDateScoreBySource.has(dsKey)) return;
            if (isSyntheticLegacy && realDateKey && seenDatesBySource.has(realDateKey)) return;
            seenSimKeys.add(key);
            if (dsKey) stageDateScores.add(dsKey);
            if (realDateKey) stageDates.add(realDateKey);
            catSims.push({
                ...s,
                id: s.id || key,
                date: s.date || s.createdAt,
                categoryId: safeCategory.id,
                subject: catName,
                score
            });
        });
        stageDateScores.forEach(k => seenDateScoreBySource.add(k));
        stageDates.forEach(d => seenDatesBySource.add(d));
    };
    addFromSimList(safeSimulados);
    addFromSimList(safeOptions.allSimulados);

    // 3. Linhas de simuladoRows (agrupadas por batchId ou data)
    const rawRows = safeArray(safeOptions.simuladoRows || safeOptions.history);
    const rowsForCat = rawRows.filter(r => r && r.valid !== false && (
        (safeCategory.id && r.categoryId && String(r.categoryId) === String(safeCategory.id)) ||
        (catName && isSubjectMatch(r.subject || r.categoryName || r.materia || r.disciplina || '', catName))
    ));
    if (rowsForCat.length > 0) {
        const grouped = {};
        rowsForCat.forEach(r => {
            const groupKey = r.batchId || getDateKey(r.date || r.createdAt) || r.id;
            const parsedExplicitScore = sanitizeNum(r.score ?? r.scorePoints ?? r.scorePct);
            const rowExplicit = Number.isFinite(parsedExplicitScore) ? getSafeScore(r, maxScore, minScore) : null;
            if (!grouped[groupKey]) {
                grouped[groupKey] = {
                    date: r.date || r.createdAt,
                    correct: 0,
                    total: 0,
                    batchId: r.batchId,
                    explicitScores: []
                };
            }
            const rTotal = Math.max(0, Number(r.total ?? r.questoes ?? r.totalQuestoes ?? r.questions) || 0);
            const rCorrect = rTotal > 0
                ? Math.min(rTotal, Math.max(0, Number(r.correct ?? r.acertos ?? r.correctCount) || 0))
                : 0;
            grouped[groupKey].correct += rCorrect;
            grouped[groupKey].total += rTotal;
            if (Number.isFinite(rowExplicit)) {
                grouped[groupKey].explicitScores.push(rowExplicit);
            }
        });

        Object.entries(grouped).forEach(([gKey, gData]) => {
            const key = gData.batchId ? `b_${gData.batchId}` : `row_${gKey}`;
            if (seenSimKeys.has(key)) return;
            const avgExplicit = gData.explicitScores.length > 0
                ? kahanSum(gData.explicitScores) / gData.explicitScores.length
                : null;
            const score = gData.total > 0
                ? minScore + (gData.correct / gData.total) * (maxScore - minScore)
                : (Number.isFinite(avgExplicit) ? avgExplicit : minScore);
            const realDateKey = getDateKey(gData.date);
            const dsKey = realDateKey ? `${realDateKey}_${Math.round(score * 10)}` : null;
            if (dsKey && seenDateScoreBySource.has(dsKey)) return;
            if (!gData.batchId && realDateKey && seenDatesBySource.has(realDateKey)) return;
            seenSimKeys.add(key);
            catSims.push({
                id: key,
                date: gData.date,
                categoryId: safeCategory.id,
                subject: catName,
                score,
                correct: gData.correct,
                total: gData.total,
                batchId: gData.batchId
            });
        });
    }

    const relevantAllPreSort = catSims.length > 0 ? catSims : (
        catName
            ? safeSimulados.filter(s => s && s.valid !== false && isSubjectMatch(s.subject || s.categoryName || s.materia || s.disciplina || "", catName))
            : safeSimulados.filter(s => s && s.valid !== false)
    );

    const relevantAll = relevantAllPreSort
        .sort((a, b) => {
            const timeA = (normalizeDate(a.date || a.createdAt) || new Date(0)).getTime();
            const timeB = (normalizeDate(b.date || b.createdAt) || new Date(0)).getTime();
            return timeB - timeA;
        });

    const rootActivityDate = relevantAll.length > 0
        ? (normalizeDate(relevantAll[relevantAll.length - 1].date || relevantAll[relevantAll.length - 1].createdAt) || normalizeDate(referenceDate) || referenceDate)
        : null;

    const relevantSimulados = relevantAll.length > 50 ? relevantAll.slice(0, 50) : relevantAll;
    const simuladosWithMaxScore = relevantSimulados;

    // Global baseline antes da média inicial, para âncora mais justa em categorias sem dados
    let globalBaselinePct = 50;
    const safeAllCats = safeArray(safeOptions.allCategories);
    const validCatNames = safeAllCats.map(c => c?.name).filter(Boolean);
    const validCatNorms = new Set(validCatNames.map(n => normalize(n)).filter(Boolean));
    const validCatIds = new Set(safeAllCats.map(c => c?.id != null ? String(c.id) : "").filter(Boolean));
    let allSimsForBaseline = (validCatNorms.size > 0 || validCatIds.size > 0)
        ? safeSimulados.filter(s => {
            if (!s || s.valid === false) return false;
            if (s.categoryId != null && validCatIds.has(String(s.categoryId))) return true;
            const rawSub = s.subject || s.categoryName || s.materia || s.disciplina || "";
            if (!rawSub) return false;
            return validCatNorms.has(normalize(rawSub)) || validCatNames.some(cn => isSubjectMatch(rawSub, cn));
        })
        : safeSimulados.filter(s => s && s.valid !== false);
    if (allSimsForBaseline.length === 0 && safeAllCats.length > 0) {
        allSimsForBaseline = safeAllCats.flatMap(c =>
            safeArray(c?.simuladoStats?.history)
                .filter(h => h && h.valid !== false)
                .map(h => ({
                    ...h,
                    categoryId: h?.categoryId ?? c?.id,
                    subject: h?.subject || h?.categoryName || c?.name || '',
                }))
        );
    }

    // FIX: normalizar cada score para [0,1] usando os limites da própria matéria (com fallback globalMaxScore/globalMinScore).
    const catMap = new Map();
    safeAllCats.forEach(c => {
        if (c?.name) catMap.set(normalize(c.name), c);
        if (c?.id) catMap.set(String(c.id), c);
    });

    const validGlobalRatios = allSimsForBaseline
        .map((s) => {
            const sSub = s?.subject || s?.categoryName || s?.materia || s?.disciplina;
            const sCat = (sSub && catMap.get(normalize(sSub))) ||
                (s?.categoryId != null && catMap.get(String(s.categoryId))) ||
                (sSub ? safeAllCats.find(c => c?.name && isSubjectMatch(sSub, c.name)) : null) ||
                null;
            const rawSMax = parseOptionalFinite(sCat?.maxScore) ?? parseOptionalFinite(s?.maxScore);
            const sMax = (rawSMax !== null && rawSMax > 0) ? rawSMax : globalMaxScore;
            const rawSMin = parseOptionalFinite(sCat?.minScore) ?? parseOptionalFinite(s?.minScore);
            const sMin = rawSMin !== null ? Math.min(rawSMin, sMax) : Math.min(globalMinScore, sMax);
            const sRange = Math.max(1e-9, sMax - sMin);

            const sTotal = s?.total ?? s?.questoes ?? s?.totalQuestoes ?? s?.questions;
            const sCorrect = s?.correct ?? s?.acertos ?? s?.correctCount;
            if (!s?.isPercentage && sCorrect != null && sTotal != null && Number(sTotal) > 0) {
                const c = sanitizeNum(sCorrect);
                const t = sanitizeNum(sTotal);
                if (Number.isFinite(c) && Number.isFinite(t) && t > 0) {
                    return Math.max(0, Math.min(1, c / t));
                }
            }

            const score = getSafeScore(s, sMax, sMin);
            if (!Number.isFinite(score)) return null;
            return Math.max(0, Math.min(1, (score - sMin) / sRange));
        })
        .filter((r) => r !== null);

    if (validGlobalRatios.length > 0) {
        const meanRatio = kahanSum(validGlobalRatios) / validGlobalRatios.length;
        globalBaselinePct = meanRatio * 100;
    }

    let averageScore = 0;

    if (relevantSimulados.length > 0) {
        const coachAdaptive = deriveCoachAdaptiveParams(simuladosToHistory(relevantSimulados, maxScore, minScore), maxScore, cfg, minScore);
        const today = normalizeDate(referenceDate) || referenceDate;
        const K = coachAdaptive.decayK;
        const PESO_MIN = coachAdaptive.minWeight;
        const DELTA = coachAdaptive.scoreClampDelta;

        const calculateExponentialScore = (dataset) => {
            let weightedSum = 0;
            let totalWeight = 0;
            dataset.forEach(s => {
                const sScore = getSafeScore(s, maxScore, minScore);
                if (!Number.isFinite(sScore)) return;
                const simDate = normalizeDate(s.date || s.createdAt) || new Date(0);
                const days = Math.max(0, getDaysDiff(today, simDate));
                let timeWeight = Math.exp(-K * days);
                if (timeWeight < PESO_MIN) timeWeight = PESO_MIN;
                const maxReasonableQuestions = 300; // ✅ FIX: limite sensato de questões em vez de maxScore * 2
                const rawTotal = Math.max(1, Number(s.total ?? s.questoes ?? s.totalQuestoes ?? s.questions) || getSyntheticTotal(maxScore));
                const volumeWeight = Math.sqrt(Math.min(rawTotal, maxReasonableQuestions));
                const peso = timeWeight * volumeWeight;
                weightedSum += sScore * peso;
                totalWeight += peso;
            });
            return totalWeight > 0 ? weightedSum / totalWeight : (minScore + (maxScore - minScore) / 2);
        };

        const mostRecentSimDate = relevantSimulados.length > 0
            ? (normalizeDate(relevantSimulados[0].date || relevantSimulados[0].createdAt) || new Date(0)).getTime()
            : referenceNow;

        const SESSION_GAP_MS = 60 * 60 * 1000;
        let pastSimulados = relevantSimulados.filter(s => {
            const sTime = (normalizeDate(s.date || s.createdAt) || new Date(0)).getTime();
            return sTime < (mostRecentSimDate - SESSION_GAP_MS);
        });

        if (pastSimulados.length === 0 && relevantSimulados.length > 1) {
            pastSimulados = relevantSimulados.slice(1);
        }

        const notaBruta = calculateExponentialScore(relevantSimulados);

        if (pastSimulados.length > 0) {
            const notaAnterior = calculateExponentialScore(pastSimulados);
            const diff = notaBruta - notaAnterior;
            let clampedDiff = diff;
            if (diff > DELTA) clampedDiff = DELTA;
            else if (diff < -DELTA) clampedDiff = -DELTA;

            // ✅ PATCH-09: Validar hoursSinceLastSim explicitamente
            const rawHoursSinceLastSim = (referenceNow - mostRecentSimDate) / (1000 * 60 * 60);
            const hoursSinceLastSim = Number.isFinite(rawHoursSinceLastSim)
                ? Math.max(0, rawHoursSinceLastSim)
                : Infinity; // ← força o caminho "notaBruta"

            if (hoursSinceLastSim < 24) {
                averageScore = notaAnterior + clampedDiff;
            } else {
                averageScore = notaBruta;
            }
        } else {
            averageScore = notaBruta;
        }
    } else {
        const mappedCurrentMean = mapGlobalToCategoryScale(safeOptions.globalMcStats?.currentMean);
        const globalAnchor = Number.isFinite(mappedCurrentMean)
            ? mappedCurrentMean
            : (globalBaselinePct !== 50
                ? minScore + (globalBaselinePct / 100) * domain
                : minScore + 0.5 * domain);
        averageScore = clamp(globalAnchor, minScore, maxScore);
    }

    let daysSinceLastStudy = 0;
    let recencyUnknown = true;
    let lastDate = normalizeDate(new Date(0)) || new Date(0);

    if (simuladosWithMaxScore.length > 0) {
        const simDate = normalizeDate(simuladosWithMaxScore[0].date || simuladosWithMaxScore[0].createdAt) || new Date(0);
        if (simDate > lastDate) lastDate = simDate;
    }

    const categoryStudyLogs = safeStudyLogs.filter(log => {
        if (!log) return false;
        const matchesId = categoryId && (log?.categoryId === categoryId || String(log?.categoryId) === String(categoryId));
        const matchesName = catName && isSubjectMatch(log?.subject || log?.categoryName || log?.materia || '', catName);
        const validTime = (normalizeDate(log.date || log.createdAt) || new Date(0)).getTime() > 0;
        return (matchesId || matchesName) && validTime;
    });

    const MIN_MINUTES_VALID_STUDY = 15;
    const validStudyLogs = categoryStudyLogs.filter(log => sanitizeMinutes(log.minutes ?? log.minutos ?? log.duration) >= MIN_MINUTES_VALID_STUDY);

    if (validStudyLogs.length > 0) {
        const sortedLogs = [...validStudyLogs].sort((a, b) =>
            (normalizeDate(b.date || b.createdAt) || new Date(0)).getTime() - (normalizeDate(a.date || a.createdAt) || new Date(0)).getTime()
        );
        const logDate = normalizeDate(sortedLogs[0].date || sortedLogs[0].createdAt) || new Date(0);
        if (logDate > lastDate) lastDate = logDate;
    }

    if (lastDate.getTime() > 0) {
        const today = normalizeDate(referenceDate) || referenceDate;
        daysSinceLastStudy = getDaysDiff(today, lastDate);
        recencyUnknown = false;
    }

    const allSortedDesc = [...simuladosWithMaxScore]
        .map(s => ({
            score: getSafeScore(s, maxScore, minScore),
            date: s.date || s.createdAt
        }))
        .filter(t => Number.isFinite(t.score))
        .sort((a, b) => {
            const timeA = (normalizeDate(a.date) || new Date(0)).getTime();
            const timeB = (normalizeDate(b.date) || new Date(0)).getTime();
            return timeB - timeA;
        });

    const trendHistory = allSortedDesc.slice(0, 10).reverse();
    const allChronologicalScores = allSortedDesc.slice().reverse().map(t => t.score);

    const lastNScores = trendHistory.map(t => t.score);
    const backtestWeights = deriveBacktestWeights(allChronologicalScores, maxScore, minScore);

    // ==================== LOTE 1: STATE-SPACE / KALMAN ====================
    let stateSpace = null;
    const useStateSpace = getCoachFeature(options, 'useStateSpace', false);
    if (useStateSpace && trendHistory.length >= 3) {
        try {
            stateSpace = kalmanAbilityTrend(trendHistory, {
                maxScore,
                minScore,
            });
        } catch (err) {
            console.warn('[CoachLogic] State-space/Kalman failed:', err);
            stateSpace = null;
        }
    }

    // Se autorizado, substitui a média exponencial pela habilidade latente do Kalman.
    if (
        stateSpace &&
        getCoachFeature(options, 'useStateSpaceAverage', false)
    ) {
        averageScore = clamp(stateSpace.ability, minScore, maxScore);
    }

    // Se autorizado, substitui a tendência simples pela tendência do Kalman.
    const rawTrend = stateSpace && getCoachFeature(options, 'useStateSpaceTrend', false)
        ? stateSpace.trendPerMonth
        : calculateSlope(trendHistory, maxScore, { minScore }) * 30;

    const limiteSuperior = maxScore - averageScore;
    const limiteInferior = minScore - averageScore;
    let trend = Math.max(limiteInferior, Math.min(limiteSuperior, rawTrend));

    // ✅ PATCH-27: Janela do MC configurável (padrão 10 para volatilidade de curto prazo)
    const MC_WINDOW = Number(cfg.MC_HISTORY_WINDOW) || 10;
    const mcHistory = simuladosToHistory(simuladosWithMaxScore.slice(0, MC_WINDOW), maxScore, minScore);

    const baseMssdVolatility = mcHistory.length >= 3
        ? calculateMSSD(mcHistory, maxScore, minScore)
        : computeRobustVolatilityForCoach(mcHistory, maxScore, minScore);

    // FIX-M04: integrar detecção de regime ao pipeline com histórico datado e estados reais.
    // Se desacelerando ou entrando em platô, reduzir tendência. Se instável, aumentar volatilidade.
    let regimeAdjustedVolatility = baseMssdVolatility;
    try {
        const regime = detectRegimeTransition(trendHistory, { maxScore, minScore, windowSize: Math.min(10, trendHistory.length) });
        if ((regime?.transitionRisk === 'deceleration' || regime?.transitionRisk === 'plateau_entry') && trend > 0) {
            trend *= 0.5; // Reduzir projeção de tendência
        }
        if (regime?.transitionRisk === 'chronic_instability' || regime?.currentState === 'unstable') {
            regimeAdjustedVolatility = baseMssdVolatility * 1.3; // Aumentar volatilidade efetiva
        }
    } catch (err) {
        console.warn('[CoachLogic] Regime detection failed:', err);
    }

    // ==================== LOTE 2: VOLATILIDADE DINÂMICA ====================
    let dynamicVolatility = null;
    let mssdVolatility = regimeAdjustedVolatility;

    if (
        getCoachFeature(options, 'useDynamicVolatility', false) &&
        mcHistory.length >= 3
    ) {
        try {
            dynamicVolatility = estimateDynamicVolatility(mcHistory, {
                maxScore,
                minScore,
                useGarch: getCoachFeature(options, 'useGarchVolatility', false),
                override: getCoachFeature(options, 'useDynamicVolatilityOverride', false),
            });

            if (dynamicVolatility && Number.isFinite(dynamicVolatility.volatility)) {
                const dynamicVol = clamp(dynamicVolatility.volatility, 0, domain);
                if (getCoachFeature(options, 'useDynamicVolatilityOverride', false)) {
                    mssdVolatility = dynamicVol;
                } else {
                    // Blend conservador: mantém parte do comportamento antigo.
                    mssdVolatility = clamp(
                        (dynamicVol * 0.65) + (regimeAdjustedVolatility * 0.35),
                        0,
                        domain
                    );
                }
            }
        } catch (err) {
            console.warn('[CoachLogic] Dynamic volatility failed:', err);
            dynamicVolatility = null;
            mssdVolatility = regimeAdjustedVolatility;
        }
    }

    const mcAdaptive = {
        ...deriveCoachAdaptiveParams(mcHistory, maxScore, cfg, minScore),
        calibrationBaseline: rollingCalibration.baseline,
        calibrationMaxPenalty: rollingCalibration.maxPenalty
    };

    const adaptiveSimCount = lastNScores.length <= 5
        ? Math.max(cfg.MC_SIMULATIONS, 1200)
        : cfg.MC_SIMULATIONS;

    const DISTANCE_THRESHOLD = 0.15 * domain;
    let effectiveMCTarget = targetScore;
    let effectiveMCDays = Number.isFinite(daysToExam)
        ? Math.max(0, Math.min(daysToExam, 90))
        : 90;

    if (targetScore - averageScore > DISTANCE_THRESHOLD) {
        effectiveMCTarget = averageScore + Math.max(mssdVolatility, domain * 0.05) + (domain * 0.02);
        effectiveMCTarget = Math.max(averageScore, Math.min(effectiveMCTarget, targetScore));
        if (Number.isFinite(daysToExam)) {
            const totalGap = Math.max(1, targetScore - averageScore);
            const proximalGap = effectiveMCTarget - averageScore;
            const gapRatio = clamp(proximalGap / totalGap, 0, 1);
            effectiveMCDays = daysToExam > 0
                ? Math.max(7, Math.min(daysToExam, Math.max(7, Math.floor(gapRatio * daysToExam))))
                : 0;
        } else {
            effectiveMCDays = 21;
        }
    }

    // ✅ FIX: Verificar se safeOptions.globalMcStats existe antes de acessar e mapear para a escala da categoria
    const globalProjectedMean = safeOptions.globalMcStats && Number.isFinite(safeOptions.globalMcStats.projectedMean)
        ? mapGlobalToCategoryScale(safeOptions.globalMcStats.projectedMean)
        : null;

    if (globalProjectedMean != null && globalProjectedMean < effectiveMCTarget && globalProjectedMean > averageScore) {
        const blend = 0.25;
        effectiveMCTarget = effectiveMCTarget * (1 - blend) + globalProjectedMean * blend;
    }

    const effectiveCfg = {
        ...cfg,
        MC_SIMULATIONS: adaptiveSimCount,
        MC_CALIBRATION_NEUTRAL_PCT: globalBaselinePct,
        nominalTargetScore: targetScore
    };

    const agilitySource = safeCategory.simuladoStats?.history?.length ? safeCategory.simuladoStats.history : simuladosWithMaxScore;
    const agilityData = computeAgilityMetrics(agilitySource || []) || {};
    const agilityPenalty = Number.isFinite(agilityData.agilityPenalty)
        ? agilityData.agilityPenalty
        : 0;
    const avgSeconds = Number.isFinite(agilityData?.avgSeconds)
        ? agilityData.avgSeconds
        : 0;

    const mcResult = runCoachMonteCarlo(
        simuladosWithMaxScore,
        effectiveMCTarget,
        effectiveCfg,
        categoryId,
        maxScore,
        mcAdaptive,
        effectiveMCDays,
        agilityPenalty,
        minScore
    );

    const baseMcProbability = mcResult?.probability ?? null;
    const mcHasData = mcResult != null;

    // ==================== LOTE 3: POSTERIOR PREDICTIVE MONTE CARLO ====================
    let posteriorMc = null;
    let finalMcResult = mcResult;
    let finalMcProbability = baseMcProbability;

    if (
        getCoachFeature(options, 'usePosteriorMonteCarlo', false) &&
        mcResult
    ) {
        try {
            const safeStateSpace = stateSpace ?? null;
            const safeDynamicVolatility = dynamicVolatility ?? null;
            const fallbackAbilitySd = Math.max(
                domain * 0.02,
                (Number.isFinite(mssdVolatility) ? mssdVolatility : domain * 0.05) /
                Math.sqrt(Math.max(2, (lastNScores || []).length))
            );
            const fallbackTrendPerDay = Number.isFinite(trend)
                ? trend / 30
                : 0;
            const fallbackTrendSd = Math.max(
                domain * 0.0015,
                Math.abs(fallbackTrendPerDay) * 0.35
            );
            const medianGapDays = safeDynamicVolatility?.medianGapDays ?? 7;
            const fallbackDailyVolatility = Number.isFinite(mssdVolatility)
                ? mssdVolatility / Math.sqrt(Math.max(1, medianGapDays))
                : domain * 0.02;

            const fallbackObservationSd = Number.isFinite(mssdVolatility)
                ? mssdVolatility / Math.SQRT2
                : domain * 0.05;
            const useStateSpaceAvg = Boolean(safeStateSpace && getCoachFeature(options, 'useStateSpaceAverage', false));
            const useStateSpaceTrd = Boolean(safeStateSpace && getCoachFeature(options, 'useStateSpaceTrend', false));
            const kalmanObsSd = Number.isFinite(safeStateSpace?.observationVariance)
                ? Math.sqrt(Math.max(0, safeStateSpace.observationVariance))
                : null;
            const dynamicObsSd = Number.isFinite(safeDynamicVolatility?.volatility)
                ? clamp(safeDynamicVolatility.volatility, 0, domain)
                : null;
            // Se Lote 2 (volatilidade dinâmica) estiver ativo junto com Kalman, refletir picos recentes na observação
            const resolvedObservationSd = kalmanObsSd !== null
                ? (dynamicObsSd !== null ? Math.max(kalmanObsSd, dynamicObsSd * 0.75) : kalmanObsSd)
                : (dynamicObsSd !== null ? dynamicObsSd / Math.SQRT2 : fallbackObservationSd);

            const posteriorInput = {
                ability: useStateSpaceAvg ? safeStateSpace.ability : averageScore,
                abilitySd: safeStateSpace?.abilitySd ?? fallbackAbilitySd,
                trendPerDay: useStateSpaceTrd
                    ? (Number.isFinite(trend) ? trend / 30 : safeStateSpace.trendPerDay)
                    : fallbackTrendPerDay,
                trendSd: safeStateSpace?.trendSd ?? fallbackTrendSd,
                abilityTrendCov: safeStateSpace?.abilityTrendCov ?? 0,
                observationSd: resolvedObservationSd,
                // Só informa ruído de processo do Kalman quando Lote 1 estiver ativo;
                // caso contrário, deixa posteriorPredictive usar dailyVolatility do Lote 2.
                ...(safeStateSpace && Number.isFinite(safeStateSpace?.processNoise?.ability)
                    ? { processAbilityVar: safeStateSpace.processNoise.ability }
                    : {}),
                ...(safeStateSpace && Number.isFinite(safeStateSpace?.processNoise?.trend)
                    ? { processTrendVar: safeStateSpace.processNoise.trend }
                    : {}),
                dailyVolatility: safeDynamicVolatility?.dailyVolatility ?? fallbackDailyVolatility,
                horizonDays: effectiveMCDays,
                targetScore: effectiveMCTarget,
                minScore,
                maxScore,
                sampleSize: (relevantSimulados || lastNScores || []).length,
                baseProbability: baseMcProbability,
            };

            const posteriorSimulations = Math.max(
                300,
                Math.min(
                    1500,
                    Math.round((adaptiveSimCount || cfg.MC_SIMULATIONS || 800) * 0.75)
                )
            );

            const posteriorSeed = simpleHash(
                [
                    categoryId || 'cat',
                    (relevantSimulados || lastNScores || []).length,
                    Math.round((Number.isFinite(averageScore) ? averageScore : 0) * 100),
                    Math.round((Number.isFinite(effectiveMCTarget) ? effectiveMCTarget : 0) * 100),
                    Math.round(Number.isFinite(effectiveMCDays) ? effectiveMCDays : 0),
                    Math.round((Number.isFinite(mssdVolatility) ? mssdVolatility : 0) * 100),
                    safeStateSpace ? 'ss1' : 'ss0',
                    safeDynamicVolatility ? 'dv1' : 'dv0',
                ].join('|')
            );

            posteriorMc = estimatePosteriorPredictive(posteriorInput, {
                simulations: posteriorSimulations,
                seed: posteriorSeed,
                blendWithBase: !getCoachFeature(
                    options,
                    'usePosteriorMonteCarloOverride',
                    false
                ),
            });

            if (posteriorMc && Number.isFinite(posteriorMc.probability)) {
                finalMcProbability = clamp(posteriorMc.probability, 0, 100);
                const posteriorConformal = conformalizedCalibrationInterval(
                    finalMcProbability / 100,
                    Array.isArray(mcResult?.predObsPairs) ? mcResult.predObsPairs : [],
                    0.1
                );
                finalMcResult = {
                    ...mcResult,
                    probability: finalMcProbability,
                    probabilityRaw: Number(
                        (posteriorMc.probabilityRaw ?? finalMcProbability).toFixed(4)
                    ),
                    conformalLow: Number((posteriorConformal.low * 100).toFixed(2)),
                    conformalHigh: Number((posteriorConformal.high * 100).toFixed(2)),
                    conformalQ: Number(posteriorConformal.qHat.toFixed(4)),
                    mean: Number.isFinite(posteriorMc.mean)
                        ? posteriorMc.mean
                        : mcResult.mean,
                    meanProjected: Number.isFinite(posteriorMc.mean)
                        ? posteriorMc.mean
                        : (mcResult.meanProjected ?? mcResult.mean),
                    ci95Low: Number.isFinite(posteriorMc.ciLow)
                        ? posteriorMc.ciLow
                        : mcResult.ci95Low,
                    ci95High: Number.isFinite(posteriorMc.ciHigh)
                        ? posteriorMc.ciHigh
                        : mcResult.ci95High,
                    volatility: Number.isFinite(safeDynamicVolatility?.volatility)
                        ? clamp(safeDynamicVolatility.volatility, 0, domain)
                        : mcResult.volatility,
                    posteriorPredictive: posteriorMc,
                    baseProbability: baseMcProbability,
                    explainability: {
                        ...(mcResult?.explainability || {}),
                        note: `Posterior MC ${Number(posteriorMc.probabilityRaw ?? finalMcProbability).toFixed(0)}% → final ${Number(finalMcProbability).toFixed(0)}% ` +
                            `(base ${baseMcProbability != null ? Number(baseMcProbability).toFixed(0) : 'n/d'}%; trust ${Math.round((posteriorMc.sampleTrust ?? 0) * 100)}%).`
                    }
                };
            }
        } catch (err) {
            console.warn('[CoachLogic] Posterior predictive Monte Carlo failed:', err);
            posteriorMc = null;
            finalMcResult = mcResult;
            finalMcProbability = baseMcProbability;
        }
    }

    return {
        cfg,
        safeCategory,
        categoryId,
        rollingCalibration,
        referenceDate,
        referenceNow,
        maxScore,
        minScore,
        targetScore,
        targetScoreLabel,
        rawWeight,
        boundedWeight,
        weight,
        weightLabel,
        daysToExam,
        relevantSimulados,
        simuladoCount: relevantSimulados.length,
        rootActivityDate,
        simuladosWithMaxScore,
        averageScore,
        stateSpace,
        daysSinceLastStudy,
        recencyUnknown,
        studyLogs: safeStudyLogs,
        categoryStudyLogs,
        validStudyLogs,
        trendHistory,
        lastNScores,
        backtestWeights,
        trend,
        mssdVolatility,
        baseMssdVolatility,
        dynamicVolatility,
        mcAdaptive,
        effectiveMCTarget,
        effectiveMCDays,
        globalBaselinePct,
        effectiveCfg,
        mcResult: finalMcResult,
        mcProbability: finalMcProbability,
        baseMcResult: mcResult,
        baseMcProbability: baseMcProbability,
        posteriorMc,
        mcHasData,
        globalProjectedMean,
        agilityPenalty,
        avgSeconds
    };
};

export function deriveUrgencyWeights(mcResult, volatility, sampleSize, cfg = {}, domain = 100) {
    // FIX-I02: mcResult.sampleSize pode ser undefined quando o MC falha
    // parcialmente. Verificar explicitamente antes de usar.
    const mcSampleSize = Number.isFinite(mcResult?.sampleSize) ? mcResult.sampleSize : null;
    const nEff = mcSampleSize ?? sampleSize ?? 5;
    const safeDomain = Number.isFinite(domain) && domain > 0 ? domain : 100;
    const volPct = (volatility || 0) / safeDomain;
    const mcTrust = Math.min(1, nEff / 15);
    const volWeight = Math.min(1, volPct / 0.15);

    const baseScoreMax = cfg.SCORE_MAX ?? 45;
    // FIX-PARAM: RECENCY_MAX reduzido de 28 para 22.
    // Com crunch e multiplicadores, o recency efetivo podia chegar a ~88 pts,
    // dominando o score. 22 mantém influência sem dominar.
    const baseRecencyMax = cfg.RECENCY_MAX ?? 22;
    const baseInstabilityMax = cfg.INSTABILITY_MAX ?? 22;

    return {
        scoreMax: baseScoreMax * (0.7 + 0.3 * mcTrust),
        recencyMax: baseRecencyMax * (1.1 - 0.1 * mcTrust),
        instabilityMax: baseInstabilityMax * (0.8 + 0.4 * volWeight),
        mcBoostMax: 25 * mcTrust
    };
}

export const calculateUrgencyScore = (metrics = {}, options = {}) => {
    const rawCfg = metrics.cfg || options.config || {};
    const cfg = { ...DEFAULT_CONFIG, ...rawCfg };
    const {
        safeCategory,
        boundedWeight,
        daysToExam,
        rootActivityDate,
        simuladosWithMaxScore,
        averageScore,
        daysSinceLastStudy,
        recencyUnknown,
        studyLogs,
        categoryStudyLogs,
        validStudyLogs,
        lastNScores,
        backtestWeights,
        trend,
        mssdVolatility,
        mcProbability,
        mcHasData,
        mcResult,
        maxScore,
        globalProjectedMean
    } = metrics;
    const minScore = metrics.minScore ?? 0;
    const domain = Math.max(1e-6, maxScore - minScore);
    const targetScore = metrics.targetScore ?? (minScore + domain * 0.8);
    const hasData = (simuladosWithMaxScore?.length || 0) > 0 || (categoryStudyLogs?.length || 0) > 0;
    // FIX: agilidade não entra mais no forgetting risk
    const forgetting = computeForgettingRisk(
        simuladosWithMaxScore,
        maxScore,
        averageScore,
        mssdVolatility,
        backtestWeights?.effectiveN || (simuladosWithMaxScore?.length || 0),
        recencyUnknown ? null : daysSinceLastStudy,
        0,
        minScore
    );
    const performanceDeficit = Math.max(0, targetScore - averageScore);
    const rawGapRange = targetScore - minScore;
    const gapRatio = rawGapRange <= 0 ? 0 : clamp(performanceDeficit / rawGapRange, 0, 1);
    // ✅ FIX: Adicionar validação de retention
    const safeRetention = Number.isFinite(forgetting.retentionPct)
        ? forgetting.retentionPct
        : 100;
    // FIX-I01: floor 0 quando estudou hoje (daysSinceLastStudy === 0).
    // Antes, retenção=100% ainda gerava memoryRisk=2, inflando recency.
    const rawMemoryRisk = 35 * Math.pow(1 - safeRetention / 100, 1.5);
    const memoryFloor = (!recencyUnknown && daysSinceLastStudy <= 1) ? 0 : 2;
    const memoryRisk = !hasData
        ? 8
        : clamp(rawMemoryRisk, memoryFloor, 35);
    const safeMssdVolatility = Number.isFinite(mssdVolatility)
        ? mssdVolatility
        : 0;
    const volatilityRiskPct = clamp((safeMssdVolatility / domain) * 100, 0, 35);
    const weightMultiplier = 1 + ((boundedWeight - 5) / 5) * 0.40;
    const crunchMultiplier = getCrunchMultiplier(
        daysToExam,
        rootActivityDate,
        metrics.referenceDate
    );
    const safeTasksArray = Array.isArray(safeCategory?.tasks)
        ? safeCategory.tasks
        : Object.values(safeCategory?.tasks || {});
    const hasHighPriorityTasks = typeof options?.hasHighPriorityTasks === 'boolean'
        ? options.hasHighPriorityTasks
        : (metrics.hasHighPriorityTasks !== undefined
            ? Boolean(metrics.hasHighPriorityTasks)
            : safeTasksArray.some(t => t && !t.completed && normalizePriority(t.priority) === 'high'));
    const priorityBoost = hasHighPriorityTasks ? cfg.PRIORITY_BOOST : 0;
    const totalTasks = safeTasksArray.length;
    const completedTasks = safeTasksArray.filter(t => t?.completed).length;
    const completionRate = totalTasks > 0 ? completedTasks / totalTasks : 1.0;
    const inefficiency = Math.max(0, 1 - completionRate);
    // FIX-C05: empiricalTrust calculado SEMPRE, não apenas quando !hasData.
    // Antes, categorias com dados tinham trust=1.0 fixo, ignorando a
    // confiança real nos dados (n, volatilidade, tendência).
    const globalSignal = computeAdaptiveCoachWeight(metrics.trendHistory || [], maxScore, minScore);
    const empiricalTrust = hasData
        ? Math.max(0.2, globalSignal?.confidenceWeight ?? 0.5)
        : Math.max(0.2, globalSignal?.confidenceWeight ?? 0.2);
    const inefficiencyPenaltyMultiplier = totalTasks >= 5
        ? 1 + (inefficiency * 0.15 * empiricalTrust)
        : 1.0;

    const urgencyWeights = deriveUrgencyWeights(
        mcResult,
        safeMssdVolatility,
        (simuladosWithMaxScore || []).length,
        cfg,
        domain
    );

    // SCORE: agora mede distância até a meta com peso adaptativo e calibração de backtest
    const scoreRaw = gapRatio * urgencyWeights.scoreMax * (backtestWeights?.scoreWeight ?? 1);
    const scoreComponent = clamp(scoreRaw, 0, urgencyWeights.scoreMax * 1.15);
    // RECENCY: recência desconhecida não é mais máxima, peso adaptativo por confiança MC
    const effectiveRiskDays = recencyUnknown ? 5 : Math.min(daysSinceLastStudy, 45);
    const recencyFactor = 1 - Math.exp(-effectiveRiskDays / 8);
    // FIX-PARAM: limitar o efeito do crunch no recency a 1.5×.
    // Antes, crunch=2.0 (reta final) podia gerar recencyRaw > 88 pts,
    // dominando completamente o score (38.7% do total).
    const effectiveCrunchForRecency = Math.min(crunchMultiplier, 1.5);
    const recencyRaw =
        urgencyWeights.recencyMax *
        (memoryRisk / 35) *
        recencyFactor *
        effectiveCrunchForRecency *
        (backtestWeights?.recencyWeight ?? 1) *
        inefficiencyPenaltyMultiplier;
    const recencyComponent = clamp(recencyRaw, 0, urgencyWeights.recencyMax * 1.2);
    // INSTABILITY: baseada em % do domínio, filtro de ruído e peso adaptativo
    const lastNCount = Math.max(2, (lastNScores || []).length || 2);
    const trendNoise = 0.75 * (safeMssdVolatility / Math.sqrt(lastNCount));
    const trendThreshold = Math.max(getDynamicTrendThreshold(averageScore, maxScore, minScore), trendNoise);
    let trendModifier = 1;
    if (trend > trendThreshold) {
        trendModifier = 0.55;
    } else if (trend < -trendThreshold) {
        trendModifier = 1.25;
    }
    const instabilityRaw =
        urgencyWeights.instabilityMax *
        Math.min(1, volatilityRiskPct / 35) *
        trendModifier *
        (backtestWeights?.instabilityWeight ?? 1);
    const instabilityComponent = clamp(instabilityRaw, 0, urgencyWeights.instabilityMax);
    // MC BOOST
    let mcUrgencyBoost = 0;
    let mcRiskLabel = null;
    const adaptiveRisk = deriveAdaptiveRiskThresholds(
        lastNScores,
        mssdVolatility,
        cfg,
        maxScore,
        mcResult?.predObsPairs || [],
        minScore
    );
    if (globalProjectedMean != null && globalProjectedMean > (averageScore + domain * 0.1)) {
        const diffPct = ((globalProjectedMean - averageScore) / domain) * 100;
        const haloBoost = Math.min(6, diffPct * 0.2);
        adaptiveRisk.danger = Math.min(99, adaptiveRisk.danger + haloBoost);
        adaptiveRisk.safe = Math.min(99, adaptiveRisk.safe + haloBoost);
        if (adaptiveRisk.safe - adaptiveRisk.danger < 25) {
            adaptiveRisk.safe = Math.min(99, adaptiveRisk.danger + 25);
        }
    }
    if (mcHasData && mcProbability !== null) {
        const continuous = computeContinuousMcBoost(
            mcProbability,
            adaptiveRisk.danger,
            adaptiveRisk.safe,
            mssdVolatility,
            maxScore,
            cfg,
            minScore
        );
        mcUrgencyBoost = continuous.boost;
        mcRiskLabel = continuous.riskLabel;
        const globalProbability = options.globalMcStats && Number.isFinite(options.globalMcStats.probability)
            ? options.globalMcStats.probability
            : null;
        if (globalProbability != null && globalProbability < (mcProbability * 0.8)) {
            mcUrgencyBoost += 4;
            mcRiskLabel = mcRiskLabel || 'elevated_global_risk';
        }
    }
    const effectiveMcBoostMax = Number.isFinite(urgencyWeights.mcBoostMax) && urgencyWeights.mcBoostMax > 0
        ? Math.max(12, Math.min(25, urgencyWeights.mcBoostMax))
        : 25;
    const mcUrgencyBoostClamped = clamp(
        mcUrgencyBoost,
        cfg.MC_BOOST_SAFE_PENALTY ?? -10,
        effectiveMcBoostMax
    );
    // Burnout / hours
    const getLogMinutes = (log) => sanitizeMinutes(log?.minutes ?? log?.minutos ?? log?.duration);
    const getLogDate = (log) => normalizeDate(log?.date || log?.createdAt) || new Date(0);
    const totalMinutes = (categoryStudyLogs || []).reduce((acc, log) => acc + getLogMinutes(log), 0);
    const totalHours = totalMinutes / 60;
    const sortedLogsForBurnout = [...(categoryStudyLogs || [])].sort((a, b) =>
        getLogDate(a).getTime() - getLogDate(b).getTime()
    );
    const rollingWindowMs = 28 * MS_PER_DAY;
    // ✅ FIX: Verificar se metrics.referenceNow existe antes de usar
    const nowMs = Number.isFinite(metrics.referenceNow) ? metrics.referenceNow : Date.now();
    const recentBaselineLogs = sortedLogsForBurnout.filter(log => {
        const diff = nowMs - getLogDate(log).getTime();
        return diff >= -MS_PER_DAY && diff <= rollingWindowMs;
    });
    // Separa semanas anteriores (dias 7..28) da semana atual (dias 0..7) para evitar que
    // baselineHoursPerWeek === recentHours torne recentHours > baselineHoursPerWeek * 1.8 impossível.
    const priorBaselineLogs = recentBaselineLogs.filter(log => {
        const diff = nowMs - getLogDate(log).getTime();
        return diff > 7 * MS_PER_DAY;
    });
    const recentBaselineHours = recentBaselineLogs.reduce((acc, log) => acc + getLogMinutes(log), 0) / 60;
    const priorBaselineHours = priorBaselineLogs.reduce((acc, log) => acc + getLogMinutes(log), 0) / 60;
    const firstLogTime = sortedLogsForBurnout.length > 0
        ? getLogDate(sortedLogsForBurnout[0]).getTime()
        : nowMs;
    const recentSpanDays = recentBaselineLogs.length > 0
        ? Math.max(1, (nowMs - getLogDate(recentBaselineLogs[0]).getTime()) / MS_PER_DAY)
        : Math.max(1, (nowMs - firstLogTime) / MS_PER_DAY);
    const activeWeeks = Math.max(1, Math.min(4, recentSpanDays / 7));
    const priorSpanDays = priorBaselineLogs.length > 0
        ? Math.max(7, (nowMs - 7 * MS_PER_DAY - getLogDate(priorBaselineLogs[0]).getTime()) / MS_PER_DAY)
        : 7;
    const activePriorWeeks = Math.max(1, Math.min(3, priorSpanDays / 7));
    const baselineHoursPerWeek = priorBaselineLogs.length > 0
        ? (priorBaselineHours / activePriorWeeks)
        : (recentBaselineLogs.length > 0 ? Math.min(8.33, recentBaselineHours / activeWeeks) : 5.0);
    const dynamicBurnoutThreshold = Math.max(15.0, baselineHoursPerWeek * 1.8);
    // Balance bridge boost
    const allCategoriesSafe = safeArray(options.allCategories);
    const activeCount = allCategoriesSafe.length > 0 ? allCategoriesSafe.length : 1;
    // ✅ PATCH-11 & 29: Validação explícita de decayK
    const rawLambda = metrics.mcAdaptive?.decayK;
    const currentLambda = (Number.isFinite(rawLambda) && rawLambda > 1e-6) ? rawLambda : 0.03;
    const dynamicWindowDays = Math.max(7, Math.min(90, Math.round((Math.LN2 / currentLambda) * 2)));
    const windowStart = (normalizeDate(metrics.referenceDate) || new Date()).getTime() - (dynamicWindowDays * MS_PER_DAY);
    const safeGlobalLogsInput = options.studyLogs || studyLogs || [];
    const safeGlobalLogs = Array.isArray(safeGlobalLogsInput)
        ? safeGlobalLogsInput
        : Object.values(safeGlobalLogsInput || {});
    const recentAllLogs = safeGlobalLogs.filter(log => {
        const t = getLogDate(log).getTime();
        return t >= windowStart && (nowMs - t) >= -MS_PER_DAY;
    });
    const catNameForMatch = safeCategory?.name || safeCategory?.id || '';
    const totalRecentMinutesAll = recentAllLogs.reduce((acc, log) => acc + getLogMinutes(log), 0);
    const totalRecentMinutesCat = recentAllLogs
        .filter(log => {
            if (!log) return false;
            const matchesId = metrics.categoryId !== undefined && metrics.categoryId !== null && log?.categoryId !== undefined && log?.categoryId !== null && (
                log.categoryId === metrics.categoryId || String(log.categoryId) === String(metrics.categoryId)
            );
            const matchesName = Boolean(catNameForMatch) && isSubjectMatch(log?.subject || log?.categoryName || log?.materia || '', catNameForMatch);
            return matchesId || matchesName;
        })
        .reduce((acc, log) => acc + getLogMinutes(log), 0);
    const observedShare = totalRecentMinutesAll > 0
        ? totalRecentMinutesCat / totalRecentMinutesAll
        : (1 / activeCount);
    // Usa pesos brutos positivos reais para idealShare (evita clamp [1..10] que distorcia editais com pesos 10..50)
    const totalSyllabusWeight = allCategoriesSafe.reduce((acc, c) => {
        if (!c) return acc;
        let rawW = c.weight;
        if (typeof rawW === 'string') {
            const trimmedW = rawW.trim();
            if (trimmedW.includes(',')) {
                rawW = trimmedW.replace(/\./g, '').replace(',', '.');
            } else if (/^[1-9]\d{0,2}(\.\d{3}){2,}$/.test(trimmedW)) {
                rawW = trimmedW.replace(/\./g, '');
            } else {
                rawW = trimmedW;
            }
        }
        const parsedW = Number(rawW);
        const w = (c.weight !== undefined && Number.isFinite(parsedW) && parsedW > 0) ? parsedW : 5;
        return acc + w;
    }, 0);
    const rawCatWeight = Number.isFinite(Number(metrics.rawWeight)) && Number(metrics.rawWeight) > 0
        ? Number(metrics.rawWeight)
        : (Number.isFinite(Number(metrics.boundedWeight)) && Number(metrics.boundedWeight) > 0
            ? Number(metrics.boundedWeight)
            : (Number.isFinite(Number(metrics.weight)) && Number(metrics.weight) > 0 ? Number(metrics.weight) : 5));
    const safeRawWeight = Math.max(1e-6, rawCatWeight);
    const idealShare = totalSyllabusWeight > 0
        ? safeRawWeight / totalSyllabusWeight
        : (1 / activeCount);
    // FIX-C04: tolerance relativa (30% do ideal ou 5%, o que for menor).
    // Antes, tolerance=0.05 fixo impedia boost para idealShare < 0.05
    // (ex: 15 matérias com pesos iguais → idealShare ≈ 0.067).
    const tolerance = Math.min(0.05, idealShare * 0.3);
    const underAllocation = Math.max(0, idealShare - observedShare - tolerance);
    const balanceBridgeBoost = clamp(
        Math.min(cfg.EFFICIENCY_MAX, underAllocation > 0.001 ? Math.pow(underAllocation * 10, 1.5) : 0),
        0,
        cfg.EFFICIENCY_MAX
    );
    // SRS
    let srsBoost = 0;
    let srsLabel = null;
    if (hasData && !recencyUnknown) {
        const srsData = _getSRSBoost(
            simuladosWithMaxScore,
            daysSinceLastStudy,
            maxScore,
            cfg,
            mssdVolatility,
            backtestWeights?.effectiveN || (simuladosWithMaxScore?.length || 0),
            minScore,
            options
        );
        srsBoost = srsData.boost;
        srsLabel = srsData.label;
    }
    const maxSrsBoost = cfg.SRS_BOOST * 2 * 1.10;
    const currentSrsBoost = clamp(
        srsBoost * (crunchMultiplier > 1.3 ? 1.10 : 1),
        0,
        maxSrsBoost
    );
    const maxPriorityBoost = cfg.PRIORITY_BOOST * 1.15;
    const currentPriorityBoost = clamp(
        priorityBoost * (crunchMultiplier > 1.3 ? 1.15 : 1),
        0,
        maxPriorityBoost
    );
    // Rotation penalty corrigida: menos dependente da nota e mais dependente de recência/volatilidade
    let exactLastTime = 0;
    if (Array.isArray(simuladosWithMaxScore) && simuladosWithMaxScore.length > 0) {
        for (const s of simuladosWithMaxScore) {
            const t = (normalizeDate(s?.date || s?.createdAt) || new Date(0)).getTime();
            if (t > exactLastTime) exactLastTime = t;
        }
    }
    if (Array.isArray(validStudyLogs) && validStudyLogs.length > 0) {
        const logsOrdenados = [...validStudyLogs].sort((a, b) =>
            getLogDate(b).getTime() - getLogDate(a).getTime()
        );
        const logTime = getLogDate(logsOrdenados[0]).getTime();
        if (logTime > exactLastTime) exactLastTime = logTime;
    }
    // FIX: clamp em >= 0 porque datas sem hora ('YYYY-MM-DD') são normalizadas para 12:00 local,
    // evitando exactHoursSinceLast negativo entre 00:00 e 12:00 que dobrava rotationPenalty para 30.
    const exactHoursSinceLast = exactLastTime > 0
        ? Math.max(0, (nowMs - exactLastTime) / (1000 * 60 * 60))
        : 48;
    let rotationPenalty = 0;
    // FIX: Removido fatigueRatio baseado em performance.
    // Notas altas já recebem urgência menor via SCORE_MAX (gap da meta).
    // FIX-C03: volatilidade removida da rotation penalty.
    // A volatilidade já é penalizada no instabilityComponent.
    // Manter aqui causava dupla contagem (~39 pts para σ=15%).
    if (exactHoursSinceLast <= 24) {
        const recentFatigue = Math.max(0.2, Math.exp(-exactHoursSinceLast / 12));
        rotationPenalty = Math.min(30, 15 * recentFatigue);
        rotationPenalty = Math.max(rotationPenalty, 3);
    } else if (exactHoursSinceLast > 24 && exactHoursSinceLast < 48 && !srsLabel) {
        rotationPenalty = 2;
    }
    if (srsBoost > 0) rotationPenalty *= 0.1;
    const rawScore = Math.max(
        0,
        scoreComponent +
        recencyComponent +
        instabilityComponent +
        currentPriorityBoost +
        currentSrsBoost +
        mcUrgencyBoostClamped +
        balanceBridgeBoost -
        rotationPenalty
    );
    const weightedRaw = rawScore * weightMultiplier;
    const NORMALIZATION_CEILING = cfg.NORMALIZATION_CEILING || 170;
    const CRITICAL_THRESHOLD = cfg.CRITICAL_THRESHOLD || Math.round(NORMALIZATION_CEILING * 0.72);
    let normalized;
    if (weightedRaw <= 0) {
        normalized = 0;
    } else if (weightedRaw <= CRITICAL_THRESHOLD) {
        normalized = (weightedRaw / CRITICAL_THRESHOLD) * 80;
    } else {
        const excess = weightedRaw - CRITICAL_THRESHOLD;
        const excessNormalized = 20 * (1 - Math.exp(-excess / (NORMALIZATION_CEILING * 0.4)));
        normalized = 80 + excessNormalized;
    }
    normalized = Number.isFinite(normalized) ? clamp(Math.round(normalized), 0, 100) : 0;
    return {
        weightedRaw,
        normalized,
        scoreComponent,
        recencyComponent,
        instabilityComponent,
        priorityBoost: currentPriorityBoost,
        srsBoost: currentSrsBoost,
        mcUrgencyBoost: mcUrgencyBoostClamped,
        balanceBridgeBoost,
        rotationPenalty,
        weightMultiplier,
        crunchMultiplier,
        forgetting,
        performanceDeficit,
        memoryRisk,
        volatilityRisk: volatilityRiskPct,
        totalPain: (domain > 0 ? clamp((performanceDeficit / domain) * 35, 0, 35) : 0) + memoryRisk + volatilityRiskPct,
        dynamicScoreMax: urgencyWeights.scoreMax,
        dynamicRecencyMax: urgencyWeights.recencyMax,
        dynamicInstabilityMax: urgencyWeights.instabilityMax,
        completionRate,
        inefficiencyPenaltyMultiplier,
        totalHours,
        baselineHoursPerWeek,
        dynamicBurnoutThreshold,
        observedShare,
        idealShare,
        srsLabel,
        exactHoursSinceLast,
        adaptiveRisk,
        mcRiskLabel,
        hasHighPriorityTasks,
        trendThreshold
    };
};

export const generateCoachStrings = (weightedRaw, normalized, metrics, scoreInfo, options = {}) => {
    const {
        cfg,
        maxScore,
        targetScore,
        weight,
        weightLabel,
        relevantSimulados,
        averageScore,
        daysSinceLastStudy,
        recencyUnknown,
        categoryStudyLogs,
        trend,
        mssdVolatility,
        effectiveMCTarget,
        effectiveMCDays,
        mcResult,
        mcProbability,
        mcHasData,
        globalProjectedMean,
        agilityPenalty
    } = metrics;
    const minScore = metrics.minScore ?? options.minScore ?? 0;
    const domain = Math.max(1e-6, (maxScore || options.maxScore || 100) - minScore);
    // FIX: globalProjectedMean está em PONTOS da prova — normalizar para
    // a escala 0–100 antes de formatar como %. Provas com maxScore ≠ 100
    // exibiam "Contexto Global MC: 742%".
    const globalProjectedPct = globalProjectedMean != null
        ? ((globalProjectedMean - minScore) / domain) * 100
        : null;
    const {
        scoreComponent,
        recencyComponent,
        instabilityComponent,
        priorityBoost,
        srsBoost,
        mcUrgencyBoost,
        balanceBridgeBoost,
        rotationPenalty,
        weightMultiplier,
        crunchMultiplier,
        totalHours,
        baselineHoursPerWeek,
        dynamicBurnoutThreshold,
        srsLabel,
        adaptiveRisk,
        mcRiskLabel,
        hasHighPriorityTasks,
        completionRate,
        trendThreshold: scoreInfoTrendThreshold
    } = scoreInfo;
    let recommendation = "";
    const oneWeekAgo = (normalizeDate(metrics.referenceDate) || new Date()).getTime() - (7 * 24 * 60 * 60 * 1000);
    const recentLogs = categoryStudyLogs.filter(log => {
        const d = normalizeDate(log?.date || log?.createdAt) || new Date(0);
        return d && d.getTime() >= oneWeekAgo;
    });
    const recentHours = recentLogs.reduce((acc, log) => acc + sanitizeMinutes(log?.minutes ?? log?.minutos ?? log?.duration), 0) / 60;
    // FIX: contar dias reais, não timestamps únicos
    const refTime = (normalizeDate(metrics.referenceDate) || new Date()).getTime();
    const recentStudyDays = new Set(
        recentLogs
            .filter(log => {
                const t = (normalizeDate(log?.date || log?.createdAt) || new Date(0)).getTime();
                return t > 0 && (refTime - t) <= 7 * 24 * 60 * 60 * 1000;
            })
            .map(log => getDateKey(log?.date || log?.createdAt)).filter(Boolean)
    ).size;
    const isHighVolume = recentHours > dynamicBurnoutThreshold;
    // FIX: threshold de frequência deve ser proporcional ao período analisado.
    // Antes: >= 5 era fixo mesmo para janelas de 3 dias (impossível de atingir).
    const analysisWindowDays = 7;
    const isHighFrequency = recentStudyDays >= Math.min(5, analysisWindowDays - 1);
    const isEliteMaintenance = averageScore >= (minScore + domain * 0.95);
    const trendThreshold = Number.isFinite(scoreInfoTrendThreshold)
        ? scoreInfoTrendThreshold
        : getDynamicTrendThreshold(averageScore, maxScore, minScore);
    const lastNScores = metrics.lastNScores;
    const isStagnant = !isEliteMaintenance && trend <= trendThreshold && lastNScores.length >= 2;
    const burnoutMsg = isHighVolume && isStagnant
        ? `Você estudou ${recentHours.toFixed(1)}h esta semana (seu normal é ~${baselineHoursPerWeek.toFixed(1)}h), mas a nota estagnou.`
        : '';
    const isBurnoutRisk = (isHighVolume || (isHighFrequency && recentHours > 5.0)) && isStagnant && recentStudyDays >= 3;
    // Ordem corrigida: crítico > burnout > SRS > cruzeiro seguro
    if (mcHasData && mcRiskLabel === 'critical') {
        const burnoutNote = isBurnoutRisk ? ` (⚠️ ${burnoutMsg || 'Sinais de estafa — mude o método.'})` : '';
        const targetInfo = effectiveMCTarget < targetScore ? ` (Meta ZDP: ${formatValue(effectiveMCTarget)})` : '';
        const globalNote = globalProjectedPct != null ? ` [Global: ${formatPercent(globalProjectedPct)}]` : '';
        recommendation = `🎯 Projeção Crítica: ${Math.round(mcProbability)}% de chance. Risco Crítico.${targetInfo}${globalNote}${burnoutNote}`;
    } else if (isBurnoutRisk) {
        recommendation = `🛑 Risco de Estafa: ${burnoutMsg || 'Você estudou muito mas a nota não reagiu.'} Considere descansar.`;
    } else if (srsBoost > 0) {
        recommendation = `${srsLabel} - Não pule essa revisão!`;
    } else if (mcHasData && mcRiskLabel === 'safe') {
        recommendation = `🏆 Cruzeiro Seguro (${formatPercent(mcProbability)} nas projeções). Modo de manutenção ativado.`;
    } else if (mssdVolatility > cfg.MC_VOLATILITY_HIGH * (domain / 100) && trend > 0) {
        recommendation = "Desempenho Oscilante: Foque em preencher lacunas de base";
    } else if (trend < -trendThreshold) {
        recommendation = normalized > 50
            ? `Nota caindo (${formatValue(trend)} pts) - Atenção urgente`
            : `Queda recente (${formatValue(trend)} pts) - Atenção preventiva recomendada`;
    } else if (averageScore < targetScore - (0.2 * domain)) {
        recommendation = `Nota Crítica: ${formatPercent(((averageScore - minScore) / domain) * 100)} (Meta ${formatPercent(((targetScore - minScore) / domain) * 100)})`;
    } else if (averageScore >= targetScore) {
        recommendation = "No caminho certo! Continue consolidando";
    } else {
        recommendation = "Pratique com regularidade";
    }
    const hasData = relevantSimulados.length > 0 || categoryStudyLogs.length > 0;
    const result = {
        score: weightedRaw,
        normalizedScore: normalized,
        recommendation,
        details: {
            categoryId: metrics.categoryId || metrics.safeCategory?.id || null,
            averageScore: safeFixedNumber(averageScore),
            globalProjectedMean: globalProjectedMean != null ? safeFixedNumber(globalProjectedMean, 1) : null,
            daysSinceLastStudy,
            recencyUnknown: Boolean(recencyUnknown),
            standardDeviation: safeFixedNumber(mssdVolatility),
            mssdVolatility: safeFixedNumber(mssdVolatility),
            posteriorMonteCarlo: metrics.posteriorMc
                ? {
                    model: metrics.posteriorMc.model || null,
                    probability: safeFixedNumber(metrics.posteriorMc.probability),
                    probabilityRaw: safeFixedNumber(metrics.posteriorMc.probabilityRaw),
                    mean: safeFixedNumber(metrics.posteriorMc.mean),
                    ciLow: safeFixedNumber(metrics.posteriorMc.ciLow),
                    ciHigh: safeFixedNumber(metrics.posteriorMc.ciHigh),
                    horizonDays: safeFixedNumber(metrics.posteriorMc.horizonDays),
                    simulations: metrics.posteriorMc.simulations ?? null,
                    sampleTrust: safeFixedNumber(metrics.posteriorMc.sampleTrust, 4),
                    diagnostics: metrics.posteriorMc.diagnostics || null,
                    inputs: metrics.posteriorMc.inputs || null,
                }
                : null,
            dynamicVolatility: metrics.dynamicVolatility && Number.isFinite(metrics.dynamicVolatility.volatility)
                ? {
                    model: metrics.dynamicVolatility.model || null,
                    volatility: safeFixedNumber(metrics.dynamicVolatility.volatility),
                    modelVolatility: safeFixedNumber(metrics.dynamicVolatility.modelVolatility),
                    fallbackVolatility: safeFixedNumber(metrics.dynamicVolatility.fallbackVolatility),
                    dailyVolatility: safeFixedNumber(metrics.dynamicVolatility.dailyVolatility),
                    horizonDays: safeFixedNumber(metrics.dynamicVolatility.horizonDays),
                    medianGapDays: safeFixedNumber(metrics.dynamicVolatility.medianGapDays),
                    sampleSize: metrics.dynamicVolatility.sampleSize ?? null,
                    parameters: metrics.dynamicVolatility.parameters || null
                }
                : null,
            trend: safeFixedNumber(trend),
            totalHours: safeFixedNumber(totalHours),
            hasData,
            hasSimulados: relevantSimulados.length > 0,
            hasHighPriorityTasks,
            completionRate: safeFixedNumber(completionRate * 100, 1),
            efficiencyBridgeBoost: 0,
            balanceBridgeBoost: safeFixedNumber(balanceBridgeBoost),
            weight,
            srsLabel,
            isBurnoutRisk,
            crunchMultiplier: safeFixedNumber(crunchMultiplier),
            agilityPenalty: safeFixedNumber(agilityPenalty, 4),
            avgSeconds: metrics.avgSeconds || 0,
            monteCarlo: mcHasData ? {
                probability: safeFixedNumber(mcProbability),
                probabilityRaw: Number.isFinite(Number(mcResult?.probabilityRaw))
                    ? safeFixedNumber(mcResult.probabilityRaw)
                    : safeFixedNumber(mcProbability),
                conformalLow: Number.isFinite(Number(mcResult?.conformalLow))
                    ? safeFixedNumber(mcResult.conformalLow)
                    : null,
                conformalHigh: Number.isFinite(Number(mcResult?.conformalHigh))
                    ? safeFixedNumber(mcResult.conformalHigh)
                    : null,
                thresholds: {
                    danger: safeFixedNumber(adaptiveRisk?.danger),
                    safe: safeFixedNumber(adaptiveRisk?.safe)
                },
                riskLabel: mcRiskLabel,
                volatility: safeFixedNumber(mcResult?.volatility),
                meanProjected: safeFixedNumber(mcResult?.mean),
                effectiveMCTarget: safeFixedNumber(effectiveMCTarget),
                effectiveMCDays: Number.isFinite(Number(effectiveMCDays)) ? Number(effectiveMCDays) : 0,
                globalProjectedMean: globalProjectedMean != null ? safeFixedNumber(globalProjectedMean, 1) : null,
                diagnostics: mcResult?.diagnostics || null,
                ci95Low: safeFixedNumber(mcResult?.ci95Low),
                ci95High: safeFixedNumber(mcResult?.ci95High),
                urgencyBoost: safeFixedNumber(mcUrgencyBoost),
                calibrationPenalty: safeFixedNumber(mcResult?.calibrationPenalty, 4),
                avgBrier: mcResult?.avgBrier != null ? safeFixedNumber(mcResult.avgBrier, 4) : null,
                ece: mcResult?.ece != null ? safeFixedNumber(mcResult.ece, 4) : null,
                reliability: Array.isArray(mcResult?.reliability) ? mcResult.reliability : [],
                sampleSize: mcResult?.sampleSize || relevantSimulados?.length || 0,
                explainability: (() => {
                    const calibPenalty = Number(mcResult?.calibrationPenalty) || 0;
                    const shrinkTotal = Number(mcResult?.shrinkTotal) || 0;
                    const effectiveShrink = Math.max(calibPenalty, shrinkTotal);
                    return {
                        confidenceAdjusted: calibPenalty > 0 || shrinkTotal > 0.01,
                        confidenceAdjustmentPct: safeFixedNumber(effectiveShrink * 100),
                        calibrationQuality: (mcResult?.avgBrier != null && mcResult?.avgBrier <= cfg.MC_CALIBRATION_BRIER_BASELINE)
                            ? 'good'
                            : (mcResult?.avgBrier != null && mcResult?.avgBrier <= (cfg.MC_CALIBRATION_BRIER_BASELINE + 0.07)) ? 'moderate' : 'low',
                        note: calibPenalty > 0
                            ? (mcResult?.explainability?.note || 'Probabilidade ajustada para reduzir overconfidence após backtest interno.')
                            : (shrinkTotal > 0.01
                                ? (mcResult?.explainability?.note || 'Probabilidade ajustada conservadoramente por tamanho amostral ou anomalias.')
                                : 'Sem ajuste de calibração significativo.')
                    };
                })()
            } : null,
            backtest: {
                rankQuality: safeFixedNumber(metrics.backtestWeights?.rankQuality, 4),
                uplift: safeFixedNumber(metrics.backtestWeights?.uplift, 4),
                scoreWeight: safeFixedNumber(metrics.backtestWeights?.scoreWeight, 3),
                recencyWeight: safeFixedNumber(metrics.backtestWeights?.recencyWeight, 3),
                instabilityWeight: safeFixedNumber(metrics.backtestWeights?.instabilityWeight, 3)
            },
            humanReadable: {
                "Média": formatPercent(((averageScore - minScore) / domain) * 100),
                "Recência": recencyUnknown ? "Nunca" : (daysSinceLastStudy === 0 ? "Hoje" : `${daysSinceLastStudy} dias`),
                "Tendência": trend > (0.5 * (domain / 100)) ? `↑ +${formatValue(trend)}` : trend < (-0.5 * (domain / 100)) ? `↓ ${formatValue(trend)}` : "→ Estável",
                "Instabilidade": `±${formatValue(mssdVolatility)} pts`,
                "Probabilidade (MC)": mcHasData ? formatPercent(mcProbability) : "Dados insuf.",
                "Contexto Global MC": globalProjectedPct != null ? formatPercent(globalProjectedPct) : null,
                "Peso da Matéria": weightLabel,
                "Status": srsLabel || (normalized > 70 ? "🔥 Urgente" : normalized > 50 ? "⚡ Médio" : "✓ Estável")
            },
            components: {
                scoreComponent: Number((scoreComponent * weightMultiplier).toFixed(2)),
                recencyComponent: Number((recencyComponent * weightMultiplier).toFixed(2)),
                instabilityComponent: Number((instabilityComponent * weightMultiplier).toFixed(2)),
                priorityBoost: Number((priorityBoost * weightMultiplier).toFixed(2)),
                srsBoost: Number((srsBoost * weightMultiplier).toFixed(2)),
                rotationPenalty: Number((rotationPenalty * weightMultiplier).toFixed(2)),
                mcUrgencyBoost: Number((mcUrgencyBoost * weightMultiplier).toFixed(2)),
                balanceBridgeBoost: Number((balanceBridgeBoost * weightMultiplier).toFixed(2)),
            }
        }
    };
    // FIX: try/catch para o callback de calibração nunca quebrar o fluxo
    // ✅ FIX: Verificar se options.onCalibrationMetric é função antes de chamar e options é válido
    if (result.details?.monteCarlo && options && typeof options.onCalibrationMetric === 'function') {
        try {
            options.onCalibrationMetric({
                categoryId: metrics.categoryId || null,
                categoryName: metrics.safeCategory?.name || metrics.categoryName || 'Disciplina',
                timestamp: Date.now(),
                avgBrier: result.details.monteCarlo.avgBrier,
                ece: result.details.monteCarlo.ece,
                probability: result.details.monteCarlo.probability != null ? result.details.monteCarlo.probability / 100 : null,
                calibrationPenalty: result.details.monteCarlo.calibrationPenalty,
                reliability: result.details.monteCarlo.reliability || [],
                calibrationQuality: result.details.monteCarlo.explainability?.calibrationQuality || 'low',
                sampleSize: result.details.monteCarlo.sampleSize ?? metrics.simuladoCount ?? 0
            });
        } catch { /* não quebrar o fluxo principal */ }
    }
    return result;
};

const SHARED_URGENCY_CTX = Symbol('sharedUrgencyCtx');

function sortSimsByDateOnce(simsList) {
    if (!simsList || simsList.length === 0) return [];
    const len = simsList.length;
    if (len === 1) return simsList;
    const withTs = new Array(len);
    for (let i = 0; i < len; i++) {
        const s = simsList[i];
        const parsed = normalizeDate(s?.date || s?.createdAt);
        const ts = parsed ? parsed.getTime() : 0;
        withTs[i] = { sim: s, ts: Number.isNaN(ts) ? 0 : ts, idx: i };
    }
    withTs.sort((a, b) => (a.ts !== b.ts ? a.ts - b.ts : a.idx - b.idx));
    const sorted = new Array(len);
    for (let i = 0; i < len; i++) sorted[i] = withTs[i].sim;
    return sorted;
}

function summarizeLogsLinear(logsList) {
    const logCount = logsList.length;
    let lastLog = '';
    let maxTs = -Infinity;
    let minutesSum = 0;
    const perLogTokens = [];
    for (let i = 0; i < logCount; i++) {
        const l = logsList[i];
        const rawDate = l?.date || l?.createdAt;
        const parsed = normalizeDate(rawDate);
        const ts = parsed ? parsed.getTime() : 0;
        const safeTs = Number.isNaN(ts) ? 0 : ts;
        if (safeTs >= maxTs) {
            maxTs = safeTs;
            lastLog = rawDate || '';
        }
        const mins = sanitizeMinutes(l?.minutes ?? l?.minutos ?? l?.duration);
        minutesSum += mins;
        perLogTokens.push(`${l?.categoryId ?? ''}:${l?.subject ?? l?.categoryName ?? l?.materia ?? ''}:${getDateKey(rawDate) || ''}:${mins}`);
    }
    return {
        logCount,
        lastLog,
        logsMinutesChecksum: `${minutesSum.toFixed(0)}_${simpleHash(perLogTokens.join('|'))}`
    };
}

function computeUrgencyFeaturesHash(options) {
    return simpleHash(
        `${getCoachFeature(options, 'useStateSpace', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useStateSpaceAverage', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useStateSpaceTrend', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDynamicVolatility', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useGarchVolatility', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDynamicVolatilityOverride', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'usePosteriorMonteCarlo', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'usePosteriorMonteCarloOverride', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useBayesianTopics', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useBayesianTopicsForUrgency', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDecisionUtility', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDecisionUtilityForTopics', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDecisionUtilityForBestTask', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useBanditPlanner', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useLLMExplanations', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useKnowledgeGraph', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useKnowledgeGraphForTopics', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useAdvancedFsrs', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useFsrsForSrsBoost', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useFsrsTopicScheduling', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useEvaluationTelemetry', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useObservability', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDriftGuard', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useModelHealthTelemetry', false) === true ? 1 : 0}` +
        `${getCoachFeature(options, 'useDriftAlerts', false) === true ? 1 : 0}`
    );
}

function buildSharedUrgencyContext(simulados, studyLogs, allCategories, options = {}) {
    const safeSims = Array.isArray(simulados) ? simulados : Object.values(simulados || {});
    const logsInput = options?.studyLogs ?? studyLogs;
    const safeLogs = Array.isArray(logsInput) ? logsInput : Object.values(logsInput || {});
    const simsForChecksum = sortSimsByDateOnce(safeSims);
    const lastSim = simsForChecksum.length > 0
        ? (simsForChecksum[simsForChecksum.length - 1]?.date || simsForChecksum[simsForChecksum.length - 1]?.createdAt || '')
        : '';
    const { logCount, lastLog, logsMinutesChecksum } = summarizeLogsLinear(safeLogs);
    const todayStr = getDateKey(new Date());
    const refDateStr = options.now ? (getDateKey(options.now) || todayStr) : todayStr;
    const activeId = options?.contestId || options?.activeId || options?.config?.contestId || (typeof useAppStore !== 'undefined' ? useAppStore.getState()?.appState?.activeId : null) || 'default';
    const weightsHash = simpleHash(
        safeArray(allCategories)
            .map(c => `${c?.id || c?.name || '?'}:${c?.weight ?? ''}:${c?.maxScore ?? ''}:${c?.minScore ?? ''}:${safeArray(c?.simuladoStats?.history).length}`)
            .join('|')
    );
    const globalHash = options.globalMcStats
        ? simpleHash(
            `${Number(options.globalMcStats.projectedMean || 0).toFixed(1)}:${Number(options.globalMcStats.probability || 0).toFixed(1)}:${Number(options.globalMcStats.currentMean || 0).toFixed(1)}`
        )
        : 'noglobal';
    const goalKey = options?.user?.goalDate
        ? `_gd${getDateKey(options.user.goalDate) || String(options.user.goalDate)}`
        : '';
    const featuresHash = computeUrgencyFeaturesHash(options);
    const configHash = options.config
        ? simpleHash(JSON.stringify(options.config))
        : 'defcfg';
    const optAllSims = Array.isArray(options.allSimulados) ? options.allSimulados : Object.values(options.allSimulados || {});
    const optSimRows = Array.isArray(options.simuladoRows) ? options.simuladoRows : Object.values(options.simuladoRows || {});
    const optHistory = Array.isArray(options.history) ? options.history : Object.values(options.history || {});
    const optSimsHash = simpleHash(
        [...optAllSims, ...optSimRows, ...optHistory]
            .filter(Boolean)
            .map(s => `${s?.id ?? ''}:${s?.date ?? s?.createdAt ?? ''}:${s?.subject ?? s?.categoryName ?? s?.materia ?? ''}:${s?.categoryId ?? ''}:${s?.score ?? s?.value ?? ''}:${s?.correct ?? ''}:${s?.total ?? ''}:${s?.timeSpent ?? s?.timedQuestoes ?? s?.avgSeconds ?? ''}:${s?.valid === false ? 0 : 1}`)
            .join('|')
    );

    return {
        safeSims,
        safeLogs,
        simsForChecksum,
        simCount: safeSims.length,
        lastSim,
        logCount,
        lastLog,
        logsMinutesChecksum,
        refDateStr,
        activeId,
        weightsHash,
        globalHash,
        goalKey,
        featuresHash,
        configHash,
        optSimsHash
    };
}

export const calculateUrgency = (category, simulados = [], studyLogs = [], options = {}) => {
    try {
        const safeCat = category || {};
        const catId = safeCat.id || safeCat.name || 'unknown';
        const sharedCtx = options?.[SHARED_URGENCY_CTX] || null;
        const safeSims = sharedCtx
            ? sharedCtx.safeSims
            : (Array.isArray(simulados) ? simulados : Object.values(simulados || {}));
        const logsInput = options?.studyLogs ?? studyLogs;
        const safeLogs = sharedCtx
            ? sharedCtx.safeLogs
            : (Array.isArray(logsInput) ? logsInput : Object.values(logsInput || {}));
        const safeTasks = Array.isArray(safeCat.tasks) ? safeCat.tasks : Object.values(safeCat.tasks || {});
        const simCount = sharedCtx ? sharedCtx.simCount : safeSims.length;
        const baseDateStr = sharedCtx
            ? sharedCtx.refDateStr
            : (options.now ? (getDateKey(options.now) || getDateKey(new Date())) : getDateKey(new Date()));
        const refDateStr = options?.now != null
            ? `${baseDateStr}_${options.now instanceof Date ? options.now.getTime() : (typeof options.now === 'number' ? options.now : (_safeDateParse(options.now)?.getTime() ?? String(options.now)))}`
            : baseDateStr;
        const simsForChecksum = sharedCtx ? sharedCtx.simsForChecksum : sortSimsByDateOnce(safeSims);
        const urgencyCatMax = parseOptionalFinite(safeCat.maxScore);
        const urgencyOptMax = parseOptionalFinite(options?.maxScore);
        const catMax = (urgencyCatMax !== null && urgencyCatMax > 0)
            ? urgencyCatMax
            : ((urgencyOptMax !== null && urgencyOptMax > 0) ? urgencyOptMax : 100);
        const urgencyCatMin = parseOptionalFinite(safeCat.minScore);
        const urgencyOptMin = parseOptionalFinite(options?.minScore);
        const catMin = urgencyCatMin !== null
            ? Math.min(urgencyCatMin, catMax)
            : (urgencyOptMin !== null ? Math.min(urgencyOptMin, catMax) : 0);
        const scoreChecksum = simsForChecksum.reduce((acc, s, index) => {
            if (!s) return acc;
            const parsed = getSafeScore(s, catMax, catMin);
            const validVal = Number.isNaN(parsed) ? 0 : parsed;
            const validFlag = s.valid === false ? 0 : 1;
            const totalQ = Number(s.total ?? s.questoes ?? s.totalQuestoes ?? s.questions) || 0;
            const timeVal = Number(s.timeSpent ?? s.timedQuestoes ?? s.avgSeconds) || 0;
            return acc + ((validVal + totalQ * 0.13 + timeVal * 0.07 + validFlag * 1000) * (index + 1) * 1.17);
        }, 0).toFixed(2);
        const optKey = (options?.daysToExam != null && Number.isFinite(Number(options.daysToExam))) ? `_dte${options.daysToExam}` : '';
        const targetKey = `_ts${options?.targetScore ?? 'def'}_ms${catMax}_min${catMin}`;
        const lastSim = sharedCtx
            ? sharedCtx.lastSim
            : (simsForChecksum.length > 0
                ? (simsForChecksum[simsForChecksum.length - 1]?.date || simsForChecksum[simsForChecksum.length - 1]?.createdAt || '')
                : '');
        const logsSummary = sharedCtx ? null : summarizeLogsLinear(safeLogs);
        const logCount = sharedCtx ? sharedCtx.logCount : logsSummary.logCount;
        const lastLog = sharedCtx ? sharedCtx.lastLog : logsSummary.lastLog;
        const logsMinutesChecksum = sharedCtx ? sharedCtx.logsMinutesChecksum : logsSummary.logsMinutesChecksum;
        const pendingCount = safeTasks.filter(t => t && !t.completed).length;
        const completedCount = safeTasks.filter(t => t?.completed).length;
        const pendingHighCount = safeTasks.filter(t => t && !t.completed && normalizePriority(t.priority) === 'high').length;
        const tasksContentHash = simpleHash(
            safeTasks
                .map(t => `${t?.id ?? ''}:${t?.text ?? t?.title ?? ''}:${t?.topicName ?? t?.topic ?? ''}:${normalizePriority(t?.priority)}:${t?.completed ? 1 : 0}`)
                .join('|')
        );
        const tasksHash = `${safeTasks.length}_${completedCount}_${pendingCount}_${pendingHighCount}_${options?.hasHighPriorityTasks ? 1 : 0}_${tasksContentHash}`;
        // FIX (BUG-13): activeId deve vir de options prioritariamente para manter pureza
        const activeId = sharedCtx
            ? sharedCtx.activeId
            : (options?.contestId || options?.activeId || options?.config?.contestId || (typeof useAppStore !== 'undefined' ? useAppStore.getState()?.appState?.activeId : null) || 'default');
        const weightsHash = sharedCtx
            ? sharedCtx.weightsHash
            : simpleHash(
                safeArray(options.allCategories)
                    .map(c => `${c?.id || c?.name || '?'}:${c?.weight ?? ''}`)
                    .join('|')
            );
        const globalHash = sharedCtx
            ? sharedCtx.globalHash
            : (options.globalMcStats
                ? simpleHash(
                    `${Number(options.globalMcStats.projectedMean || 0).toFixed(1)}:${Number(options.globalMcStats.probability || 0).toFixed(1)}:${Number(options.globalMcStats.currentMean || 0).toFixed(1)}`
                )
                : 'noglobal');
        const catCalibHistory = getCalibrationHistoryFor(options.calibrationHistoryByCategory, catId, safeCat.name);
        const lastCalib = catCalibHistory.length > 0 ? catCalibHistory[catCalibHistory.length - 1] : null;
        const calibrationHash = `${catCalibHistory.length}_${lastCalib?.timestamp || 0}_${lastCalib?.avgBrier ?? 'na'}`;
        const goalKey = sharedCtx
            ? sharedCtx.goalKey
            : (options?.user?.goalDate
                ? `_gd${getDateKey(options.user.goalDate) || String(options.user.goalDate)}`
                : '');
        const featuresHash = sharedCtx ? sharedCtx.featuresHash : computeUrgencyFeaturesHash(options);
        // ✅ PATCH-13: Incluir hash da config customizada no cache key
        const configHash = sharedCtx
            ? sharedCtx.configHash
            : (options.config ? simpleHash(JSON.stringify(options.config)) : 'defcfg');
        // ✅ FIX: Incluir hash completo dos simulados da categoria para que qualquer edição invalide o cache imediatamente
        const catStatsHistory = safeArray(safeCat.simuladoStats?.history);
        const catStatsHash = simpleHash(
            catStatsHistory
                .map(s => `${s?.date || s?.createdAt || ''}:${s?.score ?? s?.value ?? ''}:${s?.correct ?? ''}:${s?.total ?? ''}:${s?.timeSpent ?? ''}:${s?.timedQuestoes ?? ''}:${s?.avgSeconds ?? ''}:${Array.isArray(s?.topics) ? s.topics.reduce((acc, t) => `${acc},${t?.timeSpent ?? ''}:${t?.timedQuestoes ?? ''}`, '') : ''}:${s?.valid === false ? 0 : 1}`)
                .join('|')
        );
        const optSimsHash = sharedCtx
            ? sharedCtx.optSimsHash
            : simpleHash(
                [
                    ...(Array.isArray(options.allSimulados) ? options.allSimulados : Object.values(options.allSimulados || {})),
                    ...(Array.isArray(options.simuladoRows) ? options.simuladoRows : Object.values(options.simuladoRows || {})),
                    ...(Array.isArray(options.history) ? options.history : Object.values(options.history || {}))
                ]
                    .filter(Boolean)
                    .map(s => `${s?.id ?? ''}:${s?.date ?? s?.createdAt ?? ''}:${s?.subject ?? s?.categoryName ?? s?.materia ?? ''}:${s?.categoryId ?? ''}:${s?.score ?? s?.value ?? ''}:${s?.correct ?? ''}:${s?.total ?? ''}:${s?.timeSpent ?? s?.timedQuestoes ?? s?.avgSeconds ?? ''}:${s?.valid === false ? 0 : 1}`)
                    .join('|')
            );

        // FIX (BUG-13): cache key compacta via hashString64 (evita chave de 400+ chars e colisões)
        const parsedMinCutoffForKey = parseOptionalFinite(safeCat.minCutoff);
        const minCutoffKey = parsedMinCutoffForKey !== null ? parsedMinCutoffForKey : 'na';
        const cacheKeyRaw = JSON.stringify([
            activeId, catId, safeCat.name ?? '', safeCat.weight ?? '', simCount, logCount, scoreChecksum, catStatsHash, optSimsHash,
            refDateStr, optKey, targetKey, lastSim, lastLog,
            tasksHash, logsMinutesChecksum, weightsHash, globalHash, calibrationHash,
            goalKey, featuresHash, configHash, minCutoffKey,
            options.maxScore ?? catMax, options.minScore ?? catMin, options.targetScore ?? 0, options.targetScoreLabel ?? ''
        ]);
        const cacheKey = `urg_${hashString64(cacheKeyRaw)}`;
        const cachedUrgency = cacheGet(_urgencyCache, cacheKey);
        // BUG: cache podia devolver urgência de outra categoria se hash colidisse ou estado mudasse.
        if (
            cachedUrgency &&
            (!catId || !cachedUrgency?.details?.categoryId || cachedUrgency.details.categoryId === catId || cachedUrgency.details.categoryId === category?.id) &&
            Number.isFinite(cachedUrgency?.score)
        ) {
            // ✅ FIX: Validar que o cache não está stale verificando se a categoria ainda existe
            const allCatsForExistCheck = safeArray(options.allCategories);
            const categoryStillExists = options.allCategories
                ? allCatsForExistCheck.some(c => c && (c.id === catId || c.name === catId))
                : true;
            if (!categoryStillExists) {
                _urgencyCache.delete(cacheKey);
            } else {
                // Se a urgência em cache possui dados de monteCarlo e o chamador passou callback de calibração,
                // propaga o evento de calibração para não engolir o pipeline em cache hits
                if (cachedUrgency.details?.monteCarlo && options && typeof options.onCalibrationMetric === 'function') {
                    try {
                        options.onCalibrationMetric({
                            categoryId: cachedUrgency.details.categoryId || catId,
                            categoryName: safeCat.name || catId,
                            timestamp: Date.now(),
                            avgBrier: cachedUrgency.details.monteCarlo.avgBrier,
                            ece: cachedUrgency.details.monteCarlo.ece,
                            probability: cachedUrgency.details.monteCarlo.probability != null ? cachedUrgency.details.monteCarlo.probability / 100 : null,
                            calibrationPenalty: cachedUrgency.details.monteCarlo.calibrationPenalty,
                            reliability: cachedUrgency.details.monteCarlo.reliability || [],
                            calibrationQuality: cachedUrgency.details.monteCarlo.explainability?.calibrationQuality || 'low',
                            sampleSize: cachedUrgency.details.monteCarlo.sampleSize ?? cachedUrgency.details.simuladoCount ?? 0
                        });
                    } catch { /* não quebrar o fluxo */ }
                }
                if (getCoachFeature(options, 'useEvaluationTelemetry', false) && typeof options?.onCoachEvaluationSnapshot === 'function') {
                    try {
                        options.onCoachEvaluationSnapshot({
                            timestamp: Date.now(),
                            categoryId: cachedUrgency.details?.categoryId || catId,
                            categoryName: safeCat.name || null,
                            normalizedScore: cachedUrgency.normalizedScore,
                            probability: cachedUrgency.details?.monteCarlo?.probability ?? null,
                            predictedMean: cachedUrgency.details?.monteCarlo?.meanProjected ?? cachedUrgency.details?.averageScore ?? null,
                            targetScore: cachedUrgency.details?.monteCarlo?.effectiveMCTarget ?? options?.targetScore ?? null,
                            maxScore: catMax,
                            minScore: catMin,
                            strategyId: options?.strategyId || null,
                        });
                    } catch { /* ignore */ }
                }
                if (getCoachFeature(options, 'useObservability', false) && typeof options?.onCoachObservability === 'function') {
                    try {
                        const mcDetails = cachedUrgency.details?.monteCarlo || null;
                        options.onCoachObservability({
                            timestamp: Date.now(),
                            categoryId: cachedUrgency.details?.categoryId || catId,
                            categoryName: safeCat.name || null,
                            normalizedScore: cachedUrgency.normalizedScore,
                            probability: mcDetails?.probability ?? null,
                            probabilityRaw: mcDetails?.probabilityRaw ?? null,
                            avgBrier: mcDetails?.avgBrier ?? null,
                            ece: mcDetails?.ece ?? null,
                            calibrationPenalty: mcDetails?.calibrationPenalty ?? null,
                            volatility: mcDetails?.volatility ?? cachedUrgency.details?.mssdVolatility ?? null,
                            sampleSize: mcDetails?.sampleSize ?? null,
                            reliability: Array.isArray(mcDetails?.reliability) ? mcDetails.reliability : [],
                        });
                    } catch { /* ignore */ }
                }
                if (options && typeof options.logger === 'function') {
                    try {
                        options.logger({ categoryId: cachedUrgency.details?.categoryId || catId, name: safeCat.name, urgency: cachedUrgency });
                    } catch { /* ignore */ }
                }
                return deepClone(cachedUrgency);
            }
        }
        const metrics = extractMetrics(safeCat, safeSims, safeLogs, options);
        const scoreInfo = calculateUrgencyScore(metrics, options);
        const result = generateCoachStrings(scoreInfo.weightedRaw, scoreInfo.normalized, metrics, scoreInfo, options);
        // ==================== LOTE 8: EVALUATION SNAPSHOT ====================
        if (
            getCoachFeature(options, 'useEvaluationTelemetry', false) &&
            typeof options.onCoachEvaluationSnapshot === 'function'
        ) {
            try {
                options.onCoachEvaluationSnapshot({
                    timestamp: Date.now(),
                    categoryId: metrics.categoryId || null,
                    categoryName: metrics.safeCategory?.name || null,
                    normalizedScore: result.normalizedScore,
                    probability: result.details?.monteCarlo?.probability ?? null,
                    predictedMean:
                        result.details?.monteCarlo?.meanProjected ??
                        result.details?.averageScore ??
                        null,
                    targetScore: metrics.targetScore,
                    maxScore: metrics.maxScore,
                    minScore: metrics.minScore,
                    strategyId: options.strategyId || null,
                });
            } catch {
                // ignore evaluation errors
            }
        }
        // ==================== LOTE 9: OBSERVABILITY SNAPSHOT ====================
        if (
            getCoachFeature(options, 'useObservability', false) &&
            typeof options.onCoachObservability === 'function'
        ) {
            try {
                const mcDetails = result.details?.monteCarlo || null;
                options.onCoachObservability({
                    timestamp: Date.now(),
                    categoryId: metrics.categoryId || null,
                    categoryName: metrics.safeCategory?.name || null,
                    normalizedScore: result.normalizedScore,
                    probability: mcDetails?.probability ?? null,
                    probabilityRaw: mcDetails?.probabilityRaw ?? null,
                    avgBrier: mcDetails?.avgBrier ?? null,
                    ece: mcDetails?.ece ?? null,
                    calibrationPenalty: mcDetails?.calibrationPenalty ?? null,
                    volatility: mcDetails?.volatility ?? result.details?.mssdVolatility ?? null,
                    sampleSize: mcDetails?.sampleSize ?? null,
                    reliability: (mcDetails && Array.isArray(mcDetails.reliability))
                        ? mcDetails.reliability
                        : [],
                });
            } catch {
                // observability must never break the Coach
            }
        }
        // ✅ FIX: Verificar se options.logger é função antes de chamar e options é válido
        if (options && typeof options.logger === 'function') {
            try {
                options.logger({ categoryId: metrics.categoryId, name: metrics.safeCategory?.name, urgency: result });
            } catch {
                // ignore
            }
        }
        cacheSet(_urgencyCache, URGENCY_CACHE_MAX, cacheKey, deepClone(result));
        return result;
    } catch (err) {
        // FIX: incluir categoryId e nome no log para debuggability
        console.error(
            `[CoachLogic] Critical error in calculateUrgency [cat=${category?.id}, name=${category?.name}]:`,
            err
        );
        return {
            score: 0,
            normalizedScore: 0,
            recommendation: "Erro no cálculo",
            details: {
                hasData: false,
                daysSinceLastStudy: 0,
                error: true,
                errorMessage: err?.message || String(err),
                monteCarlo: null,
                humanReadable: { "Status": "Erro" }
            }
        };
    }
};

export const getSuggestedFocus = (categories, simulados, studyLogs = [], options = {}) => {
    if (!categories || (Array.isArray(categories) && categories.length === 0)) return null;
    const safeCategories = Array.isArray(categories) ? categories : Object.values(categories || {});
    if (safeCategories.length === 0) return null;
    const callerAllCategories = safeArray(options?.allCategories);
    const effectiveAllCategories = callerAllCategories.length > 0 ? callerAllCategories : safeCategories;
    const sharedCtx = buildSharedUrgencyContext(simulados, studyLogs, effectiveAllCategories, options);
    const batchOptions = { ...options, allCategories: effectiveAllCategories, [SHARED_URGENCY_CTX]: sharedCtx };
    const ranked = safeCategories.map(cat => ({
        ...cat,
        urgency: calculateUrgency(cat, simulados, studyLogs, batchOptions)
    })).sort((a, b) => {
        const valA = Number.isFinite(a.urgency?.normalizedScore) ? a.urgency.normalizedScore : -Infinity;
        const valB = Number.isFinite(b.urgency?.normalizedScore) ? b.urgency.normalizedScore : -Infinity;
        if (valA !== valB) return valB - valA;
        const rawA = Number.isFinite(a.urgency?.score) ? a.urgency.score : -Infinity;
        const rawB = Number.isFinite(b.urgency?.score) ? b.urgency.score : -Infinity;
        if (rawA !== rawB) return rawB - rawA;
        return String(a.id || '').localeCompare(String(b.id || ''));
    });
    const top = ranked[0];
    if (!top) return null;
    const maxScore = options.maxScore ?? top.maxScore ?? 100;
    const minScore = options.minScore ?? top.minScore ?? 0;
    // calculateUrgency já retorna objeto próprio desconectado do cache (sem duplo deepClone)
    const clonedUrgency = top.urgency || null;
    const topicOptions = {
        ...options,
        studyLogs: options?.studyLogs ?? studyLogs,
        mcRiskLabel: clonedUrgency?.details?.monteCarlo?.riskLabel ?? null,
    };
    const result = {
        ...top,
        urgency: clonedUrgency,
        weakestTopic: getWeakestTopic(top, simulados, maxScore, minScore, topicOptions) || null
    };
    // ✅ FIX: Verificar se options.flashcardDue é número antes de comparar
    if (options && Number.isFinite(Number(options.flashcardDue)) && Number(options.flashcardDue) > 0) {
        result.flashcardDue = Number(options.flashcardDue);
        result.srsRecommendation = `Revisar ${Number(options.flashcardDue)} flashcards hoje para reforçar retenção e consistência.`;
        if (result.urgency) {
            result.urgency.srsDue = Number(options.flashcardDue);
        }
    }
    // ✅ FIX: Verificar se options.globalMcStats existe antes de acessar
    if (options && options.globalMcStats && Number.isFinite(options.globalMcStats.projectedMean)) {
        const globalMean = Number(options.globalMcStats.projectedMean);
        if (result.urgency && result.urgency.details) {
            result.urgency.details.globalMcContext = {
                projectedMean: Number(globalMean.toFixed(1)),
                volatility: options.globalMcStats.sd ? Number(options.globalMcStats.sd.toFixed(2)) : null,
                source: 'global from useMonteCarloStats (Coach integration)'
            };
        }
        result.globalProjectedMean = Number(globalMean.toFixed(1));
        result.mcIntegrationSource = 'globalMcStats';
    }
    return result;
};

function _buildSortedTopics(category, simulados = [], maxScore = 100, minScore = 0, options = {}) {
    const safeCat = category || {};
    const catId = safeCat.id || safeCat.name || 'unknown';
    const optCatMax = parseOptionalFinite(safeCat.maxScore);
    const optParamMax = parseOptionalFinite(maxScore);
    const catMax = (optCatMax !== null && optCatMax > 0)
        ? optCatMax
        : ((optParamMax !== null && optParamMax > 0) ? optParamMax : 100);
    const passedMin = parseOptionalFinite(minScore) ?? 0;
    const optCatMin = parseOptionalFinite(safeCat.minScore);
    const catMin = optCatMin !== null
        ? Math.min(optCatMin, catMax)
        : passedMin;
    const safeTasks = Array.isArray(safeCat.tasks)
        ? safeCat.tasks
        : Object.values(safeCat.tasks || {});
    const openTasks = safeTasks.filter(t => t && !t.completed).length;
    const allSafeSims = Array.isArray(simulados)
        ? simulados
        : Object.values(simulados || {});
    const optAllSimsRaw = Array.isArray(options?.allSimulados)
        ? options.allSimulados
        : Object.values(options?.allSimulados || {});
    const optSimRowsRaw = Array.isArray(options?.simuladoRows)
        ? options.simuladoRows
        : Object.values(options?.simuladoRows || {});
    const catNameForSims = safeCat.name || safeCat.id || '';
    const matchesCatSim = (s) => s && s.valid !== false && (
        (safeCat.id && s.categoryId && String(s.categoryId) === String(safeCat.id)) ||
        (catNameForSims && isSubjectMatch(s.subject || s.categoryName || s.materia || s.disciplina || '', catNameForSims))
    );
    const safeSims = catNameForSims ? allSafeSims.filter(matchesCatSim) : allSafeSims.filter(s => s && s.valid !== false);
    const optAllSims = catNameForSims ? optAllSimsRaw.filter(matchesCatSim) : [];
    const optSimRows = catNameForSims ? optSimRowsRaw.filter(matchesCatSim) : [];
    const rawCatHistForHash = safeArray(safeCat.simuladoStats?.history).filter(h => h && h.valid !== false);
    const allSourcesForHash = [...rawCatHistForHash, ...safeSims, ...optAllSims, ...optSimRows];
    let lastSimTimestamp = 0;
    const historyVolume = allSourcesForHash.length;
    for (let i = 0; i < historyVolume; i++) {
        const current = allSourcesForHash[i];
        if (!current) continue;
        const parsed = normalizeDate(current.date || current.createdAt);
        const currTime = parsed ? parsed.getTime() : 0;
        if (Number.isFinite(currTime) && currTime > lastSimTimestamp) {
            lastSimTimestamp = currTime;
        }
    }
    const scoreChecksum = allSourcesForHash.reduce((acc, s, index) => {
        if (!s) return acc;
        const parsed = getSafeScore(s, catMax, catMin);
        const validVal = Number.isNaN(parsed) ? 0 : parsed;
        const tLen = Array.isArray(s.topics) ? s.topics.length : (s.topic || s.assunto ? 1 : 0);
        const tSum = Array.isArray(s.topics)
            ? s.topics.reduce((sum, t) => sum + (Number(t?.total ?? t?.questoes) || 0) * 3 + (Number(t?.correct ?? t?.acertos) || 0) * 7 + (Number(t?.score) || 0), 0)
            : ((Number(s.total ?? s.questoes) || 0) * 3 + (Number(s.correct ?? s.acertos) || 0) * 7);
        return acc + ((validVal + tLen * 13 + tSum) * (index + 1) * 1.17);
    }, 0);
    const tasksHash = simpleHash(
        safeTasks
            .map(t => `${t?.id ?? ''}:${t?.text ?? ''}:${t?.title ?? ''}:${t?.topicName ?? ''}:${t?.topic ?? ''}:${t?.priority ?? ''}:${t?.status ?? ''}:${t?.completed ? 1 : 0}`)
            .join('|')
    );
    const historyLen = rawCatHistForHash.length;



    const userId = safeCat?.userId || safeSims[0]?.userId || 'default';
    const refDateKey = options?.now ? (getDateKey(options.now) || getDateKey(new Date())) : getDateKey(new Date());
    const coachFeatureHash = simpleHash(JSON.stringify({
        bt: getCoachFeature(options, 'useBayesianTopics', false),
        btu: getCoachFeature(options, 'useBayesianTopicsForUrgency', false),
        du: getCoachFeature(options, 'useDecisionUtility', false),
        dut: getCoachFeature(options, 'useDecisionUtilityForTopics', false),
        dubt: getCoachFeature(options, 'useDecisionUtilityForBestTask', false),
        bp: getCoachFeature(options, 'useBanditPlanner', false),
        kg: getCoachFeature(options, 'useKnowledgeGraph', false),
        kgt: getCoachFeature(options, 'useKnowledgeGraphForTopics', false),
        afsrs: getCoachFeature(options, 'useAdvancedFsrs', false),
        fsrsb: getCoachFeature(options, 'useFsrsForSrsBoost', false),
        fsrst: getCoachFeature(options, 'useFsrsTopicScheduling', false),
    }));
    const logsSummaryForTopics = options?.studyLogs ? summarizeLogsLinear(safeArray(options.studyLogs)) : null;
    const kgSig = safeCat?.knowledgeGraph || safeCat?.prerequisites || safeCat?.graphEdges
        ? simpleHash(JSON.stringify({ kg: safeCat.knowledgeGraph, p: safeCat.prerequisites, e: safeCat.graphEdges }))
        : 'nokg';
    const hash = `${userId}-${refDateKey}-${lastSimTimestamp}-${openTasks}-${tasksHash}-${historyLen}-${optAllSims.length}-${optSimRows.length}-${catMax}-${catMin}-${historyVolume}-${scoreChecksum.toFixed(1)}-${safeCat?.weight ?? ''}-${options?.mcRiskLabel ?? ''}-${logsSummaryForTopics?.logsMinutesChecksum ?? 'nologs'}-${kgSig}-${coachFeatureHash}`;
    // FIX (BUG-13): activeId deve vir de options prioritariamente
    const activeId = options?.contestId || options?.activeId || options?.config?.contestId || (typeof useAppStore !== 'undefined' ? useAppStore.getState()?.appState?.activeId : null) || 'default';
    const cacheKey = `isolate_${activeId}_${catId}_${safeCat?.name ?? ''}_${hash}`;
    const cachedTopics = cacheGet(_topicsCache, cacheKey);
    if (cachedTopics) return deepClone(cachedTopics);
    const result = _buildSortedTopicsImpl(safeCat, safeSims, catMax, catMin, options);
    cacheSet(_topicsCache, TOPICS_CACHE_MAX, cacheKey, deepClone(result));
    return result;
}

const _buildSortedTopicsImpl = (category, _simulados = [], maxScore = 100, minScore = 0, options = {}) => {
    const safeCat = category || {};
    const optCatMax = parseOptionalFinite(safeCat.maxScore);
    const optParamMax = parseOptionalFinite(maxScore);
    const catMax = (optCatMax !== null && optCatMax > 0)
        ? optCatMax
        : ((optParamMax !== null && optParamMax > 0) ? optParamMax : 100);
    const optCatMin = parseOptionalFinite(safeCat.minScore);
    const optParamMin = parseOptionalFinite(minScore);
    const catMin = optCatMin !== null
        ? Math.min(optCatMin, catMax)
        : (optParamMin !== null ? Math.min(optParamMin, catMax) : 0);
    const catRange = Math.max(1e-9, catMax - catMin);
    const tasks = Array.isArray(safeCat.tasks) ? safeCat.tasks : Object.values(safeCat.tasks || {});
    const topicMap = {};
    const rawCatHistory = safeArray(safeCat.simuladoStats?.history);
    const catNameForSims = safeCat.name || safeCat.id || '';
    const matchesCatSim = (s) => s && (
        (safeCat.id && s.categoryId && String(s.categoryId) === String(safeCat.id)) ||
        (catNameForSims && isSubjectMatch(s.subject || s.categoryName || s.materia || s.disciplina || '', catNameForSims))
    );
    const optAllSims = catNameForSims ? safeArray(options?.allSimulados).filter(matchesCatSim) : [];
    const optSimRows = catNameForSims ? safeArray(options?.simuladoRows).filter(matchesCatSim) : [];

    // Combina as fontes de histórico de tópicos sem duplicar registros espelhados entre fontes
    const extractEntryTopics = (entry) => {
        if (!entry) return [];
        const rawTopics = entry.topics;
        if (Array.isArray(rawTopics) && rawTopics.length > 0 && rawTopics.some(t => t && (t.name || t.topic || t.assunto || t.subtopic || t.topicName))) {
            return rawTopics;
        }
        const singleTopicName = entry.topic || entry.assunto || entry.subtopic || entry.topicName;
        if (singleTopicName) {
            return [{
                name: String(singleTopicName).trim(),
                total: entry.total ?? entry.questoes ?? entry.totalQuestoes ?? entry.questions,
                correct: entry.correct ?? entry.acertos ?? entry.correctCount,
                score: entry.score,
                isPercentage: entry.isPercentage
            }];
        }
        return [];
    };

    const history = [];
    const seenCrossSourceDateTopic = new Set();
    const seenEntryIds = new Set();
    const topicSources = [rawCatHistory, safeArray(_simulados), optAllSims, optSimRows];

    topicSources.forEach((sourceList) => {
        if (!Array.isArray(sourceList) || sourceList.length === 0) return;
        const sourceDateTopics = new Set();
        sourceList.forEach((entry) => {
            if (!entry || entry.valid === false) return;
            const entryId = entry.id && !String(entry.id).startsWith('legacy-') ? String(entry.id) : null;
            if (entryId && seenEntryIds.has(entryId)) return;
            const entryTopics = extractEntryTopics(entry);
            if (entryTopics.length === 0) return;
            const dKey = getDateKey(entry.date || entry.createdAt) || '';
            const filteredTopics = entryTopics.filter((t) => {
                const tName = t && (t.name || t.topic || t.assunto || t.subtopic || t.topicName);
                if (!tName) return false;
                const normTopic = normalize(String(tName));
                if (!normTopic) return false;
                const crossKey = dKey
                    ? `${dKey}|${normTopic}`
                    : `nodate|${normTopic}|${t.total ?? t.questoes ?? ''}|${t.correct ?? t.acertos ?? ''}|${t.score ?? ''}`;
                if (seenCrossSourceDateTopic.has(crossKey)) return false;
                sourceDateTopics.add(crossKey);
                return true;
            });
            if (filteredTopics.length === 0) return;
            if (entryId) seenEntryIds.add(entryId);
            history.push({ ...entry, topics: filteredTopics });
        });
        sourceDateTopics.forEach((k) => seenCrossSourceDateTopic.add(k));
    });
    const parsedRefNow = options?.now ? normalizeDate(options.now) : null;
    const todayForTopics = (parsedRefNow && !Number.isNaN(parsedRefNow.getTime())) ? parsedRefNow : new Date();
    // FIX: alinhar timestamp de entradas sem data na ordenação com todayForTopics (evita scores fora de ordem cronológica)
    const fallbackTopicTime = todayForTopics.getTime();
    const historyWithTime = history.map((h, idx) => {
        const rawTime = (normalizeDate(h?.date || h?.createdAt) || new Date(0)).getTime();
        const safeTime = Number.isFinite(rawTime) && rawTime > 0 ? rawTime : fallbackTopicTime;
        return { entry: h, time: safeTime, idx };
    }).sort((a, b) => (a.time !== b.time ? a.time - b.time : a.idx - b.idx));
    const sortedTopicsHistory = historyWithTime.map(item => item.entry);
    sortedTopicsHistory.forEach(entry => {
        if (!entry) return;
        let entryTime = fallbackTopicTime;
        if (entry.date || entry.createdAt) {
            entryTime = (normalizeDate(entry.date || entry.createdAt) || new Date(0)).getTime();
        }
        const safeEntryTime = Number.isFinite(entryTime) && entryTime > 0 ? entryTime : fallbackTopicTime;
        const entryDate = normalizeDate(safeEntryTime) || new Date(safeEntryTime);
        const daysOld = Math.max(0, (todayForTopics.getTime() - safeEntryTime) / (1000 * 60 * 60 * 24));
        const timeWeight = Math.max(0.01, Math.exp(-0.015 * daysOld));
        let topics = entry.topics;
        if (!Array.isArray(topics) || topics.length === 0 || !topics.some(t => t && (t.name || t.topic || t.assunto || t.subtopic || t.topicName))) {
            const singleTopicName = entry.topic || entry.assunto || entry.subtopic || entry.topicName;
            if (singleTopicName) {
                topics = [{
                    name: String(singleTopicName).trim(),
                    total: entry.total ?? entry.questoes ?? entry.totalQuestoes ?? entry.questions,
                    correct: entry.correct ?? entry.acertos ?? entry.correctCount,
                    score: entry.score,
                    isPercentage: entry.isPercentage
                }];
            } else {
                topics = [];
            }
        }
        topics.forEach(t => {
            if (!t) return;
            let rawName = t.name || t.topic || t.assunto || t.subtopic || t.topicName;
            if (typeof rawName !== 'string' || !rawName) rawName = "Tópico Desconhecido";
            const name = rawName.trim();
            const topicKey = normalize(name) || name.toLowerCase();
            if (!topicMap[topicKey]) {
                topicMap[topicKey] = {
                    displayName: name,
                    total: 0,
                    correct: 0,
                    lastSeen: new Date(0),
                    completed: true,
                    hasTasks: false,
                    scores: []
                };
                topicMap[topicKey].hasUnfinishedTask = false;
            } else if (
                name &&
                topicMap[topicKey].displayName === topicMap[topicKey].displayName?.toLowerCase() &&
                name !== name.toLowerCase()
            ) {
                topicMap[topicKey].displayName = name;
            }
            const candidateTotal = t.total ?? t.questoes ?? t.totalQuestoes ?? t.questions;
            let rawTotal = Number(candidateTotal);
            let topicTotal = Number.isFinite(rawTotal) && rawTotal > 0 ? rawTotal : 0;
            let topicCorrect = 0;
            const isTotalMissing = candidateTotal === undefined || candidateTotal === null || String(candidateTotal).trim() === "" || Number(candidateTotal) === 0;
            const candidateCorrect = t.correct ?? t.acertos ?? t.correctCount;
            const resolvedScoreRaw = t.score ?? t.scorePoints ?? t.scorePct;
            const isScoreMissing = resolvedScoreRaw === undefined || resolvedScoreRaw === null || (typeof resolvedScoreRaw === 'string' && resolvedScoreRaw.trim() === '');
            if (!isScoreMissing && isTotalMissing) {
                topicTotal = getSyntheticTotal(catMax);
                topicCorrect = ((getSafeScore(t, catMax, catMin) - catMin) / catRange) * topicTotal;
            } else if (topicTotal > 0) {
                const rawC = sanitizeNum(candidateCorrect);
                if (!t.isPercentage && Number.isFinite(rawC)) {
                    topicCorrect = Math.min(topicTotal, rawC);
                } else if (!isScoreMissing) {
                    topicCorrect = ((getSafeScore(t, catMax, catMin) - catMin) / catRange) * topicTotal;
                } else if (Number.isFinite(rawC)) {
                    topicCorrect = Math.min(topicTotal, rawC);
                } else {
                    topicCorrect = 0;
                }
            } else {
                return;
            }
            if (Number.isNaN(topicCorrect)) return;
            topicCorrect = Math.max(0, topicCorrect);
            topicMap[topicKey].total += (topicTotal * timeWeight);
            topicMap[topicKey].correct += (topicCorrect * timeWeight);
            if (topicTotal > 0) {
                if (topicMap[topicKey].scores.length >= 20) {
                    topicMap[topicKey].scores = topicMap[topicKey].scores.slice(-19);
                }
                topicMap[topicKey].scores.push({
                    score: (topicCorrect / topicTotal) * 100,
                    total: topicTotal,
                    date: entryDate.toISOString(),
                    // ✅ FIX: score de tópico já está normalizado em percentual [0, 100]
                    maxScore: 100
                });
            }
            if (entryDate > topicMap[topicKey].lastSeen) {
                topicMap[topicKey].lastSeen = entryDate;
            }
        });
    });
    tasks.forEach(task => {
        const name = String(task.topicName || task.topic || '').trim()
            || String(task.text || task.title || "").trim();
        if (!name) return;
        const topicKey = normalize(name) || name.toLowerCase();
        if (!topicMap[topicKey]) {
            topicMap[topicKey] = {
                displayName: name,
                total: 0,
                correct: 0,
                lastSeen: new Date(0),
                completed: !!task.completed,
                hasTasks: true,
                scores: []
            };
            topicMap[topicKey].hasUnfinishedTask = !task.completed;
        } else {
            if (
                name &&
                topicMap[topicKey].displayName === topicMap[topicKey].displayName?.toLowerCase() &&
                name !== name.toLowerCase()
            ) {
                topicMap[topicKey].displayName = name;
            }
            topicMap[topicKey].hasTasks = true;
            if (topicMap[topicKey].hasUnfinishedTask === undefined) {
                topicMap[topicKey].hasUnfinishedTask = !task.completed;
            } else if (!task.completed) {
                topicMap[topicKey].hasUnfinishedTask = true;
            }
            topicMap[topicKey].completed = !topicMap[topicKey].hasUnfinishedTask;
        }
        let newTaskPriority = 0;
        const normTaskPriority = normalizePriority(task?.priority);
        if (normTaskPriority === 'high') newTaskPriority = 40;
        else if (normTaskPriority === 'medium') newTaskPriority = 20;
        if (!task.completed) {
            topicMap[topicKey].manualPriority = Math.max(topicMap[topicKey].manualPriority || 0, newTaskPriority);
        }
    });
    const today = todayForTopics;
    const topics = Object.entries(topicMap).map(([key, data]) => {
        const name = data.displayName || key;
        const percentage = data.total > 0 ? (data.correct / data.total) * 100 : 0;
        const topicHistory = data.scores.slice(-3);
        const trend = topicHistory.length >= 2 ? calculateSlope(topicHistory, 100) * 30 : 0;
        let daysSince = 0;
        if (data.lastSeen.getTime() === 0) {
            daysSince = 30;
        } else {
            daysSince = getDaysDiff(today, data.lastSeen);
        }
        const priorityBoost = data.manualPriority || 0;
        const perfComponent = Math.max(0, Math.min(1, (100 - percentage) / 100));
        const recencyComponent_topic = Math.max(0, Math.min(1, daysSince / 60));
        const priorityComponent = Math.max(0, Math.min(1, priorityBoost / 40));
        const perfRatio = percentage / 100;
        const TOPIC_W_PERF = 0.70 - (0.40 * perfRatio);
        const TOPIC_W_RECENCY = 0.10 + (0.40 * perfRatio);
        const TOPIC_W_PRIORITY = 0.20;
        let urgencyScore = (
            perfComponent * TOPIC_W_PERF +
            recencyComponent_topic * TOPIC_W_RECENCY +
            priorityComponent * TOPIC_W_PRIORITY
        ) * 200;
        // FIX: tópicos não testados pesam menos do que tópicos já aferidos
        if (data.total === 0) {
            urgencyScore *= 0.45;
        }
        const topicDropThreshold = -2.0;
        if (trend < topicDropThreshold) {
            const dropSeverity = Math.min(2.0, 1 + Math.abs(trend / topicDropThreshold) * 0.1);
            urgencyScore *= dropSeverity;
        }
        return {
            name,
            total: data.total,
            percentage,
            daysSince,
            trend: Number(trend.toFixed(2)),
            priorityBoost,
            urgencyScore,
            isUntested: data.total === 0,
            manualPriority: data.manualPriority || 0,
            completed: data.completed,
            hasTasks: !!data.hasTasks,
            scores: data.scores.slice(-8),
            lastSeen: data.lastSeen
        };
    });
    // ==================== LOTE 4: BAYESIAN TOPICS ====================
    let bayesianTopicMap = null;
    if (getCoachFeature(options, 'useBayesianTopics', false)) {
        try {
            const bayesianInput = topics.map(topic => ({
                name: topic.name,
                total: topic.total,
                percentage: topic.percentage,
                correct: topic.total > 0 ? (topic.percentage / 100) * topic.total : 0,
                trend: topic.trend,
                isUntested: topic.isUntested
            }));
            const bayesianResult = estimateTopicProficiencies(bayesianInput, {
                untestedPriorMean: 0.25,
                untestedPriorWeight: 0.45
            });
            bayesianTopicMap = new Map(
                bayesianResult.topics.map(t => [t.name, t])
            );
            topics.forEach(topic => {
                const bayes = bayesianTopicMap.get(topic.name);
                if (!bayes) return;
                topic.bayesian = bayes;
                topic.bayesianProficiency = bayes.proficiencyMean * 100;
                topic.bayesianEvidence = bayes.evidence;
                topic.bayesianUncertainty = bayes.uncertainty;
                if (getCoachFeature(options, 'useBayesianTopicsForUrgency', false)) {
                    const weakness = clamp(1 - bayes.proficiencyMean, 0, 1);
                    const uncertainty = clamp(bayes.uncertainty, 0, 1);
                    const evidence = clamp(bayes.evidence, 0, 1);
                    const bayesianBoost = (weakness * 0.65 + uncertainty * 0.35) * 70;
                    topic.urgencyScore =
                        topic.urgencyScore * (0.75 + 0.25 * evidence) +
                        bayesianBoost;
                    if (topic.isUntested) {
                        const explorationFactor = 0.40 + 0.35 * uncertainty;
                        topic.urgencyScore *= explorationFactor;
                    }
                }
            });
        } catch (err) {
            console.warn('[CoachLogic] Bayesian topics failed:', err);
            bayesianTopicMap = null;
        }
    }
    // ==================== LOTE 5: DECISION UTILITY ====================
    let decisionTopicMap = null;
    if (getCoachFeature(options, 'useDecisionUtility', false)) {
        try {
            const cognitiveFatigue = options?.studyLogs
                ? (getCognitiveState(options.studyLogs, { now: today })?.fatigue ?? 0)
                : 0;
            const decisionCandidates = topics.map(topic => {
                const bayesianProficiency = Number.isFinite(topic.bayesianProficiency)
                    ? topic.bayesianProficiency
                    : topic.percentage;
                const weakness = clamp(1 - (bayesianProficiency / 100), 0, 1);
                const uncertainty = Number.isFinite(topic.bayesianUncertainty)
                    ? topic.bayesianUncertainty
                    : (topic.total > 0
                        ? clamp(10 / (topic.total + 10), 0, 1)
                        : 0.85);
                const evidence = Number.isFinite(topic.bayesianEvidence)
                    ? topic.bayesianEvidence
                    : clamp(topic.total / (topic.total + 10), 0, 1);
                return {
                    id: `topic:${topic.name}`,
                    name: topic.name,
                    type: 'topic',
                    weakness,
                    uncertainty,
                    evidence,
                    errorRate: topic.total > 0 ? clamp(1 - (topic.percentage / 100), 0, 1) : 0,
                    mcRisk: options?.mcRiskLabel ?? null,
                    recencyDays: topic.daysSince,
                    priority: topic.manualPriority >= 40
                        ? 'high'
                        : topic.manualPriority >= 20
                            ? 'medium'
                            : 'low',
                    priorityValue: clamp((topic.manualPriority || 0) / 40, 0, 1),
                    hasTasks: topic.hasTasks,
                    completed: topic.completed,
                    costMinutes: 35,
                    fatigue: cognitiveFatigue,
                    weight: Number(safeCat?.weight) || 5
                };
            });
            const rankedDecisionTopics = rankDecisionCandidates(decisionCandidates, {
                useBandit: getCoachFeature(options, 'useBanditPlanner', false),
                contestId: options?.contestId || options?.config?.contestId,
                seed: `topics-${topics.length}-${getDateKey(today)}`,
                explorationScale: 16
            });
            decisionTopicMap = new Map(
                rankedDecisionTopics.map(item => [item.name, item])
            );
            topics.forEach(topic => {
                const decisionItem = decisionTopicMap.get(topic.name);
                if (!decisionItem) return;
                topic.decisionUtility = decisionItem.decision?.utility ?? 0;
                topic.decisionScore = decisionItem.decisionScore ?? 0;
                topic.decisionExploration = decisionItem.explorationBonus ?? 0;
                topic.decisionComponents = decisionItem.decision?.components ?? null;
                if (getCoachFeature(options, 'useDecisionUtilityForTopics', false)) {
                    // Escala decisionUtility [0..100] para a mesma escala [0..200] de urgencyScore
                    topic.urgencyScore =
                        topic.urgencyScore * 0.70 +
                        (topic.decisionUtility * 2) * 0.30;
                }
            });
        } catch (err) {
            console.warn('[CoachLogic] Decision utility topics failed:', err);
            decisionTopicMap = null;
        }
    }
    const useBayesianSort = getCoachFeature(options, 'useBayesianTopicsForUrgency', false);
    const useDecisionSort = getCoachFeature(options, 'useDecisionUtilityForTopics', false);
    // ==================== LOTE 7: FSRS + KNOWLEDGE GRAPH ====================
    if (getCoachFeature(options, 'useAdvancedFsrs', false)) {
        try {
            topics.forEach(topic => {
                topic.fsrs = estimateTopicFsrs(
                    {
                        name: topic.name,
                        scores: topic.scores || [],
                        lastSeen: topic.lastSeen,
                        daysSince: topic.daysSince,
                        total: topic.total,
                        percentage: topic.percentage,
                    },
                    {
                        maxScore: 100,
                        scoreScale: 100,
                        desiredRetention: 0.85,
                    }
                );
                if (
                    getCoachFeature(options, 'useFsrsTopicScheduling', false) &&
                    topic.fsrs
                ) {
                    const retentionRisk = clamp(
                        1 - (topic.fsrs.retentionPct / 100),
                        0,
                        1
                    );
                    const dueBoost = topic.fsrs.due ? 10 : 0;
                    topic.urgencyScore += retentionRisk * 18 + dueBoost;
                    if (topic.fsrs.due) {
                        topic.srsDue = true;
                    }
                }
            });
        } catch (err) {
            console.warn('[CoachLogic] Advanced FSRS topics failed:', err);
        }
    }
    if (getCoachFeature(options, 'useKnowledgeGraph', false)) {
        try {
            const graphConfig = getKnowledgeGraphForCategory(
                category?.name || category?.id,
                category
            );
            if (graphConfig) {
                const graphInput = topics.map(topic => ({
                    name: topic.name,
                    proficiency: Number.isFinite(topic.bayesianProficiency)
                        ? topic.bayesianProficiency / 100
                        : topic.percentage / 100,
                    evidence: Number.isFinite(topic.bayesianEvidence)
                        ? topic.bayesianEvidence
                        : clamp(topic.total / (topic.total + 10), 0, 1),
                    total: topic.total,
                }));
                const graphMetrics = computeTopicGraphMetrics(graphInput, graphConfig);
                const graphMap = new Map(
                    graphMetrics.topics.map(metric => [metric.normalizedKey || normalizeGraphName(metric.name), metric])
                );
                topics.forEach(topic => {
                    const metric = graphMap.get(normalizeGraphName(topic.name));
                    if (!metric) return;
                    topic.graph = metric;
                    if (getCoachFeature(options, 'useKnowledgeGraphForTopics', false)) {
                        const importanceBoost = metric.graphImportance * 22;
                        const prereqPenalty = (1 - metric.prereqReadiness) * 16;
                        topic.urgencyScore =
                            topic.urgencyScore + importanceBoost - prereqPenalty;
                        if ((metric.blockedBy || []).length > 0) {
                            topic.urgencyScore *= 0.92;
                            topic.recommendedPrerequisites = metric.blockedBy;
                        }
                    }
                });
            }
        } catch (err) {
            console.warn('[CoachLogic] Knowledge graph topics failed:', err);
        }
    }
    topics.sort((a, b) => {
        const aNeedsAction = !a.completed && a.hasTasks;
        const bNeedsAction = !b.completed && b.hasTasks;
        const aProf = useBayesianSort && Number.isFinite(a.bayesianProficiency)
            ? a.bayesianProficiency
            : a.percentage;
        const bProf = useBayesianSort && Number.isFinite(b.bayesianProficiency)
            ? b.bayesianProficiency
            : b.percentage;
        // ✅ FIX: Validar urgencyScore antes de usar
        let aBase = Number.isFinite(a.urgencyScore) ? a.urgencyScore : 0;
        let bBase = Number.isFinite(b.urgencyScore) ? b.urgencyScore : 0;
        if (useDecisionSort) {
            if (Number.isFinite(a.decisionExploration)) aBase += a.decisionExploration;
            if (Number.isFinite(b.decisionExploration)) bBase += b.decisionExploration;
        }
        let aScore = aBase + (aNeedsAction ? 50 : 0);
        let bScore = bBase + (bNeedsAction ? 50 : 0);
        if (a.total > 0 && aProf < 40) aScore += 80;
        else if (a.total > 0 && aProf < 60) aScore += 40;
        if (b.total > 0 && bProf < 40) bScore += 80;
        else if (b.total > 0 && bProf < 60) bScore += 40;
        if (useBayesianSort) {
            const aEvidence = Number.isFinite(a.bayesianEvidence) ? a.bayesianEvidence : 0;
            const bEvidence = Number.isFinite(b.bayesianEvidence) ? b.bayesianEvidence : 0;
            if (a.total > 0) aScore += aEvidence * 15;
            if (b.total > 0) bScore += bEvidence * 15;
            if (a.total === 0) aScore -= 12;
            if (b.total === 0) bScore -= 12;
        } else {
            if (a.total === 0) aScore -= 25;
            if (b.total === 0) bScore -= 25;
        }
        // ✅ FIX: Garantir que scores não são NaN/Infinity
        const finalAScore = Number.isFinite(aScore) ? aScore : 0;
        const finalBScore = Number.isFinite(bScore) ? bScore : 0;
        return finalBScore - finalAScore;
    });
    return topics;
};

const getWeakestTopic = (category, simulados = [], maxScore = 100, minScore = 0, options = {}) => {
    const topics = _buildSortedTopics(category, simulados, maxScore, minScore, options);
    return (topics && topics.length > 0) ? topics[0] : null;
};

const getWeakestTopicsList = (category, simulados = [], maxScore = 100, limit = 3, minScore = 0, options = {}) => {
    const topics = _buildSortedTopics(category, simulados, maxScore, minScore, options);
    return (topics || []).slice(0, limit);
};

export const generateDailyGoals = (categories, simulados, studyLogs = [], options = {}) => {
    const optMin = parseOptionalFinite(options.minScore);
    const optMax = parseOptionalFinite(options.maxScore);
    const optTarget = parseOptionalFinite(options.targetScore);
    const minScore = optMin !== null ? optMin : 0;
    const maxScore = (optMax !== null && optMax > minScore) ? optMax : (minScore + 100);
    const domain = Math.max(1e-9, maxScore - minScore);
    const targetScore = optTarget !== null ? optTarget : (minScore + domain * 0.8);
    const cfg = { ...DEFAULT_CONFIG, ...(options.config || {}) };
    const safeCategories = Array.isArray(categories) ? categories : Object.values(categories || {});
    if (safeCategories.length === 0) return [];
    const safeSimulados = safeArray(simulados);
    const safeStudyLogs = safeArray(studyLogs);
    const callerAllCategories = safeArray(options?.allCategories);
    const effectiveAllCategories = callerAllCategories.length > 0 ? callerAllCategories : safeCategories;
    const sharedCtx = buildSharedUrgencyContext(safeSimulados, safeStudyLogs, effectiveAllCategories, options);
    const batchOptions = { ...options, allCategories: effectiveAllCategories, minScore, maxScore, targetScore, [SHARED_URGENCY_CTX]: sharedCtx };
    const ranked = safeCategories.map(cat => ({
        ...cat,
        urgency: calculateUrgency(cat, safeSimulados, safeStudyLogs, batchOptions)
    })).sort((a, b) => {
        const valA = Number.isFinite(a.urgency.normalizedScore) ? a.urgency.normalizedScore : -Infinity;
        const valB = Number.isFinite(b.urgency.normalizedScore) ? b.urgency.normalizedScore : -Infinity;
        if (valA !== valB) return valB - valA;
        const rawA = Number.isFinite(a.urgency.score) ? a.urgency.score : -Infinity;
        const rawB = Number.isFinite(b.urgency.score) ? b.urgency.score : -Infinity;
        if (rawA !== rawB) return rawB - rawA;
        return String(a.id || '').localeCompare(String(b.id || ''));
    });
    const topCategories = ranked.slice(0, 10);
    const performDeepCheck = (category, averageScore) => {
        const baseDate = options.now ? (normalizeDate(options.now) || new Date()) : new Date();
        const thirtyDaysAgo = new Date(baseDate.getTime() - 30 * 24 * 60 * 60 * 1000);
        const cutoffTime = thirtyDaysAgo.getTime();

        // ✅ FIX: Permitir filtro por categoryId OU nome da disciplina (mesmo quando category.id estiver ausente)
        const categoryId = category?.id;
        const catName = category?.name || category?.id || '';
        const recentLogs = (categoryId || catName)
            ? safeStudyLogs.filter(l => {
                const matchesId = categoryId !== undefined && categoryId !== null && l?.categoryId !== undefined && l?.categoryId !== null && (
                    l.categoryId === categoryId || String(l.categoryId) === String(categoryId)
                );
                // FIX C-02: logs antigos podem ter só categoryName/subject.
                const matchesName = catName && (l?.categoryName || l?.subject || l?.materia)
                    ? isSubjectMatch(l?.categoryName || l?.subject || l?.materia, catName)
                    : false;
                return (matchesId || matchesName) &&
                    (normalizeDate(l?.date || l?.createdAt) || new Date(0)).getTime() >= cutoffTime;
            })
            : [];

        // ✅ FIX: Incluir simulados de safeSimulados E category.simuladoStats.history (com deduplicação e isSubjectMatch)
        const catHistorySims = safeArray(category?.simuladoStats?.history).filter(h =>
            h && (normalizeDate(h?.date || h?.createdAt) || new Date(0)).getTime() >= cutoffTime
        );
        const globalMatchingSims = (categoryId || catName)
            ? safeSimulados.filter(s => {
                if (!s) return false;
                const matchesId = categoryId !== undefined && categoryId !== null && s?.categoryId !== undefined && s?.categoryId !== null && (
                    s.categoryId === categoryId || String(s.categoryId) === String(categoryId)
                );
                const matchesSubj = catName && isSubjectMatch(s?.subject || s?.categoryName || s?.materia || s?.disciplina || '', catName);
                return (matchesId || matchesSubj) &&
                    (normalizeDate(s?.date || s?.createdAt) || new Date(0)).getTime() >= cutoffTime;
            })
            : [];
        const seenDeepCheckKeys = new Set();
        const recentSims = [];
        [...catHistorySims, ...globalMatchingSims].forEach((s, idx) => {
            const dKey = getDateKey(s?.date || s?.createdAt) || `idx_${idx}`;
            const k = s?.batchId ? `b_${s.batchId}` : (s?.id && !String(s.id).startsWith('legacy-') ? `id_${s.id}` : `d_${dKey}`);
            if (seenDeepCheckKeys.has(k)) return;
            seenDeepCheckKeys.add(k);
            recentSims.push(s);
        });

        const deepCatMax = parseOptionalFinite(category?.maxScore);
        const deepCatMin = parseOptionalFinite(category?.minScore);
        const catMax = (deepCatMax !== null && deepCatMax > 0)
            ? deepCatMax
            : (maxScore > minScore ? maxScore : minScore + 100);
        const catMin = deepCatMin !== null
            ? Math.min(deepCatMin, catMax)
            : minScore;
        const catRange = Math.max(1e-9, catMax - catMin);
        const totalHours = recentLogs.reduce((acc, l) => acc + sanitizeMinutes(l?.minutes ?? l?.minutos ?? l?.duration), 0) / 60;
        const totalQuestions = recentSims.reduce((acc, s) => acc + (Number(s?.total ?? s?.questoes ?? s?.totalQuestoes ?? s?.questions) || getSyntheticTotal(catMax)), 0);
        const questionsPerHour = totalHours >= 0.25 ? totalQuestions / totalHours : 0;
        const dynamicThreshold = totalHours >= 20 ? 30 : totalHours >= 10 ? 20 : 12;

        // ✅ FIX: Validar averageScore antes de calcular normalizedScore
        const safeAverageScore = Number.isFinite(averageScore) ? averageScore : catMin;
        const normalizedScore = catRange > 0 ? ((safeAverageScore - catMin) / catRange) * 100 : 0;
        const isFormingBase = normalizedScore < 45;

        if (totalHours > 5 && questionsPerHour < dynamicThreshold && !isFormingBase) {
            return {
                isTrap: true,
                msg: `⚠️ Alerta de Método: Estudou ${totalHours.toFixed(1)}h de ${catName || category?.id || 'matéria'} mas resolveu poucas questões (${questionsPerHour.toFixed(1)}/h). O seu nível atual exige prática >${dynamicThreshold}/h.`
            };
        }
        return { isTrap: false };
    };
    let allGeneratedTasks = [];
    const tasksPerCategory = topCategories.length < 5 ? 3 : (topCategories.length < 8 ? 2 : 1);
    topCategories.forEach((cat) => {
        let localPriorityCounter = 0;
        const safeCatKey = cat.id || normalize(cat.name) || 'cat';
        const safeCategoryId = cat.id || safeCatKey;
        const optCatMax = parseOptionalFinite(cat?.maxScore);
        const optCatMin = parseOptionalFinite(cat?.minScore);
        const catMax = (optCatMax !== null && optCatMax > 0) ? optCatMax : maxScore;
        const catMin = optCatMin !== null ? Math.min(optCatMin, catMax) : minScore;
        const catRange = Math.max(1e-9, catMax - catMin);
        const mc = cat.urgency?.details?.monteCarlo;
        const topicOptionsForCat = {
            ...options,
            studyLogs: options?.studyLogs ?? safeStudyLogs,
            mcRiskLabel: mc?.riskLabel ?? null,
        };
        const allCategoryTopics = _buildSortedTopics(cat, safeSimulados, catMax, catMin, topicOptionsForCat) || [];
        const weakTopics = allCategoryTopics.slice(0, tasksPerCategory);
        const iterations = tasksPerCategory;
        const catTasksList = (Array.isArray(cat?.tasks) ? cat.tasks : Object.values(cat?.tasks || {})).filter(Boolean);
        const assignedTopicNames = new Set();
        const toTopicKey = (val) => {
            const raw = String(val || '').trim();
            if (!raw) return '';
            return normalize(raw) || raw.toLowerCase();
        };
        const markTopicAssigned = (val) => {
            const k = toTopicKey(val);
            if (!k) return;
            assignedTopicNames.add(k);
            for (const t of catTasksList) {
                const keys = [
                    toTopicKey(t.topicName),
                    toTopicKey(t.topic),
                    toTopicKey(t.text),
                    toTopicKey(t.title),
                    toTopicKey(t.name)
                ].filter(Boolean);
                if (keys.includes(k)) {
                    keys.forEach(aliasKey => assignedTopicNames.add(aliasKey));
                }
            }
        };
        const isTopicAssigned = (val) => {
            const k = toTopicKey(val);
            return k ? assignedTopicNames.has(k) : false;
        };
        const isTaskTopicAssigned = (t) => {
            if (!t) return false;
            return (
                isTopicAssigned(t.topicName) ||
                isTopicAssigned(t.topic) ||
                isTopicAssigned(t.text) ||
                isTopicAssigned(t.title) ||
                isTopicAssigned(t.name)
            );
        };
        const getPriorityLabel = (priority = 'high') => {
            if (priority === 'high' || (priority === 'medium' && localPriorityCounter === 0)) {
                localPriorityCounter++;
                return '[PROTOCOLO PRIORITÁRIO] ';
            }
            return '';
        };
        const adaptiveDanger = mc?.thresholds?.danger || cfg.MC_PROB_DANGER;
        const adaptiveSafe = mc?.thresholds?.safe || cfg.MC_PROB_SAFE;
        // ✅ FIX: sufixo determinístico — sem Date.now() (IDs estáveis p/ Planner/dedupe)
        const mcIdSuffix = hashString64(`${safeCatKey}|mc`);
        // Ordem corrigida: crítico > caos > SRS > cruzeiro > trap
        const calibratedProb = mc
            ? (Number.isFinite(Number(mc.probability)) ? Number(mc.probability) : Number(mc.probabilityRaw))
            : null;
        if (mc && Number.isFinite(calibratedProb) && calibratedProb < adaptiveDanger) {
            const probPct = Math.round(calibratedProb);
            const parsedCatCutoff = parseOptionalFinite(cat?.minCutoff);
            const catTargetScore = parsedCatCutoff !== null
                ? clamp(parsedCatCutoff, catMin, catMax)
                : (Math.abs(catMax - maxScore) < 1e-6 && Math.abs(catMin - minScore) < 1e-6
                    ? targetScore
                    : catMin + clamp((targetScore - minScore) / domain, 0, 1) * catRange);
            const parsedMcEffTarget = parseOptionalFinite(mc?.effectiveMCTarget);
            const mcEffTarget = parsedMcEffTarget !== null ? parsedMcEffTarget : catTargetScore;
            const zdpNote = mcEffTarget < catTargetScore - 1e-6
                ? ` (Meta ZDP: ${catMin === 0 && catMax === 100 ? `${Math.round(mcEffTarget)}%` : `${formatValue(mcEffTarget)} pts`})`
                : '';
            allGeneratedTasks.push({
                // FIX (LOGIC): Removido mcProbKey do ID para manter estabilidade no Planner
                id: `${safeCatKey}-mc-danger-${mcIdSuffix}`,
                actionType: 'mock_exam',
                text: `${cat.name}: [ALERTA MESTRE] 🚨 VETOR CRÍTICO! Projeção matemática indica colapso de performance.`,
                completed: false,
                status: 'pending',
                priority: 'high',
                categoryId: safeCategoryId,
                category: cat.name,
                catName: cat.name,
                subjectName: cat.name,
                topicName: 'Vetor Crítico — Intervenção Exigida',
                analysis: {
                    reason: "Monte Carlo — Zona de Perigo",
                    details: `Apenas ${probPct}% de chance de bater a meta de ${options.targetScoreLabel != null ? `${options.targetScoreLabel}%` : (catMin === 0 && catMax === 100 ? `${Math.round(catTargetScore)}%` : `${formatValue(catTargetScore)} pts (${Math.round(((catTargetScore - catMin) / catRange) * 100)}%)`)}${zdpNote} em ${Number.isFinite(Number(mc?.effectiveMCDays)) && Number(mc.effectiveMCDays) > 0 ? Math.round(Number(mc.effectiveMCDays)) : 90} dias.`,
                    metrics: cat.urgency?.details?.humanReadable || {},
                    monteCarlo: mc || null,
                    verdict: "Probabilidade crítica detectada. Mude de método imediatamente."
                }
            });
        } else if (mc && mc.volatility > cfg.MC_VOLATILITY_HIGH * (catRange / 100) && Number.isFinite(calibratedProb) && calibratedProb < adaptiveSafe) {
            const probPct = Math.round(calibratedProb);
            allGeneratedTasks.push({
                // FIX (LOGIC): Removido mcVolKey e mcProbKey do ID para manter estabilidade
                id: `${safeCatKey}-mc-chaos-${mcIdSuffix}`,
                text: `${cat.name}: [ALERTA MESTRE] 🌪️ OSCILAÇÃO ESTATÍSTICA: Padrão imprevisível detectado.`,
                completed: false,
                status: 'pending',
                priority: 'high',
                categoryId: safeCategoryId,
                category: cat.name,
                catName: cat.name,
                subjectName: cat.name,
                topicName: 'Oscilação Estatística — Caos Detectado',
                analysis: {
                    reason: "Monte Carlo — Caos Estatístico",
                    details: `Volatilidade MSSD: ${mc.volatility.toFixed(2)}. Probabilidade: ${probPct}%.`,
                    metrics: cat.urgency?.details?.humanReadable || {},
                    monteCarlo: mc || null,
                    verdict: "Seu nível base é promissor, mas a inconsistência torna a aprovação imprevisível."
                }
            });
        } else if (cat.urgency?.details?.srsLabel) {
            const srsKey = cat.urgency?.details?.srsLabel.replace(/\s/g, '').substring(0, 15);
            const srsTopic = weakTopics[0]?.name || 'Revisão Espaçada (SRS)';
            allGeneratedTasks.push({
                id: `${safeCatKey}-srs-${srsKey}`,
                actionType: 'srs_review',
                text: `${cat.name}: [${srsTopic}]`,
                completed: false,
                status: 'pending',
                priority: 'high',
                categoryId: safeCategoryId,
                category: cat.name,
                catName: cat.name,
                subjectName: cat.name,
                topicName: srsTopic,
                analysis: {
                    reason: "Revisão Espaçada (SRS) Ativada",
                    label: cat.urgency?.details?.srsLabel,
                    metrics: cat.urgency?.details?.humanReadable || {},
                    monteCarlo: mc || null,
                    verdict: "Intervalo de retenção atingido. Revisão crítica para memória de longo prazo."
                }
            });
        } else if (mc && Number.isFinite(calibratedProb) && calibratedProb >= adaptiveSafe && calibratedProb >= adaptiveDanger) {
            const probPct = Math.round(calibratedProb);
            allGeneratedTasks.push({
                // FIX (LOGIC): Emitido como alerta de sistema [STATUS] para acionar o banner Cruzeiro Seguro no AICoachView sem duplicar tarefa comum
                id: `${safeCatKey}-mc-safe-${mcIdSuffix}`,
                actionType: 'general_review',
                text: `${cat.name}: [STATUS] 🏆 CRUZEIRO SEGURO: ${probPct}% de probabilidade de atingir a meta.`,
                completed: false,
                status: 'pending',
                priority: 'low',
                categoryId: safeCategoryId,
                category: cat.name,
                catName: cat.name,
                subjectName: cat.name,
                topicName: `Manutenção — ${cat.name}`,
                analysis: {
                    reason: "Monte Carlo — Cruzeiro Seguro",
                    details: `${probPct}% de probabilidade de atingir a meta.`,
                    metrics: cat.urgency?.details?.humanReadable || {},
                    monteCarlo: mc || null,
                    verdict: "Mantenha o ritmo atual para proteger sua posição."
                }
            });
        } else if (performDeepCheck(cat, cat.urgency?.details?.averageScore).isTrap) {
            const trapTopicCandidate = allCategoryTopics[0]?.name ||
                (Array.isArray(cat?.tasks) ? cat.tasks : Object.values(cat?.tasks || {})).find(t => t && !t.completed && (t.text || t.title))?.text;
            const trapTopic = trapTopicCandidate ? ` — ${trapTopicCandidate}` : '';
            allGeneratedTasks.push({
                id: `${safeCatKey}-trap-trap`,
                text: `${cat.name}: [Estudo Ativo & Auto-Explicação${trapTopic}]`,
                completed: false,
                status: 'pending',
                priority: 'medium',
                categoryId: safeCategoryId,
                category: cat.name,
                catName: cat.name,
                subjectName: cat.name,
                topicName: trapTopicCandidate || 'Estudo Ativo & Auto-Explicação',
                analysis: {
                    reason: "Otimização de Estudo",
                    details: "Alta carga horária teórica acumulada — hora de elevar a densidade cognitiva.",
                    metrics: cat.urgency?.details?.humanReadable || {},
                    monteCarlo: mc || null,
                    verdict: "Substitua a leitura passiva por auto-explicação ativa, síntese e estruturação de esquemas mentais."
                }
            });
        }
        const agilityData = cat.urgency?.details?.agilityPenalty !== undefined
            ? {
                avgSeconds: cat.urgency?.details?.avgSeconds || 0,
                agilityPenalty: cat.urgency?.details?.agilityPenalty || 0
            }
            : computeAgilityMetrics((cat.simuladoStats && Array.isArray(cat.simuladoStats.history)) ? cat.simuladoStats.history : []);
        // ✅ PATCH-12: Validar avgSeconds explicitamente
        const avgSeconds = Number.isFinite(agilityData?.avgSeconds) ? agilityData.avgSeconds : 0;
        const targetSeconds = 120;
        const isAgilityProblem = (avgSeconds > targetSeconds + 30) && (cat.urgency?.normalizedScore >= 75);
        if (isAgilityProblem) {
            const agilityTopicCandidate = allCategoryTopics[0]?.name ||
                (Array.isArray(cat?.tasks) ? cat.tasks : Object.values(cat?.tasks || {})).find(t => t && !t.completed && (t.text || t.title))?.text;
            const agilityTopicSuffix = agilityTopicCandidate ? ` — ${agilityTopicCandidate}` : ' — Fórmulas & Prazos';
            allGeneratedTasks.push({
                // FIX (LOGIC): Removido avgSeconds do ID para manter estabilidade no Planner
                id: `${safeCatKey}-agility`,
                actionType: 'agility_training',
                text: `${cat.name}: [Revisão Expressa${agilityTopicSuffix}]`,
                completed: false,
                status: 'pending',
                priority: 'medium',
                categoryId: safeCategoryId,
                category: cat.name,
                catName: cat.name,
                subjectName: cat.name,
                topicName: agilityTopicCandidate || 'Revisão Expressa — Fórmulas e Prazos',
                analysis: {
                    reason: "Agilidade Cognitiva AI",
                    details: `Identificada oportunidade de acelerar a retenção de conceitos de ${cat.name}.`,
                    metrics: cat.urgency?.details?.humanReadable || {},
                    monteCarlo: mc || null,
                    verdict: "Sessão rápida de estudo: revise resumos de alta densidade, mnemônicos e fórmulas para agilizar a recuperação de memória."
                }
            });
        }
        let topicCursor = 0;
        let srsBlitzAssigned = false;
        for (let i = 0; i < iterations; i++) {
            const weakTopic = (topicCursor < weakTopics.length) ? weakTopics[topicCursor++] : null;
            // FIX (LOGIC): Removido weakTopic.total do ID para evitar que a tarefa suma do planner ao fazer exercícios;
            // inclui hash normalizado do nome completo para evitar colisões quando os 10 primeiros caracteres coincidem.
            const topicSlug = weakTopic
                ? weakTopic.name.replace(/\s/g, '').substring(0, 10).replace(/[^a-zA-Z0-9]/g, '')
                : '';
            const topicHash = weakTopic ? hashString(normalize(weakTopic.name) || weakTopic.name.trim().toLowerCase()) : '';
            const uniqueIdSuffix = weakTopic
                ? `${topicSlug || 'topico'}-${i}-${topicHash}`
                : `geral-${i}`;
            if (weakTopic) {
                markTopicAssigned(weakTopic.name);
                let reasonStr = "";
                let topicPriority = 'medium';
                let actionPrefix = "";
                let customTopicName = weakTopic.name;

                const hasTestedTopicData = !weakTopic.isUntested && Number(weakTopic.total) > 0;
                if (hasTestedTopicData && weakTopic.percentage < 40) {
                    reasonStr = "Vetor Crítico de Erros";
                    topicPriority = 'high';
                } else if (hasTestedTopicData && weakTopic.percentage < 60) {
                    reasonStr = "Lacuna de Conhecimento";
                    topicPriority = 'medium';
                } else if (weakTopic.trend < -2) {
                    reasonStr = "Degradação Recente";
                    topicPriority = 'medium';
                } else if (weakTopic.daysSince >= 14 && weakTopic.total > 0) {
                    reasonStr = "Curva de Esquecimento / Recência";
                    const isSevereDecay = weakTopic.daysSince >= 45 || (weakTopic.daysSince >= 30 && Number(cat?.weight || 5) >= 7);
                    topicPriority = isSevereDecay ? 'high' : (weakTopic.daysSince >= 21 ? 'medium' : 'low');
                    actionPrefix = "Revisão por Recência — ";
                    customTopicName = `Revisão por Recência — ${weakTopic.name}`;
                } else if (weakTopic.isUntested) {
                    reasonStr = "Cobertura de Edital";
                    topicPriority = 'medium';
                    actionPrefix = "Avanço de Edital — ";
                    customTopicName = `Avanço de Edital — ${weakTopic.name}`;
                } else {
                    reasonStr = "Consolidação Estratégica";
                    topicPriority = 'low';
                }

                const displayLabel = actionPrefix ? `${actionPrefix}${weakTopic.name}` : weakTopic.name;
                const topicLabel = `${getPriorityLabel(topicPriority)}[${displayLabel}]`;
                let verdictStr = `Priorize ${weakTopic.name} — ${reasonStr}.`;
                if (actionPrefix.startsWith("Revisão por Recência")) {
                    verdictStr = `Revise os grifos, notas e esquemas conceituais de ${weakTopic.name} para reativar a memória de longo prazo.`;
                } else if (actionPrefix.startsWith("Avanço de Edital")) {
                    verdictStr = `Estude a base teórica e conceitos fundamentais de ${weakTopic.name}, anotando os pontos-chave no material.`;
                }

                allGeneratedTasks.push({
                    id: `${safeCatKey}-topic-${uniqueIdSuffix}`,
                    actionType: actionPrefix.startsWith("Revisão por Recência") ? 'srs_review' : 'weak_topic_practice',
                    text: `${cat.name}: ${topicLabel}`,
                    completed: false,
                    status: 'pending',
                    priority: topicPriority,
                    categoryId: safeCategoryId,
                    category: cat.name,
                    catName: cat.name,
                    subjectName: cat.name,
                    topicName: customTopicName,
                    analysis: {
                        reason: reasonStr,
                        details: `Aproveitamento: ${Number(weakTopic.percentage || 0).toFixed(0)}% | Última visita: ${weakTopic.daysSince ?? 0} dias | Tendência: ${Number(weakTopic.trend || 0) > 0 ? '+' : ''}${Number(weakTopic.trend || 0).toFixed(1)}`,
                        metrics: cat.urgency?.details?.humanReadable || {},
                        monteCarlo: mc || null,
                        verdict: verdictStr
                    }
                });

            } else {
                // ====================================================================
                // CASCATA DE REVISÃO ATIVA (Substituição Inteligente de Revisão Geral)
                // ====================================================================
                let activeTask = null;

                // NÍVEL 1: Tópico Dormente / Recência (daysSince >= 14)
                const dormantCandidates = allCategoryTopics.filter(t => {
                    if (!t || !t.name) return false;
                    if (isTopicAssigned(t.name)) return false;
                    return t.total > 0 && t.daysSince >= 14;
                }).sort((a, b) => b.daysSince - a.daysSince);

                if (dormantCandidates.length > 0) {
                    const dormant = dormantCandidates[0];
                    markTopicAssigned(dormant.name);
                    const safeDays = Math.round(dormant.daysSince);
                    const safePct = Math.round(Number(dormant.percentage || 0));
                    const safeSlug = dormant.name.replace(/\s/g, '').substring(0, 10).replace(/[^a-zA-Z0-9]/g, '');
                    const isSevereDecay = safeDays >= 45 || (safeDays >= 30 && Number(cat?.weight || 5) >= 7);
                    const dormantPriority = isSevereDecay ? 'high' : (safeDays >= 21 ? 'medium' : 'low');

                    activeTask = {
                        id: `${safeCatKey}-decay-${safeSlug}-${i}-${hashString(`${safeCatKey}|decay|${dormant.name}|${i}`)}`,
                        actionType: 'srs_review',
                        text: `${cat.name}: ${getPriorityLabel(dormantPriority)}[Revisão por Recência — ${dormant.name}]`,
                        completed: false,
                        status: 'pending',
                        priority: dormantPriority,
                        categoryId: safeCategoryId,
                        category: cat.name,
                        catName: cat.name,
                        subjectName: cat.name,
                        topicName: `Revisão por Recência — ${dormant.name}`,
                        analysis: {
                            reason: "Curva de Esquecimento / Recência",
                            details: `Sem contato há ${safeDays} dias (Aproveitamento anterior: ${safePct}%). Risco de perda de retenção de longo prazo.`,
                            metrics: cat.urgency?.details?.humanReadable || {},
                            monteCarlo: mc || null,
                            verdict: `Revise os grifos principais, notas e esquemas conceituais de ${dormant.name} para reativar a memória e proteger a retenção.`
                        }
                    };
                }

                // NÍVEL 2: Avanço de Edital (Tópicos cadastrados na matéria ainda não concluídos)
                if (!activeTask) {
                    const uncompletedSyllabusTasks = catTasksList.filter(t => {
                        if (!t || t.completed === true) return false;
                        if (String(t.status || '').toLowerCase() === 'completed') return false;
                        const title = (t.topicName || t.topic || t.text || t.title || t.name || '').trim();
                        if (!title) return false;
                        return !isTaskTopicAssigned(t);
                    });

                    if (uncompletedSyllabusTasks.length > 0) {
                        const syllabusTask = uncompletedSyllabusTasks[0];
                        const title = (syllabusTask.topicName || syllabusTask.topic || syllabusTask.text || syllabusTask.title || syllabusTask.name || '').trim();
                        markTopicAssigned(title);
                        const safeSlug = title.replace(/\s/g, '').substring(0, 10).replace(/[^a-zA-Z0-9]/g, '');
                        const syllabusPriority = syllabusTask.priority || 'medium';

                        activeTask = {
                            id: `${safeCatKey}-syllabus-${safeSlug}-${i}-${hashString(`${safeCatKey}|syllabus|${title}|${i}`)}`,
                            text: `${cat.name}: ${getPriorityLabel(syllabusPriority)}[Avanço de Edital — ${title}]`,
                            completed: false,
                            status: 'pending',
                            priority: syllabusPriority,
                            categoryId: safeCategoryId,
                            category: cat.name,
                            catName: cat.name,
                            subjectName: cat.name,
                            topicName: `Avanço de Edital — ${title}`,
                            analysis: {
                                reason: "Cobertura de Edital",
                                details: "Tópico pendente no plano de estudos da disciplina.",
                                metrics: cat.urgency?.details?.humanReadable || {},
                                monteCarlo: mc || null,
                                verdict: `Estude a base teórica e conceitos fundamentais de ${title}, consolidando os pontos essenciais no material.`
                            }
                        };
                    }
                }

                // NÍVEL 3: Flashcards SRS (Cartões com revisão vencida da disciplina)
                if (!activeTask && !srsBlitzAssigned) {
                    const flashcardDecks = Array.isArray(options?.flashcardDecks) ? options.flashcardDecks : Object.values(options?.flashcardDecks || {});
                    if (flashcardDecks.length > 0) {
                        const refDateObj = options.now ? (normalizeDate(options.now) || new Date()) : new Date();
                        const refKey = getDateKey(refDateObj);
                        const nowMs = refDateObj.getTime();
                        // FIX: agregar TODOS os decks correspondentes à matéria (não só o primeiro)
                        const matchingDecks = flashcardDecks.filter(d => {
                            if (!d) return false;
                            const matchId = d.categoryId && cat.id && (d.categoryId === cat.id || String(d.categoryId) === String(cat.id));
                            const matchName = (d.subject || d.name) && isSubjectMatch(d.subject || d.name, cat.name);
                            return matchId || matchName;
                        });

                        if (matchingDecks.length > 0) {
                            const dueCards = matchingDecks.flatMap(deck => {
                                const rawCards = Array.isArray(deck.cards) ? deck.cards : Object.values(deck.cards || {});
                                return rawCards.filter(c => {
                                    if (!c) return false;
                                    // FIX: flashcards do app salvam vencimento em `c.due`; só cair para nextReview/dueDate se `due` ausente
                                    if (c.due !== undefined && c.due !== null && c.due !== '') {
                                        return isFlashcardDue(c.due, refKey);
                                    }
                                    const legacyDue = c.nextReview ?? c.dueDate;
                                    if (legacyDue !== undefined && legacyDue !== null && legacyDue !== '') {
                                        const parsedLegacy = normalizeDate(legacyDue);
                                        return parsedLegacy ? parsedLegacy.getTime() <= nowMs : false;
                                    }
                                    return true;
                                });
                            });

                            if (dueCards.length > 0) {
                                srsBlitzAssigned = true;
                                const srsPriority = dueCards.length >= 15 ? 'high' : (dueCards.length >= 5 ? 'medium' : 'low');
                                activeTask = {
                                    id: `${safeCatKey}-srsblitz-${i}-${hashString(`${safeCatKey}|srs|${i}`)}`,
                                    actionType: 'srs_review',
                                    text: `${cat.name}: ${getPriorityLabel(srsPriority)}[SRS Blitz — Zerar ${dueCards.length} Flashcards]`,
                                    completed: false,
                                    status: 'pending',
                                    priority: srsPriority,
                                    categoryId: safeCategoryId,
                                    category: cat.name,
                                    catName: cat.name,
                                    subjectName: cat.name,
                                    topicName: `SRS Blitz — ${cat.name}`,
                                    analysis: {
                                        reason: "Repetição Espaçada (SRS)",
                                        details: `${dueCards.length} cartões de memória atingiram a data limite de retenção.`,
                                        metrics: cat.urgency?.details?.humanReadable || {},
                                        monteCarlo: mc || null,
                                        verdict: "Zere os flashcards pendentes para fixar conceitos essenciais e termos técnicos."
                                    }
                                };
                            }
                        }
                    }
                }

                // NÍVEL 4: Consolidação Teórica / Síntese & Mapeamento (Estudo aprofundado)
                if (!activeTask) {
                    const reviewPriority = 'low';
                    const availableTopicObj = allCategoryTopics.find(t => t?.name && !isTopicAssigned(t.name));
                    const uncompletedTask = catTasksList.find(t => {
                        if (t.completed) return false;
                        const label = (t.topicName || t.topic || t.text || t.title || t.name || '').trim();
                        return label && !isTaskTopicAssigned(t);
                    });
                    const unassignedTask = catTasksList.find(t => {
                        const label = (t.topicName || t.topic || t.text || t.title || t.name || '').trim();
                        return label && !isTaskTopicAssigned(t);
                    });
                    const synthesisFallbacks = [
                        'Síntese e Mapeamento',
                        'Revisão Estruturada e Esquemas',
                        'Auto-Explicação e Questões-Chave',
                    ];
                    const fallbackLabel = synthesisFallbacks.find(lbl => !isTopicAssigned(lbl)) ||
                        `Síntese e Mapeamento (${i + 1})`;

                    const resolvedTopicName = availableTopicObj?.name ||
                        (uncompletedTask ? (uncompletedTask.topicName || uncompletedTask.topic || uncompletedTask.text || uncompletedTask.title || uncompletedTask.name).trim() : null) ||
                        (unassignedTask ? (unassignedTask.topicName || unassignedTask.topic || unassignedTask.text || unassignedTask.title || unassignedTask.name).trim() : null) ||
                        fallbackLabel;

                    if (resolvedTopicName) {
                        markTopicAssigned(resolvedTopicName);
                    }

                    activeTask = {
                        id: `${safeCatKey}-synthesis-${i}-${hashString(`${safeCatKey}|synthesis|${i}`)}`,
                        actionType: 'general_review',
                        text: `${cat.name}: ${getPriorityLabel(reviewPriority)}[Consolidação Teórica — ${resolvedTopicName}]`,
                        completed: false,
                        status: 'pending',
                        priority: reviewPriority,
                        categoryId: safeCategoryId,
                        category: cat.name,
                        catName: cat.name,
                        subjectName: cat.name,
                        topicName: `Consolidação Teórica — ${resolvedTopicName}`,
                        analysis: {
                            reason: "Consolidação Teórica / Síntese",
                            details: `Estudo integrado e estruturação de conhecimento de ${resolvedTopicName} para reforçar conexões neurais da disciplina.`,
                            metrics: cat.urgency?.details?.humanReadable || {},
                            monteCarlo: mc || null,
                            verdict: `Dedique este bloco ao estudo aprofundado de ${resolvedTopicName} (${cat.name}): estruture mapas conceituais, resumos ou elabore auto-explicação dos tópicos densos.`
                        }
                    };
                }

                allGeneratedTasks.push(activeTask);
            }
        }
    });

    // ✅ CORREÇÃO — dedupe por ID. Tarefas geradas não possuem
    // lastUpdated/createdAt, então a primeira ocorrência é mantida
    // (os duplicados têm conteúdo idêntico — o dedupe é só garantia
    // de unicidade).
    const taskMap = new Map();
    for (const t of allGeneratedTasks) {
        if (!t || !t.id) continue;

        const existing = taskMap.get(t.id);
        if (!existing) {
            taskMap.set(t.id, t);
            continue;
        }

        // Se já existe, manter o mais recente (por lastUpdated ou createdAt)
        const toTime = (d) => (normalizeDate(d) || new Date(0)).getTime();
        const existingTime = toTime(existing.lastUpdated || existing.createdAt);
        const newTime = toTime(t.lastUpdated || t.createdAt);

        if (newTime > existingTime) {
            taskMap.set(t.id, t); // substitui pela versão mais nova
        }
    }

    // ✅ FIX: Deduplicar por ID e por texto para evitar duplicatas
    const seenTexts = new Set();
    const dedupedTasks = Array.from(taskMap.values()).filter(task => {
        if (!task || !task.id) return false;
        const textKey = `${task.categoryId || ''}|${task.topicName || ''}|${task.text || ''}`;
        if (seenTexts.has(textKey)) return false;
        seenTexts.add(textKey);
        return true;
    });

    // BUG: testes exigiam máximo de 12 tarefas, mas o generator podia crescer sem limite.
    // MELHORIA: Quando houver mais de 12 itens, impedir que alertas informativos ([STATUS] / [ALERTA MESTRE])
    // consumam a maior parte das vagas das tarefas acionáveis de estudo no Planner.
    const MAX_DAILY_GOALS = 12;
    if (dedupedTasks.length <= MAX_DAILY_GOALS) {
        return dedupedTasks;
    }

    const MAX_SYSTEM_ALERTS_IN_QUOTA = 3;
    const isSysAlert = (t) => /\[(ALERTA MESTRE|STATUS)\]/i.test(String(t?.text || t?.title || ''));
    const isMasterAlert = (t) => /\[ALERTA MESTRE\]/i.test(String(t?.text || t?.title || ''));

    const allSystemAlerts = dedupedTasks.filter(isSysAlert);
    if (allSystemAlerts.length <= MAX_SYSTEM_ALERTS_IN_QUOTA) {
        return dedupedTasks.slice(0, MAX_DAILY_GOALS);
    }

    const prioritizedAlerts = [
        ...allSystemAlerts.filter(isMasterAlert),
        ...allSystemAlerts.filter(t => !isMasterAlert(t))
    ].slice(0, MAX_SYSTEM_ALERTS_IN_QUOTA);
    const allowedAlertIds = new Set(prioritizedAlerts.map(t => t.id));

    return dedupedTasks
        .filter(t => !isSysAlert(t) || allowedAlertIds.has(t.id))
        .slice(0, MAX_DAILY_GOALS);
};

export const getCoachInsight = (category, simulados = [], studyLogs = [], options = {}) => {
    const fallback = {
        text: "Dados insuficientes para análise.",
        parts: [],
        trend: 0,
        volatility: 0,
        probability: null,
        error: false,
    };

    try {
        const urgency = calculateUrgency(category, simulados, studyLogs, options);
        if (!urgency || urgency.details?.error) return { ...fallback, error: true, text: "Erro ao calcular urgência." };

        const details = urgency?.details || {};
        if (!details.hasData) {
            return { ...fallback };
        }
        const mc = details.monteCarlo;
        const trend = Number(details.trend) || 0;
        const vol = Number(details.mssdVolatility) || 0;

        const parts = [];
        if (mc && Number.isFinite(mc.probability)) {
            parts.push(`chance de meta em ${Math.round(mc.probability)}%`);
        }
        // FIX: escalar thresholds de tendência e volatilidade pela amplitude real [minScore, maxScore]
        const rawCatMax = parseOptionalFinite(category?.maxScore);
        const rawOptMax = parseOptionalFinite(options?.maxScore);
        const safeMaxScore = (rawCatMax !== null && rawCatMax > 0)
            ? rawCatMax
            : ((rawOptMax !== null && rawOptMax > 0) ? rawOptMax : 100);
        const rawCatMin = parseOptionalFinite(category?.minScore);
        const rawOptMin = parseOptionalFinite(options?.minScore);
        const rawMin = rawCatMin ?? rawOptMin;
        const safeMinScore = rawMin !== null ? Math.min(rawMin, safeMaxScore) : 0;
        const safeDomain = Math.max(1e-9, safeMaxScore - safeMinScore);
        const trendScaleThreshold = 0.5 * (safeDomain / 100);
        parts.push(trend > trendScaleThreshold ? "tendência positiva" : trend < -trendScaleThreshold ? "tendência negativa" : "estável");
        if (vol > 15 * (safeDomain / 100)) parts.push("alta volatilidade");

        return {
            text: parts.join(" · "),
            parts,
            trend,
            volatility: vol,
            probability: mc?.probability ?? null,
            error: false,
        };
    } catch (err) {
        console.error("[getCoachInsight] Erro:", err);
        return {
            ...fallback,
            error: true,
            text: "Erro ao gerar insight. Verifique console."
        };
    }
};

