              method: 'POST',
              headers: { 'x-forwarded-for': uniqueIp },
              body: { materia: 'Penal', assunto: 'Dolo' },
            },
            lastRes
          );
        }
        expect(lastRes.statusCode).toBe(429);
        expect(lastRes.headers['retry-after']).toBe('60');
