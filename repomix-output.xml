const safeLocalSet = (key, value) => {
  try {
    localStorage.setItem(key, value);
    return true;
  } catch (err) {
    console.warn('[AI Sim] Falha ao gravar no localStorage:', err?.message || err);
    return false;
  }
};

const safeLocalRemove = (key) => {
  try {
    localStorage.removeItem(key);
  } catch {
    // ignore storage removal errors
  }
};

function resolveMixedQuestionMeta(q, idx, targets = [], catsArray = []) {
  const safeTargets = Array.isArray(targets) ? targets.filter(Boolean) : [];
  const rawMateria = String(q?.materia || '').trim();
  const rawAssunto = String(q?.assunto || '').replace(/\s*\(Nível:.*?\)\s*$/i, '').trim();
  const isGenericMateria = !rawMateria || /^simulado personalizado$/i.test(rawMateria);
  const isMultilineAssunto = /-\s*Mat[eé]ria:/i.test(rawAssunto);

  const matchedCat = !isGenericMateria
    ? catsArray.find(c => c && isSubjectMatch(c.name, rawMateria))
    : null;

  if (matchedCat) {
    const safeCatTasks = Array.isArray(matchedCat.tasks) ? matchedCat.tasks : Object.values(matchedCat.tasks || {});
    const matchedTask = !isMultilineAssunto
      ? safeCatTasks.find(t => t && normalize(t.title || t.text || '') === normalize(rawAssunto))
      : null;
    const fallbackTarget = safeTargets.find(t => t.catId === matchedCat.id || isSubjectMatch(t.materia, matchedCat.name));
    const resolvedAssunto = matchedTask
      ? (matchedTask.title || matchedTask.text || rawAssunto)
      : (!isMultilineAssunto && rawAssunto ? rawAssunto : (fallbackTarget?.assunto || 'Geral'));
    return {
      materia: matchedCat.name,
      assunto: resolvedAssunto,
      realCategoryId: matchedCat.id,
      realTaskId: matchedTask?.id || fallbackTarget?.taskId || null,
    };
  }

  if (safeTargets.length > 0) {
    const targetByAssunto = !isMultilineAssunto && rawAssunto
      ? safeTargets.find(t => normalize(t.assunto) === normalize(rawAssunto))
      : null;
    const chosen = targetByAssunto || safeTargets[idx % safeTargets.length];
    return {
      materia: chosen.materia || rawMateria || 'Geral',
      assunto: chosen.assunto || (!isMultilineAssunto && rawAssunto ? rawAssunto : 'Geral'),
      realCategoryId: chosen.catId || null,
      realTaskId: chosen.taskId || null,
    };
  }

  return {
    materia: !isGenericMateria ? rawMateria : 'Geral',
    assunto: !isMultilineAssunto && rawAssunto ? rawAssunto : 'Geral',
    realCategoryId: q?.realCategoryId || null,
    realTaskId: q?.realTaskId || null,
  };
}

const LOADING_MESSAGES = [
  "Iniciando Motor Analítico...",
  "Identificando Banca Examinadora...",
  "Cruzando Jurisprudências Recentes...",
  "Formulando Enunciados Inéditos...",
  "Calibrando Nível de Dificuldade...",
  "Ajustando Pegadinhas e Casos Práticos...",
  "Finalizando Pacote de Questões..."
];

// ✅ FIX C07: Usa crypto.randomUUID() quando disponível, eliminando o
// contador mutável que pode colidir após HMR (Hot Module Replacement).
// Fallback para Date.now() + random longo quando crypto não existe.
function nextAiId(prefix = 'ai') {
  if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
    return `${prefix}-${crypto.randomUUID()}`;
  }
  // Fallback: timestamp de alta precisão + random duplo
  const time = (typeof performance !== 'undefined' && performance.now)
    ? performance.now().toString(36).replace('.', '')
    : '';
  const rand = () => Math.random().toString(36).substring(2, 11);
  return `${prefix}-${Date.now().toString(36)}-${time}-${rand()}${rand()}`;
}

const EMPTY_CATEGORIES = Object.freeze([]);

export default function AIGeneratedSimulado({ drillRequest = null, onDrillConsumed = null } = {}) {
  const setData = useAppStore(state => state.setData);
  const activeId = useAppStore(state => state.appState?.activeId || 'default');
  const { rawCategories, contestPenalty, contestBoard, contestSimuladoRows, contestExamDuration } = useAppStore(useShallow(state => {
    const active = state.appState?.contests?.[state.appState?.activeId];
    return {
      rawCategories: active?.categories || EMPTY_CATEGORIES,
      contestPenalty: Number(active?.penaltyPerWrong) || 0,
      contestBoard: active?.examBoard || '',
      contestSimuladoRows: active?.simuladoRows || EMPTY_CATEGORIES,
      contestExamDuration: Number(active?.examDurationMinutes) || 240,
    };
  }));
  const categories = useMemo(
    () => (Array.isArray(rawCategories) ? rawCategories : Object.values(rawCategories || {})).filter(Boolean),
    [rawCategories]
  );
  const simuladoRowsList = useMemo(
    () => (Array.isArray(contestSimuladoRows) ? contestSimuladoRows : Object.values(contestSimuladoRows || {})).filter(Boolean),
    [contestSimuladoRows]
  );
  const showToast = useToast();
  const isAdmin = isAdminUser(useAuth()?.currentUser || null);

  const [step, setStep] = useState('setup');
  const [form, setForm] = useState({
    categoryId: '', taskId: '', materia: '', assunto: '',
    dificuldade: 'medio', quantidade: 10,
  });
  const [questions, setQuestions] = useState([]);
  const [answers, setAnswers] = useState({});
  const [currentIndex, setCurrentIndex] = useState(0);
  const [isLoading, setIsLoading] = useState(false);
  const [results, setResults] = useState(null);
  const [timeLeft, setTimeLeft] = useState(45 * 60);
  const [timerActive, setTimerActive] = useState(false);
  const [showReview, setShowReview] = useState(false);
  const [loadingMsgIdx, setLoadingMsgIdx] = useState(0);
  const [timePerQuestion, setTimePerQuestion] = useState({});
  const [confidences, setConfidences] = useState({});
  const [errorTypes, setErrorTypes] = useState({});
  const [lastSessionBatchId, setLastSessionBatchId] = useState(null);
  const [showEscapeConfirm, setShowEscapeConfirm] = useState(false);

  const mountedRef = useRef(true);
  const restoredContestIdRef = useRef(null);
  const sessionContestIdRef = useRef(activeId);
  const abortControllerRef = useRef(null);
  const activeGenerationRef = useRef(null);

  const stepRef = useRef(step);
  const latestAnswersRef = useRef(answers);
  const latestQuestionsRef = useRef(questions);
  const latestFormRef = useRef(form);
  const isFinishingRef = useRef(false);
  const latestCurrentIndexRef = useRef(currentIndex);
  const latestTimePerQuestionRef = useRef(timePerQuestion);
  const latestTimeLeftRef = useRef(timeLeft);
  const simStartMsRef = useRef(null);
  const activeElapsedSecsRef = useRef(0);

  useEffect(() => { stepRef.current = step; }, [step]);

  const persistDraftImmediately = useCallback((targetContestId = null) => {
    const contestKey = targetContestId || sessionContestIdRef.current;
    if (stepRef.current === 'playing' && latestQuestionsRef.current.length > 0) {
      try {
        const draft = {
          version: 1,
          form: latestFormRef.current,
          questions: latestQuestionsRef.current,
          answers: latestAnswersRef.current,
          currentIndex: latestCurrentIndexRef.current,
          timeLeft: latestTimeLeftRef.current,
          timePerQuestion: latestTimePerQuestionRef.current,
          simStartMs: simStartMsRef.current,
          activeElapsedSecs: activeElapsedSecsRef.current,
          savedAt: Date.now()
        };
        localStorage.setItem(getAiSimStorageKey(contestKey), JSON.stringify(draft));
      } catch (e) {
        console.warn('[Draft] Falha ao salvar rascunho imediato:', e);
      }
    }
  }, []);

  useEffect(() => {
    mountedRef.current = true;
    const onBeforeUnload = () => persistDraftImmediately();
    window.addEventListener('beforeunload', onBeforeUnload);
    return () => {
      mountedRef.current = false;
      window.removeEventListener('beforeunload', onBeforeUnload);
      // G-20 FIX: Salvar draft imediatamente ao desmontar usando o concurso dono da sessão
      persistDraftImmediately(sessionContestIdRef.current);
      // ✅ FIX: Abortar request pendente ao desmontar
      if (abortControllerRef.current) {
        abortControllerRef.current.abort();
        abortControllerRef.current = null;
      }
    };
  }, [persistDraftImmediately]);

  useEffect(() => { latestAnswersRef.current = answers; }, [answers]);
  useEffect(() => { latestQuestionsRef.current = questions; }, [questions]);
  useEffect(() => { latestFormRef.current = form; }, [form]);
  useEffect(() => { latestCurrentIndexRef.current = currentIndex; }, [currentIndex]);
  useEffect(() => { latestTimePerQuestionRef.current = timePerQuestion; }, [timePerQuestion]);
  useEffect(() => { latestTimeLeftRef.current = timeLeft; }, [timeLeft]);

  // FIX: Draft persist com debounce de 5s (não a cada segundo)
  const draftTimeoutRef = useRef(null);
  const timeLeftRef = useRef(timeLeft);
  const totalAllowedTimeRef = useRef(0);
  useEffect(() => { timeLeftRef.current = timeLeft; }, [timeLeft]);

  useEffect(() => {
    if (step === 'playing' && questions.length > 0) {
      const targetContestId = sessionContestIdRef.current;
      if (draftTimeoutRef.current) clearTimeout(draftTimeoutRef.current);
      draftTimeoutRef.current = setTimeout(() => {
        const draft = {
          version: 1,
          form: latestFormRef.current || form,
          questions,
          answers,
          currentIndex,
          timeLeft: timeLeftRef.current,
          timePerQuestion: latestTimePerQuestionRef.current || {},
          simStartMs: simStartMsRef.current,
          activeElapsedSecs: activeElapsedSecsRef.current,
          savedAt: Date.now()
        };
        try {
          localStorage.setItem(getAiSimStorageKey(targetContestId), JSON.stringify(draft));
        } catch (e) {
          console.warn('[Draft] Storage full or unavailable:', e);
        }
      }, 5000);
    }
    return () => {
      if (draftTimeoutRef.current) clearTimeout(draftTimeoutRef.current);
    };
  }, [step, questions, answers, currentIndex, form]);

  // FIX: Reagir à troca de concurso (activeId) salvando o rascunho anterior e restaurando o do novo concurso
  useEffect(() => {
    const prevContestId = sessionContestIdRef.current;
    if (prevContestId && prevContestId !== activeId) {
      if (draftTimeoutRef.current) {
        clearTimeout(draftTimeoutRef.current);
        draftTimeoutRef.current = null;
      }
      persistDraftImmediately(prevContestId);
      if (abortControllerRef.current) {
        abortControllerRef.current.abort();
        abortControllerRef.current = null;
      }
      activeGenerationRef.current = null;
      isFinishingRef.current = false;
      stepRef.current = 'setup';
      latestQuestionsRef.current = [];
      latestAnswersRef.current = {};
      latestTimePerQuestionRef.current = {};
      activeElapsedSecsRef.current = 0;
      simStartMsRef.current = null;
      sessionContestIdRef.current = activeId;
      setStep('setup');
      setQuestions([]);
      setAnswers({});
      setTimePerQuestion({});
      setCurrentIndex(0);
      setResults(null);
      setTimerActive(false);
      setIsLoading(false);
      setShowReview(false);
      setForm({
        categoryId: '', taskId: '', materia: '', assunto: '',
        dificuldade: 'medio', quantidade: 10,
      });
    } else {
      sessionContestIdRef.current = activeId;
    }

    if (restoredContestIdRef.current === activeId) return;
    restoredContestIdRef.current = activeId;

    let timeoutId1;
    let timeoutId2;
    let cancelled = false;

    const gen = safeGetJSON(getAiGenStorageKey(activeId), null);
    if (gen) {
      if (gen.status === 'done' && gen.questions?.length > 0) {
        timeoutId1 = setTimeout(() => {
          if (cancelled) return;

          const f = gen.form || {};
          setForm({
            categoryId: f.categoryId || '', taskId: f.taskId || '',
            materia: f.materia || '', assunto: f.assunto || '',
            dificuldade: f.dificuldade || 'medio', quantidade: f.quantidade || 10,
            ...(Array.isArray(f.targets) ? { targets: f.targets } : {}),
          });

          // ✅ FIX: Ler categories do store ATUAL, não da closure
          const currentCategories = useAppStore.getState().appState?.contests?.[
            activeId
          ]?.categories || [];
          const catsArray = (Array.isArray(currentCategories)
            ? currentCategories
            : Object.values(currentCategories || {})).filter(Boolean);

          const cat = catsArray.find(c => c.id === f.categoryId);
          const safeCatTasks = cat ? (Array.isArray(cat.tasks) ? cat.tasks : Object.values(cat.tasks || {})).filter(Boolean) : [];
          const tsk = safeCatTasks.find(t => t && t.id === f.taskId);
          const isMixed = f.categoryId === 'mixed';

          const normalizedQuestions = gen.questions.map((q, idx) => {
            if (isMixed) {
              const resolved = resolveMixedQuestionMeta(q, idx, f.targets, catsArray);
              return {
                ...q,
                id: q.id || nextAiId('ai-bg'),
                categoryId: 'mixed',
                taskId: 'mixed',
                realCategoryId: resolved.realCategoryId,
                realTaskId: resolved.realTaskId,
                materia: resolved.materia,
                assunto: resolved.assunto,
              };
            }
            return {
              ...q,
              id: q.id || nextAiId('ai-bg'),
              categoryId: f.categoryId, taskId: f.taskId,
              materia: cat?.name || q.materia || f.materia,
              assunto: tsk ? (tsk.title || tsk.text || f.assunto) : (q.assunto || f.assunto),
            };
          });

          isFinishingRef.current = false;
          setQuestions(normalizedQuestions);
          setAnswers({});
          setTimePerQuestion({});
          setCurrentIndex(0);
          setTimeLeft(normalizedQuestions.length * 3 * 60);
          setStep('playing');
          setTimerActive(true);
          simStartMsRef.current = Date.now();
          activeElapsedSecsRef.current = 0;
          setShowReview(false);
          setIsLoading(false);
          safeLocalRemove(getAiGenStorageKey(activeId));
          showToast(`${normalizedQuestions.length} questões geradas com sucesso!`, 'success');
        }, 0);
        return () => { cancelled = true; clearTimeout(timeoutId1); clearTimeout(timeoutId2); restoredContestIdRef.current = null; };
      } else if (gen.status === 'error') {
        timeoutId1 = setTimeout(() => {
          if (cancelled) return;
          showToast(gen.errorMessage || 'Erro ao gerar questões em segundo plano.', 'error');
          safeLocalRemove(getAiGenStorageKey(activeId));
          setIsLoading(false);
        }, 0);
        return () => { cancelled = true; clearTimeout(timeoutId1); clearTimeout(timeoutId2); restoredContestIdRef.current = null; };
      } else if (gen.status === 'generating') {
        timeoutId1 = setTimeout(() => {
          if (cancelled) return;
          const f = gen.form || {};
          setForm({
            categoryId: f.categoryId || '', taskId: f.taskId || '',
            materia: f.materia || '', assunto: f.assunto || '',
            dificuldade: f.dificuldade || 'medio', quantidade: f.quantidade || 10,
            ...(Array.isArray(f.targets) ? { targets: f.targets } : {}),
          });
          setIsLoading(true);
          setStep('setup');
          if (activeGenerationRef.current) {
            activeGenerationRef.current.then((normalizedQuestions) => {
              if (cancelled || !mountedRef.current) return;
              if (normalizedQuestions && normalizedQuestions.length > 0) {
                isFinishingRef.current = false;
                setQuestions(normalizedQuestions);
                setAnswers({});
                setTimePerQuestion({});
                setCurrentIndex(0);
                setTimeLeft(normalizedQuestions.length * 3 * 60);
                setStep('playing');
                setTimerActive(true);
                simStartMsRef.current = Date.now();
                activeElapsedSecsRef.current = 0;
                setIsLoading(false);
                safeLocalRemove(getAiGenStorageKey(activeId));
                showToast(`${normalizedQuestions.length} questões geradas com sucesso!`, 'success');
              }
            }).catch((error) => {
              if (cancelled || !mountedRef.current) return;
              setIsLoading(false);
              safeLocalRemove(getAiGenStorageKey(activeId));
              showToast(error.message || 'Erro ao gerar questões.', 'error');
            });
          } else {
            const age = Date.now() - (gen.startedAt || 0);
            safeLocalRemove(getAiGenStorageKey(activeId));
            setIsLoading(false);
            if (age <= 5 * 60 * 1000) {
              showToast('A geração anterior foi interrompida. Gere novamente.', 'warning');
            }
          }
        }, 0);
        return () => { cancelled = true; clearTimeout(timeoutId1); clearTimeout(timeoutId2); restoredContestIdRef.current = null; };
      }
    }

    const draft = safeGetJSON(getAiSimStorageKey(activeId), null);
    if (draft) {
      function isSimuladoDraftValid(d) {
        if (!d || typeof d !== 'object') return false;

        const draftVersion = Number(d.version ?? 1);
        if (!Number.isFinite(draftVersion) || draftVersion !== 1) return false;
        if (!Array.isArray(d.questions) || d.questions.length === 0) return false;
        const savedAt = Number(d.savedAt || 0);
        if (!Number.isFinite(savedAt) || savedAt <= 0) return false;
        const age = Date.now() - savedAt;
        return age >= 0 && age < 24 * 60 * 60 * 1000;
      }

      if (isSimuladoDraftValid(draft)) {
        timeoutId2 = setTimeout(() => {
          if (cancelled) return;

          const f = draft.form || {};
          let restoredForm = {
            categoryId: f.categoryId || '', taskId: f.taskId || '',
            materia: f.materia || '', assunto: f.assunto || '',
            dificuldade: f.dificuldade || 'medio', quantidade: f.quantidade || 10,
            ...(Array.isArray(f.targets) ? { targets: f.targets } : {}),
          };

          // ✅ FIX: Validar contra categories do store ATUAL
          const currentCategories = useAppStore.getState().appState?.contests?.[
            activeId
          ]?.categories || [];
          const catsArray = (Array.isArray(currentCategories)
            ? currentCategories
            : Object.values(currentCategories || {})).filter(Boolean);

          // C-14 FIX: Validar que a categoria do draft existe no concurso ATUAL
          const cat = catsArray.find(c => c && c.id === f.categoryId);
          if (!cat && f.categoryId && f.categoryId !== 'mixed') {
            // Categoria não existe mais — descartar draft
            safeLocalRemove(getAiSimStorageKey(activeId));
            safeLocalRemove(getAiGenStorageKey(activeId));
            return;
          }
          const safeTasks = cat ? (Array.isArray(cat.tasks) ? cat.tasks : Object.values(cat.tasks || {})).filter(Boolean) : [];
          const tsk = safeTasks.find(t => t && t.id === f.taskId);

          if (restoredForm.taskId && restoredForm.taskId !== 'mixed' && !tsk) {
            restoredForm = { ...restoredForm, taskId: '', assunto: '' };
          }

          const questions = Array.isArray(draft.questions) ? draft.questions : [];
          const answers = Array.isArray(draft.answers) ? draft.answers : (draft.answers || {});
          const maxIndex = Math.max(0, questions.length - 1);
          const currentIndex = Number.isInteger(draft.currentIndex)
            ? Math.min(Math.max(draft.currentIndex, 0), maxIndex) : 0;
          const timeLeft = Number.isFinite(draft.timeLeft)
            ? Math.max(0, draft.timeLeft) : draft.questions.length * 3 * 60;

          const totalAllowedTime = questions.length * 3 * 60;
          const elapsedSeconds = Math.max(0, totalAllowedTime - timeLeft);

          setForm(restoredForm);
          setQuestions(questions);
          setAnswers(answers);
          setTimePerQuestion(draft.timePerQuestion || {});
          setCurrentIndex(currentIndex);
          setTimeLeft(timeLeft);
          setStep('playing');
          setTimerActive(true);

          activeElapsedSecsRef.current = Number.isFinite(Number(draft.activeElapsedSecs))
            ? Math.max(0, Number(draft.activeElapsedSecs))
            : elapsedSeconds;
          simStartMsRef.current = Number.isFinite(Number(draft.simStartMs))
            ? Number(draft.simStartMs)
            : Date.now() - elapsedSeconds * 1000;
        }, 0);
      }
    }

    return () => {
      cancelled = true;
      clearTimeout(timeoutId1);
      clearTimeout(timeoutId2);
      restoredContestIdRef.current = null;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [activeId]);

  const handleInputChange = (field, value) => {
    setForm(prev => ({ ...prev, [field]: value }));
  };

  const computeTriForCategory = useCallback((cat) => {
    if (!cat) return null;
    const catHist = Array.isArray(cat?.simuladoStats?.history)
      ? cat.simuladoStats.history
      : Object.values(cat?.simuladoStats?.history || {});
    const matchingRows = simuladoRowsList.filter(
      (r) => r && ((cat.id && r.categoryId === cat.id) || isSubjectMatch(r.subject, cat.name))
    );
    const entries = [...catHist, ...matchingRows];
    if (!entries.length) return null;
    return estimateIRTAbility(entries, {
      minScore: Number.isFinite(Number(cat.minScore)) ? Number(cat.minScore) : 0,
      maxScore: Number(cat.maxScore) > 0 ? Number(cat.maxScore) : 100,
    });
  }, [simuladoRowsList]);

  const handleCategorySelect = (catId) => {
    const cat = categories.find(c => c && c.id === catId);
    const tri = cat ? computeTriForCategory(cat) : null;
    setForm(prev => ({
      ...prev,
      categoryId: catId || '',
      materia: cat ? cat.name : '',
      taskId: '',
      assunto: '',
      ...(tri?.hasData && tri.recommendedDifficulty ? { dificuldade: tri.recommendedDifficulty } : {}),
    }));
  };

  const selectedCategory = categories.find(c => c && c.id === form.categoryId);
  const triRecommendation = useMemo(
    () => (selectedCategory ? computeTriForCategory(selectedCategory) : null),
    [selectedCategory, computeTriForCategory]
  );

  useEffect(() => {
    if (!drillRequest?.items?.length) return;
    const targets = [];
    const seen = new Set();
    drillRequest.items.forEach((err) => {
      const key = `${err.subject || ''}|${err.topic || ''}`;
      if (seen.has(key)) return;
      seen.add(key);
      targets.push({
        catId: err.categoryId || null,
        taskId: err.taskId || null,
        materia: err.subject || 'Geral',
        assunto: err.topic || 'Geral',
      });
    });
    const timer = setTimeout(() => {
      if (targets.length > 0) {
        const assuntoStr = targets.map((t) => `- Matéria: ${t.materia} | Assunto: ${t.assunto} (Caderno de Erros)`).join('\n');
        setForm((prev) => ({
          ...prev,
          categoryId: 'mixed',
          taskId: 'mixed',
          materia: 'Revisão do Caderno de Erros',
          assunto: assuntoStr,
          quantidade: Math.min(15, Math.max(5, drillRequest.items.length)),
          targets,
        }));
        setStep('setup');
        showToast(`Caderno de Erros carregado (${targets.length} foco(s)). Clique em GERAR SIMULADO!`, 'info');
      }
      if (typeof onDrillConsumed === 'function') onDrillConsumed();
    }, 0);
    return () => clearTimeout(timer);
  }, [drillRequest, onDrillConsumed, showToast]);

  const handleTaskSelect = (tskId) => {
    const cat = categories.find(c => c && c.id === form.categoryId);
    const rawCatTasks = cat?.tasks || [];
    const safeCatTasks = (Array.isArray(rawCatTasks) ? rawCatTasks : Object.values(rawCatTasks || {})).filter(Boolean);
    const tsk = safeCatTasks.find(t => t && t.id === tskId);
    setForm(prev => ({
      ...prev, taskId: tskId || '',
      assunto: tsk ? (tsk.title || tsk.text || '') : '',
    }));
  };

  const rawTasks = selectedCategory?.tasks || [];
  const availableTasks = (Array.isArray(rawTasks) ? rawTasks : Object.values(rawTasks || {})).filter(Boolean);

  // Modo Prova Completa (Edital): distribui questões proporcionalmente pelos pesos do edital + banca + tempo real
  const generateFullExamSimulado = async () => {
    const validCats = categories.filter((c) => c && c.name);
    if (validCats.length === 0) {
      showToast('Cadastre matérias no Dashboard primeiro.', 'warning');
      return;
    }
    const totalWeight = validCats.reduce((acc, c) => acc + Math.max(1, Number(c.weight) || 10), 0) || 1;
    const maxFullExamQ = isAdmin ? 50 : 20;
    const totalQuestions = Math.min(maxFullExamQ, Math.max(10, validCats.length * 3));
    const weightedTargets = validCats
      .sort((a, b) => (Number(b.weight) || 10) - (Number(a.weight) || 10))
      .slice(0, isAdmin ? 20 : 8)
      .map((cat) => {
        const catTasks = (Array.isArray(cat.tasks) ? cat.tasks : Object.values(cat.tasks || {})).filter(Boolean);
        const pickTask = catTasks.find((t) => !t.completed) || catTasks[0];
        const share = Math.max(1, Math.round(((Number(cat.weight) || 10) / totalWeight) * totalQuestions));
        return {
          catId: cat.id,
          taskId: pickTask?.id || null,
          materia: cat.name,
          assunto: pickTask?.title || pickTask?.text || 'Conteúdo Geral do Edital',
          share,
