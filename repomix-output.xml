  const saveAIResultsToSystem = useCallback(async (formData, correct, total, _answeredQs, timeSpentSecs = 0, preventGlobalEvent = false, batchId = null) => {
    // FIX: Evitar mutar proxies de draft do Immer enquanto retorna novo estado (causava crash no 2º simulado do dia).
    useAppStore.setState(
      (state) => {
        const activeContestId = state.appState?.activeId;
        const currentDraft = state.appState?.contests?.[activeContestId];
        if (!currentDraft) return;
        const plainContest = safeClone(isDraft(currentDraft) ? current(currentDraft) : currentDraft);
        applyAIResultsToDraft(plainContest, formData, correct, total, timeSpentSecs, preventGlobalEvent, batchId);
        state.appState.contests[activeContestId] = plainContest;
        state.appState.version = (state.appState.version || 0) + 1;
        state.appState.lastUpdated = new Date().toISOString();
      },
      false,
      preventGlobalEvent ? "AI_BACKGROUND_SAVE" : "AI_SIMULADO_SAVE"
    );
    markStorageDirty();
  }, []);

  const handleFinish = useCallback(async () => {
    const qList = latestQuestionsRef.current.length > 0 ? latestQuestionsRef.current : questions;
    const ansMap = latestAnswersRef.current || answers || {};
    const f = latestFormRef.current;
    if (qList.length === 0) {
      showToast('Nenhuma questão disponível para finalizar.', 'warning');
      return;
    }

    // FIX: Garantir que latestTimePerQuestionRef está sincronizado
    const timePerQ = latestTimePerQuestionRef.current || timePerQuestion || {};

    const totalAllowedTime = totalAllowedTimeRef.current > 0
      ? totalAllowedTimeRef.current
      : (qList.length * 3 * 60);
    const activeElapsed = activeElapsedSecsRef.current > 0
      ? activeElapsedSecsRef.current
      : Math.max(0, totalAllowedTime - latestTimeLeftRef.current);
    const fallbackTimeSpent = Math.max(activeElapsed, Math.max(0, totalAllowedTime - latestTimeLeftRef.current));

    if (isFinishingRef.current || stepRef.current === 'finished') return;
    isFinishingRef.current = true;

    try {
      let correctCount = 0;
      const answeredQuestions = [];
      qList.forEach(q => {
        const selected = ansMap[q.id];
        const wasAnswered = selected !== undefined && selected !== null;
        const isCorrect =
          wasAnswered &&
          normalizeAlternative(selected) === normalizeAlternative(q.alternativa_correta);
        if (isCorrect) correctCount++;
        answeredQuestions.push({ ...q, selected: selected || null, isCorrect, wasAnswered });
      });

      const total = qList.length;
      const blanksCount = answeredQuestions.filter((q) => !q.wasAnswered).length;
      const contestForScore = useAppStore.getState().appState?.contests?.[useAppStore.getState().appState?.activeId];
      const finishPenalty = Math.max(0, Number(contestForScore?.penaltyPerWrong) || 0);
      const overallEff = computeEffectiveScoreRatio(correctCount, total, {
        blanks: blanksCount,
        penaltyPerWrong: finishPenalty,
        minScore: 0,
        maxScore: 100,
      });
      const scorePercent = total > 0 ? Math.round((correctCount / total) * 100) : 0;
      const effectiveScorePercent = total > 0 ? Math.round(overallEff.ratio * 100) : 0;
      const exactTotalTime = answeredQuestions.reduce((acc, q) => acc + (timePerQ[q.id] || 0), 0);
      const finalTimeSpent = exactTotalTime > 0 ? exactTotalTime : fallbackTimeSpent;
      const sessionBatchId = generateId('batch');
      setLastSessionBatchId(sessionBatchId);

      const buildTelemetry = (qsSlice) =>
        qsSlice.map((q, idx) => ({
          id: q.id,
          idx,
          timeSec: Math.max(0, Math.round(Number(timePerQ[q.id]) || 0)),
          correct: Boolean(q.isCorrect),
          wasAnswered: Boolean(q.wasAnswered),
          confidence: confidences[q.id] || null,
          errorType: errorTypes[q.id] || null,
          difficulty: f.dificuldade || 'medio',
          ...(!q.isCorrect ? {
            statement: String(q.enunciado || '').slice(0, 240),
            explanation: String(q.justificativa || '').slice(0, 240),
            correctAnswer: String(q.alternativa_correta || '').slice(0, 10),
          } : {}),
        }));

      if (f.categoryId === 'mixed') {
        const rawCats = useAppStore.getState().appState?.contests?.[useAppStore.getState().appState?.activeId]?.categories || [];
        const cats = Array.isArray(rawCats) ? rawCats : Object.values(rawCats);
        const groups = {};
        answeredQuestions.forEach((q, idx) => {
          const resolved = resolveMixedQuestionMeta(q, idx, f.targets, cats);
          const effMateria = resolved.materia;
          const effAssunto = resolved.assunto;
          const key = `${effMateria}\u0000${effAssunto}`;
          if (!groups[key]) {
            groups[key] = {
              materia: effMateria,
              assunto: effAssunto,
              categoryId: resolved.realCategoryId || null,
              taskId: resolved.realTaskId || null,
              correct: 0,
              total: 0,
              qs: [],
              timeSpent: 0,
            };
          }
          groups[key].qs.push(q);
          groups[key].total++;
          if (q.isCorrect) groups[key].correct++;
          const spent = timePerQ[q.id] || 0;
          groups[key].timeSpent += spent;
        });
        const totalQuestionsInMixed = Object.values(groups).reduce((acc, g) => acc + g.total, 0);
        const totalCorrectInMixed = Object.values(groups).reduce((acc, g) => acc + g.correct, 0);

        const failedGroups = [];
        const promises = Object.entries(groups).map(async ([groupKey, g]) => {
          try {
            const [materia, assunto] = groupKey.split('\u0000');
            const cleanAssunto = String(assunto || '').replace(/\s*\(Nível:.*?\)\s*$/i, '').trim();

            const cat = (g.categoryId && cats.find(c => c && c.id === g.categoryId)) ||
              cats.find(c => isSubjectMatch(c?.name, materia));

            const catTasks = cat?.tasks ? (Array.isArray(cat.tasks) ? cat.tasks : Object.values(cat.tasks)) : [];
            const tsk = (g.taskId && catTasks.find(t => t && t.id === g.taskId)) ||
              catTasks.find(t => normalize(t?.title || t?.text || '') === normalize(cleanAssunto));

            const subForm = {
              ...f,
              materia: cat?.name || g.materia,
              assunto: tsk ? (tsk.title || tsk.text || cleanAssunto) : cleanAssunto,
              categoryId: cat ? cat.id : null, taskId: tsk ? tsk.id : null,
              questionTelemetry: buildTelemetry(g.qs),
            };
            const topicTime =
              g.timeSpent > 0
                ? g.timeSpent
                : Math.round(fallbackTimeSpent * (g.total / Math.max(1, totalQuestionsInMixed)));
            await saveAIResultsToSystem(subForm, g.correct, g.total, g.qs, topicTime, true, sessionBatchId);
          } catch (err) {
            console.error(`[AI Sim] Falha ao salvar grupo ${groupKey}:`, err);
            failedGroups.push(groupKey);
          }
        });
        await Promise.allSettled(promises);

        if (failedGroups.length > 0) {
          showToast(`⚠️ ${failedGroups.length} grupo(s) não salvos: ${failedGroups.join(', ')}`, 'warning');
        }

        const nowIso = new Date().toISOString();
        const todayKey = getDateKey(new Date()) || new Date().toISOString().slice(0, 10);
        const activeContest = useAppStore.getState().appState?.contests?.[useAppStore.getState().appState?.activeId];
        const mixedDomain = safeDomain(Number(activeContest?.maxScore) || 100, Number(activeContest?.minScore) || 0);
        const mixedPenalty = Math.max(0, Number(activeContest?.penaltyPerWrong) || 0);
        const totalBlanksInMixed = answeredQuestions.filter((q) => !q.wasAnswered).length;
        const mixedEff = computeEffectiveScoreRatio(totalCorrectInMixed, totalQuestionsInMixed, {
          blanks: totalBlanksInMixed,
          penaltyPerWrong: mixedPenalty,
          minScore: mixedDomain.min,
          maxScore: mixedDomain.max,
        });
        const mixedRatio = mixedEff.ratio;
        const mixedScorePoints = mixedDomain.min + mixedRatio * mixedDomain.range;
        const mixedScorePct = mixedRatio * 100;
        const globalMixedEvent = {
          id: generateId('ai-sim'),
          batchId: sessionBatchId,
          date: todayKey,
          createdAt: nowIso,
          lastUpdated: nowIso,
          scorePoints: mixedScorePoints,
          scorePct: mixedScorePct,
          score: mixedScorePoints,
          total: totalQuestionsInMixed,
          correct: totalCorrectInMixed,
          ...(mixedEff.blanks > 0 ? { blanks: mixedEff.blanks } : {}),
          ...(mixedEff.penaltyApplied ? { netPoints: mixedEff.netPoints, penaltyPerWrong: mixedPenalty } : {}),
          type: 'ai-simulado',
          subject: 'Simulado Misto (IA)',
          categoryId: 'mixed',
          taskId: null,
          validated: true,
          scoreUnit: 'points',
          isPercentage: false,
        };
        useAppStore.setState(
          (state) => {
            const nextContests = { ...state.appState.contests };
            const currentDraft = nextContests[state.appState.activeId];
            if (!currentDraft) return state;
            const existingSims = Array.isArray(currentDraft.simulados) ? currentDraft.simulados : Object.values(currentDraft.simulados || {});
            nextContests[state.appState.activeId] = {
              ...currentDraft,
              simulados: [...existingSims, globalMixedEvent].slice(-DEFAULT_SIMULADO_HISTORY_CAP),
              lastUpdated: new Date().toISOString()
            };
            return {
              appState: {
                ...state.appState,
                version: (state.appState.version || 0) + 1,
                contests: nextContests,
                lastUpdated: new Date().toISOString()
              }
            };
          },
          false,
          "AI_MIXED_SIMULADO_SAVE"
        );
        markStorageDirty();
      } else {
        await saveAIResultsToSystem(
          { ...f, questionTelemetry: buildTelemetry(answeredQuestions) },
          correctCount,
          total,
          answeredQuestions,
          finalTimeSpent,
          false,
          sessionBatchId
        );
      }

      clearUrgencyCache();
      clearTopicsCache();
      clearMcCache();
      try {
        const st = useAppStore.getState().appState;
        const cid = st?.activeId || 'default';
        if (st?.contests?.[cid]) {
          syncAdaptiveFeatureFlags(st.contests[cid], cid, { respectOverrides: true, isAdmin });
        }
      } catch {
        // non-blocking adaptive flag sync
      }

      stepRef.current = 'finished';
      latestQuestionsRef.current = [];
      latestAnswersRef.current = {};
      latestTimePerQuestionRef.current = {};
      activeElapsedSecsRef.current = 0;
      simStartMsRef.current = null;
      setResults({
        correct: correctCount, total, scorePercent, effectiveScorePercent,
        blanks: blanksCount, netPoints: overallEff.netPoints,
        questions: answeredQuestions, timeSpentSecs: finalTimeSpent,
      });
      setStep('finished');
      setTimerActive(false);
      safeLocalRemove(getAiSimStorageKey(sessionContestIdRef.current));
      safeLocalRemove(getAiGenStorageKey(sessionContestIdRef.current));
      showToast(`Simulado finalizado! ${correctCount}/${total} acertos`, 'success');
      try {
        useAppStore.getState().awardExperience?.(500);
      } catch (xpErr) {
        console.warn('Falha não-bloqueante ao conceder XP do simulado IA:', xpErr);
      }
    } catch (error) {
      console.error('[Simulado] Error finishing:', error);
      showToast('Erro ao finalizar o simulado.', 'error');
      isFinishingRef.current = false;
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [saveAIResultsToSystem, showToast, setData, isAdmin]);

  const finishMutexRef = useRef(false);

  const safeFinish = useCallback(async () => {
    if (finishMutexRef.current) return;
    finishMutexRef.current = true;
    try {
      await handleFinish();
    } finally {
      setTimeout(() => { finishMutexRef.current = false; }, 1000);
    }
  }, [handleFinish]);

  const safeFinishRef = useRef(safeFinish);
  useEffect(() => { safeFinishRef.current = safeFinish; }, [safeFinish]);

  const activeQIdRef = useRef(null);
  useEffect(() => { activeQIdRef.current = questions[currentIndex]?.id; }, [currentIndex, questions]);

  useEffect(() => {
    if (!timerActive || step !== 'playing') return;

    let lastTick = Date.now();

    const interval = setInterval(() => {
      const now = Date.now();
      const elapsedSecs = Math.floor((now - lastTick) / 1000);

      if (elapsedSecs > 0) {
        lastTick += elapsedSecs * 1000;
        activeElapsedSecsRef.current += elapsedSecs;
        setTimeLeft((prev) => {
          const next = prev - elapsedSecs;
          return next <= 0 ? 0 : next;
        });

        const qId = activeQIdRef.current;
        if (qId) {
          setTimePerQuestion(prev => ({ ...prev, [qId]: (prev[qId] || 0) + elapsedSecs }));
        }
      }
    }, 1000);

    return () => clearInterval(interval);
  }, [timerActive, step]);

  useEffect(() => {
    if (step !== 'playing') return;
    if (!timerActive) return;
    if (timeLeft > 0) return;
    if (isFinishingRef.current) return;

    safeFinishRef.current();
  }, [step, timerActive, timeLeft]);

  const resetAll = useCallback(() => {
    isFinishingRef.current = false;
    stepRef.current = 'setup';
    latestQuestionsRef.current = [];
    latestAnswersRef.current = {};
    latestTimePerQuestionRef.current = {};
    activeElapsedSecsRef.current = 0;
    simStartMsRef.current = null;
    setForm(prev => prev.categoryId === 'mixed'
      ? { ...prev, categoryId: '', taskId: '', materia: '', assunto: '' }
      : prev
    );
    setStep('setup');
    setQuestions([]);
    setAnswers({});
    setTimePerQuestion({});
    setCurrentIndex(0);
    setResults(null);
    setTimeLeft(Math.max(1, Number(form.quantidade) || 10) * 3 * 60);
    setTimerActive(false);
    setShowReview(false);
    safeLocalRemove(getAiSimStorageKey(sessionContestIdRef.current));
    safeLocalRemove(getAiGenStorageKey(sessionContestIdRef.current));
  }, [form.quantidade]);

  const retrySameQuestions = () => {
    const initialTimeLeft = questions.length * 3 * 60;
    isFinishingRef.current = false;
    stepRef.current = 'playing';
    latestQuestionsRef.current = questions;
    latestAnswersRef.current = {};
    latestTimePerQuestionRef.current = {};
    latestCurrentIndexRef.current = 0;
    latestTimeLeftRef.current = initialTimeLeft;
    setAnswers({});
    setTimePerQuestion({});
    setCurrentIndex(0);
    setResults(null);
    setTimeLeft(initialTimeLeft);
    setTimerActive(true);
    setShowReview(false);
    setStep('playing');

    activeElapsedSecsRef.current = 0;
    simStartMsRef.current = Date.now();

    showToast('Questões reiniciadas. Boa sorte!', 'info');
  };

  useEffect(() => {
    if (step !== 'playing' || !currentQuestion || showEscapeConfirm) return;
    const handleKeyDown = (e) => {
      if (e.ctrlKey || e.metaKey || e.altKey) return;
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.tagName === 'SELECT')) {
        return;
      }
      const key = e.key.toUpperCase();
      const curIdx = latestCurrentIndexRef.current;
      const qLen = latestQuestionsRef.current.length || questions.length;
      if (['A', 'B', 'C', 'D', 'E'].includes(key)) { e.preventDefault(); selectAnswer(key); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(curIdx - 1); }
      else if (e.key === 'ArrowRight' || e.key === 'Enter') {
        e.preventDefault();
        if (curIdx < qLen - 1) goTo(curIdx + 1); else safeFinishRef.current();
      } else if (e.key.toLowerCase() === 'escape') {
        e.preventDefault();
        setShowEscapeConfirm(true);
      }
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);

  }, [step, currentQuestion, showEscapeConfirm, questions.length, goTo, selectAnswer, resetAll]);

  useEffect(() => {
    let interval = null;
    let timeout = null;
    if (isLoading) {
      interval = setInterval(() => {
        setLoadingMsgIdx(prev => (prev < LOADING_MESSAGES.length - 1 ? prev + 1 : prev));
      }, 3500);
    } else {
      timeout = setTimeout(() => setLoadingMsgIdx(0), 0);
    }
    return () => {
      if (interval) clearInterval(interval);
      if (timeout) clearTimeout(timeout);
    };
  }, [isLoading]);

  const handleSelectConfidence = useCallback((questionId, level) => {
    setConfidences((prev) => ({ ...prev, [questionId]: level }));
  }, []);

  const handleTagErrorType = useCallback((questionId, errType) => {
    setErrorTypes((prev) => ({ ...prev, [questionId]: errType }));
    if (!lastSessionBatchId) return;
    setData((contest) => {
      if (!contest || !contest.simuladoRows) return contest;
      const rowsArr = Array.isArray(contest.simuladoRows)
        ? contest.simuladoRows
        : Object.values(contest.simuladoRows || {}).filter(Boolean);
      const nextRows = rowsArr.map((row) => {
        if (!row || row.batchId !== lastSessionBatchId || !Array.isArray(row.questionTelemetry)) return row;
        const nextTel = row.questionTelemetry.map((q) => (q && q.id === questionId ? { ...q, errorType: errType } : q));
        return { ...row, questionTelemetry: nextTel };
      });
      return { ...contest, simuladoRows: nextRows };
    });
  }, [lastSessionBatchId, setData]);

  const handleCreateErrorFlashcards = useCallback(() => {
    const wrongQs = (results?.questions || []).filter((q) => q && !q.isCorrect);
    if (!wrongQs.length) {
      showToast('Nenhuma questão errada para converter em flashcard.', 'info');
      return;
    }
    const nowIso = new Date().toISOString();
    const deckName = `Erros IA — ${form.materia || 'Geral'}`;
    let createdCount = 0;

    setData((contest) => {
      if (!contest) return contest;
      const decks = (Array.isArray(contest.flashcardDecks)
        ? [...contest.flashcardDecks]
        : Object.values(contest.flashcardDecks || {})).filter(Boolean);
      let targetIdx = decks.findIndex((d) => d && normalize(d.name) === normalize(deckName));
      const newCards = wrongQs.map((q) => {
        const isCritical = confidences[q.id] === 'certeza';
        const front = `${isCritical ? '[ERRO CRÍTICO] ' : ''}${String(q.enunciado || '').slice(0, 220)}`;
        const back = `Gabarito: ${q.alternativa_correta}\n${q.justificativa || ''}`.trim();
        return {
          id: generateId('card'),
          front,
          back,
          interval: 1,
          ease: isCritical ? 2.1 : 2.5,
          priority: isCritical ? 'critical' : 'normal',
          confidence: confidences[q.id] || null,
          errorType: errorTypes[q.id] || null,
          reviews: 0,
          lapses: isCritical ? 1 : 0,
          due: getDateKey(new Date()) || nowIso.slice(0, 10),
          createdAt: nowIso,
          source: 'ai-error',
        };
      });
      createdCount = newCards.length;
      if (targetIdx === -1) {
        decks.push({
          id: generateId('deck'),
          name: deckName,
          categoryId: form.categoryId !== 'mixed' ? form.categoryId : null,
          subject: form.materia || 'Geral',
          cards: newCards,
          createdAt: nowIso,
          lastUpdated: nowIso,
          updatedAt: nowIso,
        });
      } else {
        const existingDeck = decks[targetIdx];
        const existingCards = (Array.isArray(existingDeck.cards)
          ? existingDeck.cards
          : Object.values(existingDeck.cards || {})).filter(Boolean);
        decks[targetIdx] = {
          ...existingDeck,
          cards: [...existingCards, ...newCards],
          lastUpdated: nowIso,
          updatedAt: nowIso,
        };
      }
      return { ...contest, flashcardDecks: decks, lastUpdated: nowIso };
    });

    showToast(`${createdCount} flashcard(s) FSRS criado(s) no deck "${deckName}"!`, 'success');
  }, [results, form.materia, form.categoryId, confidences, errorTypes, setData, showToast]);

  const handleStartAdaptiveNextRound = useCallback((nextDiff) => {
    setForm((prev) => ({ ...prev, dificuldade: nextDiff }));
    setStep('setup');
    setQuestions([]);
    setAnswers({});
    setConfidences({});
    setErrorTypes({});
    setResults(null);
    showToast(`Modo Adaptativo (CAT): nível ajustado para ${nextDiff.toUpperCase()}. Clique em Gerar!`, 'info');
  }, [showToast]);

  const recommendedNextDifficulty = useMemo(() => {
    if (!results || !results.total) return null;
    const avgSec = results.total > 0 ? (results.timeSpentSecs || 0) / results.total : null;
    const scoreForCat = results.effectiveScorePercent ?? results.scorePercent;
    return nextAdaptiveDifficulty(form.dificuldade, scoreForCat, avgSec);
  }, [results, form.dificuldade]);

  if (step === 'setup') {
    return (
      <SimuladoSetup
        form={form} handleInputChange={handleInputChange} categories={categories}
        handleCategorySelect={handleCategorySelect} handleTaskSelect={handleTaskSelect}
        availableTasks={availableTasks} generatePersonalizedSimulado={generatePersonalizedSimulado}
        generateFullExamSimulado={generateFullExamSimulado}
        triRecommendation={triRecommendation}
        isAdmin={isAdmin}
        handleGenerate={handleGenerate} isLoading={isLoading} loadingMsgIdx={loadingMsgIdx}
        DIFFICULTIES={DIFFICULTIES} LOADING_MESSAGES={LOADING_MESSAGES}
      />
    );
  }
  if (step === 'playing' && currentQuestion) {
    return (
      <>
        <SimuladoPlayer
          form={form} questions={questions} currentIndex={currentIndex} answers={answers}
          confidences={confidences} onSelectConfidence={handleSelectConfidence}
          timeLeft={timeLeft} DIFFICULTIES={DIFFICULTIES} goTo={goTo} selectAnswer={selectAnswer}
          clearAnswer={clearAnswer} penaltyPerWrong={contestPenalty}
          handleFinish={safeFinish} resetAll={() => setShowEscapeConfirm(true)}
        />
        <ConfirmModal
          isOpen={showEscapeConfirm}
          onClose={() => setShowEscapeConfirm(false)}
          onConfirm={() => { setShowEscapeConfirm(false); resetAll(); }}
          title="Sair do Simulado"
          message="Tem certeza que deseja sair? Todo o progresso deste simulado será perdido."
          confirmText="Sair e Descartar"
          type="danger"
        />
      </>
    );
  }
  if (step === 'finished' && results) {
    return (
      <SimuladoResults
        results={results} form={form} showReview={showReview} setShowReview={setShowReview}
        resetAll={resetAll} retrySameQuestions={retrySameQuestions} showToast={showToast}
        errorTypes={errorTypes} onTagErrorType={handleTagErrorType}
        onCreateErrorFlashcards={handleCreateErrorFlashcards}
        onStartAdaptiveNextRound={handleStartAdaptiveNextRound}
        recommendedNextDifficulty={recommendedNextDifficulty}
        penaltyPerWrong={contestPenalty}
        examBoard={contestBoard}
      />
    );
  }
  return (
    <div className="flex flex-col items-center justify-center min-h-[300px] gap-4 p-8 text-center bg-slate-900/60 rounded-2xl border border-white/5 mx-auto">
      <p className="text-sm text-slate-400">Nenhuma questão ativa ou estado de simulado divergente.</p>
      <button
        onClick={resetAll}
        className="px-6 py-2.5 bg-indigo-600 hover:bg-indigo-500 rounded-xl font-bold text-white text-sm transition-colors"
      >
        Voltar ao início
      </button>
    </div>
  );
}
