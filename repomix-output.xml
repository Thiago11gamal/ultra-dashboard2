<file path="src/utils/__tests__/lazyRetry.test.jsx">
import React, { Suspense } from 'react';
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { render, screen, waitFor } from '@testing-library/react';
import {
  lazyWithRetry,
  isChunkLoadError,
  hasRecentlyForceRefreshed,
  clearChunkReloadState,
  preloadRoute,
  REFRESH_KEY,
  REFRESH_AT_KEY,
  REFRESH_COOLDOWN_MS,
} from '../lazyRetry';

describe('lazyRetry & Resilient Chunk Loading', () => {
  const originalLocation = window.location;
  const originalOnLine = Object.getOwnPropertyDescriptor(window.navigator, 'onLine');
  let reloadMock;

  beforeEach(() => {
    clearChunkReloadState();
    reloadMock = vi.fn();
    delete window.location;
    window.location = { ...originalLocation, reload: reloadMock };
    Object.defineProperty(window.navigator, 'onLine', {
      configurable: true,
      get: () => true,
    });
  });

  afterEach(() => {
    window.location = originalLocation;
    if (originalOnLine) {
      Object.defineProperty(window.navigator, 'onLine', originalOnLine);
    }
    vi.restoreAllMocks();
  });

  it('recovers from transient chunk errors in-memory without reloading the page', async () => {
    let attempts = 0;
    const MockComp = () => <div data-testid="loaded-comp">Sucesso</div>;
    const importer = vi.fn(async () => {
      attempts += 1;
      if (attempts < 3) {
        throw new TypeError('Failed to fetch dynamically imported module: /assets/Page.js');
      }
      return { default: MockComp };
    });

    const LazyComp = lazyWithRetry(importer, { retries: 2, retryDelayMs: 5 });

    render(
      <Suspense fallback={<div>Carregando...</div>}>
        <LazyComp />
      </Suspense>
    );

    await waitFor(() => {
      expect(screen.getByTestId('loaded-comp')).toBeDefined();
    });
    expect(importer).toHaveBeenCalledTimes(3);
    expect(reloadMock).not.toHaveBeenCalled();
  });

  it('does not retry or force page reload on module contract errors (missing default export)', async () => {
    const importer = vi.fn(async () => ({ namedOnly: () => null }));
    const LazyComp = lazyWithRetry(importer, { retries: 2, retryDelayMs: 5 });

    await expect(LazyComp.preload()).resolves.toBeNull();
    expect(importer).toHaveBeenCalledTimes(1);
    expect(reloadMock).not.toHaveBeenCalled();
  });

  it('does not force page reload when browser is offline (navigator.onLine === false)', async () => {
    Object.defineProperty(window.navigator, 'onLine', {
      configurable: true,
      get: () => false,
    });

    const importer = vi.fn(async () => {
      throw new TypeError('Failed to fetch dynamically imported module');
    });

    const LazyComp = lazyWithRetry(importer, { retries: 2, retryDelayMs: 5 });

    class LocalBoundary extends React.Component {
      constructor(props) {
        super(props);
        this.state = { err: null };
      }
      static getDerivedStateFromError(err) {
        return { err };
      }
      render() {
        if (this.state.err) return <div data-testid="offline-err">{this.state.err.message}</div>;
        return this.props.children;
      }
    }

    render(
      <LocalBoundary>
        <Suspense fallback={<div>Carregando...</div>}>
          <LazyComp />
        </Suspense>
      </LocalBoundary>
    );

    await waitFor(() => {
      expect(screen.getByTestId('offline-err')).toBeDefined();
    });
    expect(importer).toHaveBeenCalledTimes(1);
    expect(reloadMock).not.toHaveBeenCalled();
  });

  it('clears expired force-refresh cooldown automatically so future deploys can reload', () => {
    const pastTimestamp = Date.now() - (REFRESH_COOLDOWN_MS + 5_000);
    window.sessionStorage.setItem(REFRESH_KEY, 'true');
    window.sessionStorage.setItem(REFRESH_AT_KEY, String(pastTimestamp));

    expect(hasRecentlyForceRefreshed()).toBe(false);
    expect(window.sessionStorage.getItem(REFRESH_KEY)).toBe('false');
  });

  it('supports .preload() and preloadRoute() with request deduplication', async () => {
    const MockComp = () => <div>Route Preloaded</div>;
    const importer = vi.fn(async () => ({ default: MockComp }));

    lazyWithRetry(importer, { route: '/test-preload-route' });

    const [res1, res2] = await Promise.all([
      preloadRoute('/test-preload-route?tab=1'),
      preloadRoute('/test-preload-route#section'),
    ]);

    expect(res1?.default).toBe(MockComp);
    expect(res2?.default).toBe(MockComp);
    expect(importer).toHaveBeenCalledTimes(1);
  });

  it('identifies chunk load errors accurately via isChunkLoadError', () => {
    expect(isChunkLoadError(new TypeError('Failed to fetch dynamically imported module'))).toBe(true);
    expect(isChunkLoadError(new Error('Importing a module script failed'))).toBe(true);
    expect(isChunkLoadError(new Error('Unable to preload CSS for /assets/style.css'))).toBe(true);
    expect(isChunkLoadError(new ReferenceError('foo is not defined'))).toBe(false);
    expect(isChunkLoadError(new Error('Module has no default export'))).toBe(false);
  });
});
</file>

<file path="src/utils/__tests__/measurement.test.js">
import { describe, it, expect } from "vitest";
import {
  safeDomain,
  normalizeScoreValue,
  sanitizeSimuladoRow,
  mergeQuestionResult,
  toProb01,
  toProbPct,
  resolveTargetPoints,
  deduplicateSimulados,
  latestByDate,
  pointsToPct,
  pctToPoints,
  migrateContestData
} from "../measurement.js";

describe("measurement", () => {
  it("cria domínio seguro", () => {
    const d = safeDomain(1000, 200);

    expect(d.min).toBe(200);
    expect(d.max).toBe(1000);
    expect(d.range).toBe(800);
  });

  it("converte pct para points com minScore", () => {
    expect(pctToPoints(50, 1000, 200)).toBe(600);
  });

  it("converte points para pct com minScore", () => {
    expect(pointsToPct(600, 1000, 200)).toBe(50);
  });

  it("normaliza percentual explícito", () => {
    const norm = normalizeScoreValue(
      { score: 80, isPercentage: true },
      1000,
      0
    );

    expect(norm.points).toBe(800);
    expect(norm.pct).toBe(80);
  });

  it("total/correct manda mais que score", () => {
    const norm = normalizeScoreValue(
      { total: 10, correct: 8, score: 10 },
      1000,
      0
    );

    expect(norm.points).toBe(800);
    expect(norm.pct).toBe(80);
  });

  it("sanitize zera correct quando total é zero", () => {
    const row = sanitizeSimuladoRow(
      { total: 0, correct: 5 },
      100
    );

    expect(row.total).toBe(0);
    expect(row.correct).toBe(0);
  });

  it("sanitize clamp correct > total", () => {
    const row = sanitizeSimuladoRow(
      { total: 10, correct: 20 },
      100
    );

    expect(row.correct).toBe(10);
    expect(row.total).toBe(10);
  });

  it("mergeQuestionResult nunca deixa correct maior que total", () => {
    const row = mergeQuestionResult(
      { total: 10, correct: 8 },
      { total: 5, correct: 10 },
      100
    );

    expect(row.total).toBe(10);
    expect(row.correct).toBeLessThanOrEqual(10);
  });

  it("probabilidade aceita 0-1 e 0-100", () => {
    expect(toProb01(0.7)).toBe(0.7);
    expect(toProb01(70)).toBe(0.7);
    expect(toProb01(70, "pct")).toBe(0.7);
    expect(toProbPct(0.7)).toBe(70);
  });

  it("resolve meta percentual para pontos", () => {
    const domain = safeDomain(1000, 0);
    expect(resolveTargetPoints(70, domain, "pct")).toBe(700);
  });

  it("deduplicação preserva matérias diferentes na mesma data", () => {
    const rows = [
      {
        subject: "Português",
        date: "2026-01-01",
        score: 80,
        isPercentage: true
      },
      {
        subject: "Matemática",
        date: "2026-01-01",
        score: 80,
        isPercentage: true
      }
    ];

    const unique = deduplicateSimulados(rows, {
      maxScore: 1000,
      minScore: 0,
      getDateKey: (d) => String(d).slice(0, 10)
    });

    expect(unique).toHaveLength(2);
  });

  it("deduplicateSimulados com defaultGetDateKey não desloca datas YYYY-MM-DD em fuso UTC-4", () => {
    const rows = [
      { subject: "Direito Civil", date: "2026-01-01", total: 10, correct: 8 },
      { subject: "Direito Civil", date: "2026-01-01T15:00:00-04:00", total: 10, correct: 8 }
    ];
    const unique = deduplicateSimulados(rows, { maxScore: 100, minScore: 0 });
    expect(unique).toHaveLength(1);
  });

  it("migrateContestData sanitiza simuladoStats.history e simuladoRows", () => {
    const migrated = migrateContestData({
      maxScore: 100,
      minScore: 0,
      simuladoRows: [{ date: "2026-05-01", total: 10, correct: 15 }],
      categories: [{ id: "c1", name: "Direito Penal", simuladoStats: { history: [{ date: "2026-05-01", total: 5, correct: 9 }] } }]
    });
    expect(migrated.simuladoRows[0].correct).toBe(10);
    expect(migrated.categories[0].simuladoStats.history[0].correct).toBe(5);
  });

  it("migrateContestData preserva minScore negativo (ex.: Cebraspe -120..120)", () => {
    const migrated = migrateContestData({
      maxScore: 120,
      minScore: -120,
      categories: [{ id: "c1", name: "Penal", maxScore: 120, minScore: -120, simuladoStats: { history: [{ date: "2026-05-01", score: -30 }] } }]
    });
    expect(migrated.minScore).toBe(-120);
    expect(migrated.categories[0].minScore).toBe(-120);
    expect(migrated.categories[0].simuladoStats.history[0].score).toBe(-30);
  });

  it("normalizeScoreValue deriva correct de score quando total > 0 e correct está ausente", () => {
    const norm = normalizeScoreValue({ total: 50, score: 80, isPercentage: true }, 100, 0);
    expect(norm.points).toBe(80);
    expect(norm.pct).toBe(80);
    expect(norm.correct).toBe(40);
    expect(norm.total).toBe(50);
  });

  it("latestByDate retorna o mais recente por data real", () => {
    const rows = [
      { date: "2026-01-01", id: "a" },
      { date: "2026-02-01", id: "b" },
      { date: "2026-01-15", id: "c" }
    ];

    const latest = latestByDate(rows);
    expect(latest.id).toBe("b");
  });
});
