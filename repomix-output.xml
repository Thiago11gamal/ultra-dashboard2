<file path="src/components/charts/ReliabilityCurveChart.jsx">
import React, { useMemo } from 'react';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer, ReferenceLine } from 'recharts';
import { Target } from 'lucide-react';
import { ChartFrame } from './ChartFrame';

// FIX: conversão segura para percentual inteiro (nunca NaN e compatível com 0..1 e 0..100)
const toPercentInt = (value, fallback = 0) => {
    if (value === null || value === undefined || value === '') return fallback;
    const n = Number(value);
    if (!Number.isFinite(n)) return fallback;
    const pct = Math.abs(n) <= 1 ? n * 100 : n;
    const result = Math.round(pct);
    return Number.isFinite(result) ? Math.max(0, Math.min(100, result)) : fallback;
};

/**
 * CustomTooltip for ReliabilityCurveChart
 */
const CustomTooltip = ({ active, payload }) => {
    if (active && payload && payload.length) {
        const dataPoint = payload[0]?.payload;
        if (!dataPoint) return null;
        // FIX: gap inválido não vira "NaN%" no tooltip
        const safeGap = Number.isFinite(dataPoint.gap) ? Math.abs(dataPoint.gap) : 0;
        const isNeutralGap = safeGap < 1e-4;
        const isOverconfident = !isNeutralGap && dataPoint.pred > dataPoint.obs;
        return (
            <div className="bg-slate-900 border border-white/10 p-3 rounded-xl shadow-2xl min-w-[160px]">
                <div className="flex items-center gap-2 mb-2 border-b border-white/10 pb-2">
                    <Target size={14} className="text-cyan-400" />
                    <span className="text-[10px] font-black text-slate-300 uppercase tracking-widest">
                        Confiança {toPercentInt(dataPoint.pred)}%
                    </span>
                </div>
                <div className="space-y-1.5">
                    <div className="flex justify-between items-center gap-4 text-[11px]">
                        <span className="text-slate-500 font-bold">Previsão:</span>
                        <span className="font-mono text-cyan-400 font-bold">{toPercentInt(dataPoint.pred)}%</span>
                    </div>
                    <div className="flex justify-between items-center gap-4 text-[11px]">
                        <span className="text-slate-500 font-bold">Observado:</span>
                        <span className="font-mono text-emerald-400 font-bold">{toPercentInt(dataPoint.obs)}%</span>
                    </div>
                    <div className="flex justify-between items-center gap-4 text-[11px] pt-1 mt-1 border-t border-white/5">
                        <span className="text-slate-500 font-bold">Gap/Viés:</span>
                        <span className={`font-mono font-black ${isNeutralGap ? 'text-slate-400' : isOverconfident ? 'text-amber-400' : 'text-indigo-400'}`}>
                            {isNeutralGap ? '' : isOverconfident ? '-' : '+'}{(safeGap * 100).toFixed(1)}%
                        </span>
                    </div>
                    {/* FIX: n nulo/vazio protegido */}
                    <div className="text-[9px] text-slate-600 font-mono mt-2 text-right">
                        n={Number.isFinite(Number(dataPoint.count)) ? dataPoint.count : 0}
                    </div>
                </div>
            </div>
        );
    }
    return null;
};

/**
 * Gráfico de Confiabilidade (Reliability Diagram)
 * Eixo X: Probabilidade Prevista
 * Eixo Y: Taxa de Acerto Observada
 */
const ReliabilityCurveChart = ({ buckets }) => {
    const chartData = useMemo(() => {
        if (!buckets || !Array.isArray(buckets) || buckets.length === 0) return [];
        return buckets
            .filter(b => {
                const count = b?.count != null && b?.count !== '' ? Number(b.count) : 0;
                const hasPred = b?.meanPred !== null && b?.meanPred !== undefined && b?.meanPred !== '' && Number.isFinite(Number(b.meanPred));
                const hasObs = b?.observedRate !== null && b?.observedRate !== undefined && b?.observedRate !== '' && Number.isFinite(Number(b.observedRate));
                return count > 0 && hasPred && hasObs;
            })
            .map(b => {
                const rawPred = Number(b.meanPred);
                const rawObs = Number(b.observedRate);
                const pred = Math.max(0, Math.min(1, rawPred > 1 ? rawPred / 100 : rawPred));
                const obs = Math.max(0, Math.min(1, rawObs > 1 ? rawObs / 100 : rawObs));
                const rawGap = b?.gap !== null && b?.gap !== undefined && b?.gap !== '' && Number.isFinite(Number(b.gap))
                    ? Math.abs(Number(b.gap))
                    : Math.abs(pred - obs);
                const gap = Math.max(0, Math.min(1, rawGap > 1 ? rawGap / 100 : rawGap));
                return {
                    pred,
                    obs,
                    gap,
                    count: Math.max(0, Math.round(Number(b.count)))
                };
            })
            .sort((a, b) => a.pred - b.pred);
    }, [buckets]);

    if (chartData.length === 0) {
        return (
            <div className="w-full h-48 sm:h-56 flex items-center justify-center bg-slate-900/20 border border-white/5 rounded-2xl">
                <p className="text-[10px] text-slate-600 uppercase font-black tracking-widest">
                    Sem dados de calibração suficientes
                </p>
            </div>
        );
    }

    return (
        <div
            role="img"
            aria-label="Curva de confiabilidade comparando previsão do motor com taxa real de acerto"
            className="w-full h-48 sm:h-56"
        >
            <ChartFrame minHeight={192} label="Curva de Confiabilidade">
                <ResponsiveContainer width="100%" height="100%">
                <LineChart
                    data={chartData}
                    margin={{ top: 16, right: 20, left: 6, bottom: 8 }}
                >
                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" vertical={false} />
                    <XAxis
                        dataKey="pred"
                        type="number"
                        domain={[0, 1]}
                        ticks={[0, 0.25, 0.5, 0.75, 1]}
                        tickFormatter={(val) => `${Math.round(val * 100)}%`}
                        stroke="rgba(255,255,255,0.2)"
                        tick={{ fill: 'rgba(255,255,255,0.4)', fontSize: 10, fontWeight: 700 }}
                        tickLine={false}
                        axisLine={{ stroke: 'rgba(255,255,255,0.1)' }}
                        minTickGap={16}
                        dy={4}
                    />
                    <YAxis
                        type="number"
                        domain={[0, 1]}
                        ticks={[0, 0.25, 0.5, 0.75, 1]}
                        tickFormatter={(val) => `${Math.round(val * 100)}%`}
                        stroke="rgba(255,255,255,0.2)"
                        tick={{ fill: 'rgba(255,255,255,0.4)', fontSize: 10, fontWeight: 700, fontFamily: 'monospace' }}
                        tickLine={false}
                        axisLine={false}
                        width={40}
                        dx={-2}
                    />
                    <Tooltip
                        content={<CustomTooltip />}
                        cursor={{ stroke: 'rgba(255,255,255,0.1)', strokeWidth: 1, strokeDasharray: '4 4' }}
                    />
                    {/* Linha de Calibração Perfeita (y = x) */}
                    <ReferenceLine
                        segment={[{ x: 0, y: 0 }, { x: 1, y: 1 }]}
                        stroke="rgba(255,255,255,0.18)"
                        strokeDasharray="4 4"
                        strokeWidth={1.5}
                    />
                    {/* Curva de Calibração Real */}
                    <Line
                        type="linear"
                        dataKey="obs"
                        stroke="#2dd4bf" /* cyan-400 */
                        strokeWidth={2.5}
                        dot={{ r: 4.5, fill: '#090d16', stroke: '#2dd4bf', strokeWidth: 2 }}
                        activeDot={{ r: 6.5, fill: '#2dd4bf', stroke: '#ffffff', strokeWidth: 2 }}
                        isAnimationActive={false}
                        connectNulls={true}
                    />
                </LineChart>
                </ResponsiveContainer>
            </ChartFrame>
        </div>
    );
};

export default React.memo(ReliabilityCurveChart);
</file>

<file path="src/components/coach/AdaptiveTacticalAlerts.jsx">
import React, { useMemo } from 'react';
import { Flame, AlertTriangle, Brain, ShieldAlert } from 'lucide-react';
import { computeACWR } from '../../engine/adaptive/workloadACWR';
import { computeWeeklyCategoryCorrelation } from '../../engine/diagnostics';
import { estimateIRTAbility } from '../../engine/adaptive/irtEngine';

const safeArr = (v) => (Array.isArray(v) ? v : (v && typeof v === 'object' ? Object.values(v) : [])).filter(Boolean);

/**
 * Gera alertas táticos automáticos no topo do Coach quando detecta:
 * 1) Risco de Burnout (ACWR > 1.5×)
 * 2) Crowding-out entre disciplinas (r <= -0.45)
 * 3) Incoerência pedagógica TRI (errando fáceis e acertando difíceis)
 * 4) Ilusão de competência (certeza + erro recorrente)
 */
export const AdaptiveTacticalAlerts = React.memo(function AdaptiveTacticalAlerts({
  categories = [],
  studyLogs = [],
  simuladoRows = [],
  minScore = 0,
  maxScore = 100,
}) {
  const alerts = useMemo(() => {
    const list = [];

    // 1. ACWR Burnout alert
    const acwr = computeACWR(studyLogs);
    if (acwr.hasChronicle && (acwr.zone === 'burnout_risk' || acwr.zone === 'elevated')) {
      list.push({
        id: 'acwr-alert',
        severity: acwr.zone === 'burnout_risk' ? 'critical' : 'warning',
        icon: Flame,
        title: acwr.zone === 'burnout_risk' ? `Risco de Burnout (ACWR ${acwr.acwr.toFixed(2)}×)` : `Carga Cognitiva Elevada (ACWR ${acwr.acwr.toFixed(2)}×)`,
        body: `${acwr.advice} Bloco Pomodoro ideal hoje: ${acwr.recommendedBlockMinutes} min.`,
      });
    }

    // 2. Crowding-Out detection
    const corr = computeWeeklyCategoryCorrelation(categories, maxScore, minScore);
    const worstCrowding = (corr.pairs || []).find((p) => p.type === 'crowding_out');
    if (worstCrowding) {
      list.push({
        id: 'crowding-out',
        severity: 'warning',
        icon: AlertTriangle,
        title: `Canibalização Detectada (${worstCrowding.catA} × ${worstCrowding.catB})`,
        body: `Correlação semanal r = ${worstCrowding.r} (${worstCrowding.n} semanas): quando você acelera em ${worstCrowding.catA}, seu desempenho cai em ${worstCrowding.catB}. Use interleaving na Agenda para alternar blocos.`,
      });
    }

    // 3. TRI Pedagogical Incoherence
    const allEntries = [
      ...safeArr(simuladoRows),
      ...safeArr(categories).flatMap((c) => safeArr(c?.simuladoStats?.history)),
    ];
    const irt = estimateIRTAbility(allEntries, { minScore, maxScore });
    if (irt.pedagogicalIncoherence && irt.incoherenceMessage) {
      list.push({
        id: 'tri-incoherence',
        severity: 'warning',
        icon: Brain,
        title: `Incoerência Pedagógica TRI (θ = ${irt.theta >= 0 ? '+' : ''}${irt.theta})`,
        body: irt.incoherenceMessage,
      });
    }

    // 4. Illusion of Competence (certeza + erro)
    const allTelemetry = safeArr(simuladoRows).flatMap((r) => safeArr(r?.questionTelemetry));
    const illusionErrors = allTelemetry.filter((q) => q && q.confidence === 'certeza' && q.correct === false);
    if (illusionErrors.length >= 2) {
      list.push({
        id: 'illusion-competence',
        severity: 'critical',
        icon: ShieldAlert,
        title: `Ilusão de Competência (${illusionErrors.length} erros com "Certeza")`,
        body: 'Você marcou "Certeza" mas errou essas questões. Revise no Caderno de Erros e envie para Flashcards FSRS com prioridade crítica.',
      });
    }

    return list;
  }, [categories, studyLogs, simuladoRows, minScore, maxScore]);

  if (alerts.length === 0) return null;

  return (
    <div className="mb-4 grid grid-cols-1 md:grid-cols-2 gap-3">
      {alerts.map((a) => {
        const Icon = a.icon;
        const isCritical = a.severity === 'critical';
        return (
          <div
            key={a.id}
            className={`rounded-2xl border p-3.5 flex items-start gap-3 ${
              isCritical
                ? 'border-rose-500/35 bg-rose-500/10 text-rose-100'
                : 'border-amber-500/30 bg-amber-500/10 text-amber-100'
            }`}
          >
            <div className={`p-2 rounded-xl shrink-0 ${isCritical ? 'bg-rose-500/20 text-rose-300' : 'bg-amber-500/20 text-amber-300'}`}>
              <Icon size={16} />
            </div>
            <div className="min-w-0">
              <h4 className="text-xs font-black uppercase tracking-wider">{a.title}</h4>
              <p className="text-[11px] opacity-85 leading-relaxed mt-1">{a.body}</p>
            </div>
          </div>
        );
      })}
    </div>
  );
});

export default AdaptiveTacticalAlerts;
</file>

<file path="src/components/pomodoro/PomodoroProgress.jsx">
import React, { useEffect } from 'react';
import { Minus, Plus, Layers } from 'lucide-react';
import { MAX_TARGET_CYCLES } from '../../utils/pomodoroHelpers';

export const PomodoroProgress = React.memo(function PomodoroProgress({
    targetCycles,
    completedCycles,
    setTargetCycles,
    syncChannel,
    STABLE_TAB_ID,
    activeSubject,
    workFillsRef,
    breakBallsRef,
    mode = 'work',
    timeLeft = 0,
    totalTime = 25 * 60
}) {
    const safeTargetCycles = Math.min(MAX_TARGET_CYCLES, Math.max(1, Math.round(Number(targetCycles) || 1)));
    const safeCompletedCycles = Math.min(safeTargetCycles, Math.max(0, Math.round(Number(completedCycles) || 0)));

    const persistTargetCycles = (newTarget) => {
        try {
            const raw = localStorage.getItem('pomodoroState');
            if (raw) {
                const parsed = JSON.parse(raw);
                if (parsed && typeof parsed === 'object') {
                    parsed.targetCycles = newTarget;
                    localStorage.setItem('pomodoroState', JSON.stringify(parsed));
                }
            }
        } catch { /* ignore */ }
    };

    useEffect(() => {
        if (workFillsRef?.current && Array.isArray(workFillsRef.current)) {
            workFillsRef.current.length = safeTargetCycles;
        }
        if (breakBallsRef?.current && Array.isArray(breakBallsRef.current)) {
            breakBallsRef.current.length = Math.max(0, safeTargetCycles - 1);
        }
    }, [safeTargetCycles, workFillsRef, breakBallsRef]);

    return (
        <div className="w-full rounded-2xl border-2 border-[#94785a] bg-[#b08e6b] px-3.5 sm:px-4 py-2 sm:py-2.5 shadow-xl relative overflow-hidden group">
            <div className="absolute inset-0 bg-gradient-to-b from-white/20 via-transparent to-black/5 pointer-events-none" />

            <div className="relative z-10 flex flex-col gap-1.5">
                {/* Header: Title & Cycle Stepper */}
                <div className="flex items-center justify-between gap-3">
                    <div className="flex items-center gap-1.5">
                        <Layers size={14} className="text-[#2d1a12]/80" />
                        <h3 className="text-xs sm:text-[13px] font-black text-[#2d1a12]/90 uppercase tracking-[0.2em]">
                            Progresso dos Ciclos
                        </h3>
                    </div>

                    <div className="flex items-center gap-1.5 text-[#2d1a12]">
                        <button
                            type="button"
                            onClick={() => {
                                const minAllowed = Math.min(MAX_TARGET_CYCLES, safeCompletedCycles + 1);
                                const newTarget = Math.max(minAllowed, safeTargetCycles - 1);
                                if (typeof setTargetCycles === 'function') {
                                    setTargetCycles(newTarget);
                                }
                                persistTargetCycles(newTarget);
                                try {
                                    if (syncChannel && typeof syncChannel.postMessage === 'function') {
                                        syncChannel.postMessage({
                                            type: 'TARGET_CYCLES_CHANGE',
                                            targetCycles: newTarget,
                                            tabId: STABLE_TAB_ID,
                                            taskId: activeSubject?.taskId || null,
                                            sessionInstanceId: activeSubject?.sessionInstanceId || null
                                        });
                                    }
                                } catch (err) {
                                    console.warn('[PomodoroProgress] Falha ao sincronizar:', err);
                                }
                            }}
                            disabled={safeTargetCycles <= Math.min(MAX_TARGET_CYCLES, safeCompletedCycles + 1)}
                            className="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#2d1a12]/10 hover:bg-[#2d1a12]/20 active:scale-95 flex items-center justify-center transition-all disabled:opacity-30 disabled:cursor-not-allowed border border-[#2d1a12]/20 shadow-inner"
                            title="Reduzir meta de ciclos"
                            aria-label={`Reduzir meta de ciclos para ${safeTargetCycles - 1}`}
                        >
                            <Minus size={13} className="stroke-[3]" />
                        </button>

                        <div 
                            className="flex items-baseline gap-1 px-2 py-0.5 rounded-lg bg-[#2d1a12]/10 border border-[#2d1a12]/15 text-xs sm:text-sm font-black tabular-nums shadow-inner"
                            role="status"
                            aria-live="polite"
                            aria-label={`Ciclos: ${safeCompletedCycles} de ${safeTargetCycles}`}
                        >
                            <span className="text-[#2d1a12] font-black">{safeCompletedCycles}</span>
                            <span className="text-[#2d1a12]/40 text-[10px] font-bold">/</span>
                            <span className="text-[#2d1a12]/80 text-[10px] font-bold">{safeTargetCycles}</span>
                        </div>

                        <button
                            type="button"
                            onClick={() => {
                                const newTarget = Math.min(MAX_TARGET_CYCLES, safeTargetCycles + 1);
                                if (typeof setTargetCycles === 'function') {
                                    setTargetCycles(newTarget);
                                }
                                persistTargetCycles(newTarget);
                                try {
                                    if (syncChannel && typeof syncChannel.postMessage === 'function') {
                                        syncChannel.postMessage({
                                            type: 'TARGET_CYCLES_CHANGE',
                                            targetCycles: newTarget,
                                            tabId: STABLE_TAB_ID,
                                            taskId: activeSubject?.taskId || null,
                                            sessionInstanceId: activeSubject?.sessionInstanceId || null
                                        });
                                    }
                                } catch (err) {
                                    console.warn('[PomodoroProgress] Falha ao sincronizar:', err);
                                }
                            }}
                            disabled={safeTargetCycles >= MAX_TARGET_CYCLES}
                            className="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-[#2d1a12]/10 hover:bg-[#2d1a12]/20 active:scale-95 flex items-center justify-center transition-all disabled:opacity-30 disabled:cursor-not-allowed border border-[#2d1a12]/20 shadow-inner"
                            title="Aumentar meta de ciclos"
                            aria-label={`Aumentar meta de ciclos para ${safeTargetCycles + 1}`}
                        >
                            <Plus size={13} className="stroke-[3]" />
                        </button>
                    </div>
                </div>

                {/* Progress Indicators Track - Barras e Bolinhas Maiores (com escala dinâmica para metas longas) */}
                <div className="flex items-center gap-1 sm:gap-1.5 pt-0.5 overflow-x-auto custom-scrollbar pb-0.5">
                    {Array.from({ length: safeTargetCycles }).map((_, i) => {
                        let workRatio = 0;
                        let breakRatio = 0;
                        const isCompact = safeTargetCycles > 6;

                        const progressRatio = (Number.isFinite(totalTime) && totalTime > 0)
                            ? Math.max(0, Math.min(1, (totalTime - timeLeft) / totalTime))
                            : 0;

                        if (mode === 'work') {
                            if (i < safeCompletedCycles) {
                                workRatio = 1;
                                breakRatio = 1;
                            } else if (i === safeCompletedCycles) {
                                workRatio = progressRatio;
                                breakRatio = 0;
                            }
                        } else {
                            if (i < safeCompletedCycles - 1) {
                                workRatio = 1;
                                breakRatio = 1;
                            } else if (i === safeCompletedCycles - 1) {
                                workRatio = 1;
                                breakRatio = progressRatio;
                            }
                        }

                        return (
                            <React.Fragment key={i}>
                                {/* Barra de Progresso do Foco (transform scaleX para evitar reflow a 60fps) */}
                                <div className={`flex-1 min-w-[12px] ${isCompact ? 'h-3 sm:h-3.5' : 'h-3.5 sm:h-4'} bg-[#2d1a12]/20 rounded-full overflow-hidden border-2 border-[#2d1a12]/25 shadow-inner`}>
                                    <div
                                        ref={el => {
                                            if (workFillsRef?.current && Array.isArray(workFillsRef.current)) {
                                                workFillsRef.current[i] = el || undefined;
                                            }
                                        }}
                                        style={{ transform: `scaleX(${workRatio})`, transformOrigin: 'left center' }}
                                        className="w-full h-full bg-gradient-to-r from-blue-600 to-blue-500 rounded-full shadow-sm"
                                    />
                                </div>

                                {/* Bolinha Verde de Pausa (transform scaleY para evitar reflow a 60fps) */}
                                {i < safeTargetCycles - 1 && (
                                    <div className={`relative ${isCompact ? 'w-4 h-4 sm:w-4.5 sm:h-4.5' : 'w-5 h-5 sm:w-6 sm:h-6'} rounded-full bg-[#2d1a12]/20 border-2 border-[#2d1a12]/35 overflow-hidden shrink-0 shadow-md`}>
                                        <div
                                            ref={el => {
                                                if (breakBallsRef?.current && Array.isArray(breakBallsRef.current)) {
                                                    breakBallsRef.current[i] = el || undefined;
                                                }
                                            }}
                                            style={{ transform: `scaleY(${breakRatio})`, transformOrigin: 'bottom center' }}
                                            className="absolute inset-0 w-full h-full bg-gradient-to-t from-emerald-600 to-emerald-400 shadow-[0_0_10px_rgba(34,197,94,0.6)]"
                                        />
                                    </div>
                                )}
                            </React.Fragment>
                        );
                    })}
                </div>
            </div>
        </div>
    );
});

export default PomodoroProgress;
</file>

