import React, { useMemo, useState } from 'react';
import {
  ScatterChart,
  Scatter,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  BarChart,
  Bar,
  Legend,
} from 'recharts';
import { Compass } from 'lucide-react';
import { ChartFrame } from '../ChartFrame';
import { computeEfficientAllocation } from '../../../engine/adaptive/allocationOptimizer';

export const EfficientAllocationChart = React.memo(function EfficientAllocationChart({
  categories = [],
  studyLogs = [],
  targetScore = 80,
  minScore = 0,
  maxScore = 100,
}) {
  const [weeklyBudget, setWeeklyBudget] = useState(null);

  const data = useMemo(
    () =>
      computeEfficientAllocation(categories, studyLogs, {
        weeklyBudgetHours: weeklyBudget || undefined,
        targetScore,
        minScore,
        maxScore,
      }),
    [categories, studyLogs, weeklyBudget, targetScore, minScore, maxScore]
  );

  if (!data.hasData || !data.subjects.length) return null;

  const effectiveBudget = weeklyBudget ?? data.weeklyBudgetHours;

  return (
    <div className="glass p-5 sm:p-6 rounded-3xl border border-white/10 shadow-2xl bg-slate-900/45 space-y-5">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-sky-500/15 border border-sky-500/30 flex items-center justify-center text-sky-300 shrink-0">
            <Compass size={20} />
          </div>
          <div>
            <h2 className="text-sm font-black text-white uppercase tracking-widest leading-none">
              Fronteira Eficiente de Alocação (Markowitz)
            </h2>
            <p className="text-[11px] text-slate-400 mt-1">
              Otimização de horas semanais por ganho marginal decrescente × risco de corte
            </p>
          </div>
        </div>

        <label className="flex items-center gap-2 text-xs text-slate-300 bg-slate-950/70 border border-white/10 rounded-xl px-3 py-1.5">
          <span className="font-semibold">Orçamento semanal:</span>
          <input
            type="number"
            min={4}
            max={70}
            value={effectiveBudget}
            onChange={(e) => setWeeklyBudget(Math.max(4, Math.min(70, Number(e.target.value) || 4)))}
            className="w-14 bg-slate-900 border border-white/10 rounded-md px-1.5 py-0.5 text-white font-mono text-center"
          />
          <span className="text-slate-500">h/sem</span>
        </label>
      </div>

      {/* Comparativo Atual vs Ótimo */}
      <div className="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <div className="rounded-2xl border border-white/5 bg-slate-950/50 p-3.5 space-y-2">
          <p className="text-[11px] font-bold text-slate-300">
            Fronteira Eficiente: Risco Residual (X) × Ganho Esperado em pp (Y)
          </p>
          <ChartFrame minHeight={230} label="Traçando fronteira eficiente">
            <div className="h-[230px] w-full" role="img" aria-label="Curva de Fronteira Eficiente de alocação de horas">
              <ResponsiveContainer width="100%" height="100%" minHeight={200} minWidth={1}>
                <ScatterChart margin={{ top: 12, right: 16, bottom: 20, left: 0 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" />
                  <XAxis type="number" dataKey="residualRisk" name="Risco" stroke="#64748b" fontSize={10} label={{ value: 'Risco Residual (menor = mais seguro)', position: 'insideBottom', offset: -12, fill: '#64748b', fontSize: 10 }} />
                  <YAxis type="number" dataKey="expectedGainPct" name="Ganho (pp)" stroke="#64748b" fontSize={10} tickFormatter={(v) => `+${v}`} />
                  <Tooltip cursor={{ strokeDasharray: '3 3' }} />
                  <Scatter name="Fronteira Eficiente" data={data.frontier} fill="#6366f1" line={{ stroke: '#818cf8', strokeWidth: 2 }} />
                  <Scatter name="Alocação Atual" data={[data.currentPortfolio]} fill="#f59e0b" />
                  <Scatter name="Ótimo Sugerido" data={[data.optimalPortfolio]} fill="#10b981" />
                </ScatterChart>
              </ResponsiveContainer>
            </div>
          </ChartFrame>
          <div className="flex flex-wrap gap-3 text-[10px] text-slate-400">
            <span className="flex items-center gap-1.5"><span className="w-2.5 h-2.5 rounded-full bg-amber-400" />Atual: +{data.currentPortfolio.expectedGainPct}pp</span>
            <span className="flex items-center gap-1.5"><span className="w-2.5 h-2.5 rounded-full bg-emerald-400" />Ótima: +{data.optimalPortfolio.expectedGainPct}pp</span>
          </div>
        </div>

        <div className="rounded-2xl border border-white/5 bg-slate-950/50 p-3.5 space-y-2">
          <p className="text-[11px] font-bold text-slate-300">
            Realocação Recomendada (Horas Atuais vs. Ótimas / semana)
          </p>
          <ChartFrame minHeight={230} label="Calculando realocação de horas">
            <div className="h-[230px] w-full" role="img" aria-label="Comparativo de horas semanais atuais versus ótimas por disciplina">
              <ResponsiveContainer width="100%" height="100%" minHeight={200} minWidth={1}>
                <BarChart data={data.subjects.slice(0, 8)} margin={{ top: 12, right: 12, left: 0, bottom: 24 }}>
                  <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" vertical={false} />
                  <XAxis dataKey="name" stroke="#94a3b8" fontSize={10} interval={0} angle={-18} textAnchor="end" height={45} tickFormatter={(v) => (String(v).length > 14 ? `${String(v).slice(0, 13)}…` : v)} />
                  <YAxis stroke="#64748b" fontSize={10} tickFormatter={(v) => `${v}h`} />
                  <Tooltip />
                  <Legend wrapperStyle={{ fontSize: 10 }} />
                  <Bar dataKey="currentHours" name="Atual (h/sem)" fill="#475569" radius={[4, 4, 0, 0]} />
                  <Bar dataKey="optimalHours" name="Ótima (h/sem)" fill="#38bdf8" radius={[4, 4, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </div>
          </ChartFrame>
        </div>
      </div>
    </div>
  );
});

export default EfficientAllocationChart;
</file>

<file path="src/components/charts/Analytics/EvolucaoFocoChart.jsx">
import React, { useId } from 'react';
import { AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip, ResponsiveContainer } from 'recharts';
import { formatDuration } from '../../../utils/dateHelper';

export const EvolucaoFocoChart = React.memo(function EvolucaoFocoChart({ data }) {
    const instanceId = useId().replace(/:/g, "");
    const colorFocoId = `foco_grad_${instanceId}`;

    if (!Array.isArray(data) || data.length === 0) {
        return (
            <div className="flex items-center justify-center h-full min-h-[300px] border border-white/5 rounded-2xl bg-black/20 mt-4 pb-2">
                <p className="text-slate-500 text-sm font-medium italic">Dados insuficientes para análise de foco.</p>
            </div>
        );
    }

    return (
        <div className="h-full min-h-[300px] w-full min-w-0 mt-4 pb-2">
            {/* FIX BUG 8: minWidth={1} com min-w-0 no container pai permite que o gráfico se adapte fluidamente a telas mobile sem estourar o viewport */}
            <ResponsiveContainer width="100%" height="100%" minHeight={250} minWidth={1}>
                {/* Ajustado margin left para 10 para o eixo Y e a linha do gráfico não ficarem cortados */}
                <AreaChart data={data} margin={{ top: 20, right: 20, left: 10, bottom: 5 }}>
                    {/* ORGANIZAÇÃO: defs sempre no topo do gráfico */}
                    <defs>
                        <linearGradient id={colorFocoId} x1="0" y1="0" x2="0" y2="1">
                            <stop offset="5%" stopColor="#8b5cf6" stopOpacity={0.3} />
                            <stop offset="95%" stopColor="#8b5cf6" stopOpacity={0} />
                        </linearGradient>
                    </defs>

                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" vertical={false} />

                    <XAxis
                        dataKey="data"
                        stroke="#64748b"
                        fontSize={11}
                        tickLine={false}
                        axisLine={false}
                        dy={10}
                        minTickGap={25}
                    />

                    <YAxis
                        stroke="#94a3b8"
                        fontSize={11}
                        domain={[0, dataMax => {
                            const safeMax = Number.isFinite(dataMax) ? Math.max(0, dataMax) : 0;
                            return Math.max(1, Math.ceil(safeMax * 1.15));
                        }]}
                        axisLine={false}
                        tickLine={false}
                        dx={-5}
                        width={45}
                        tickFormatter={(val) => formatDuration(val)}
                    />

                    <Tooltip
                        contentStyle={{ backgroundColor: 'rgba(15, 23, 42, 0.95)', border: '1px solid rgba(139, 92, 246, 0.3)', borderRadius: '12px', fontSize: '13px', backdropFilter: 'blur(8px)' }}
                        labelStyle={{ color: '#e2e8f0', fontWeight: 700, marginBottom: '4px' }}
                        itemStyle={{ color: '#fff', fontWeight: 'bold' }}
                        labelFormatter={(label) => `Dia ${label}`}
                        formatter={(value) => [formatDuration(value), 'Tempo Estudado']}
                    />

                    <Area connectNulls
                        type="monotoneX"
                        dataKey="horasEstudadas"
                        stroke="#8b5cf6"
                        strokeWidth={3}
                        fillOpacity={1}
                        fill={`url(#${colorFocoId})`}
                        name="Horas Estudadas"
                    />
                </AreaChart>
            </ResponsiveContainer>
        </div>
    );
});
</file>

<file path="src/components/charts/Analytics/HorasDisciplinaChart.jsx">
import React, { useMemo } from 'react';
import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid, Cell } from 'recharts';
import { formatDuration } from '../../../utils/dateHelper';

const COLORS = ['#818cf8', '#6366f1', '#4f46e5', '#4338ca', '#3730a3'];

export const HorasDisciplinaChart = React.memo(function HorasDisciplinaChart({ data }) {
    // Sort by hours descending (ensuring numerical sort)
    const sortedData = useMemo(() => {
        if (!data || !Array.isArray(data) || data.length === 0) return [];
        return [...data].sort((a, b) => (Number(b.horas) || 0) - (Number(a.horas) || 0));
    }, [data]);

    if (sortedData.length === 0) {
        return (
            <div className="flex items-center justify-center h-[300px] border border-white/5 rounded-2xl bg-black/20">
                <p className="text-slate-500 text-sm font-medium italic">Dados insuficientes para análise por matéria.</p>
            </div>
        );
    }

    // FIX: Altura base de 300px (para o eixo X ficar sempre no fundo alinhado ao outro gráfico), 
    // mas se tiver muitas matérias, cresce proporcionalmente para não amassar as barras.
    const minChartHeight = Math.max(300, sortedData.length * 45);

    return (
        <div className="h-full w-full mt-2 pb-2 transition-all duration-300" style={{ minHeight: `${minChartHeight}px` }}>
            <ResponsiveContainer width="100%" height={minChartHeight} minWidth={1}>
                <BarChart
                    layout="vertical"
                    data={sortedData}
                    margin={{ top: 25, right: 15, left: 0, bottom: 5 }}
                >
                    <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" horizontal={true} vertical={false} />

                    <XAxis
                        type="number"
                        stroke="#94a3b8"
                        fontSize={10}
                        domain={[0, dataMax => {
                            const safeMax = Number.isFinite(dataMax) ? Math.max(0, dataMax) : 0;
                            return Math.max(1, Math.ceil(safeMax * 1.1));
                        }]}
                        axisLine={false}
                        tickLine={false}
                        tickFormatter={(val) => formatDuration(val)}
                    />

                    <YAxis
                        type="category"
                        dataKey="disciplina"
                        stroke="#f1f5f9"
                        fontSize={10}
                        axisLine={false}
                        tickLine={false}
                        width={110}
                        tick={(props) => {
                            const { x, y, payload } = props;
                            const fullText = String(payload?.value ?? '');
                            const displayText = fullText.length > 18
                                ? fullText.substring(0, 18).trim() + '…'
                                : fullText;
                            return (
                                <g transform={`translate(${x},${y})`}>
                                    <text x={0} y={0} dy={3} dx={-5} textAnchor="end" fill="#e2e8f0" fontSize={9.5} fontWeight={600}>
                                        <title>{fullText}</title>
                                        {displayText}
                                    </text>
                                </g>
                            );
                        }}
                    />

                    <Tooltip
                        cursor={{ fill: 'rgba(255,255,255,0.03)' }}
                        contentStyle={{ backgroundColor: '#0f172a', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '12px', fontSize: '12px' }}
                        labelStyle={{ color: '#f8fafc', fontWeight: 700, marginBottom: '4px' }}
                        itemStyle={{ padding: '2px 0' }}
                        labelFormatter={(label) => String(label ?? '')}
                        formatter={(value) => [formatDuration(value), 'Total']}
                    />

                    <Bar
                        dataKey="horas"
                        fill="#6366f1"
                        radius={[0, 6, 6, 0]}
                        maxBarSize={24}
                        name="Horas"
                    >
                        {sortedData.map((entry, index) => (
                            <Cell key={`cell-${entry?.disciplina || index}`} fill={COLORS[index % COLORS.length]} />
                        ))}
                    </Bar>
                </BarChart>
            </ResponsiveContainer>
        </div>
    );
});
</file>

<file path="src/components/charts/Analytics/SyllabusBurndownChart.jsx">
import React, { useMemo, useState, useId } from 'react';
import {
  ComposedChart,
  Area,
  Line,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceLine,
} from 'recharts';
import { CalendarClock, TrendingUp, TrendingDown } from 'lucide-react';
import { ChartFrame } from '../ChartFrame';
import { buildSyllabusBurndownData } from '../../../utils/advancedChartHelpers';

const STATUS_BADGE = {
  completed: { label: 'Edital 100% Concluído', cls: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40' },
  ahead: { label: 'No Prazo / Adiantado', cls: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' },
  on_track: { label: 'Ritmo Estável', cls: 'bg-sky-500/15 text-sky-300 border-sky-500/30' },
  behind: { label: 'Ritmo Abaixo da Meta', cls: 'bg-amber-500/15 text-amber-300 border-amber-500/30' },
  overdue: { label: 'Prazo Atingido', cls: 'bg-rose-500/15 text-rose-300 border-rose-500/30' },
  stalled: { label: 'Sem Avanço Recente', cls: 'bg-slate-700/40 text-slate-300 border-slate-600/40' },
  no_goal: { label: 'Sem Data de Prova', cls: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/30' },
};

function BurndownTooltip({ active, payload, mode }) {
  if (!active || !payload || !payload.length) return null;
  const pt = payload[0]?.payload;
  if (!pt) return null;
  const isBurnup = mode === 'burnup';

  return (
    <div className="bg-slate-950/95 border border-white/15 rounded-2xl p-3.5 shadow-2xl backdrop-blur-xl min-w-[195px] text-xs">
      <p className="text-[10px] font-black uppercase tracking-widest text-slate-400 border-b border-white/10 pb-1.5 mb-2">
        {pt.isToday ? `${pt.label} (Hoje)` : pt.label}
      </p>
      <div className="space-y-1 font-mono">
        {(isBurnup ? pt.actualCompleted : pt.actualRemaining) != null && (
          <div className="flex justify-between gap-4">
            <span className="text-emerald-300">{isBurnup ? 'Concluídos:' : 'Restantes:'}</span>
            <span className="font-black text-white">{isBurnup ? pt.actualCompleted : pt.actualRemaining}</span>
          </div>
        )}
        {(isBurnup ? pt.projectedCompleted : pt.projectedRemaining) != null && !pt.isToday && (
          <div className="flex justify-between gap-4">
            <span className="text-sky-300">Projeção:</span>
            <span className="font-bold text-sky-300">{isBurnup ? pt.projectedCompleted : pt.projectedRemaining}</span>
          </div>
        )}
        <div className="flex justify-between gap-4 text-slate-400">
          <span>Ritmo Ideal:</span>
          <span>{isBurnup ? pt.idealCompleted : pt.idealRemaining}</span>
        </div>
      </div>
    </div>
  );
}

export const SyllabusBurndownChart = React.memo(function SyllabusBurndownChart({
  categories = [],
  user = {},
  defaultMode = 'burnup',
}) {
  const uid = useId().replace(/:/g, '');
  const [mode, setMode] = useState(defaultMode);

  const data = useMemo(
    () => buildSyllabusBurndownData(categories, user),
    [categories, user]
  );

  if (data.totalTasks === 0) {
    return null;
  }

  const isBurnup = mode === 'burnup';
  const badge = STATUS_BADGE[data.status] || STATUS_BADGE.on_track;
  const todayEntry = data.series.find((s) => s.isToday);

  return (
    <div className="glass p-5 sm:p-6 rounded-3xl border border-white/10 shadow-2xl bg-slate-900/45 space-y-5">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0">
            <CalendarClock size={20} />
          </div>
          <div>
            <div className="flex items-center gap-2 flex-wrap">
              <h2 className="text-sm font-black text-white uppercase tracking-widest leading-none">
                {isBurnup ? 'Burnup do Edital' : 'Burndown do Edital'}
              </h2>
              <span className={`px-2 py-0.5 rounded-full border text-[9px] font-bold uppercase ${badge.cls}`}>
                {badge.label}
              </span>
            </div>
            <p className="text-[11px] text-slate-400 mt-1">
              Ritmo real de tópicos concluídos vs. ritmo ideal até {data.hasGoalDate ? data.goalDateKey.split('-').reverse().join('/') : 'horizonte de 60 dias'}
            </p>
          </div>
        </div>

        <div className="flex items-center gap-1 bg-slate-950/70 border border-white/10 p-1 rounded-xl self-start sm:self-auto">
          <button
            type="button"
            onClick={() => setMode('burnup')}
            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all ${
              isBurnup ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40' : 'text-slate-400 hover:text-white'
            }`}
          >
            <TrendingUp size={13} />
            Burnup
          </button>
          <button
            type="button"
            onClick={() => setMode('burndown')}
            className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all ${
              !isBurnup ? 'bg-sky-500/20 text-sky-300 border border-sky-500/40' : 'text-slate-400 hover:text-white'
            }`}
          >
            <TrendingDown size={13} />
            Burndown
          </button>
        </div>
      </div>

      {/* KPIs */}
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div className="rounded-xl bg-slate-950/60 border border-white/5 p-3">
          <p className="text-[9px] uppercase text-slate-500 font-bold">Progresso</p>
          <p className="text-lg font-black font-mono text-white">
            {data.completionPct}% <span className="text-xs text-slate-400 font-normal">({data.completedTasks}/{data.totalTasks})</span>
          </p>
        </div>
        <div className="rounded-xl bg-slate-950/60 border border-white/5 p-3">
          <p className="text-[9px] uppercase text-slate-500 font-bold">Ritmo Atual</p>
          <p className="text-lg font-black font-mono text-emerald-300">{data.currentWeeklyPace}/sem</p>
        </div>
        <div className="rounded-xl bg-slate-950/60 border border-white/5 p-3">
          <p className="text-[9px] uppercase text-slate-500 font-bold">Ritmo Necessário</p>
          <p className="text-lg font-black font-mono text-amber-300">{data.requiredWeeklyPace}/sem</p>
        </div>
        <div className="rounded-xl bg-slate-950/60 border border-white/5 p-3">
          <p className="text-[9px] uppercase text-slate-500 font-bold">Previsão Fechamento</p>
          <p className="text-sm font-black font-mono text-sky-300 mt-0.5">
            {data.projectedFinishKey ? data.projectedFinishKey.split('-').reverse().join('/') : 'Defina ritmo'}
          </p>
        </div>
      </div>

      <ChartFrame minHeight={260} label="Calculando burndown do edital">
        <div className="h-[260px] w-full" role="img" aria-label="Gráfico de Burndown e Burnup do Edital">
          <ResponsiveContainer width="100%" height="100%" minHeight={240} minWidth={1}>
            <ComposedChart data={data.series} margin={{ top: 12, right: 16, left: 0, bottom: 8 }}>
              <defs>
                <linearGradient id={`burnFill_${uid}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stopColor={isBurnup ? '#10b981' : '#38bdf8'} stopOpacity={0.35} />
                  <stop offset="100%" stopColor={isBurnup ? '#10b981' : '#38bdf8'} stopOpacity={0.02} />
                </linearGradient>
              </defs>
              <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.06)" vertical={false} />
              <XAxis dataKey="label" stroke="#64748b" fontSize={10} />
              <YAxis domain={[0, data.totalTasks]} stroke="#64748b" fontSize={11} allowDecimals={false} />
              <Tooltip content={<BurndownTooltip mode={mode} />} />
              {todayEntry && (
                <ReferenceLine
                  x={todayEntry.label}
                  stroke="#94a3b8"
                  strokeDasharray="3 3"
                  label={{ value: 'Hoje', position: 'top', fill: '#cbd5e1', fontSize: 10 }}
                />
              )}
              <Line
                type="linear"
                dataKey={isBurnup ? 'idealCompleted' : 'idealRemaining'}
                name="Ritmo Ideal"
                stroke="#64748b"
                strokeWidth={2}
                strokeDasharray="5 5"
                dot={false}
              />
              <Area
                type="monotone"
                dataKey={isBurnup ? 'actualCompleted' : 'actualRemaining'}
                name={isBurnup ? 'Concluídos' : 'Restantes'}
                stroke={isBurnup ? '#34d399' : '#38bdf8'}
                strokeWidth={2.5}
                fill={`url(#burnFill_${uid})`}
                connectNulls={false}
              />
              <Line
                type="linear"
                dataKey={isBurnup ? 'projectedCompleted' : 'projectedRemaining'}
                name="Projeção (ritmo 14d)"
                stroke="#a78bfa"
                strokeWidth={2}
                strokeDasharray="3 3"
                dot={false}
                connectNulls
              />
            </ComposedChart>
          </ResponsiveContainer>
        </div>
      </ChartFrame>
    </div>
  );
});

export default SyllabusBurndownChart;
</file>

<file path="src/components/charts/Analytics/WorkloadACWRChart.jsx">
import React, { useMemo } from 'react';
import {
  ComposedChart,
  Line,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip,
  ResponsiveContainer,
  ReferenceArea,
  ReferenceLine,
} from 'recharts';
import { Flame, HeartPulse } from 'lucide-react';
import { ChartFrame } from '../ChartFrame';
import { computeACWR } from '../../../engine/adaptive/workloadACWR';

const ZONE_STYLE = {
  optimal: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/35',
  detraining: 'bg-sky-500/15 text-sky-300 border-sky-500/35',
  elevated: 'bg-amber-500/15 text-amber-300 border-amber-500/35',
